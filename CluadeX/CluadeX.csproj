<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Explicit entry point (Program.Main) so Velopack lifecycle hooks run
         before any WPF init โ€” see Program.cs. -->
    <StartupObject>CluadeX.Program</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>CluadeX</AssemblyName>
    <RootNamespace>CluadeX</RootNamespace>
    <Version>3.0.170</Version>
    <Description>CluadeX - AI Coding Assistant by Xman Studio</Description>
    <Company>Xman Studio</Company>
    <Authors>Xman Studio</Authors>
    <Copyright>ยฉ 2024-2026 Xman Studio (https://xman4289.com)</Copyright>
    <Product>CluadeX</Product>

    <!-- App icon -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Allow reading/loading native DLLs from the output directory for portable mode -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- We embed our own short git hash into InformationalVersion (EmbedGitCommitHash target);
         stop the SDK from appending the full 40-char revision on top of it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Debug builds go to bin\DebugBuild so a running CluadeX.exe (which locks
       bin\Debug\...\CluadeX.exe) never breaks `dotnet build`.
       Must come after TargetFramework is defined above. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>bin\DebugBuild\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\mascot.png" />
    <Resource Include="Assets\logo-wordmark.png" />
    <Resource Include="Assets\splash-girl.png" />
    <Resource Include="Assets\Girls\*.png" />
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>

  <!-- Syntax definitions AvalonEdit lacks (GDScript, Godot shader/scene, JSONC, YAML, TOML, shell) โ€” loaded by
       Views/Editor/NeonHighlighting.cs as "CluadeX.Resources.Syntax.<file>". -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Syntax\*.xshd" />
  </ItemGroup>

  <!-- UI Studio: the page overlay, the Vite locator plugin and the starter templates, read by
       Services/UiStudio/StudioTemplates.cs as "UiStudio/<path>" (portable: nothing is downloaded). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\UiStudio\**\*" LogicalName="UiStudio/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Resources\UiStudio\**\*" />
  </ItemGroup>

  <!-- Embed the git commit hash into AssemblyInformationalVersion (read at runtime for the
       title-bar version chip) so every build is traceable to its exact commit โ€” "which build
       am I actually running?" stops being a guessing game. -->
  <Target Name="EmbedGitCommitHash" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(ProjectDir)" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">local</GitCommitHash>
      <InformationalVersion>$(Version)+$(GitCommitHash)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!--
    Sprint 3 #2 โ€” Hook Script Library. Ship 15 bundled .ps1 hook scripts
    next to the .exe under Resources/HooksBundled/. HookBundleService copies
    them to %USERPROFILE%/.cluadex/hooks-bundled/ on first run.
  -->
  <ItemGroup>
    <Content Include="Resources\HooksBundled\*.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\HooksBundled\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="LLamaSharp" Version="0.26.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.26.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.26.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- Text and page images of PDFs the user attaches to a chat (Services/Attachments). Pure managed, Apache-2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <!-- Real self-update: delta packages, atomic swap, rollback. Same version the
         BrainX client ships, so both apps behave identically under `vpk`. -->
    <PackageReference Include="Velopack" Version="1.1.1" />
    <!-- Dev Preview built-in browser (Services/Browser). WebView2 runtime ships with Windows 10/11; the loader
         lands in runtimes\win-x64|x86|arm64\native\WebView2Loader.dll for this AnyCPU build (root on publish -r). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!--
    Post-build: copy llama-server.exe + all native DLLs (llama.cpp, ggml backends,
    CUDA runtime, multimodal projector) to the output directory. This is what
    enables Gemma 4 / Llama 4 / Qwen 3 support โ€” LLamaSharp's bundled llama.cpp
    is too old, so LocalGgufProvider transparently routes those models to this
    out-of-process server. CUDA runtime DLLs are required because most users
    don't have the CUDA Toolkit installed (only the driver).

    Uses globbing so newly added DLLs in llama-backend/ are picked up
    automatically โ€” no need to re-edit this list each time the backend updates.
  -->
  <ItemGroup>
    <LlamaBackendFiles Include="$(ProjectDir)llama-backend\*.dll" />
    <LlamaBackendFiles Include="$(ProjectDir)llama-backend\*.exe" />
  </ItemGroup>

  <Target Name="CopyLlamaServer" AfterTargets="Build" Condition="Exists('$(ProjectDir)llama-backend\llama-server.exe')">
    <Message Text="Copying llama-backend (llama-server, ggml, CUDA runtime) โ€” supports Gemma 4 / Llama 4 / Qwen 3..." Importance="high" />
    <MakeDir Directories="$(OutDir)llama-backend" />
    <Copy SourceFiles="@(LlamaBackendFiles)" DestinationFolder="$(OutDir)llama-backend\" SkipUnchangedFiles="true" />
  </Target>

</Project>
