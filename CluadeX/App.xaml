<Application x:Class="CluadeX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] THE THEME SLOT: colours, brushes, effects, fonts. Midnight is the default and the
                     look before themes existed; ThemeService.Apply swaps this entry at runtime (live, no
                     restart) for Resources/Themes/Classic.xaml or NeonCyber.xaml. Keep it FIRST. -->
                <ResourceDictionary Source="Resources/Themes/Midnight.xaml"/>
                <!-- [1] Shared control styles. Colour-free: every brush is a {DynamicResource token}. -->
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <conv:NavItemConverter x:Key="NavConverter"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <conv:DiffKindToBrushConverter x:Key="DiffKindBrush"/>
            <conv:DiffKindToBackgroundConverter x:Key="DiffKindBg"/>
            <conv:AiBoolToBrushConverter x:Key="AiBoolBrush"/>
            <conv:AiBoolToAvatarConverter x:Key="AiBoolAvatar"/>
            <conv:FileStatusToTextConverter x:Key="FileStatusText"/>
            <conv:ContextUsageBrushConverter x:Key="CtxBrush"/>
            <conv:ContextLedGateConverter x:Key="ContextLedGate"/>
            <conv:HexToColorConverter x:Key="HexToColor"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
