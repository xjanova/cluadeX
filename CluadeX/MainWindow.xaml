<Window x:Class="CluadeX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CluadeX.Views"
        xmlns:vm="clr-namespace:CluadeX.ViewModels"
        xmlns:conv="clr-namespace:CluadeX.Converters"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="CluadeX v3.0 — AI Coding Workbench"
        Icon="Assets/app.ico"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource NeonBg0Brush}"
        FontFamily="{StaticResource NeonUiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="L"
                    Command="{Binding ChatVM.ClearChatCommand}"/>
        <KeyBinding Modifiers="Control" Key="N"
                    Command="{Binding ChatVM.NewSessionCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemComma"
                    Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
        <KeyBinding Modifiers="Control" Key="D1"
                    Command="{Binding NavigateToCommand}" CommandParameter="Chat"/>
        <KeyBinding Modifiers="Control" Key="D2"
                    Command="{Binding NavigateToCommand}" CommandParameter="Models"/>
        <KeyBinding Modifiers="Control" Key="D3"
                    Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"/>
        <KeyBinding Modifiers="Control" Key="D4"
                    Command="{Binding NavigateToCommand}" CommandParameter="HexEditor"/>
        <KeyBinding Modifiers="Control" Key="D5"
                    Command="{Binding NavigateToCommand}" CommandParameter="Code"/>
        <KeyBinding Modifiers="Control" Key="D6"
                    Command="{Binding NavigateToCommand}" CommandParameter="SubAgents"/>
        <KeyBinding Modifiers="Control" Key="D7"
                    Command="{Binding NavigateToCommand}" CommandParameter="Skills"/>
        <KeyBinding Modifiers="Control" Key="D8"
                    Command="{Binding NavigateToCommand}" CommandParameter="Instincts"/>
        <KeyBinding Modifiers="Control" Key="D9"
                    Command="{Binding NavigateToCommand}" CommandParameter="DebugLog"/>
        <KeyBinding Modifiers="Control" Key="S"
                    Command="{Binding CodeEditorVM.SaveActiveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
            <views:ModelManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginManagerViewModel}">
            <views:PluginManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
            <views:PermissionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskManagerViewModel}">
            <views:TaskManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
            <views:FeaturesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpServersViewModel}">
            <views:McpServersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeMachineViewModel}">
            <views:TimeMachineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HexEditorViewModel}">
            <views:HexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CodeEditorViewModel}">
            <views:CodeEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubAgentsViewModel}">
            <views:SubAgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstinctsViewModel}">
            <views:InstinctsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <views:DebugLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityShieldViewModel}">
            <views:SecurityShieldView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HookLibraryViewModel}">
            <views:HookLibraryView/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootGrid">
            <!-- Nebula background — same physics as TimeMachine but app-wide -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" RadiusX="0.8" RadiusY="0.55">
                        <GradientStop Color="#22A672FF" Offset="0"/>
                        <GradientStop Color="#06071A" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 4 ambient depth orbs (subtle parallax) -->
            <Grid IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="0">
                <Ellipse Width="220" Height="220" Margin="-40,80,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.16">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#A672FF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="180" Height="180" Margin="0,80,80,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4CDFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="240" Height="240" Margin="0,0,180,40"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.13">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF5EC4" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="160" Height="160" Margin="180,0,0,40"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5CFFB0" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Grid Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       TITLE BAR (42)                     -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EB141838" Offset="0"/>
                            <GradientStop Color="#D90A0C22" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Traffic lights -->
                            <ColumnDefinition Width="Auto"/>  <!-- Project / branch -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- Cmd palette pill -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- New Chat -->
                            <ColumnDefinition Width="Auto"/>  <!-- Open folder -->
                            <ColumnDefinition Width="Auto"/>  <!-- Bell -->
                            <ColumnDefinition Width="Auto"/>  <!-- Buddy chip -->
                            <ColumnDefinition Width="Auto"/>  <!-- Caption buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Traffic lights (cosmetic) — actual window controls are on the right -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                            <Ellipse Width="12" Height="12" Margin="0,0,7,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.3,0.3" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#FFB8B8" Offset="0"/>
                                        <GradientStop Color="#FF6E6E" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><DropShadowEffect Color="#FF6E6E" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="12" Height="12" Margin="0,0,7,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.3,0.3" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#FFE6B0" Offset="0"/>
                                        <GradientStop Color="#FFD166" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><DropShadowEffect Color="#FFD166" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="12" Height="12">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.3,0.3" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#BFFFE0" Offset="0"/>
                                        <GradientStop Color="#5CFFB0" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><DropShadowEffect Color="#5CFFB0" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>

                        <Border Grid.Column="0" Width="1" Margin="106,8,0,8" HorizontalAlignment="Left"
                                Background="{StaticResource NeonLineBrush}"/>

                        <!-- Project + branch -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="CluadeX" FontFamily="{StaticResource NeonMonoFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeonInk1Brush}" VerticalAlignment="Center"/>
                            <!-- Version chip: vX.Y.Z · commit · build time — set in code-behind from the
                                 assembly InformationalVersion, so which build is running is never a guess. -->
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                    Background="#3311152E" BorderThickness="1"
                                    BorderBrush="{StaticResource NeonLineBrush}">
                                <TextBlock x:Name="VersionChip" Text="v?"
                                           FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                           Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center"
                                           ToolTip="Version · commit · build time of this running binary"/>
                            </Border>
                            <TextBlock Text="›" Margin="8,0" FontSize="11"
                                       Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{StaticResource NeonCyanBrush}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ChatVM.ProjectName}" FontFamily="{StaticResource NeonMonoFont}"
                                           FontSize="11" Foreground="{StaticResource NeonCyanBrush}"
                                           VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ChatVM.WorkingDirectory}"/>
                            </StackPanel>
                            <TextBlock Text="(no project open)" FontFamily="{StaticResource NeonMonoFont}"
                                       FontSize="11" Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        </StackPanel>

                        <!-- Command palette pill (cosmetic for now — opens Settings as fallback) -->
                        <Button Grid.Column="3" Style="{StaticResource CommandPalettePill}"
                                MinWidth="340" Margin="20,8"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Settings (Cmd-K palette planned for next iteration)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Search files, symbols &amp; commands…" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="Ctrl K" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" Foreground="{StaticResource NeonInk2Brush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- New Chat (icon button) -->
                        <Button Grid.Column="5" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.NewSessionCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="New Chat (Ctrl+N)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{StaticResource NeonCyanBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Open folder (icon button) -->
                        <Button Grid.Column="6" Width="32" Height="32" Margin="2,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.OpenFolderCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Open Folder">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{StaticResource NeonMintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Notification bell -->
                        <Button Grid.Column="7" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CheckUpdateCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Check for updates">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{StaticResource NeonInk2Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Buddy chip -->
                        <Border Grid.Column="8" Margin="10,6,12,6" Padding="4,0,12,0"
                                CornerRadius="14"
                                Background="#7028326E"
                                BorderBrush="#665CFFB0" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Buddy_Pet"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding IsBuddyEnabled, Converter={StaticResource BoolVis}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#5CFFB0" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.3,0.3" RadiusX="0.9" RadiusY="0.9">
                                            <GradientStop Color="#5CFFB0" Offset="0"/>
                                            <GradientStop Color="#1F8C5C" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding BuddyService.CurrentBuddy.DisplayEmoji, FallbackValue=🦎}"
                                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BuddyService.CurrentBuddy.Soul.Name, FallbackValue=Buddy}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NeonInk0Brush}"/>
                                        <TextBlock Text="{Binding BuddyService.CurrentBuddy.ShinyBadge, FallbackValue=''}"
                                                   FontSize="10" Margin="2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" Foreground="{StaticResource NeonMintBrush}">
                                        <Run Text="{Binding BuddyService.CurrentBuddy.Bones.Rarity, Mode=OneWay, FallbackValue=COMMON}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Caption buttons (min/max/close) -->
                        <StackPanel Grid.Column="9" Orientation="Horizontal"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="BtnMinimize" Style="{StaticResource NeonCaptionButton}"
                                    Content="&#xE921;" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Style="{StaticResource NeonCaptionButton}"
                                    Content="&#xE922;" Click="BtnMaximize_Click"/>
                            <Button x:Name="BtnClose" Style="{StaticResource NeonCaptionCloseButton}"
                                    Content="&#xE8BB;" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       MAIN CONTENT                       -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>      <!-- Activity bar -->
                        <ColumnDefinition Width="Auto"/>    <!-- Contextual panel (240 when shown) -->
                        <ColumnDefinition Width="*"/>       <!-- Center content -->
                    </Grid.ColumnDefinitions>

                    <!-- ░░░ ACTIVITY BAR (60px) ░░░ -->
                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource NeonLineBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D90C0E26" Offset="0"/>
                                <GradientStop Color="#D906071A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Logo + divider -->
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>  <!-- Bottom: settings -->
                            </Grid.RowDefinitions>

                            <!-- Logo -->
                            <StackPanel Grid.Row="0" Margin="0,12,0,8" HorizontalAlignment="Center">
                                <Grid Width="36" Height="36">
                                    <!-- Halo with conic-gradient feel via radial -->
                                    <Ellipse Width="48" Height="48" Margin="-6" Opacity="0.55">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#A672FF" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="0.7"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect><BlurEffect Radius="8"/></Ellipse.Effect>
                                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                                        <Ellipse.RenderTransform><RotateTransform x:Name="LogoHalo"/></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="LogoHalo"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{StaticResource NeonBg2Brush}">
                                        <Image Source="Assets/logo.png" Width="32" Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                                <Border Width="28" Height="1" Margin="0,10,0,0" Background="{StaticResource NeonLineHiBrush}"/>
                            </StackPanel>

                            <!-- Activity icons -->
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE8BD;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Chat, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Chat"
                                             GroupName="Activity"
                                             ToolTip="Chat (Ctrl+1)" AutomationProperties.Name="Chat"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE70F;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Code, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Code"
                                             GroupName="Activity"
                                             ToolTip="Code Editor (Ctrl+5)" AutomationProperties.Name="Code Editor"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE99A;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=SubAgents, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="SubAgents"
                                             GroupName="Activity"
                                             ToolTip="Subagents (Ctrl+6)" AutomationProperties.Name="Subagents"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE945;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Skills, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Skills"
                                             GroupName="Activity"
                                             ToolTip="Skills (Ctrl+7)" AutomationProperties.Name="Skills"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE82D;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Instincts, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Instincts"
                                             GroupName="Activity"
                                             ToolTip="Instincts (Ctrl+8) — continuous learning"
                                             AutomationProperties.Name="Instincts"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xEBE8;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=DebugLog, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="DebugLog"
                                             GroupName="Activity"
                                             ToolTip="Debug Log (Ctrl+9) — dev diagnostics"
                                             AutomationProperties.Name="Debug Log"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE72E;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=SecurityShield, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="SecurityShield"
                                             GroupName="Activity"
                                             ToolTip="SecurityShield — OWASP-style scanner (25 rules)"
                                             AutomationProperties.Name="SecurityShield"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE9F5;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=HookLibrary, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="HookLibrary"
                                             GroupName="Activity"
                                             ToolTip="Hook Library — 15 bundled .ps1 hooks (PreToolUse/PostToolUse/Stop/SessionStart/PreCompact)"
                                             AutomationProperties.Name="Hook Library"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE8F1;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Models, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Models"
                                             GroupName="Activity"
                                             ToolTip="Models (Ctrl+2)" AutomationProperties.Name="Models"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE823;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=TimeMachine, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"
                                             GroupName="Activity"
                                             ToolTip="Time Machine (Ctrl+3)" AutomationProperties.Name="Time Machine"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE943;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=HexEditor, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="HexEditor"
                                             GroupName="Activity"
                                             ToolTip="Hex Editor (Ctrl+4)" AutomationProperties.Name="Hex Editor"/>

                                <Border Width="28" Height="1" Margin="16,8" Background="{StaticResource NeonLineBrush}"/>

                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE74C;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Plugins, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Plugins"
                                             GroupName="Activity"
                                             ToolTip="Plugins" AutomationProperties.Name="Plugins"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xECAA;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=McpServers, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="McpServers"
                                             GroupName="Activity"
                                             ToolTip="MCP Servers" AutomationProperties.Name="MCP Servers"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE9D5;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Tasks, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Tasks"
                                             GroupName="Activity"
                                             ToolTip="Tasks" AutomationProperties.Name="Tasks"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE72E;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Permissions, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Permissions"
                                             GroupName="Activity"
                                             ToolTip="Permissions" AutomationProperties.Name="Permissions"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE734;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Features, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Features"
                                             GroupName="Activity"
                                             ToolTip="Features" AutomationProperties.Name="Features"/>
                            </StackPanel>

                            <!-- Bottom: Settings -->
                            <StackPanel Grid.Row="2" Margin="0,4,0,12">
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE713;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                             GroupName="Activity"
                                             ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ░░░ CONTEXTUAL PANEL (240px when Chat is selected) ░░░ -->
                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{StaticResource NeonLineBrush}"
                            Background="#A60A0C22">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavItem}" Value="Chat">
                                        <Setter Property="Width" Value="240"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Header -->
                                <RowDefinition Height="Auto"/>  <!-- Search box -->
                                <RowDefinition Height="*"/>     <!-- Sessions list -->
                            </Grid.RowDefinitions>

                            <!-- Panel header: EXPLORER-style strip -->
                            <Border Grid.Row="0" Padding="14,12,14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CHAT HISTORY" FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource NeonMonoFont}"
                                                   Foreground="{StaticResource NeonInk3Brush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Width="22" Height="22"
                                                  IsChecked="{Binding ChatVM.ShowAllProjectSessions}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                  Foreground="{StaticResource NeonInk3Brush}"
                                                  ToolTip="Show sessions from all projects">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                                    <TextBlock Text="&#xE1A6;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource NeonMagentaBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Search box -->
                            <Border Grid.Row="1" Margin="14,2,14,10" Padding="8,0"
                                    Background="#7011152E"
                                    BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource NeonInk2Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ChatVM.HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource NeonInk0Brush}"
                                             CaretBrush="{StaticResource NeonCyanBrush}"
                                             FontSize="11" Padding="0,7" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Width="20" Height="20"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding ChatVM.ClearSearchCommand}"
                                            Visibility="{Binding ChatVM.IsSearchingHistory, Converter={StaticResource BoolVis}}"
                                            ToolTip="Clear search">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{StaticResource NeonInk3Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Sessions list / search results -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,0,6,12">
                                <Grid>
                                    <!-- Normal session list -->
                                    <ItemsControl ItemsSource="{Binding ChatVM.VisibleSessions}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChatVM.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource NeonInk1Brush}"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Margin="0,1" Padding="10,7">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6"
                                                                    BorderThickness="1" BorderBrush="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#15FFFFFF"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       Foreground="{StaticResource NeonInk1Brush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM dd · HH:mm}'}"
                                                                       FontSize="9" Margin="0,2,0,0"
                                                                       FontFamily="{StaticResource NeonMonoFont}"
                                                                       Foreground="{StaticResource NeonInk3Brush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Width="20" Height="20"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.ChatVM.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" ToolTip="Delete session">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                       Foreground="{StaticResource NeonInk3Brush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <TextBlock Text="No conversations yet.&#x0a;Click + (top) to start!"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="20,30"
                                               Foreground="{StaticResource NeonInk3Brush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.VisibleSessionsCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Search results -->
                                    <ItemsControl ItemsSource="{Binding ChatVM.SearchResults}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChatVM.LoadSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SessionId}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Margin="0,1" Padding="10,7">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#15FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SessionTitle}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource NeonVioletBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="8" Padding="6,1">
                                                                <TextBlock Text="{Binding MatchCount, StringFormat='{}{0} hits'}"
                                                                           FontSize="9" FontFamily="{StaticResource NeonMonoFont}"
                                                                           Foreground="{StaticResource NeonInk2Brush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Snippet}" FontSize="10" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource NeonInk3Brush}"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ░░░ CENTER CONTENT ░░░ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Update banner -->
                        <Border Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource NeonLineBrush}"
                                Visibility="{Binding ShowUpdateBar, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1A6366F1" Offset="0"/>
                                    <GradientStop Color="#1A06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateMessage}" FontSize="12"
                                               Foreground="{StaticResource NeonInk0Brush}"/>
                                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Foreground="{StaticResource NeonCyanBrush}"
                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding InstallUpdateCommand}"
                                        Padding="14,6" Margin="8,0" FontSize="11" Cursor="Hand"
                                        Background="{StaticResource NeonRewindGradient}" BorderThickness="0"
                                        Foreground="White">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Install &amp; Restart"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding DismissUpdateCommand}" Width="28" Height="28"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Dismiss">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource NeonInk3Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Main content area — hosts the active page -->
                        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                     STATUS BAR (34)                      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource NeonLineBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EB0C0E26" Offset="0"/>
                            <GradientStop Color="#F206071A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Connected -->
                            <ColumnDefinition Width="Auto"/>  <!-- GPU -->
                            <ColumnDefinition Width="Auto"/>  <!-- Model -->
                            <ColumnDefinition Width="Auto"/>  <!-- Tok/s + cost -->
                            <ColumnDefinition Width="Auto"/>  <!-- ObsidianX bridge chip -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- LED context -->
                            <ColumnDefinition Width="Auto"/>  <!-- Time Machine -->
                            <ColumnDefinition Width="Auto"/>  <!-- Secure -->
                        </Grid.ColumnDefinitions>

                        <!-- Connected pip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource NeonRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource NeonMintBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource NeonAmberBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#5CFFB0" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="10" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource NeonRedBrush}"/>
                                        <Setter Property="Text" Value="OFFLINE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource NeonMintBrush}"/>
                                                <Setter Property="Text" Value="CONNECTED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource NeonAmberBrush}"/>
                                                <Setter Property="Text" Value="LOADING…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- GPU info — VRAM + sparkline + temp chip -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                                    Visibility="{Binding HasLiveGpuStats, Converter={StaticResource BoolVis}}">
                            <StackPanel.ToolTip>
                                <StackPanel Margin="4">
                                    <TextBlock Text="GPU live monitor" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk0Brush}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource NeonInk1Brush}">
                                        <Run Text="Utilization: "/><Run Text="{Binding LiveGpuStats.GpuUtilization, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{StaticResource NeonInk1Brush}">
                                        <Run Text="Temperature: "/><Run Text="{Binding LiveGpuStats.TemperatureC, Mode=OneWay}"/><Run Text="°C"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{StaticResource NeonInk1Brush}">
                                        <Run Text="VRAM: "/><Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel.ToolTip>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonVioletBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonInk2Brush}" VerticalAlignment="Center">
                                <Run Text="{Binding GpuUsageDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- Rolling sparkline of last ~48s of GPU utilization -->
                            <Canvas Width="100" Height="18" Margin="8,0,0,0" ClipToBounds="True"
                                    Background="#221E2056">
                                <Polyline Points="{Binding GpuSparklinePoints}"
                                          Stroke="{StaticResource NeonVioletBrush}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round">
                                    <Polyline.Effect>
                                        <DropShadowEffect Color="#A672FF" BlurRadius="6" ShadowDepth="0" Opacity="0.7"/>
                                    </Polyline.Effect>
                                </Polyline>
                            </Canvas>
                            <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                    Background="{Binding GpuTempBrush}">
                                <TextBlock Text="{Binding GpuTempDisplay}" FontSize="9" FontWeight="Bold"
                                           Foreground="#1E1E2E"/>
                            </Border>
                        </StackPanel>

                        <!-- Model name -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonVioletBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonVioletBrush}" VerticalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ChatVM.LoadedModelName, FallbackValue='no model'}"/>
                        </StackPanel>

                        <!-- Tokens/sec + Cost -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ChatVM.LastTurnStats, FallbackValue='—'}"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonInk2Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" · " FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChatVM.CostText, FallbackValue='$0.00'}"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonMintBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ObsidianX bridge chip -->
                        <Border Grid.Column="4" Margin="14,5,0,5" Padding="8,2" CornerRadius="6"
                                Background="#1A4FFFE2" BorderBrush="#554FFFE2" BorderThickness="1"
                                Visibility="{Binding McpHost, Converter={StaticResource NullToCollapsed}}">
                            <Border.ToolTip>
                                <StackPanel Margin="4">
                                    <TextBlock Text="ObsidianX bridge (MCP host)" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk0Brush}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource NeonInk1Brush}">
                                        <Run Text="Pipe: \\.\pipe\"/><Run Text="{Binding McpHost.PipeName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{StaticResource NeonInk1Brush}">
                                        <Run Text="Active: "/><Run Text="{Binding McpHost.ActiveConnections, Mode=OneWay}"/>
                                        <Run Text=" · Total: "/><Run Text="{Binding McpHost.TotalRequests, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource NeonRedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding McpHost.IsListening}" Value="True">
                                                    <Setter Property="Fill" Value="#4FFFE2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="🌉" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock FontSize="9" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonInk1Brush}">
                                    <Run Text="{Binding McpHost.ActiveConnections, Mode=OneWay, FallbackValue=0}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- LED context bar (5 segments) -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource CtxBrush}}">
                                <Run Text="CTX "/>
                                <Run Text="{Binding ChatVM.ContextUsagePercent, Mode=OneWay, StringFormat={}{0:F0}}"/>
                                <Run Text="% · "/>
                                <Run Text="{Binding ChatVM.ContextLevelLabel, Mode=OneWay, FallbackValue='FRESH'}"/>
                            </TextBlock>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=0}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NeonMintBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#5CFFB0" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=25}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NeonCyanBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#4CDFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=50}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NeonAmberBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFD166" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=75}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NeonPinkBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF8AA6" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=90}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NeonRedBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF6E6E" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>

                        <!-- Time Machine quick button -->
                        <Button Grid.Column="7" Style="{StaticResource StatusBarChipButton}"
                                Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"/>
                                <TextBlock Text="Time Machine"/>
                            </StackPanel>
                        </Button>

                        <!-- Secure badge -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonMintBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="SECURE · 0 telemetry" FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonMintBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════ MODEL LOADING OVERLAY ════════ -->
            <Border Panel.ZIndex="999"
                    Visibility="{Binding IsModelLoading, Converter={StaticResource BoolVis}}">
                <Border.Background>
                    <SolidColorBrush Color="#06071A" Opacity="0.85"/>
                </Border.Background>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="40,36" MinWidth="380">
                    <Border.Effect>
                        <DropShadowEffect Color="#A672FF" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,20"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#A672FF" Offset="0"/>
                                    <GradientStop Color="#4CDFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="SpinTransform" Angle="0"/></TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Loading Model" Foreground="{StaticResource NeonInk0Brush}"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ModelStatus}" Foreground="{StaticResource NeonInk1Brush}"
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="260"
                                     Foreground="{StaticResource NeonVioletBrush}"
                                     HorizontalAlignment="Center"/>
                        <TextBlock Text="Please wait while the model loads into memory..."
                                   Foreground="{StaticResource NeonInk2Brush}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
