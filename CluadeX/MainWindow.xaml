<Window x:Class="CluadeX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CluadeX.Views"
        xmlns:vm="clr-namespace:CluadeX.ViewModels"
        xmlns:conv="clr-namespace:CluadeX.Converters"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="CluadeX v3.0 — AI Coding Workbench"
        Icon="Assets/app.ico"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{DynamicResource Font.Ui.Display}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K"
                    Command="{Binding TogglePaletteCommand}"/>
        <KeyBinding Modifiers="Control" Key="L"
                    Command="{Binding ChatVM.ClearChatCommand}"/>
        <KeyBinding Modifiers="Control" Key="N"
                    Command="{Binding ChatVM.NewChatAndShowCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemComma"
                    Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
        <KeyBinding Modifiers="Control" Key="D1"
                    Command="{Binding NavigateToCommand}" CommandParameter="Chat"/>
        <KeyBinding Modifiers="Control" Key="D2"
                    Command="{Binding NavigateToCommand}" CommandParameter="Models"/>
        <KeyBinding Modifiers="Control" Key="D3"
                    Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"/>
        <KeyBinding Modifiers="Control" Key="D4"
                    Command="{Binding NavigateToCommand}" CommandParameter="HexEditor"/>
        <KeyBinding Modifiers="Control" Key="D5"
                    Command="{Binding NavigateToCommand}" CommandParameter="Code"/>
        <KeyBinding Modifiers="Control" Key="D6"
                    Command="{Binding NavigateToCommand}" CommandParameter="SubAgents"/>
        <KeyBinding Modifiers="Control" Key="D7"
                    Command="{Binding NavigateToCommand}" CommandParameter="Skills"/>
        <KeyBinding Modifiers="Control" Key="D8"
                    Command="{Binding NavigateToCommand}" CommandParameter="Instincts"/>
        <KeyBinding Modifiers="Control" Key="D9"
                    Command="{Binding NavigateToCommand}" CommandParameter="DebugLog"/>
        <KeyBinding Modifiers="Control" Key="S"
                    Command="{Binding CodeEditorVM.SaveActiveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
            <views:ModelManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginManagerViewModel}">
            <views:PluginManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
            <views:PermissionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskManagerViewModel}">
            <views:TaskManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
            <views:FeaturesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpServersViewModel}">
            <views:McpServersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeMachineViewModel}">
            <views:TimeMachineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HexEditorViewModel}">
            <views:HexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CodeEditorViewModel}">
            <views:CodeEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubAgentsViewModel}">
            <views:SubAgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstinctsViewModel}">
            <views:InstinctsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <views:DebugLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityShieldViewModel}">
            <views:SecurityShieldView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HookLibraryViewModel}">
            <views:HookLibraryView/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootGrid">
            <!-- Nebula background — same physics as TimeMachine but app-wide -->
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Backdrop.Nebula}"/>

            <!-- 4 ambient depth orbs (subtle parallax) -->
            <Grid IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="0">
                <Ellipse Width="220" Height="220" Margin="-40,80,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.16"
                         Fill="{DynamicResource Backdrop.Orb.1}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="180" Height="180" Margin="0,80,80,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.14"
                         Fill="{DynamicResource Backdrop.Orb.2}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="240" Height="240" Margin="0,0,180,40"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.13"
                         Fill="{DynamicResource Backdrop.Orb.3}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="160" Height="160" Margin="180,0,0,40"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.12"
                         Fill="{DynamicResource Backdrop.Orb.4}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Grid Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       TITLE BAR (42)                     -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TitleBar.Border}"
                        Background="{DynamicResource TitleBar.Background}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- (unused: the cosmetic mac traffic lights were removed) -->
                            <ColumnDefinition Width="Auto"/>  <!-- Project / branch -->
                            <ColumnDefinition Width="*"/>
                            <!-- The palette pill is the one thing that gives way on a narrow window: star-sized, so the
                                 caption buttons on the right are never pushed off-screen (they were at 1280 px). -->
                            <ColumnDefinition Width="6*"/>    <!-- Cmd palette pill -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- License chip -->
                            <ColumnDefinition Width="Auto"/>  <!-- New Chat -->
                            <ColumnDefinition Width="Auto"/>  <!-- Open folder -->
                            <ColumnDefinition Width="Auto"/>  <!-- Bell -->
                            <ColumnDefinition Width="Auto"/>  <!-- Buddy chip -->
                            <ColumnDefinition Width="Auto"/>  <!-- Caption buttons -->
                        </Grid.ColumnDefinitions>


                        <!-- Project + branch -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="CluadeX" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBar.Foreground}" VerticalAlignment="Center"/>
                            <!-- Version chip: vX.Y.Z · commit · build time — set in code-behind from the
                                 assembly InformationalVersion, so which build is running is never a guess. -->
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource TitleBar.Chip.Background}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border.Subtle}">
                                <TextBlock x:Name="VersionChip" Text="v?"
                                           FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                           Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"
                                           ToolTip="{services:Loc nav.versionTip}"/>
                            </Border>
                            <TextBlock Text="›" Margin="8,0" FontSize="11"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource Accent.1}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ChatVM.ProjectName}" FontFamily="{DynamicResource Font.Mono.Display}"
                                           FontSize="11" Foreground="{DynamicResource Accent.1}"
                                           VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ChatVM.WorkingDirectory}"/>
                            </StackPanel>
                            <TextBlock Text="{services:Loc nav.noProject}" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="11" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        </StackPanel>

                        <!-- Command palette pill — opens the real Ctrl+K palette -->
                        <Button Grid.Column="3" Style="{StaticResource CommandPalettePill}"
                                MaxWidth="440" Margin="12,8"
                                Command="{Binding OpenPaletteCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.paletteTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- DockPanel, not StackPanel: the pill shrinks on a narrow window and the text must
                                     trim instead of running under the Ctrl K badge -->
                                <DockPanel LastChildFill="True" Margin="0,0,8,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc nav.searchPlaceholder}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Border Grid.Column="1" Background="{DynamicResource TitleBar.Search.Kbd.Background}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="Ctrl K" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" Foreground="{DynamicResource Text.Muted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- License chip — always in view: a glowing invitation when this PC has no key, a countdown
                             during the free trial, a quiet "Pro" once bought. Opens the license dialog. -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- DGX Spark chip — opens the Spark window; solid green while CluadeX runs on a Spark -->
                        <Button Height="26" Margin="4,0,2,0" Cursor="Hand"
                                Command="{Binding OpenDgxSparkCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc spark.chipTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="13" Padding="10,0" BorderThickness="1"
                                            Background="{DynamicResource Spark.Chip.Background}" BorderBrush="{DynamicResource Spark.Chip.Border}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="dot" Width="7" Height="7" Margin="0,0,6,0" Fill="{DynamicResource Spark.Chip.Dot}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Text="{services:Loc spark.chip}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Spark.Chip.Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Spark.Chip.Hover.Background}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSparkActive}" Value="True">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Spark.Chip.Dot.Active}"/>
                                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.Spark.Active}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="26" Margin="4,0,2,0"
                                Command="{Binding OpenLicenseCommand}" Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{Binding LicenseChipTip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource License.Chip.Foreground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource License.Chip.Border}"/>
                                    <Setter Property="Background" Value="{DynamicResource License.Chip.Background}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                        CornerRadius="13" Padding="12,0"
                                                        Effect="{DynamicResource Glow.License.Chip}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding LicenseChipState}" Value="trial">
                                                        <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.License.Trial}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseChipState}" Value="active">
                                                        <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseChipState}" Value="trial">
                                            <Setter Property="Foreground" Value="{DynamicResource License.Chip.Trial.Foreground}"/>
                                            <Setter Property="Background" Value="{DynamicResource License.Chip.Trial.Background}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LicenseChipState}" Value="active">
                                            <Setter Property="Foreground" Value="{DynamicResource License.Chip.Active.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource License.Chip.Active.Border}"/>
                                            <Setter Property="Background" Value="{DynamicResource License.Chip.Active.Background}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LicenseChipText}" FontSize="11.5" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource Font.Ui}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>

                        <!-- New Chat (icon button) -->
                        <Button Grid.Column="6" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.NewChatAndShowCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.newChatTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource Accent.1}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Open folder (icon button) -->
                        <Button Grid.Column="7" Width="32" Height="32" Margin="2,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.OpenFolderCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc sidebar.openFolder}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource Status.Success}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Notification bell -->
                        <Button Grid.Column="8" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CheckUpdateCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.checkUpdatesTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Buddy chip -->
                        <Border Grid.Column="9" Margin="10,6,12,6" Padding="4,0,12,0"
                                CornerRadius="14"
                                Background="{DynamicResource Buddy.Chip.Background}"
                                BorderBrush="{DynamicResource Buddy.Chip.Border}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Buddy_Pet"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Effect="{DynamicResource Glow.Buddy.Chip}"
                                Visibility="{Binding IsBuddyEnabled, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                        Background="{DynamicResource Buddy.Avatar}">
                                    <TextBlock Text="{Binding BuddyService.CurrentBuddy.DisplayEmoji, FallbackValue=🦎}"
                                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BuddyService.CurrentBuddy.Soul.Name, FallbackValue=Buddy}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{Binding BuddyService.CurrentBuddy.ShinyBadge, FallbackValue=''}"
                                                   FontSize="10" Margin="2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" Foreground="{DynamicResource Status.Success}">
                                        <Run Text="{Binding BuddyService.CurrentBuddy.Bones.Rarity, Mode=OneWay, FallbackValue=COMMON}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Caption buttons (min/max/close) -->
                        <StackPanel Grid.Column="10" Orientation="Horizontal"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="BtnMinimize" Style="{StaticResource NeonCaptionButton}"
                                    Content="&#xE921;" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Style="{StaticResource NeonCaptionButton}"
                                    Content="&#xE922;" Click="BtnMaximize_Click"/>
                            <Button x:Name="BtnClose" Style="{StaticResource NeonCaptionCloseButton}"
                                    Content="&#xE8BB;" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       MAIN CONTENT                       -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>      <!-- Activity bar -->
                        <ColumnDefinition Width="Auto"/>    <!-- Contextual panel (240 when shown) -->
                        <ColumnDefinition Width="*"/>       <!-- Center content -->
                    </Grid.ColumnDefinitions>

                    <!-- ░░░ ACTIVITY BAR (60px) ░░░ -->
                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ActivityBar.Border}"
                            Background="{DynamicResource ActivityBar.Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Logo + divider -->
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>  <!-- Bottom: settings -->
                            </Grid.RowDefinitions>

                            <!-- Logo -->
                            <StackPanel Grid.Row="0" Margin="0,12,0,8" HorizontalAlignment="Center">
                                <Grid Width="36" Height="36">
                                    <!-- Halo with conic-gradient feel via radial -->
                                    <Ellipse Width="48" Height="48" Margin="-6" Opacity="0.55"
                                             Fill="{DynamicResource ActivityBar.Logo.Halo}">
                                        <Ellipse.Effect><BlurEffect Radius="8"/></Ellipse.Effect>
                                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                                        <Ellipse.RenderTransform><RotateTransform x:Name="LogoHalo"/></Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="LogoHalo"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="{DynamicResource ActivityBar.Logo.Background}">
                                        <Image Source="Assets/logo.png" Width="32" Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                                <Border Width="28" Height="1" Margin="0,10,0,0" Background="{DynamicResource ActivityBar.Logo.Divider}"/>
                            </StackPanel>

                            <!-- Activity icons -->
                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE8BD;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Chat, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Chat"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.chatTip}" AutomationProperties.Name="Chat"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE70F;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Code, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Code"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.codeTip}" AutomationProperties.Name="Code Editor"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE99A;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=SubAgents, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="SubAgents"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.subagentsTip}" AutomationProperties.Name="Subagents"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE945;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Skills, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Skills"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.skillsTip}" AutomationProperties.Name="Skills"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE82D;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Instincts, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Instincts"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.instinctsTip}"
                                             AutomationProperties.Name="Instincts"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xEBE8;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=DebugLog, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="DebugLog"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.debugLogTip}"
                                             AutomationProperties.Name="Debug Log"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE72E;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=SecurityShield, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="SecurityShield"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.shieldTip}"
                                             AutomationProperties.Name="SecurityShield"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE9F5;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=HookLibrary, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="HookLibrary"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.hooksTip}"
                                             AutomationProperties.Name="Hook Library"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE8F1;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Models, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Models"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.modelsTip}" AutomationProperties.Name="Models"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE823;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=TimeMachine, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.timeMachineTip}" AutomationProperties.Name="Time Machine"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE943;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=HexEditor, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="HexEditor"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.hexTip}" AutomationProperties.Name="Hex Editor"/>

                                <Border Width="28" Height="1" Margin="16,8" Background="{DynamicResource ActivityBar.Divider}"/>

                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE74C;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Plugins, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Plugins"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.pluginsTip}" AutomationProperties.Name="Plugins"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xECAA;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=McpServers, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="McpServers"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.mcpTip}" AutomationProperties.Name="MCP Servers"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE9D5;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Tasks, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Tasks"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.tasksTip}" AutomationProperties.Name="Tasks"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE72E;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Permissions, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Permissions"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.permissionsTip}" AutomationProperties.Name="Permissions"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE734;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Features, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Features"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.featuresTip}" AutomationProperties.Name="Features"/>
                            </StackPanel>

                            <!-- Bottom: Settings -->
                            <StackPanel Grid.Row="2" Margin="0,4,0,12">
                                <RadioButton Style="{StaticResource ActivityBarButton}" Content="&#xE713;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.settingsTip}" AutomationProperties.Name="Settings"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ░░░ CONTEXTUAL PANEL (240px when Chat is selected) ░░░ -->
                    <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sidebar.Border}"
                            Background="{DynamicResource Sidebar.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavItem}" Value="Chat">
                                        <Setter Property="Width" Value="240"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Header -->
                                <RowDefinition Height="Auto"/>  <!-- Search box -->
                                <RowDefinition Height="*"/>     <!-- Sessions list -->
                            </Grid.RowDefinitions>

                            <!-- Panel header: EXPLORER-style strip -->
                            <Border Grid.Row="0" Padding="14,12,14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc sidebar.chatHistory}" FontSize="10" FontWeight="Bold"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Width="22" Height="22"
                                                  IsChecked="{Binding ChatVM.ShowAllProjectSessions}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                  Foreground="{DynamicResource Text.Faint}"
                                                  ToolTip="{services:Loc nav.allProjectsTip}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                                    <TextBlock Text="&#xE1A6;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Sidebar.Toggle.Checked}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource State.Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Search box -->
                            <Border Grid.Row="1" Margin="14,2,14,10" Padding="8,0"
                                    Background="{DynamicResource Surface.Input}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ChatVM.HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Primary}"
                                             CaretBrush="{DynamicResource Accent.1}"
                                             FontSize="11" Padding="0,7" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Width="20" Height="20"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding ChatVM.ClearSearchCommand}"
                                            Visibility="{Binding ChatVM.IsSearchingHistory, Converter={StaticResource BoolVis}}"
                                            ToolTip="{services:Loc sidebar.clearSearch}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Sessions list / search results -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,0,6,12">
                                <Grid>
                                    <!-- Normal session list -->
                                    <ItemsControl ItemsSource="{Binding ChatVM.VisibleSessions}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChatVM.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Margin="0,1" Padding="10,7">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6"
                                                                    BorderThickness="1" BorderBrush="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       Foreground="{DynamicResource Text.Secondary}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM dd · HH:mm}'}"
                                                                       FontSize="9" Margin="0,2,0,0"
                                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                                       Foreground="{DynamicResource Text.Faint}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Width="20" Height="20"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Command="{Binding DataContext.ChatVM.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.deleteSession}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                       Foreground="{DynamicResource Text.Faint}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <TextBlock Text="{services:Loc sidebar.noConversations}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="20,30"
                                               Foreground="{DynamicResource Text.Faint}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.VisibleSessionsCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Search results -->
                                    <ItemsControl ItemsSource="{Binding ChatVM.SearchResults}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChatVM.LoadSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SessionId}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Margin="0,1" Padding="10,7">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SessionTitle}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent.2}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource Surface.Badge}" CornerRadius="8" Padding="6,1">
                                                                <TextBlock Text="{Binding MatchCount, StringFormat='{}{0} hits'}"
                                                                           FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                                                           Foreground="{DynamicResource Text.Muted}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Snippet}" FontSize="10" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource Text.Faint}"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ░░░ CENTER CONTENT ░░░ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Update banner -->
                        <Border Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Banner.Background}"
                                Visibility="{Binding ShowUpdateBar, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateMessage}" FontSize="12"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource Accent.1}"
                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding InstallUpdateCommand}"
                                        Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolVis}}"
                                        Padding="14,6" Margin="8,0" FontSize="11" Cursor="Hand"
                                        Background="{DynamicResource Banner.Button.Background}" BorderThickness="0"
                                        Foreground="{DynamicResource Text.OnAccent}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{services:Loc nav.installRestart}"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding DismissUpdateCommand}" Width="28" Height="28"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="{services:Loc nav.dismissTip}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource Text.Faint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Main content area — hosts the active page -->
                        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                     STATUS BAR (34)                      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StatusBar.Border}"
                        Background="{DynamicResource StatusBar.Background}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Connected -->
                            <ColumnDefinition Width="Auto"/>  <!-- GPU -->
                            <ColumnDefinition Width="Auto"/>  <!-- Model -->
                            <ColumnDefinition Width="Auto"/>  <!-- Tok/s + cost -->
                            <ColumnDefinition Width="Auto"/>  <!-- BrainX link chip -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- LED context -->
                        </Grid.ColumnDefinitions>

                        <!-- Connected pip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Effect="{DynamicResource Glow.StatusBar.Pip}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                        <Setter Property="Text" Value="OFFLINE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                <Setter Property="Text" Value="CONNECTED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                <Setter Property="Text" Value="LOADING…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- GPU info — VRAM + sparkline + temp chip -->
                        <!-- Only while a local model is the brain: with Claude / GPT / Gemini this PC's GPU does no work for the chat -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                                    Visibility="{Binding ShowGpuStats, Converter={StaticResource BoolVis}}">
                            <StackPanel.ToolTip>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{services:Loc nav.gpuMonitor}" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="{services:Loc nav.utilization}"/><Run Text="{Binding LiveGpuStats.GpuUtilization, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="{services:Loc nav.temperature}"/><Run Text="{Binding LiveGpuStats.TemperatureC, Mode=OneWay}"/><Run Text="°C"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="VRAM: "/><Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel.ToolTip>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center">
                                <Run Text="{Binding GpuUsageDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- Rolling sparkline of last ~48s of GPU utilization -->
                            <Canvas Width="100" Height="18" Margin="8,0,0,0" ClipToBounds="True"
                                    Background="{DynamicResource Chart.Background}">
                                <Polyline Points="{Binding GpuSparklinePoints}"
                                          Stroke="{DynamicResource Chart.Line}"
                                          Effect="{DynamicResource Glow.Chart.Line}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                    Background="{Binding GpuTempBrush}">
                                <TextBlock Text="{Binding GpuTempDisplay}" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Inverse}"/>
                            </Border>
                        </StackPanel>

                        <!-- Model name -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ChatVM.LoadedModelName, FallbackValue='no model'}"/>
                        </StackPanel>

                        <!-- Tokens/sec + Cost -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ChatVM.LastTurnStats, FallbackValue='—'}"
                                       FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Text=" · " FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChatVM.CostText, FallbackValue='$0.00'}"
                                       FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Status.Success}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Two MCP chips, opposite directions:
                             🧠 = we can reach the BrainX brain (outbound client)
                             🌉 = orchestrators can reach us (inbound named-pipe host) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- BrainX link chip — click: the MCP page when connected, the BrainX window (install / connect) otherwise -->
                        <Border Margin="14,5,0,5" Padding="8,2" CornerRadius="6" Cursor="Hand"
                                Background="{DynamicResource StatusBar.Brain.Background}" BorderBrush="{DynamicResource StatusBar.Brain.Border}" BorderThickness="1"
                                Visibility="{Binding McpServers, Converter={StaticResource NullToCollapsed}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBrainCommand}"/>
                            </Border.InputBindings>
                            <Border.ToolTip>
                                <StackPanel Margin="4" MaxWidth="420">
                                    <TextBlock Text="BrainX" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="Server: "/><Run Text="{Binding McpServers.BrainServerName, Mode=OneWay, FallbackValue='(not configured)'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="State: "/><Run Text="{Binding McpServers.BrainState, Mode=OneWay}"/>
                                        <Run Text=" · Tools: "/><Run Text="{Binding McpServers.BrainToolCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Status.Danger}"
                                               Text="{Binding McpServers.BrainLastError, Mode=OneWay}"
                                               Visibility="{Binding McpServers.BrainLastError, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <!-- Default red: anything that is not provably Ready is a
                                                 brain the agent cannot call. -->
                                            <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                            <Style.Triggers>
                                                <!-- Amber while starting OR while the supervisor is between two
                                                     respawn attempts (an attempt just failed, the next is due): the
                                                     same IsBrainStarting the BrainX window asks, so the chip no
                                                     longer goes red in the gap while the window says "starting". -->
                                                <DataTrigger Binding="{Binding McpServers.IsBrainStarting}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                                <!-- Last, so it wins: bound to the BOOL, not the enum, because a
                                                     bool trigger is the pattern already proven in this file. If the
                                                     enum triggers above ever failed to match, the dot degrades to
                                                     red — still honest, never a false green. -->
                                                <DataTrigger Binding="{Binding McpServers.IsBrainConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusBar.Brain.Connected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="🧠" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding McpServers.BrainStatusText, Mode=OneWay, FallbackValue='brain · —'}"/>
                            </StackPanel>
                        </Border>


                        </StackPanel>

                        <!-- LED context bar (5 segments) -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource CtxBrush}}">
                                <Run Text="CTX "/>
                                <Run Text="{Binding ChatVM.ContextUsagePercent, Mode=OneWay, StringFormat={}{0:F0}}"/>
                                <Run Text="% · "/>
                                <Run Text="{Binding ChatVM.ContextLevelLabel, Mode=OneWay, FallbackValue='FRESH'}"/>
                            </TextBlock>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Led.Off}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=0}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Glow.Led.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Led.Off}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=25}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent.1}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Glow.Led.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Led.Off}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=50}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Glow.Led.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Led.Off}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=75}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent.4}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Glow.Led.Caution}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="22" Height="8" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Led.Off}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource ContextLedGate}, ConverterParameter=90}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Glow.Led.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>

            <!-- ════════ MODEL LOADING OVERLAY ════════ -->
            <Border Panel.ZIndex="999" Background="{DynamicResource Bg.Overlay}"
                    Visibility="{Binding IsModelLoading, Converter={StaticResource BoolVis}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="16" Padding="40,36" MinWidth="380"
                        Effect="{DynamicResource Glow.Loading.Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,20"
                                HorizontalAlignment="Center" Background="{DynamicResource Loading.Orb}">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="SpinTransform" Angle="0"/></TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{services:Loc nav.loadingModel}" Foreground="{DynamicResource Text.Primary}"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ModelStatus}" Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="260"
                                     Foreground="{DynamicResource Accent.2}"
                                     HorizontalAlignment="Center"/>
                        <TextBlock Text="{services:Loc nav.loadingHint}"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ COMMAND PALETTE (Ctrl+K) ═══
                 Overlays everything. Pages + skills + project files, subsequence-matched. -->
            <Grid Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="900"
                  Background="{DynamicResource Bg.Scrim}"
                  Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolVis}}">
                <!-- click the backdrop to dismiss -->
                <Button Command="{Binding ClosePaletteCommand}" Background="Transparent"
                        BorderThickness="0" Focusable="False">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate></Button.Template>
                </Button>

                <Border Width="640" MaxHeight="460" VerticalAlignment="Top" Margin="0,90,0,0"
                        Background="{DynamicResource Palette.Background}" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Default}"
                        Effect="{DynamicResource Shadow.Palette}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Query box -->
                        <Grid Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBox x:Name="PaletteBox" Grid.Column="1"
                                     Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.1}"
                                     FontSize="16" VerticalContentAlignment="Center"
                                     PreviewKeyDown="PaletteBox_PreviewKeyDown"/>
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Subtle}"/>

                        <!-- Results -->
                        <ListBox Grid.Row="1" x:Name="PaletteList"
                                 ItemsSource="{Binding Palette.Results}"
                                 SelectedIndex="{Binding Palette.SelectedIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="PaletteList_Click">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                        Margin="8,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource Text.Muted}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                       Foreground="{DynamicResource Text.Faint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="3" Padding="6,1"
                                                Background="{DynamicResource Surface.Badge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="9"
                                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding KindColor, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Footer -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource Border.Subtle}" Padding="16,7">
                            <Grid>
                                <TextBlock Text="{Binding Palette.ResultSummary}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="10"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}"
                                           Text="{services:Loc nav.paletteHint}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
