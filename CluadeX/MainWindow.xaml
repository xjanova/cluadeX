<Window x:Class="CluadeX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CluadeX.Views"
        xmlns:vm="clr-namespace:CluadeX.ViewModels"
        xmlns:conv="clr-namespace:CluadeX.Converters"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="CluadeX v3.0 — AI Coding Workbench"
        Icon="Assets/app.ico"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg.Window}"
        FontFamily="{DynamicResource Font.Ui.Display}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K"
                    Command="{Binding TogglePaletteCommand}"/>
        <KeyBinding Modifiers="Control" Key="L"
                    Command="{Binding ChatVM.ClearChatCommand}"/>
        <KeyBinding Modifiers="Control" Key="N"
                    Command="{Binding ChatVM.NewChatAndShowCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemComma"
                    Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
        <KeyBinding Modifiers="Control" Key="D1"
                    Command="{Binding NavigateToCommand}" CommandParameter="Chat"/>
        <KeyBinding Modifiers="Control" Key="D2"
                    Command="{Binding NavigateToCommand}" CommandParameter="Models"/>
        <KeyBinding Modifiers="Control" Key="D3"
                    Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"/>
        <KeyBinding Modifiers="Control" Key="D4"
                    Command="{Binding NavigateToCommand}" CommandParameter="HexEditor"/>
        <KeyBinding Modifiers="Control" Key="D5"
                    Command="{Binding NavigateToCommand}" CommandParameter="Code"/>
        <KeyBinding Modifiers="Control" Key="D6"
                    Command="{Binding NavigateToCommand}" CommandParameter="SubAgents"/>
        <KeyBinding Modifiers="Control" Key="D7"
                    Command="{Binding NavigateToCommand}" CommandParameter="Skills"/>
        <KeyBinding Modifiers="Control" Key="D8"
                    Command="{Binding NavigateToCommand}" CommandParameter="Instincts"/>
        <KeyBinding Modifiers="Control" Key="D9"
                    Command="{Binding NavigateToCommand}" CommandParameter="DebugLog"/>
        <KeyBinding Modifiers="Control" Key="S"
                    Command="{Binding CodeEditorVM.SaveActiveCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:EqualsMultiConverter x:Key="EqualsMulti"/>
        <!-- A small on/off icon in the chat list's header. The on state is set on the glyph itself: a Foreground on the
             button is a local value, which a template trigger on that property can never beat. -->
        <Style x:Key="SidebarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Sidebar.Toggle.Checked}"/>
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource State.Selected}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource State.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Sidebar.Toggle.Checked}"/>
                                <Setter TargetName="glyph" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="bg" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row of the sidebar's project list: picked = the chat rows' selected look (fill + accent strip). Takes a dropped chat. -->
        <ControlTemplate x:Key="SidebarProjectRowTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"
                        BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="strip" Width="3" HorizontalAlignment="Left" Margin="0,4" CornerRadius="2"
                        Background="{DynamicResource Accent.1}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                </Trigger>
                <!-- Tag "picked" is set by the row's own style (a project's IsSelected, or the "No project" filter) -->
                <Trigger Property="Tag" Value="picked">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                    <Setter TargetName="strip" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
            <views:ModelManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginManagerViewModel}">
            <views:PluginManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
            <views:PermissionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WatchViewModel}">
            <views:WatchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UiStudioViewModel}">
            <views:UiStudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NodeGraphViewModel}">
            <views:NodeGraphView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskManagerViewModel}">
            <views:TaskManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
            <views:FeaturesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpServersViewModel}">
            <views:McpServersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeMachineViewModel}">
            <views:TimeMachineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HexEditorViewModel}">
            <views:HexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CodeEditorViewModel}">
            <views:CodeEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubAgentsViewModel}">
            <views:SubAgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstinctsViewModel}">
            <views:InstinctsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
            <views:DebugLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityShieldViewModel}">
            <views:SecurityShieldView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HookLibraryViewModel}">
            <views:HookLibraryView/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootGrid">
            <!-- Nebula background — same physics as TimeMachine but app-wide -->
            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Backdrop.Nebula}"/>

            <!-- 4 ambient depth orbs (subtle parallax) -->
            <Grid IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="0">
                <Ellipse Width="220" Height="220" Margin="-40,80,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.16"
                         Fill="{DynamicResource Backdrop.Orb.1}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="180" Height="180" Margin="0,80,80,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.14"
                         Fill="{DynamicResource Backdrop.Orb.2}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="240" Height="240" Margin="0,0,180,40"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.13"
                         Fill="{DynamicResource Backdrop.Orb.3}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="160" Height="160" Margin="180,0,0,40"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.12"
                         Fill="{DynamicResource Backdrop.Orb.4}">
                    <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Grid x:Name="ShellGrid" Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       TITLE BAR (42)                     -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TitleBar.Border}"
                        Background="{DynamicResource TitleBar.Background}">
                    <!-- Two layers: everything else may shrink and clip; the caption buttons keep their own column and are
                         always on screen (on a narrow window the Auto columns used to push them off the right edge). -->
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <!-- The brand: the mascot and the name in real type — the ornate wordmark PNG shrank to 38 px was
                         unreadable (owner 2026-10-17). It stays put; only the row after it glides. Theme colours: the name in Text.Primary, its X in the accent. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center" ToolTip="CluadeX">
                        <Image Source="/CluadeX;component/Assets/logo.png" Width="30" Height="30" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock FontSize="19" FontWeight="Black" FontFamily="{DynamicResource Font.Ui}" VerticalAlignment="Center"
                                   Margin="7,0,0,1"><Run Text="Cluade" Foreground="{DynamicResource Text.Primary}"/><Run Text="X" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                    </StackPanel>
                    <!-- Too narrow for everything: the row glides to show each item in turn, and follows the mouse -->
                    <views:MarqueeScroller Grid.Column="1">
                    <Grid x:Name="TitleContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- The CluadeX wordmark -->
                            <ColumnDefinition Width="Auto"/>  <!-- Project / branch -->
                            <ColumnDefinition Width="*"/>
                            <!-- The palette pill is the one thing that gives way on a narrow window: star-sized, so the
                                 caption buttons on the right are never pushed off-screen (they were at 1280 px). -->
                            <ColumnDefinition Width="6*"/>    <!-- Cmd palette pill -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- License chip -->
                            <ColumnDefinition Width="Auto"/>  <!-- New Chat -->
                            <ColumnDefinition Width="Auto"/>  <!-- Open folder -->
                            <ColumnDefinition Width="Auto"/>  <!-- Bell -->
                            <ColumnDefinition Width="Auto"/>  <!-- Buddy chip -->
                            <ColumnDefinition Width="Auto"/>  <!-- Caption buttons -->
                        </Grid.ColumnDefinitions>



                        <!-- Project + branch -->
                        <StackPanel x:Name="TitleProject" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <!-- Version chip: vX.Y.Z · commit · build time — set in code-behind from the
                                 assembly InformationalVersion, so which build is running is never a guess. -->
                            <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource TitleBar.Chip.Background}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border.Subtle}">
                                <TextBlock x:Name="VersionChip" Text="v?"
                                           FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                           Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"
                                           ToolTip="{services:Loc nav.versionTip}"/>
                            </Border>
                            <TextBlock Text="›" Margin="8,0" FontSize="11"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{DynamicResource Accent.1}"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding ChatVM.ProjectName}" FontFamily="{DynamicResource Font.Ui}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                           VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ChatVM.WorkingDirectory}"/>
                                <TextBlock Text="{Binding ChatVM.WorkingDirectory}" FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ChatVM.WorkingDirectory}"/>
                                <Border CornerRadius="9" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Status.Success.Tint}"
                                        Visibility="{Binding ChatVM.GitBranch, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AD;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource Status.Success}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ChatVM.GitBranch}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                   Foreground="{DynamicResource Status.Success}" VerticalAlignment="Center"
                                                   MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChatVM.GitBranch}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{services:Loc nav.noProject}" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="11" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="{Binding ChatVM.HasProject, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        </StackPanel>

                        <!-- Command palette pill — opens the real Ctrl+K palette -->
                        <Button x:Name="TitlePalette" Grid.Column="3" Style="{StaticResource CommandPalettePill}"
                                MaxWidth="440" Margin="12,8"
                                Command="{Binding OpenPaletteCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.paletteTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- DockPanel, not StackPanel: the pill shrinks on a narrow window and the text must
                                     trim instead of running under the Ctrl K badge -->
                                <DockPanel LastChildFill="True" Margin="0,0,8,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc nav.searchPlaceholder}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Border Grid.Column="1" Background="{DynamicResource TitleBar.Search.Kbd.Background}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="Ctrl K" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" Foreground="{DynamicResource Text.Muted}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- License chip — always in view: a glowing invitation when this PC has no key, a countdown
                             during the free trial, a quiet "Pro" once bought. Opens the license dialog. -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Today: what CluadeX spent on paid APIs, against the daily budget when one is set. Click: set it. -->
                        <Button Margin="0,0,8,0" Cursor="Hand" Click="TodayChip_Click" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{services:Loc chat.today.tip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Padding="8,3" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ChatVM.TodayBudgetText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChatVM.TodayBudgetPercent}" FontSize="11" Margin="10,0,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="3" Margin="0,3,0,0" MinWidth="120"
                                      Visibility="{Binding ChatVM.HasDailyBudget, Converter={StaticResource BoolVis}}">
                                    <Border Background="{DynamicResource Surface.Raised}" CornerRadius="2"/>
                                    <Border CornerRadius="2" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" Background="{DynamicResource Accent.1}">
                                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding ChatVM.TodayBudgetFraction}"/></Border.RenderTransform>
                                        <Border.Width><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/></Border.Width>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Button>
                        <!-- DGX Spark chip — opens the Spark window. NVIDIA's own logo on white (never under its 15 px digital minimum),
                             then the live status of the remembered Spark: grey = not set up, amber = connecting, green = online,
                             glowing green = in use (with the model), red = not reachable (the tooltip says why and what to do). -->
                        <Button Height="26" Margin="4,0,2,0" Cursor="Hand"
                                Command="{Binding OpenDgxSparkCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="{Binding SparkChipText}"
                                ToolTip="{Binding SparkChipTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="13" BorderThickness="1"
                                            Background="{DynamicResource Spark.Chip.Background}" BorderBrush="{DynamicResource Spark.Chip.Border}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="12,0,0,12" Background="White" Padding="10,4,10,4" VerticalAlignment="Stretch">
                                                <Image Source="/CluadeX;component/Assets/Logos/nvidia.png" Height="15" Stretch="Uniform"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                            </Border>
                                            <Ellipse x:Name="dot" Width="7" Height="7" Margin="9,0,6,0" Fill="{DynamicResource Spark.Chip.Dot}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt" Text="{Binding SparkChipText}" FontSize="11.5" FontWeight="SemiBold"
                                                       MaxWidth="190" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource Spark.Chip.Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Spark.Chip.Hover.Background}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SparkLinkState}" Value="Checking">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SparkLinkState}" Value="Online">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Spark.Chip.Dot.Active}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SparkLinkState}" Value="InUse">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Spark.Chip.Dot.Active}"/>
                                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.Spark.Active}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SparkLinkState}" Value="Unreachable">
                                            <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="26" Margin="4,0,2,0"
                                Command="{Binding OpenLicenseCommand}" Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{Binding LicenseChipTip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource License.Chip.Foreground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource License.Chip.Border}"/>
                                    <Setter Property="Background" Value="{DynamicResource License.Chip.Background}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                        CornerRadius="13" Padding="12,0"
                                                        Effect="{DynamicResource Glow.License.Chip}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding LicenseChipState}" Value="trial">
                                                        <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.License.Trial}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseChipState}" Value="active">
                                                        <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseChipState}" Value="trial">
                                            <Setter Property="Foreground" Value="{DynamicResource License.Chip.Trial.Foreground}"/>
                                            <Setter Property="Background" Value="{DynamicResource License.Chip.Trial.Background}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LicenseChipState}" Value="active">
                                            <Setter Property="Foreground" Value="{DynamicResource License.Chip.Active.Foreground}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource License.Chip.Active.Border}"/>
                                            <Setter Property="Background" Value="{DynamicResource License.Chip.Active.Background}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LicenseChipText}" FontSize="11.5" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource Font.Ui}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>

                        <!-- New Chat (icon button) -->
                        <Button Grid.Column="6" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.NewChatAndShowCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.newChatTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource Accent.1}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Open folder (icon button) -->
                        <Button Grid.Column="7" Width="32" Height="32" Margin="2,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ChatVM.OpenFolderCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc sidebar.openFolder}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <!-- E8B7 Folder — E838 drew as a half-open bracket the owner read as a broken icon -->
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{DynamicResource Status.Success}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Notification bell -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal">
                        <!-- Theme: one click to the list of themes, applied on the spot -->
                        <Button x:Name="ThemeButton" Width="32" Height="32" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="ThemeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.themeTip}" AutomationProperties.Name="Theme">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="32" Height="32" Margin="2,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CheckUpdateCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="{services:Loc nav.checkUpdatesTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        </StackPanel>

                        <!-- Buddy chip -->
                        <Border x:Name="TitleBuddy" Grid.Column="9" Margin="10,6,12,6" Padding="4,0,12,0"
                                CornerRadius="14"
                                Background="{DynamicResource Buddy.Chip.Background}"
                                BorderBrush="{DynamicResource Buddy.Chip.Border}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Buddy_Pet" MouseRightButtonUp="Buddy_Menu" ToolTip="{Binding PetDetails}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Effect="{DynamicResource Glow.Buddy.Chip}"
                                Visibility="{Binding IsBuddyEnabled, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                        Background="{DynamicResource Buddy.Avatar}">
                                    <Image Source="{Binding PetAvatar}" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PetTitle}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <TextBlock Text="{Binding PetSubtitle}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" Foreground="{DynamicResource Status.Success}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>


                    </Grid>
                    </views:MarqueeScroller>
                        <!-- Caption buttons (min/max/close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Style="{StaticResource NeonCaptionButton}"
                                Content="&#xE921;" Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource NeonCaptionButton}"
                                Content="&#xE922;" Click="BtnMaximize_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource NeonCaptionCloseButton}"
                                Content="&#xE8BB;" Click="BtnClose_Click"/>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                       MAIN CONTENT                       -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid x:Name="MainContentGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>      <!-- Activity bar -->
                        <ColumnDefinition Width="Auto"/>    <!-- Contextual panel (240 when shown) -->
                        <ColumnDefinition Width="*"/>       <!-- Center content -->
                    </Grid.ColumnDefinitions>

                    <!-- ░░░ ACTIVITY BAR (60px) ░░░ -->
                    <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ActivityBar.Border}"
                            Background="{DynamicResource ActivityBar.Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Logo + divider -->
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>  <!-- Bottom: settings -->
                            </Grid.RowDefinitions>

                            <!-- น้อง CluadeX floats over the top of the rail (BuddyHero below, MainWindow.Buddy.cs); this keeps her square
                                 free — its height follows her size. -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                <Border x:Name="BuddyRailSpacer" Height="66"/>
                                <Border Width="28" Height="1" Background="{DynamicResource ActivityBar.Logo.Divider}"/>
                            </StackPanel>

                            <!-- Activity icons -->
                            <!-- In a short window the list scrolls (wheel) instead of sliding under the Settings button, which
                                 covered the last items and took their clicks. -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" PanningMode="VerticalOnly">
                            <!-- Only the places you work in (owner 2026-10-11: "อันไหนใช้ไม่ได้จริงบ้างหรือไม่จำเป็นต้องมี ให้เอาออกเลย").
                                 Skills, Subagents, Instincts, Hooks, Plugins, Permissions, Features, Security Shield,
                                 Hex Editor and Debug Log live under the ⋯ button at the bottom of this bar, Settings › General ›
                                 More tools, Ctrl+K and their Ctrl+number keys; the agent still opens Hex Editor itself. -->
                            <StackPanel Margin="0,8,0,8">
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="chat" Content="&#xE8BD;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Chat, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Chat"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.chatTip}" AutomationProperties.Name="Chat"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="code" Content="&#xE70F;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Code, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Code"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.codeTip}" AutomationProperties.Name="Code Editor"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="models" Content="&#xE8F1;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Models, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Models"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.modelsTip}" AutomationProperties.Name="Models"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="timemachine" Content="&#xE823;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=TimeMachine, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="TimeMachine"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.timeMachineTip}" AutomationProperties.Name="Time Machine"/>

                                <Border Width="28" Height="1" Margin="16,8" Background="{DynamicResource ActivityBar.Divider}"/>

                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="mcp" Content="&#xECAA;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=McpServers, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="McpServers"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.mcpTip}" AutomationProperties.Name="MCP Servers"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="setup" Content="&#xE90F;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Setup, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Setup"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.setupTip}" AutomationProperties.Name="Setup"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="tasks" Content="&#xE9D5;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Tasks, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Tasks"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.tasksTip}" AutomationProperties.Name="Tasks"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="watch" Content="&#xE7B3;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Watch, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Watch"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.watchTip}" AutomationProperties.Name="Watch"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="billing" Content="&#xE8C7;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Billing, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Billing"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.billingTip}" AutomationProperties.Name="Billing"/>

                                <Border Width="28" Height="1" Margin="16,8" Background="{DynamicResource ActivityBar.Divider}"/>

                                <!-- UI Studio: edit the app's UI live, down to the exact source line; Node Graph: the project as nodes -->
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="uistudio" Content="&#xE790;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=UiStudio, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="UiStudio"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.uiStudioTip}" AutomationProperties.Name="UI Studio"/>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="nodegraph" Content="&#xE9D2;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=NodeGraph, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="NodeGraph"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.nodeGraphTip}" AutomationProperties.Name="Node Graph"/>
                            </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom: More tools (⋯ → the pages that are not on the rail: Skills, Subagents, Plugins …) and
                                 Settings. Lit while one of those pages is on screen. Its own group, so a click never
                                 unchecks the page on screen; the menu's items navigate (MainViewModel.MoreToolPages). -->
                            <StackPanel Grid.Row="2" Margin="0,4,0,12">
                                <RadioButton x:Name="MoreToolsButton" Style="{StaticResource ActivityBarButton}" Tag="moretools" Content="&#xE712;"
                                             IsChecked="{Binding IsMoreToolPage, Mode=OneWay}"
                                             GroupName="MoreTools" Click="MoreToolsButton_Click"
                                             ToolTip="{services:Loc nav.moreToolsTip}" AutomationProperties.Name="More tools">
                                    <RadioButton.ContextMenu>
                                        <ContextMenu x:Name="MoreToolsMenu" Placement="Right" Closed="MoreToolsMenu_Closed"
                                                     ItemsSource="{Binding MoreToolPages}">
                                            <!-- The menu takes the button's DataContext (MainViewModel) when it opens. -->
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="ToolTip" Value="{Binding Tip}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding Target}"/>
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                            <ContextMenu.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   Width="22" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContextMenu.ItemTemplate>
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ActivityBarButton}" Tag="settings" Content="&#xE713;"
                                             IsChecked="{Binding SelectedNavItem, Converter={StaticResource NavConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                             Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                             GroupName="Activity"
                                             ToolTip="{services:Loc nav.settingsTip}" AutomationProperties.Name="Settings"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ░░░ CONTEXTUAL PANEL (240px when Chat is selected) ░░░ -->
                    <Border x:Name="ChatSidebar" Grid.Column="1" Width="240" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sidebar.Border}"
                            Background="{DynamicResource Sidebar.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Shown on the Chat page only; its width is the user's (ResizeGrip below) -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavItem}" Value="Chat">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Beside her: title, buttons, search box -->
                                <RowDefinition Height="Auto"/>  <!-- Projects -->
                                <RowDefinition Height="*" MinHeight="80"/>     <!-- Sessions list -->
                                <RowDefinition Height="Auto"/>  <!-- Drag line between the chats and the files -->
                                <RowDefinition Height="*" MinHeight="60"/>     <!-- The project's files -->
                            </Grid.RowDefinitions>

                            <!-- The top of the list sits beside น้อง CluadeX: the title, its buttons and the search box move right of
                                 her square and the zone is at least as tall as she is, so nothing is ever under her (MainWindow.Buddy.cs
                                 sets its left margin and MinHeight from her size). The projects and the chats start below her. -->
                            <Grid x:Name="SidebarTopZone" Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Panel header: EXPLORER-style strip -->
                                <!-- The title on its own line and the three buttons under it: beside น้อง CluadeX the strip is
                                     narrow but tall, so the title is never cut ("Conversatio…") and the buttons keep their size. -->
                                <Border Grid.Row="0" Padding="14,12,14,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{services:Loc sidebar.conversations}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-6,6,0,0">
                                        <Button Width="24" Height="24" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding ChatVM.NewChatAndShowCommand}" ToolTip="{services:Loc nav.newChatTip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource State.Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Off when no project is open: every chat already shows, so a live button would answer nothing -->
                                        <ToggleButton Style="{StaticResource SidebarToggle}" Content="&#xE1A6;"
                                                      IsChecked="{Binding ChatVM.ShowAllProjectSessions}"
                                                      IsEnabled="{Binding ChatVM.HasProject}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{Binding ChatVM.AllProjectsTip}"/>
                                        <!-- Split chats that were put away: show them (dimmed, with "bring back") -->
                                        <ToggleButton Style="{StaticResource SidebarToggle}" Content="&#xE7B8;"
                                                      IsChecked="{Binding ChatVM.ShowArchivedSplits}"
                                                      ToolTip="{services:Loc chat.split.showAwayTip}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2">
                                    <Border Margin="14,2,14,6" Padding="8,0"
                                            Background="{DynamicResource Surface.Input}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ChatVM.HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource Text.Primary}"
                                                     CaretBrush="{DynamicResource Accent.1}"
                                                     FontSize="11" Padding="0,7" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="2" Width="20" Height="20"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding ChatVM.ClearSearchCommand}"
                                                    Visibility="{Binding ChatVM.IsSearchingHistory, Converter={StaticResource BoolVis}}"
                                                    ToolTip="{services:Loc sidebar.clearSearch}">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                           Foreground="{DynamicResource Text.Faint}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding ChatVM.SidebarFilterText}" FontSize="10.5" Margin="16,0,14,6"
                                               Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.SidebarFilterText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- The projects, below her (the search box and the line saying what the list holds are in the zone above:
                                 the top rows often stay the same when the filter changes, so the count is what shows a button did something) -->
                            <StackPanel Grid.Row="1">
                            <!-- Projects: named groups of chats (owner 2026-11-01). A row shows only its chats (again = all); a chat
                                 dropped on it moves in; right-click for a new chat in it, rename, its folder, delete. -->
                            <StackPanel Margin="10,0,10,6">
                                <Grid Margin="2,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding ChatVM.ToggleProjectsExpandedCommand}" HorizontalAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,3"
                                            ToolTip="{services:Loc sidebar.projects.toggleTip}" Template="{StaticResource SidebarProjectRowTemplate}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       Visibility="{Binding ChatVM.IsProjectsExpanded, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       Visibility="{Binding ChatVM.IsProjectsExpanded, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                            <TextBlock Text="{services:Loc sidebar.projects}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- a project is picked: back to every chat -->
                                    <Button Grid.Column="1" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding ChatVM.ClearProjectFilterCommand}" ToolTip="{services:Loc sidebar.project.clearFilter}"
                                            Template="{StaticResource SidebarProjectRowTemplate}" Padding="0"
                                            Visibility="{Binding ChatVM.HasProjectFilter, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Accent.1}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="2" Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding ChatVM.NewProjectCommand}" ToolTip="{services:Loc sidebar.project.newTip}"
                                            Template="{StaticResource SidebarProjectRowTemplate}" Padding="0">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <StackPanel Visibility="{Binding ChatVM.IsProjectsExpanded, Converter={StaticResource BoolVis}}">
                                    <!-- empty state: what a project is for and how a chat gets into one -->
                                    <TextBlock Text="{services:Loc sidebar.projects.empty}" FontSize="10.5" TextWrapping="Wrap" Margin="6,2,6,4"
                                               Foreground="{DynamicResource Text.Faint}"
                                               Visibility="{Binding ChatVM.HasChatProjects, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsControl ItemsSource="{Binding ChatVM.ChatProjects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.ChatVM.SelectProjectFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" Template="{StaticResource SidebarProjectRowTemplate}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="0,1"
                                                            HorizontalContentAlignment="Stretch" AllowDrop="True"
                                                            DragOver="ProjectRow_DragOver" Drop="ProjectRow_Drop" MouseRightButtonUp="ProjectRow_RightClick"
                                                            ToolTip="{services:Loc sidebar.project.rowTip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Tag" Value="picked"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Text.Muted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                            <!-- a bound folder that is not there any more -->
                                                            <TextBlock Grid.Column="2" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource Status.Warning}"
                                                                       ToolTip="{services:Loc sidebar.project.folderMissingTip}"
                                                                       Visibility="{Binding FolderMissing, Converter={StaticResource BoolVis}}"/>
                                                            <Grid Grid.Column="3" Margin="6,0,0,0" MinWidth="20">
                                                                <TextBlock Text="{Binding ChatCount}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                           FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"
                                                                           Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                                <StackPanel Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolVis}}">
                                                                    <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                            Command="{Binding DataContext.ChatVM.NewChatInProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.project.newChat}">
                                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- the chats in no project: pick them, or drop a chat here to take it out of its project -->
                                    <Button Command="{Binding ChatVM.SelectProjectFilterCommand}" CommandParameter=""
                                            Template="{StaticResource SidebarProjectRowTemplate}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="0,1"
                                            HorizontalContentAlignment="Stretch" AllowDrop="True"
                                            DragOver="ProjectRow_DragOver" Drop="ProjectRow_Drop"
                                            ToolTip="{services:Loc sidebar.project.noneTip}"
                                            Visibility="{Binding ChatVM.HasChatProjects, Converter={StaticResource BoolVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsUngroupedSelected}" Value="True">
                                                        <Setter Property="Tag" Value="picked"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                            <TextBlock Grid.Column="1" Text="{services:Loc sidebar.project.none}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ChatVM.UngroupedChatCount}" FontSize="10.5" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>

                            <!-- Sessions list / search results -->
                                <Grid Grid.Row="2">
                                    <!-- Normal session list. Only the rows in view are built: pressing "all projects" built all
                                         of them at once on the UI thread, over a second for 84 chats on an idle machine. -->
                                    <ItemsControl ItemsSource="{Binding ChatVM.VisibleSessions}"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,6,12" Focusable="False"
                                                              CanContentScroll="True">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="8,10,0,4"
                                                                   Foreground="{DynamicResource Text.Muted}"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- A split chat sits indented under the chat that opened it (SplitIndent); put away = dimmed -->
                                                <Grid Margin="{Binding SplitIndent}">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <!-- The tree line of a split chat: ├ (the line goes on to the next split chat) or ╰ (the last one) — a rounded
                                                     elbow from the parent's line into this row's status dot. -->
                                                <Grid Width="13" HorizontalAlignment="Left" Margin="-9,0,0,0" IsHitTestVisible="False"
                                                      Visibility="{Binding IsTreeChild, Converter={StaticResource BoolVis}}">
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                    <Border Grid.RowSpan="2" Width="1.5" HorizontalAlignment="Left" Background="{DynamicResource Border.Strong}"
                                                            Visibility="{Binding IsLastSplit, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                    <Border Grid.Row="0" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1.5,0,0,1.5"
                                                            CornerRadius="0,0,0,7" Margin="0,0,0,-0.75"/>
                                                    <!-- working: the line lights up in the accent and twinkles, with a spark where it reaches the chat —
                                                         the two chats work together (owner 2026-11-02: "อนิเมชั่นวิบวับนิดๆ"). Paused while not on screen. -->
                                                    <Grid Grid.RowSpan="2" views:AmbientAnimation.WhileVisible="True">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RunStatus}" Value="working">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border x:Name="LiveStem" Grid.RowSpan="2" Width="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent.1}"
                                                                Visibility="{Binding IsLastSplit, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                        <Border x:Name="LiveElbow" Grid.Row="0" BorderBrush="{DynamicResource Accent.1}" BorderThickness="1.5,0,0,1.5"
                                                                CornerRadius="0,0,0,7" Margin="0,0,0,-0.75"/>
                                                        <Ellipse x:Name="LiveSpark" Grid.Row="0" Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                 Margin="0,0,-1.5,-2.75" Fill="{DynamicResource Accent.1}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <Grid.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard x:Name="AmbientLink">
                                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                                        <DoubleAnimation Storyboard.TargetName="LiveElbow" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9" AutoReverse="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="LiveStem" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9" AutoReverse="True"/>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LiveSpark" Storyboard.TargetProperty="Opacity" Duration="0:0:1.8">
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LiveSpark" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" Duration="0:0:1.8">
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1.5"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LiveSpark" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" Duration="0:0:1.8">
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1.5"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.4"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Grid.Triggers>
                                                    </Grid>
                                                </Grid>
                                                <!-- right-click: pin, rename, move to a project, delete; drag it onto a project row to move it -->
                                                <Button Command="{Binding DataContext.ChatVM.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        MouseRightButtonUp="ChatRow_RightClick"
                                                        PreviewMouseLeftButtonDown="ChatRow_MouseDown"
                                                        PreviewMouseMove="ChatRow_MouseMove">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Margin" Value="0,1"/>
                                                            <Setter Property="Padding" Value="10,7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                                                    <Setter Property="Margin" Value="0,0"/>
                                                                    <Setter Property="Padding" Value="8,5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6"
                                                                    BorderThickness="1" BorderBrush="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border x:Name="strip" Width="3" HorizontalAlignment="Left" Margin="0,6" CornerRadius="2"
                                                                    Background="{DynamicResource Accent.1}" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                                                </Trigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.ChatVM.CurrentSession.Id" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                                    <Setter TargetName="strip" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                    <!-- ═══ a split chat: one line — status dot, its task as the title, where it went (another project) ═══ -->
                                                    <Grid Visibility="{Binding IsSplit, Converter={StaticResource BoolVis}}" ToolTip="{Binding SplitTask}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- the node: faint when idle, the accent with a soft pulse while working, amber waiting, green done -->
                                                        <Grid Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse Width="9" Height="9" Opacity="0" Fill="{DynamicResource Accent.1}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="working">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="PulseNode">
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.2"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseNode"/></DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <Ellipse Width="7" Height="7">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="working"><Setter Property="Fill" Value="{DynamicResource Accent.1}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="waiting"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="done"><Setter Property="Fill" Value="{DynamicResource Status.Success}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="failed"><Setter Property="Fill" Value="{DynamicResource Status.Danger}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding RunStatus}" Value="stopped"><Setter Property="Fill" Value="{DynamicResource Status.Danger.Soft}"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                                        <!-- the work went to another project: say where -->
                                                        <Border Grid.Column="2" Margin="6,0,0,0" Padding="5,0,6,1" CornerRadius="4" VerticalAlignment="Center"
                                                                Background="{DynamicResource State.Hover.Subtle}"
                                                                Visibility="{Binding ShowProjectLine, Converter={StaticResource BoolVis}}">
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" MaxWidth="90">
                                                                <Run Text="→ "/><Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolVis}}">
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.pinTip}"
                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.unpinTip}"
                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Accent.1}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.ArchiveSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc chat.split.archiveTip}"
                                                                    Visibility="{Binding IsArchived, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.UnarchiveSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc chat.split.unarchiveTip}"
                                                                    Visibility="{Binding IsArchived, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.deleteSession}">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- ═══ an ordinary chat (top of a tree or on its own) ═══ -->
                                                    <Grid Visibility="{Binding IsSplit, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- The chat's icon tells how its run stands: a grey node when idle, a turning neon arc while it
                                                             works, an amber ripple while it waits for the owner, a green check with a pink dot for a
                                                             result not opened yet, red when the turn failed or was stopped (Views/RunBadgeIcon.xaml). -->
                                                        <views:RunBadgeIcon Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                        <StackPanel Grid.Column="1">
                                                            <DockPanel LastChildFill="True">
                                                                <!-- a chat that split work off: a git-branch badge with how many split chats are open (tooltip: how they stand) -->
                                                                <Grid DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding SplitSummary}"
                                                                      Visibility="{Binding HasOpenSplits, Converter={StaticResource BoolVis}}">
                                                                    <Border CornerRadius="6" Background="{DynamicResource Accent.2}" Opacity="0.16"/>
                                                                    <!-- a split chat works now: the badge's rim twinkles (they work together) -->
                                                                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Accent.2}"
                                                                            views:AmbientAnimation.WhileVisible="True"
                                                                            Visibility="{Binding HasWorkingSplits, Converter={StaticResource BoolVis}}">
                                                                        <Border.Triggers>
                                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                                <BeginStoryboard x:Name="AmbientBadge">
                                                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" AutoReverse="True">
                                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.9">
                                                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                                        </DoubleAnimation>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger>
                                                                        </Border.Triggers>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" Margin="5,1,6,1">
                                                                        <Path Width="11" Height="12" Margin="0,0,3,0" VerticalAlignment="Center" Stretch="None"
                                                                              Stroke="{DynamicResource Accent.2}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                                            <Path.Data>
                                                                                <GeometryGroup>
                                                                                    <EllipseGeometry Center="3,2.5" RadiusX="1.6" RadiusY="1.6"/>
                                                                                    <EllipseGeometry Center="3,9.5" RadiusX="1.6" RadiusY="1.6"/>
                                                                                    <EllipseGeometry Center="8.5,3.5" RadiusX="1.6" RadiusY="1.6"/>
                                                                                    <LineGeometry StartPoint="3,4.1" EndPoint="3,7.9"/>
                                                                                    <PathGeometry Figures="M8.5,5.1 C8.5,7.6 3,6.4 3,7.9"/>
                                                                                </GeometryGroup>
                                                                            </Path.Data>
                                                                        </Path>
                                                                        <TextBlock Text="{Binding OpenSplitCount}" FontSize="10.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           Foreground="{DynamicResource Text.Primary}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                                    <!-- a result not opened yet reads bolder -->
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RunStatus}" Value="done"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            

                                                            <TextBlock Text="{Binding ProjectName}" FontSize="11" Margin="0,1,0,0"
                                                                       Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding ShowProjectLine, Converter={StaticResource BoolVis}}"/>
                                                            <!-- what the run is doing now, breathing softly while it works -->
                                                            <TextBlock views:AmbientAnimation.WhileVisible="True" Text="{Binding RunStep}" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                                       Foreground="{DynamicResource Accent.1}"
                                                                       Visibility="{Binding RunStep, Converter={StaticResource BoolVis}}">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard x:Name="AmbientMain3">
                                                                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:1.1">
                                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Grid Grid.Column="2">
                                                        <TextBlock Text="{Binding ListTimeLabel}" FontSize="11" VerticalAlignment="Top" Margin="6,1,0,0"
                                                                   FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"
                                                                   Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                                                    Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolVis}}">
                                                            <!-- pin to the top / unpin -->
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.pinTip}"
                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.unpinTip}"
                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="&#xE77A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Accent.1}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <!-- rename -->
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.RenameChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.rename.title}">
                                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <!-- a chat that split work off: put away its finished split chats -->
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.ArchiveFinishedSplitsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc chat.split.archiveDoneTip}"
                                                                    Visibility="{Binding HasFinishedSplits, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                           Foreground="{DynamicResource Accent.2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <!-- a split chat: put it away / bring it back -->
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.ArchiveSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc chat.split.archiveTip}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSplit}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsArchived}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                           Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.UnarchiveSplitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc chat.split.unarchiveTip}"
                                                                    Visibility="{Binding IsArchived, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                           Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Width="20" Height="20"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Command="{Binding DataContext.ChatVM.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" ToolTip="{services:Loc sidebar.deleteSession}">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                           Foreground="{DynamicResource Text.Muted}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                    </Grid>
                                                </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty state -->
                                    <TextBlock Text="{services:Loc sidebar.noConversations}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="20,30"
                                               Foreground="{DynamicResource Text.Faint}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChatVM.VisibleSessionsCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Search results -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,6,12">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChatVM.IsSearchingHistory}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <ItemsControl ItemsSource="{Binding ChatVM.SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChatVM.LoadSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding SessionId}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Margin="0,1" Padding="10,7">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SessionTitle}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent.2}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource Surface.Badge}" CornerRadius="8" Padding="6,1">
                                                                <TextBlock Text="{Binding MatchCount, StringFormat='{}{0} hits'}"
                                                                           FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                                                           Foreground="{DynamicResource Text.Muted}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Snippet}" FontSize="10" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource Text.Faint}"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                            <!-- The project's files under the chats (owner 2026-10-18: "ช่องแสดงไฟล์ไปไว้ในด้านซ้าย ต่อจาก
                                 บทสนทนา จะเหมาะกว่าไว้ใต้แชท"); drag the line between them to share the height. -->
                            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                          ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Background="Transparent"
                                          BorderBrush="{DynamicResource Sidebar.Border}" BorderThickness="0,1,0,0"
                                          ToolTip="{services:Loc chat.side.splitTip}"/>
                            <views:ProjectFilesPanel Grid.Row="4" DataContext="{Binding ChatVM}"/>
                        </Grid>
                    </Border>

                    <!-- Drag the chat list's right edge to resize it (remembered); double-click puts it back to 240 -->
                    <views:ResizeGrip Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,-3,0"
                                      Key="main.chatList" MinSize="180" MaxSize="520"
                                      Target="{Binding ElementName=ChatSidebar}"
                                      Visibility="{Binding Visibility, ElementName=ChatSidebar}"/>

                    <!-- ░░░ CENTER CONTENT ░░░ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Update banner -->
                        <Border Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Banner.Background}"
                                Visibility="{Binding ShowUpdateBar, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateMessage}" FontSize="12"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource Accent.1}"
                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding InstallUpdateCommand}"
                                        Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolVis}}"
                                        Padding="14,6" Margin="8,0" FontSize="11" Cursor="Hand"
                                        Background="{DynamicResource Banner.Button.Background}" BorderThickness="0"
                                        Foreground="{DynamicResource Text.OnAccent}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{services:Loc nav.installRestart}"/>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding DismissUpdateCommand}" Width="28" Height="28"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="{services:Loc nav.dismissTip}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource Text.Faint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Main content area — hosts the active page. The chat and the code editor are built once and
                             kept (switching between them used to rebuild both); see Views/PageHost. -->
                        <views:PageHost x:Name="PageArea" Grid.Row="1" Page="{Binding CurrentView}"/>
                    </Grid>

                    <!-- ░░░ น้อง CluadeX (owner 2026-11-08: "ใหญ่ ๆ ลอยมุมซ้ายบน"): a square under the title bar over the rail and
                         the chat list beside it. In a Canvas so her size never widens a column; on top of both. MainWindow.Buddy.cs
                         sizes her (big beside the chat list, rail-sized on the other pages, smaller in a short window) and moves
                         what would sit under her: the rail's first icon and the list's title, buttons and search box.
                         A click (or Tab to her + Enter/Space) goes Home: the Chat page, an empty chat, no folder open; running
                         chats carry on in the background. ░░░ -->
                    <Canvas Grid.Column="0" Panel.ZIndex="20" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="0">
                        <Button x:Name="BuddyHero" Width="124" Height="124" Cursor="Hand"
                                Command="{Binding ChatVM.GoHomeCommand}" ToolTip="{Binding ChatVM.BuddyTip}"
                                AutomationProperties.Name="{services:Loc buddy.goHomeName}"
                                AutomationProperties.HelpText="{Binding ChatVM.BuddyMoodTip}">
                            <!-- keyboard focus only (not after a mouse click): a soft ring round her square -->
                            <Button.FocusVisualStyle>
                                <Style>
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Rectangle Margin="2" RadiusX="14" RadiusY="14" StrokeThickness="1.5" Stroke="{DynamicResource Accent.1}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.FocusVisualStyle>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <views:CluadexBuddy x:Name="Buddy" DataContext="{Binding ChatVM}" Margin="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Buddy" Property="Margin" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!--                     STATUS BAR (34)                      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StatusBar.Border}"
                        Background="{DynamicResource StatusBar.Background}">
                    <views:MarqueeScroller>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Connected -->
                            <ColumnDefinition Width="Auto"/>  <!-- GPU -->
                            <ColumnDefinition Width="Auto"/>  <!-- Model -->
                            <ColumnDefinition Width="Auto"/>  <!-- Tok/s + cost -->
                            <ColumnDefinition Width="Auto"/>  <!-- BrainX link chip -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>  <!-- LED context -->
                        </Grid.ColumnDefinitions>

                        <!-- Connected pip -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Effect="{DynamicResource Glow.StatusBar.Pip}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <!-- What the chat is doing now ("พร้อมใช้งาน", "ขั้นที่ 3/200 · กำลังคิด…") -->
                            <TextBlock Text="{Binding ChatVM.StatusText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StatusBar.Foreground}" MaxWidth="360" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ChatVM.StatusText}"/>
                        </StackPanel>

                        <!-- GPU info — VRAM + sparkline + temp chip -->
                        <!-- Only while a local model is the brain: with Claude / GPT / Gemini this PC's GPU does no work for the chat -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                                    Visibility="{Binding ShowGpuStats, Converter={StaticResource BoolVis}}">
                            <StackPanel.ToolTip>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{services:Loc nav.gpuMonitor}" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="{services:Loc nav.utilization}"/><Run Text="{Binding LiveGpuStats.GpuUtilization, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="{services:Loc nav.temperature}"/><Run Text="{Binding LiveGpuStats.TemperatureC, Mode=OneWay}"/><Run Text="°C"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="VRAM: "/><Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel.ToolTip>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center">
                                <Run Text="{Binding GpuUsageDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- Rolling sparkline of last ~48s of GPU utilization -->
                            <Canvas Width="100" Height="18" Margin="8,0,0,0" ClipToBounds="True"
                                    Background="{DynamicResource Chart.Background}">
                                <Polyline Points="{Binding GpuSparklinePoints}"
                                          Stroke="{DynamicResource Chart.Line}"
                                          Effect="{DynamicResource Glow.Chart.Line}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <Run Text="{Binding GpuVramDisplay, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                    Background="{Binding GpuTempBrush}">
                                <TextBlock Text="{Binding GpuTempDisplay}" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Inverse}"/>
                            </Border>
                        </StackPanel>

                        <!-- Model name -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{DynamicResource Font.Ui}" FontSize="12"
                                       Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ChatVM.LoadedModelName, FallbackValue='no model'}"/>
                            <TextBlock Text="{Binding ChatVM.ContextWindowText}" FontSize="12" Margin="16,0,0,0"
                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- How full the context is: tokens used of the window, as a bar -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                                    ToolTip="{services:Loc chat.ctxTip}">
                            <!-- A gauge (SpeedHigh), not E8A5 "Document": at 11 px the page read as an empty square box. -->
                            <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center">
                                <Run Text="{Binding ChatVM.ContextUsageText, Mode=OneWay}"/>
                                <Run Text=" tokens ("/><Run Text="{Binding ChatVM.ContextUsagePercent, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text="%)"/>
                            </TextBlock>
                            <Grid Width="120" Height="5" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource Led.Off}" CornerRadius="3"/>
                                <Border CornerRadius="3" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5"
                                        Background="{Binding ChatVM.ContextUsagePercent, Converter={StaticResource CtxBrush}}" Width="120">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ChatVM.ContextFraction}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Two MCP chips, opposite directions:
                             🧠 = we can reach the BrainX brain (outbound client)
                             🌉 = orchestrators can reach us (inbound named-pipe host) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- BrainX link chip — click: the MCP page when connected, the BrainX window (install / connect) otherwise -->
                        <Border Margin="14,5,0,5" Padding="8,2" CornerRadius="6" Cursor="Hand"
                                Background="{DynamicResource StatusBar.Brain.Background}" BorderBrush="{DynamicResource StatusBar.Brain.Border}" BorderThickness="1"
                                Visibility="{Binding McpServers, Converter={StaticResource NullToCollapsed}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBrainCommand}"/>
                            </Border.InputBindings>
                            <Border.ToolTip>
                                <StackPanel Margin="4" MaxWidth="420">
                                    <TextBlock Text="BrainX" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="Server: "/><Run Text="{Binding McpServers.BrainServerName, Mode=OneWay, FallbackValue='(not configured)'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="State: "/><Run Text="{Binding McpServers.BrainState, Mode=OneWay}"/>
                                        <Run Text=" · Tools: "/><Run Text="{Binding McpServers.BrainToolCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Status.Danger}"
                                               Text="{Binding McpServers.BrainLastError, Mode=OneWay}"
                                               Visibility="{Binding McpServers.BrainLastError, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <!-- Default red: anything that is not provably Ready is a
                                                 brain the agent cannot call. -->
                                            <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                            <Style.Triggers>
                                                <!-- Amber while starting OR while the supervisor is between two
                                                     respawn attempts (an attempt just failed, the next is due): the
                                                     same IsBrainStarting the BrainX window asks, so the chip no
                                                     longer goes red in the gap while the window says "starting". -->
                                                <DataTrigger Binding="{Binding McpServers.IsBrainStarting}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                                <!-- Last, so it wins: bound to the BOOL, not the enum, because a
                                                     bool trigger is the pattern already proven in this file. If the
                                                     enum triggers above ever failed to match, the dot degrades to
                                                     red — still honest, never a false green. -->
                                                <DataTrigger Binding="{Binding McpServers.IsBrainConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StatusBar.Brain.Connected}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="🧠" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding McpServers.BrainStatusText, Mode=OneWay, FallbackValue='brain · —'}"/>
                            </StackPanel>
                        </Border>


                        </StackPanel>

                        <!-- Right: other chats still running, this run's spend, files changed, the last turn -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Command="{Binding ChatVM.ShowRunningChatCommand}" Style="{StaticResource IconButton}"
                                    Width="Auto" Height="Auto" FontFamily="{DynamicResource Font.Ui}" Padding="6,1" Margin="0,0,14,0"
                                    ToolTip="{services:Loc chat.runs.showTip}"
                                    Visibility="{Binding ChatVM.HasRunningElsewhere, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding ChatVM.RunningElsewhereText}" FontSize="12" Foreground="{DynamicResource Status.Warning}"/>
                            </Button>
                            <TextBlock Text="{Binding ChatVM.RunCostText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Status.Warning}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{services:Loc chat.spend.runTip}"
                                       Visibility="{Binding ChatVM.RunCostText, Converter={StaticResource BoolVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                        Visibility="{Binding ChatVM.FilesChangedText, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ChatVM.FilesChangedText}" FontSize="12"
                                           Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" ToolTip="{services:Loc chat.lastTurnTip}">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ChatVM.LastTurnStats, FallbackValue='—'}" FontSize="12" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource StatusBar.Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                    </views:MarqueeScroller>
                </Border>
            </Grid>

            <!-- ════════ MODEL LOADING OVERLAY ════════ -->
            <Border Panel.ZIndex="999" Background="{DynamicResource Bg.Overlay}"
                    Visibility="{Binding IsModelLoading, Converter={StaticResource BoolVis}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        CornerRadius="16" Padding="40,36" MinWidth="380"
                        Effect="{DynamicResource Glow.Loading.Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- The mascot, bobbing, while a model loads (owner 2026-10-17: "หน้าโหลดโมเดลควรใช้มาสคอตมาแสดงกำลังโหลด"). -->
                        <Image Source="/CluadeX;component/Assets/mascot.png" Width="132" Height="132" Margin="0,0,0,14"
                               HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,1">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="MascotBobStoryboard">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                         From="0" To="-10" Duration="0:0:0.7">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                         From="0.97" To="1.02" Duration="0:0:0.7">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="MascotBobStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{services:Loc nav.loadingModel}" Foreground="{DynamicResource Text.Primary}"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ModelStatus}" Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="260"
                                     Foreground="{DynamicResource Accent.2}"
                                     HorizontalAlignment="Center"/>
                        <TextBlock Text="{services:Loc nav.loadingHint}"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ COMMAND PALETTE (Ctrl+K) ═══
                 Overlays everything. Pages + skills + project files, subsequence-matched. -->
            <Grid Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="900"
                  Background="{DynamicResource Bg.Scrim}"
                  Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolVis}}">
                <!-- click the backdrop to dismiss -->
                <Button Command="{Binding ClosePaletteCommand}" Background="Transparent"
                        BorderThickness="0" Focusable="False">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate></Button.Template>
                </Button>

                <Border Width="640" MaxHeight="460" VerticalAlignment="Top" Margin="0,90,0,0"
                        Background="{DynamicResource Palette.Background}" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Default}"
                        Effect="{DynamicResource Shadow.Palette}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Query box -->
                        <Grid Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBox x:Name="PaletteBox" Grid.Column="1"
                                     Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.1}"
                                     FontSize="16" VerticalContentAlignment="Center"
                                     PreviewKeyDown="PaletteBox_PreviewKeyDown"/>
                        </Grid>
                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Subtle}"/>

                        <!-- Results -->
                        <ListBox Grid.Row="1" x:Name="PaletteList"
                                 ItemsSource="{Binding Palette.Results}"
                                 SelectedIndex="{Binding Palette.SelectedIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="PaletteList_Click">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                        Margin="8,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                        <!-- A brand row (DGX Spark): the vendor's own logo on white, at its minimum size or larger. -->
                                        <Border CornerRadius="4" Background="White" Padding="5,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}">
                                            <Image Source="{Binding Logo}" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                       Foreground="{DynamicResource Text.Faint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="3" Padding="6,1"
                                                Background="{DynamicResource Surface.Badge}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="9"
                                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding KindColor, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Footer -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource Border.Subtle}" Padding="16,7">
                            <Grid>
                                <TextBlock Text="{Binding Palette.ResultSummary}" FontSize="10"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="10"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}"
                                           Text="{services:Loc nav.paletteHint}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ MODEL PICKER (the chat's model box) ═══ full screen over everything: a card per provider with her
                 girl, then that provider's models (Views/ModelPickerOverlay.xaml, ChatViewModel.ModelPicker.cs). -->
            <views:ModelPickerOverlay Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="905"
                                      DataContext="{Binding ChatVM.ModelPicker}"/>
        </Grid>
    </Border>
</Window>
