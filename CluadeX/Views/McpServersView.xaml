<UserControl x:Class="CluadeX.Views.McpServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             Background="{DynamicResource Page.Background}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       FontFamily="{DynamicResource Font.Ui.Display}"/>
            <TextBlock Text="{Binding PageSubtitle}" FontSize="12"
                       Foreground="{DynamicResource Text.Muted}"
                       FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ═══════ MASTER-DETAIL ═══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Server List -->
            <Border Background="{DynamicResource Bg.Elevated}" CornerRadius="8" Padding="8">
                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="8" Padding="12,10" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Raised}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Raised}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.2}"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <!-- the version the server itself reported — a clear badge, not small print -->
                                        <Border CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource Accent.1}"
                                                Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding VersionText}" FontSize="11.5" FontWeight="Bold"
                                                       FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Bg.Window}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Text="{Binding CommandLineDisplay, Mode=OneWay}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding ToolCountText}"
                                                   FontSize="10" Foreground="{DynamicResource Text.Secondary}"/>
                                        <!-- Enabled badge: a disabled server does not start with CluadeX -->
                                        <Border CornerRadius="6" Padding="6,0" Margin="8,0,0,0" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Text.Muted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EnabledLabel}" FontSize="9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Status Badge -->
                                <Border Grid.Column="1" CornerRadius="8" Padding="8,3"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="running">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="stopped">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="error">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="starting">
                                                    <Setter Property="Background" Value="{DynamicResource Accent.1}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="reconnecting">
                                                    <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Badge.Status.Foreground}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- RIGHT: Detail Panel -->
            <Border Grid.Column="2" Background="{DynamicResource Bg.Elevated}" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                    <StackPanel>
                        <!-- Empty State (hidden when server selected) -->

                        <!-- Server Detail (when selected) -->
                        <StackPanel Visibility="{Binding SelectedServer, Converter={StaticResource NullToCollapsed}}">

                            <!-- Server Name Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedServer.Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <Border CornerRadius="11" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Accent.1}"
                                        Visibility="{Binding SelectedServer.HasVersion, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding SelectedServer.VersionText}" FontSize="14" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Bg.Window}"/>
                                </Border>
                            </StackPanel>

                            <!-- View Mode -->
                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                <TextBlock Text="{services:Loc mcp.command}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,12">
                                    <TextBlock Foreground="{DynamicResource Text.Primary}" FontSize="12"
                                               FontFamily="Cascadia Code,Consolas,monospace" TextWrapping="Wrap"
                                               Text="{Binding SelectedServer.CommandLineDisplay, Mode=OneWay}"/>
                                </Border>

                                <!-- Discovered Tools -->
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4">
                                    <Run Text="{services:Loc mcp.discoveredTools}"/>
                                    <Run Text="{Binding SelectedServerTools.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding SelectedServerTools}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="4"
                                                    Padding="8,4" Margin="0,0,0,3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Accent.2}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                                               Foreground="{DynamicResource Text.Muted}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="32"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Server Log -->
                                <TextBlock Text="{services:Loc mcp.serverLog}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource Bg.Window}" CornerRadius="4">
                                    <TextBox Text="{Binding SelectedServer.LogOutput, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             Background="Transparent"
                                             Foreground="{DynamicResource Text.Secondary}"
                                             BorderThickness="0"
                                             Padding="8,6" MaxHeight="180"
                                             FontSize="10" FontFamily="Cascadia Code,Consolas,monospace"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>

                            <!-- Edit Mode -->
                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{services:Loc mcp.command}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedServer.Command, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="{services:Loc mcpm.argsOnePerLine}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedServer.ArgsText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" AcceptsReturn="True"
                                         TextWrapping="NoWrap" MinHeight="60"
                                         FontFamily="Cascadia Code,Consolas,monospace" Margin="0,0,0,12"/>

                                <TextBlock Text="{services:Loc mcp.envHint}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedServer.EnvString, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{services:Loc mcp.save}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveEditCommand}" Margin="0,0,8,0" Padding="16,6"/>
                                    <Button Content="{services:Loc mcp.cancel}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CancelEditCommand}" Padding="16,6"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════ ADD SERVER FORM ═══════ -->
        <Border Grid.Row="2" Background="{DynamicResource Bg.Elevated}" CornerRadius="8"
                Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsAddingServer, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="{services:Loc mcp.addServerTitle}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{services:Loc mcp.name}" FontSize="10" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{services:Loc mcp.command}" FontSize="10" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NewServerCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{services:Loc mcp.arguments}" FontSize="10" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NewServerArgs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 ToolTip="{services:Loc mcpm.argsLineHint}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="{services:Loc mcp.add}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddServerCommand}" VerticalAlignment="Bottom"
                            Padding="20,6"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════ TOOLBAR ═══════ -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartServerCommand}"
                        Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.start}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding StopServerCommand}"
                        Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.stop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RestartServerCommand}"
                        Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.restart}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource Surface.Sunken}" Margin="6,2"/>

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding BeginEditCommand}"
                        Padding="12,6" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.edit}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEnabledCommand}"
                        Padding="12,6" Margin="0,0,6,0" Content="{services:Loc mcp.toggle}"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RemoveServerCommand}"
                        Padding="12,6" Margin="0,0,6,0" Foreground="{DynamicResource Status.Danger}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.remove}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource Surface.Sunken}" Margin="6,2"/>

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ShowAddFormCommand}"
                        Padding="12,6" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{services:Loc mcp.addServer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding StartAllCommand}"
                        Padding="12,6" Margin="0,0,6,0" Content="{services:Loc mcp.startAll}"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                        Padding="6,6" ToolTip="{services:Loc mcp.refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
