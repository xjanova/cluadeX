<UserControl x:Class="CluadeX.Views.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:editor="clr-namespace:CluadeX.Views.Editor"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CodeEditorViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}"
             Loaded="OnLoaded"
             KeyDown="OnPageKeyDown">
    <UserControl.Resources>
        <!-- File tree row template (recursive via HierarchicalDataTemplate) -->
        <HierarchicalDataTemplate x:Key="TreeNodeTemplate" DataType="{x:Type m:FileTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Button Background="Transparent" BorderThickness="0" Padding="2,3" Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    Click="OnNodeClick" Tag="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4"
                                BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chevron / folder-marker -->
                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                            <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="&#xE76C;"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Folder icon OR extension monogram -->
                    <Border Grid.Column="1" Width="22" Height="14" Margin="4,0,6,0"
                            VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{StaticResource NeonLineBrush}" Background="#22000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonAmberBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="&#xE8B7;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExtensionLabel}" FontSize="8" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ExtensionColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource NeonInk1Brush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Git badge -->
                    <TextBlock Grid.Column="3" Text="{Binding GitBadge}" FontSize="10" FontWeight="Bold"
                               FontFamily="{StaticResource NeonMonoFont}" Margin="6,0,4,0"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding GitBadgeColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Button>
        </HierarchicalDataTemplate>

        <!-- Tab template (top tab strip) -->
        <DataTemplate x:Key="EditorTabTemplate" DataType="{x:Type m:OpenFileTab}">
            <Border Margin="0,0,1,0" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#7011152E"/>
                                <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button Background="Transparent" BorderThickness="0" Padding="14,8,8,8"
                        Click="OnTabClick" Tag="{Binding}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0,2,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="22" Height="14" Margin="0,0,8,0"
                                CornerRadius="3" BorderThickness="1"
                                BorderBrush="{StaticResource NeonLineBrush}" Background="#22000000">
                            <TextBlock Text="{Binding Extension}" FontSize="8" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ExtensionColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding TabTitle}"
                                   Foreground="{StaticResource NeonInk1Brush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Width="18" Height="18" Margin="10,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="OnCloseTabClick" Tag="{Binding}" ToolTip="{services:Loc editor.closeTab}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   Foreground="{StaticResource NeonInk3Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>   <!-- File tree -->
            <ColumnDefinition Width="*"/>     <!-- Editor center -->
            <ColumnDefinition Width="400"/>   <!-- Chat panel -->
        </Grid.ColumnDefinitions>

        <!-- ═════════════ FILE TREE PANEL ═════════════ -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource NeonLineBrush}"
                Background="#8C0A0C22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Activity switcher: Explorer | Search -->
                    <RowDefinition Height="*"/>     <!-- The active panel -->
                </Grid.RowDefinitions>

                <!-- Activity switcher — the left panel answers two different questions
                     (what files exist / where is this text), so it gets two modes. -->
                <Border Grid.Row="0" Padding="10,10,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ShowExplorerCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0,6"
                                ToolTip="{services:Loc editor.explorer}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="5,0,0,5"
                                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1,1,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3328326E"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NeonInk3Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc editor.explorer}" FontSize="10" FontWeight="Bold"
                                           FontFamily="{StaticResource NeonMonoFont}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NeonInk3Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ShowSearchCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0,6"
                                ToolTip="{services:Loc editor.searchTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="0,5,5,0"
                                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3328326E"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NeonInk3Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc editor.search}" FontSize="10" FontWeight="Bold"
                                           FontFamily="{StaticResource NeonMonoFont}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NeonInk3Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            <!-- ══════════ EXPLORER panel ══════════ -->
            <Grid Grid.Row="1" Visibility="{Binding IsExplorerPanelActive, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- EXPLORER header -->
                    <RowDefinition Height="Auto"/>  <!-- Project card -->
                    <RowDefinition Height="*"/>     <!-- Tree -->
                    <RowDefinition Height="Auto"/>  <!-- Source Control -->
                </Grid.RowDefinitions>

                <!-- EXPLORER header -->
                <Border Grid.Row="0" Padding="14,14,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc editor.explorer}" FontSize="10" FontWeight="Bold"
                                   FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonInk3Brush}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Letterspacing15}"/>
                        <!-- Clone a GitHub repo straight from the workbench -->
                        <Button Grid.Column="1" Width="22" Height="22" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloneRepoCommand}" ToolTip="{services:Loc editor.connectRepo}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource NeonCyanBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Open / change project folder — always reachable (was only on the empty-state,
                             which hides once a folder is open, so there was no way to switch projects). -->
                        <Button Grid.Column="2" Width="22" Height="22" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenFolderCommand}" ToolTip="{services:Loc editor.openChangeFolder}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource NeonAmberBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="3" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding RefreshTreeCommand}" ToolTip="{services:Loc editor.refreshTree}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource NeonCyanBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Project card -->
                <Border Grid.Row="1" Margin="10,2,10,8" Padding="12,8" CornerRadius="6"
                        Background="#7011152E"
                        BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                        Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource NeonCyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeonInk0Brush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            <TextBlock Text="{Binding ProjectFileCount}" FontSize="9"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonInk3Brush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty state when no folder open -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,30,20,0"
                            Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <TextBlock Text="{services:Loc editor.noProject}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource NeonInk1Brush}"/>
                    <TextBlock Text="{services:Loc editor.noProjectHint}"
                               FontSize="11" Margin="0,8,0,16" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource NeonInk3Brush}"/>
                    <Button Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center"
                            Background="{StaticResource NeonRewindGradient}" BorderThickness="0"
                            Foreground="White" Padding="14,7" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.openFolder}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tree -->
                <TreeView Grid.Row="2" ItemsSource="{Binding Tree}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="4,0,4,10">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource NeonInk1Brush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <!-- Source Control panel — real git state: branch, changed files, commit box -->
                <Border Grid.Row="3" Padding="10" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource NeonLineBrush}" MaxHeight="300">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{services:Loc editor.sourceControl}" FontSize="10" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonInk3Brush}"
                                       Style="{StaticResource Letterspacing15}"
                                       VerticalAlignment="Center"/>
                            <!-- Branch switcher — pick a local branch to check it out -->
                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="3" Padding="4,0" Margin="0,0,4,0"
                                    Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc editor.switchBranch}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{StaticResource NeonAmberBrush}" Margin="2,0,2,0" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding GitBranches}"
                                              SelectedItem="{Binding SelectedBranch}"
                                              FontSize="9" FontFamily="{StaticResource NeonMonoFont}"
                                              Foreground="{StaticResource NeonAmberBrush}"
                                              Background="Transparent" BorderThickness="0"
                                              MinWidth="52" Padding="2,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Refresh -->
                            <Button Grid.Column="2" Width="18" Height="18" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Command="{Binding RefreshGitCommand}" ToolTip="{services:Loc editor.refreshGit}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{StaticResource NeonInk3Brush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Changed files (click to open) -->
                        <TextBlock Text="{Binding GitChangeCount}" FontSize="9" Margin="0,0,0,4"
                                   FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonInk3Brush}"
                                   Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}"/>
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding GitChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalContentAlignment="Left" Padding="2,1"
                                                Command="{Binding DataContext.OpenChangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Path}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status}" FontSize="9" Width="18"
                                                           FontFamily="{StaticResource NeonMonoFont}" FontWeight="Bold"
                                                           Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonInk1Brush}" VerticalAlignment="Center"/>
                                                <!-- Per-file diff view (git diff in a Patch-highlighted tab) -->
                                                <Button Grid.Column="2" Width="16" Height="14" Margin="4,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="{services:Loc editor.viewDiff}"
                                                        Command="{Binding DataContext.ShowDiffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="db" Background="Transparent" CornerRadius="2">
                                                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                           Foreground="{StaticResource NeonCyanBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="db" Property="Background" Value="#33FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Commit box -->
                        <Grid Margin="0,6,0,8" Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#3311132E" BorderBrush="{StaticResource NeonLineHiBrush}"
                                    BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="6,3"
                                         FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                         Foreground="{StaticResource NeonInk0Brush}"
                                         CaretBrush="{StaticResource NeonAmberBrush}"
                                         ToolTip="{services:Loc editor.commitMessage}"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding CommitCommand}" Cursor="Hand"
                                    Padding="8,3" Background="#5528a06E" BorderBrush="{StaticResource NeonLineHiBrush}"
                                    BorderThickness="1" Foreground="{StaticResource NeonInk0Brush}" FontSize="10"
                                    ToolTip="{services:Loc editor.stageAndCommit}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.commit}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Save buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveActiveCommand}" Cursor="Hand"
                                    Padding="8,4" Margin="0,0,4,0"
                                    Background="#3328326E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                    Foreground="{StaticResource NeonInk0Brush}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.save}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveAllCommand}" Cursor="Hand"
                                    Padding="8,4"
                                    Background="#3328326E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                    Foreground="{StaticResource NeonInk0Brush}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.saveAll}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ SEARCH panel ══════════
                 Also hosts go-to-definition candidates, find-references results and the rename
                 preview, so there is one results list instead of three. -->
            <Grid Grid.Row="1" Visibility="{Binding IsSearchPanelActive, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Query box -->
                    <RowDefinition Height="Auto"/>  <!-- Option toggles -->
                    <RowDefinition Height="Auto"/>  <!-- Include / exclude filters -->
                    <RowDefinition Height="Auto"/>  <!-- Rename bar -->
                    <RowDefinition Height="Auto"/>  <!-- Context + summary + errors -->
                    <RowDefinition Height="*"/>     <!-- Results -->
                </Grid.RowDefinitions>

                <!-- Query -->
                <Grid Grid.Row="0" Margin="10,10,10,0">
                    <Border Background="#3311132E" CornerRadius="5"
                            BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonInk3Brush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="7,6"
                                     Foreground="{StaticResource NeonInk0Brush}"
                                     CaretBrush="{StaticResource NeonCyanBrush}"
                                     FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                     KeyDown="OnSearchBoxKeyDown"/>
                            <Button Grid.Column="2" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="{services:Loc editor.clearSearch}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{StaticResource NeonInk3Brush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Option toggles: Aa / whole word / regex, plus the filter disclosure -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,6,10,0">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3328326E"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <ToggleButton IsChecked="{Binding SearchMatchCase, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.matchCase}">
                        <TextBlock Text="Aa" FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                   Foreground="{StaticResource NeonInk1Brush}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchWholeWord, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.wholeWord}">
                        <TextBlock Text="ab" FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                   TextDecorations="Underline"
                                   Foreground="{StaticResource NeonInk1Brush}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchIsRegex, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.useRegex}">
                        <TextBlock Text=".*" FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                   Foreground="{StaticResource NeonInk1Brush}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchFiltersExpanded, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.toggleFilters}">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource NeonInk1Brush}"/>
                    </ToggleButton>

                    <TextBlock Text="{services:Loc editor.searching}" FontSize="10" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource NeonCyanBrush}"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Include / exclude globs -->
                <StackPanel Grid.Row="2" Margin="10,6,10,0"
                            Visibility="{Binding SearchFiltersExpanded, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{services:Loc editor.filesToInclude}" FontSize="9"
                               Foreground="{StaticResource NeonInk3Brush}" Margin="2,0,0,2"/>
                    <Border Background="#3311132E" CornerRadius="4" Margin="0,0,0,6"
                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                        <TextBox Text="{Binding SearchInclude, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Background="Transparent" BorderThickness="0" Padding="7,4"
                                 Foreground="{StaticResource NeonInk1Brush}"
                                 CaretBrush="{StaticResource NeonCyanBrush}"
                                 FontFamily="{StaticResource NeonMonoFont}" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{services:Loc editor.filesToExclude}" FontSize="9"
                               Foreground="{StaticResource NeonInk3Brush}" Margin="2,0,0,2"/>
                    <Border Background="#3311132E" CornerRadius="4"
                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                        <TextBox Text="{Binding SearchExclude, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Background="Transparent" BorderThickness="0" Padding="7,4"
                                 Foreground="{StaticResource NeonInk1Brush}"
                                 CaretBrush="{StaticResource NeonCyanBrush}"
                                 FontFamily="{StaticResource NeonMonoFont}" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Rename bar (F2) — preview is mandatory before anything is written to disk -->
                <Border Grid.Row="3" Margin="10,8,10,0" Padding="10,8" CornerRadius="6"
                        Background="#70241436" BorderBrush="{StaticResource NeonMagentaBrush}" BorderThickness="1"
                        Visibility="{Binding IsRenameMode, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonMagentaBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.renameSymbol}" FontSize="10" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonInk1Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RenameOldName}" FontSize="11" Margin="8,0,0,0"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                        </StackPanel>
                        <Border Background="#3311132E" CornerRadius="4" Margin="0,0,0,6"
                                BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                            <TextBox x:Name="RenameBox" Text="{Binding RenameNewName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="7,5"
                                     Foreground="{StaticResource NeonInk0Brush}"
                                     CaretBrush="{StaticResource NeonMagentaBrush}"
                                     FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                     KeyDown="OnRenameBoxKeyDown"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding PreviewRenameCommand}" Cursor="Hand" Padding="9,4" Margin="0,0,6,0"
                                    Background="#3328326E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                    Foreground="{StaticResource NeonInk0Brush}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{services:Loc editor.previewRename}"/>
                            </Button>
                            <Button Command="{Binding ApplyRenameCommand}" Cursor="Hand" Padding="9,4" Margin="0,0,6,0"
                                    IsEnabled="{Binding CanApplyRename}"
                                    Background="#66C2185B" BorderBrush="{StaticResource NeonMagentaBrush}" BorderThickness="1"
                                    Foreground="White" FontSize="10"
                                    ToolTip="{services:Loc editor.applyRenameTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding RenameApplyLabel}"/>
                            </Button>
                            <Button Command="{Binding CancelRenameCommand}" Cursor="Hand" Padding="9,4"
                                    Background="Transparent" BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                                    Foreground="{StaticResource NeonInk2Brush}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{services:Loc editor.cancel}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Context (what this list is) + summary + error -->
                <StackPanel Grid.Row="4" Margin="12,8,10,4">
                    <TextBlock Text="{Binding SearchContextLabel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource NeonCyanBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasSearchContext, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding SearchSummary}" FontSize="10"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk3Brush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SearchError}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{StaticResource NeonMagentaBrush}"
                               Visibility="{Binding HasSearchError, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{services:Loc editor.noResults}" FontSize="10" Margin="0,2,0,0"
                               Foreground="{StaticResource NeonInk3Brush}"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Results: file groups → matching lines -->
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="4,0,4,10">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <!-- File header (click to collapse) -->
                                    <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" Padding="6,3"
                                            Command="{Binding DataContext.ToggleResultGroupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RelPath}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                       Foreground="{StaticResource NeonInk3Brush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70E;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource NeonInk0Brush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Directory}" FontSize="9"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource NeonInk3Brush}"/>
                                            <Border Grid.Column="3" Background="#22FFFFFF" CornerRadius="3"
                                                    Padding="4,0" MinWidth="16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MatchCount}" FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonInk2Brush}"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Matching lines -->
                                    <ItemsControl ItemsSource="{Binding Matches}" Margin="14,0,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Padding="6,2"
                                                        Command="{Binding DataContext.OpenMatchCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2628326E"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineLabel}" FontSize="9"
                                                                   HorizontalAlignment="Right" Margin="0,0,8,0"
                                                                   FontFamily="{StaticResource NeonMonoFont}"
                                                                   Foreground="{StaticResource NeonInk3Brush}"/>
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   FontFamily="{StaticResource NeonMonoFont}"
                                                                   Foreground="{StaticResource NeonInk1Brush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   editor:MatchHighlight.Start="{Binding PreviewColumn}"
                                                                   editor:MatchHighlight.Length="{Binding Length}"
                                                                   editor:MatchHighlight.Text="{Binding LineText}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            </Grid>
        </Border>

        <!-- ═════════════ EDITOR CENTER ═════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Tab strip -->
                <RowDefinition Height="*"/>      <!-- Code area + minimap -->
                <RowDefinition Height="Auto"/>   <!-- Terminal placeholder -->
            </Grid.RowDefinitions>

            <!-- Tab strip -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}"
                    Background="#8C0A0C22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource EditorTabTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Preview / open externally: review the result the way the agent's user would —
                         HTML opens in the browser, anything else in its default app. -->
                    <Button Grid.Column="1" Margin="6,3,8,3" Padding="8,3" Cursor="Hand"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource NeonLineBrush}"
                            Click="OnPreviewClick"
                            Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}"
                            ToolTip="{services:Loc editor.previewTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonMintBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc editor.preview}" FontSize="11" Foreground="{StaticResource NeonMintBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Code area + minimap -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- Editor (line gutter + TextBox) -->
                <Grid Grid.Column="0" Background="#06071A">
                    <!-- Empty state when no tab open -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource NeonInk3Brush}" Opacity="0.5"/>
                        <TextBlock Text="{services:Loc editor.openFileHint}"
                                   Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource NeonInk2Brush}"/>
                        <TextBlock Text="{services:Loc editor.askAiHint}"
                                   Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource NeonInk3Brush}" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Editor surface — AvalonEdit (real syntax highlighting + built-in gutter).
                         Content sync, neon theme, caret-follow and the changed-region glow renderer
                         are wired in code-behind (CodeEditorView.xaml.cs). -->
                    <avalonedit:TextEditor x:Name="Editor"
                                           Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}"
                                           FontFamily="{StaticResource NeonMonoFont}" FontSize="13"
                                           Background="Transparent"
                                           Foreground="{StaticResource NeonInk0Brush}"
                                           LineNumbersForeground="{StaticResource NeonInk3Brush}"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           BorderThickness="0"
                                           Padding="8,12,0,12"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Minimap — real document overview: line bars + draggable viewport (MinimapControl) -->
                <Border Grid.Column="1" Background="#7011152E"
                        BorderThickness="1,0,0,0" BorderBrush="{StaticResource NeonLineBrush}"
                        Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}">
                    <editor:MinimapControl x:Name="Minimap" Margin="0,4"/>
                </Border>
            </Grid>

            <!-- Terminal drawer — a REAL persistent PowerShell in the project folder -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource NeonLineBrush}"
                    Background="#7011152E">
                <StackPanel>
                    <!-- Header row (click to expand/collapse) -->
                    <Button Command="{Binding ToggleTerminalCommand}" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Padding="14,6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource NeonInk2Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.terminal}" FontSize="11" Foreground="{StaticResource NeonInk2Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="·" Margin="8,0" FontSize="11" Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                            <TextBlock Text="pwsh" FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource NeonInk3Brush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE70E;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTerminalOpen}" Value="False">
                                                <Setter Property="Text" Value="&#xE70D;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" FontSize="11"
                                       Foreground="{StaticResource NeonMintBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <!-- Expanded terminal: output + input line -->
                    <Grid Visibility="{Binding IsTerminalOpen, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TerminalOut" Grid.Row="0"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 Background="#0A06071A" BorderThickness="0"
                                 Foreground="{StaticResource NeonInk1Brush}"
                                 FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                 Padding="12,6"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="OnTerminalOutputChanged"/>
                        <Grid Grid.Row="1" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&gt;" FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                       Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Border Grid.Column="1" Background="#3311132E" CornerRadius="4"
                                    BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                                <TextBox Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="8,4"
                                         Foreground="{StaticResource NeonInk0Brush}"
                                         CaretBrush="{StaticResource NeonAmberBrush}"
                                         FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                         KeyDown="OnTerminalInputKeyDown"/>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════ CHAT PANEL (right) ═════════════ -->
        <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource NeonLineBrush}"
                Background="#A60A0C22">
            <ContentControl Content="{Binding ChatVM}"/>
        </Border>
    </Grid>
</UserControl>
