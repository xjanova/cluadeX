<UserControl x:Class="CluadeX.Views.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:editor="clr-namespace:CluadeX.Views.Editor"
             xmlns:preview="clr-namespace:CluadeX.Views.Preview"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CodeEditorViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}"
             Loaded="OnLoaded"
             KeyDown="OnPageKeyDown">
    <UserControl.Resources>
        <!-- File tree row template (recursive via HierarchicalDataTemplate) -->
        <HierarchicalDataTemplate x:Key="TreeNodeTemplate" DataType="{x:Type m:FileTreeNode}"
                                  ItemsSource="{Binding Children}">
            <Button Background="Transparent" BorderThickness="0" Padding="2,3" Cursor="Hand"
                    HorizontalContentAlignment="Stretch"
                    Click="OnNodeClick" Tag="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4"
                                BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chevron / folder-marker -->
                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                            <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="&#xE76C;"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Folder icon OR extension monogram -->
                    <Border Grid.Column="1" Width="22" Height="14" Margin="4,0,6,0"
                            VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Sunken}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Warning}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="&#xE8B7;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExtensionLabel}" FontSize="8" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ExtensionColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Git badge -->
                    <TextBlock Grid.Column="3" Text="{Binding GitBadge}" FontSize="10" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono.Display}" Margin="6,0,4,0"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding GitBadgeColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Button>
        </HierarchicalDataTemplate>

        <!-- Tab template (top tab strip) -->
        <DataTemplate x:Key="EditorTabTemplate" DataType="{x:Type m:OpenFileTab}">
            <Border Margin="0,0,1,0" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,2,0,0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Surface.Input}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button Background="Transparent" BorderThickness="0" Padding="14,8,8,8"
                        Click="OnTabClick" Tag="{Binding}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0,2,0,0" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="22" Height="14" Margin="0,0,8,0"
                                CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Sunken}">
                            <TextBlock Text="{Binding Extension}" FontSize="8" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ExtensionColorHex, Converter={StaticResource HexToColor}, FallbackValue=#8388BD}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding TabTitle}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Width="18" Height="18" Margin="10,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="OnCloseTabClick" Tag="{Binding}" ToolTip="{services:Loc editor.closeTab}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Pressed}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>  <!-- File tree (ExplorerPanel.Width, resizable) -->
            <ColumnDefinition Width="*"/>     <!-- Editor center -->
            <ColumnDefinition Width="Auto"/>  <!-- Chat panel (EditorChatPanel.Width, resizable) -->
        </Grid.ColumnDefinitions>

        <!-- ═════════════ FILE TREE PANEL ═════════════ -->
        <Border x:Name="ExplorerPanel" Grid.Column="0" Width="240" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border.Subtle}"
                Background="{DynamicResource Sidebar.Background}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Activity switcher: Explorer | Search -->
                    <RowDefinition Height="*"/>     <!-- The active panel -->
                </Grid.RowDefinitions>

                <!-- Activity switcher — the left panel answers two different questions
                     (what files exist / where is this text), so it gets two modes. -->
                <Border Grid.Row="0" Padding="10,10,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ShowExplorerCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0,6"
                                ToolTip="{services:Loc editor.explorer}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="5,0,0,5"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,1,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc editor.explorer}" FontSize="10" FontWeight="Bold"
                                           FontFamily="{DynamicResource Font.Mono.Display}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExplorerPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ShowSearchCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0,6"
                                ToolTip="{services:Loc editor.searchTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="0"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,1,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc editor.search}" FontSize="10" FontWeight="Bold"
                                           FontFamily="{DynamicResource Font.Mono.Display}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ShowDebugCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0,6"
                                ToolTip="{services:Loc editor.debugTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="0,5,5,0"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugPanelActive}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc editor.debug}" FontSize="10" FontWeight="Bold"
                                           FontFamily="{DynamicResource Font.Mono.Display}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugPanelActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            <!-- ══════════ EXPLORER panel ══════════ -->
            <Grid Grid.Row="1" Visibility="{Binding IsExplorerPanelActive, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- EXPLORER header -->
                    <RowDefinition Height="Auto"/>  <!-- Project card -->
                    <RowDefinition Height="*"/>     <!-- Tree -->
                    <RowDefinition Height="Auto"/>  <!-- Source Control -->
                </Grid.RowDefinitions>

                <!-- EXPLORER header -->
                <Border Grid.Row="0" Padding="14,14,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc editor.explorer}" FontSize="10" FontWeight="Bold"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Letterspacing15}"/>
                        <!-- Clone a GitHub repo straight from the workbench -->
                        <Button Grid.Column="1" Width="22" Height="22" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloneRepoCommand}" ToolTip="{services:Loc editor.connectRepo}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource Accent.1}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Open / change project folder — always reachable (was only on the empty-state,
                             which hides once a folder is open, so there was no way to switch projects). -->
                        <Button Grid.Column="2" Width="22" Height="22" Margin="0,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenFolderCommand}" ToolTip="{services:Loc editor.openChangeFolder}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource Status.Warning}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="3" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding RefreshTreeCommand}" ToolTip="{services:Loc editor.refreshTree}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource Accent.1}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Project card -->
                <Border Grid.Row="1" Margin="10,2,10,8" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource Surface.Input}"
                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                        Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            <TextBlock Text="{Binding ProjectFileCount}" FontSize="9"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Faint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Empty state when no folder open -->
                <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,30,20,0"
                            Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <TextBlock Text="{services:Loc editor.noProject}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{services:Loc editor.noProjectHint}"
                               FontSize="11" Margin="0,8,0,16" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Text.Faint}"/>
                    <Button Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center"
                            Background="{DynamicResource Banner.Button.Background}" BorderThickness="0"
                            Foreground="{DynamicResource Text.OnAccent}" Padding="14,7" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.openFolder}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tree -->
                <!-- Only with a folder open: the empty tree (transparent, so still hit-testable) lay over the
                     empty state's "Open Folder" button and swallowed every click on it. -->
                <TreeView Grid.Row="2" ItemsSource="{Binding Tree}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"
                          Visibility="{Binding HasWorkingDirectory, Converter={StaticResource BoolVis}}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Padding="4,0,4,10">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <!-- WPF's own TreeViewItem template (Aero2, .NET 8) copied 1:1 — same layout, same glyph
                                 geometry — with the expander glyph's colours as theme tokens (they were the system
                                 theme's fixed greys). Selection keeps the system highlight, as before. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <ToggleButton x:Name="Expander" ClickMode="Press" Focusable="False" Width="16" Height="16"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Padding="5,5,5,5" Background="Transparent" Width="16" Height="16">
                                                            <Path x:Name="ExpandPath"
                                                                  Fill="{DynamicResource Tree.Glyph.Fill}"
                                                                  Stroke="{DynamicResource Tree.Glyph.Stroke}">
                                                                <Path.Data>
                                                                    <PathGeometry Figures="M0,0L0,6L6,0z"/>
                                                                </Path.Data>
                                                                <Path.RenderTransform>
                                                                    <RotateTransform Angle="135" CenterX="3" CenterY="3"/>
                                                                </Path.RenderTransform>
                                                            </Path>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Tree.Glyph.Expanded.Fill}"/>
                                                                <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource Tree.Glyph.Expanded.Stroke}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Tree.Glyph.Hover.Fill}"/>
                                                                <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource Tree.Glyph.Hover.Stroke}"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsChecked" Value="True"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Tree.Glyph.Hover.Expanded.Fill}"/>
                                                                <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource Tree.Glyph.Hover.Expanded.Stroke}"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Border x:Name="Bd" Grid.Column="1" SnapsToDevicePixels="True"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}}"/>
                                            </MultiTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <!-- Source Control panel — real git state: branch, changed files, commit box -->
                <Border Grid.Row="3" Padding="10" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Border.Subtle}" MaxHeight="300">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{services:Loc editor.sourceControl}" FontSize="10" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Faint}"
                                       Style="{StaticResource Letterspacing15}"
                                       VerticalAlignment="Center"/>
                            <!-- Branch switcher — pick a local branch to check it out -->
                            <Border Grid.Column="1" Background="{DynamicResource Surface.Badge}" CornerRadius="3" Padding="4,0" Margin="0,0,4,0"
                                    Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc editor.switchBranch}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="{DynamicResource Status.Warning}" Margin="2,0,2,0" VerticalAlignment="Center"/>
                                    <!-- Explicit: arrowing through the list must not check anything out. The
                                         choice is committed when the dropdown closes or Enter is pressed
                                         (and then still confirmed by the VM). -->
                                    <ComboBox ItemsSource="{Binding GitBranches}"
                                              SelectedItem="{Binding SelectedBranch, UpdateSourceTrigger=Explicit}"
                                              DropDownClosed="OnBranchDropDownClosed"
                                              KeyDown="OnBranchKeyDown"
                                              LostKeyboardFocus="OnBranchLostFocus"
                                              FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                              Foreground="{DynamicResource Status.Warning}"
                                              Background="Transparent" BorderThickness="0"
                                              MinWidth="52" Padding="2,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Refresh -->
                            <Button Grid.Column="2" Width="18" Height="18" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Command="{Binding RefreshGitCommand}" ToolTip="{services:Loc editor.refreshGit}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       Foreground="{DynamicResource Text.Faint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Changed files (click to open) -->
                        <TextBlock Text="{Binding GitChangeCount}" FontSize="9" Margin="0,0,0,4"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}"
                                   Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}"/>
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding GitChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalContentAlignment="Left" Padding="2,1"
                                                Command="{Binding DataContext.OpenChangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Path}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status}" FontSize="9" Width="18"
                                                           FontFamily="{DynamicResource Font.Mono.Display}" FontWeight="Bold"
                                                           Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="10"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                                                <!-- Per-file diff view (git diff in a Patch-highlighted tab) -->
                                                <Button Grid.Column="2" Width="16" Height="14" Margin="4,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="{services:Loc editor.viewDiff}"
                                                        Command="{Binding DataContext.ShowDiffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="db" Background="Transparent" CornerRadius="2">
                                                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                           Foreground="{DynamicResource Accent.1}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="db" Property="Background" Value="{DynamicResource State.Pressed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Commit box -->
                        <Grid Margin="0,6,0,8" Visibility="{Binding HasGitRepo, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="6,3"
                                         FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         CaretBrush="{DynamicResource Status.Warning}"
                                         ToolTip="{services:Loc editor.commitMessage}"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding CommitCommand}" Cursor="Hand"
                                    Padding="8,3" Background="{DynamicResource Button.Success.Background}" BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" Foreground="{DynamicResource Button.Flat.Foreground}" FontSize="10"
                                    ToolTip="{services:Loc editor.stageAndCommit}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <!-- A disabled button must LOOK disabled: these templates drew the
                                             same box whether or not a click would do anything. -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.commit}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Save buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveActiveCommand}" Cursor="Hand"
                                    Padding="8,4" Margin="0,0,4,0"
                                    Background="{DynamicResource Button.Flat.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Foreground="{DynamicResource Button.Flat.Foreground}" FontSize="10"
                                    ToolTip="{services:Loc ide.saveTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Flat.Hover.Background}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.save}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveAllCommand}" Cursor="Hand"
                                    Padding="8,4"
                                    Background="{DynamicResource Button.Flat.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Foreground="{DynamicResource Button.Flat.Foreground}" FontSize="10"
                                    ToolTip="{services:Loc ide.saveAllTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Flat.Hover.Background}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{services:Loc editor.saveAll}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ SEARCH panel ══════════
                 Also hosts go-to-definition candidates, find-references results and the rename
                 preview, so there is one results list instead of three. -->
            <Grid Grid.Row="1" Visibility="{Binding IsSearchPanelActive, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Query box -->
                    <RowDefinition Height="Auto"/>  <!-- Option toggles -->
                    <RowDefinition Height="Auto"/>  <!-- Include / exclude filters -->
                    <RowDefinition Height="Auto"/>  <!-- Rename bar -->
                    <RowDefinition Height="Auto"/>  <!-- Context + summary + errors -->
                    <RowDefinition Height="*"/>     <!-- Results -->
                </Grid.RowDefinitions>

                <!-- Query -->
                <Grid Grid.Row="0" Margin="10,10,10,0">
                    <Border Background="{DynamicResource Surface.Input}" CornerRadius="5"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Text.Faint}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="7,6"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.1}"
                                     FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                     KeyDown="OnSearchBoxKeyDown"/>
                            <Button Grid.Column="2" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="{services:Loc editor.clearSearch}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource Text.Faint}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Option toggles: Aa / whole word / regex, plus the filter disclosure -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,6,10,0">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <ToggleButton IsChecked="{Binding SearchMatchCase, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.matchCase}">
                        <TextBlock Text="Aa" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchWholeWord, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.wholeWord}">
                        <TextBlock Text="ab" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                   TextDecorations="Underline"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchIsRegex, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.useRegex}">
                        <TextBlock Text=".*" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding SearchFiltersExpanded, Mode=TwoWay}"
                                  ToolTip="{services:Loc editor.toggleFilters}">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </ToggleButton>

                    <TextBlock Text="{services:Loc editor.searching}" FontSize="10" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent.1}"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Include / exclude globs -->
                <StackPanel Grid.Row="2" Margin="10,6,10,0"
                            Visibility="{Binding SearchFiltersExpanded, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{services:Loc editor.filesToInclude}" FontSize="9"
                               Foreground="{DynamicResource Text.Faint}" Margin="2,0,0,2"/>
                    <Border Background="{DynamicResource Surface.Input}" CornerRadius="4" Margin="0,0,0,6"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                        <TextBox Text="{Binding SearchInclude, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Background="Transparent" BorderThickness="0" Padding="7,4"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 CaretBrush="{DynamicResource Accent.1}"
                                 FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{services:Loc editor.filesToExclude}" FontSize="9"
                               Foreground="{DynamicResource Text.Faint}" Margin="2,0,0,2"/>
                    <Border Background="{DynamicResource Surface.Input}" CornerRadius="4"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                        <TextBox Text="{Binding SearchExclude, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Background="Transparent" BorderThickness="0" Padding="7,4"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 CaretBrush="{DynamicResource Accent.1}"
                                 FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Rename bar (F2) — preview is mandatory before anything is written to disk -->
                <Border Grid.Row="3" Margin="10,8,10,0" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource Bg.Panel.Solid}" BorderBrush="{DynamicResource Accent.3}" BorderThickness="1"
                        Visibility="{Binding IsRenameMode, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.3}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.renameSymbol}" FontSize="10" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RenameOldName}" FontSize="11" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                        </StackPanel>
                        <Border Background="{DynamicResource Surface.Input}" CornerRadius="4" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <TextBox x:Name="RenameBox" Text="{Binding RenameNewName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="7,5"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.3}"
                                     FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                     KeyDown="OnRenameBoxKeyDown"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding PreviewRenameCommand}" Cursor="Hand" Padding="9,4" Margin="0,0,6,0"
                                    Background="{DynamicResource Button.Flat.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    Foreground="{DynamicResource Button.Flat.Foreground}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{services:Loc editor.previewRename}"/>
                            </Button>
                            <Button Command="{Binding ApplyRenameCommand}" Cursor="Hand" Padding="9,4" Margin="0,0,6,0"
                                    IsEnabled="{Binding CanApplyRename}"
                                    Background="{DynamicResource Button.Danger.Solid.Background}" BorderBrush="{DynamicResource Accent.3}" BorderThickness="1"
                                    Foreground="{DynamicResource Text.OnAccent}" FontSize="10"
                                    ToolTip="{services:Loc editor.applyRenameTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding RenameApplyLabel}"/>
                            </Button>
                            <Button Command="{Binding CancelRenameCommand}" Cursor="Hand" Padding="9,4"
                                    Background="Transparent" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                    Foreground="{DynamicResource Text.Muted}" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{services:Loc editor.cancel}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Context (what this list is) + summary + error -->
                <StackPanel Grid.Row="4" Margin="12,8,10,4">
                    <TextBlock Text="{Binding SearchContextLabel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent.1}" TextWrapping="Wrap"
                               Visibility="{Binding HasSearchContext, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding SearchSummary}" FontSize="10"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SearchError}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Accent.3}"
                               Visibility="{Binding HasSearchError, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{services:Loc editor.noResults}" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Text.Faint}"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Results: file groups → matching lines -->
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="4,0,4,10">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <!-- File header (click to collapse) -->
                                    <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" Padding="6,3"
                                            Command="{Binding DataContext.ToggleResultGroupCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RelPath}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                       Foreground="{DynamicResource Text.Faint}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70E;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Directory}" FontSize="9"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Text.Faint}"/>
                                            <Border Grid.Column="3" Background="{DynamicResource Surface.Badge}" CornerRadius="3"
                                                    Padding="4,0" MinWidth="16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MatchCount}" FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Matching lines -->
                                    <ItemsControl ItemsSource="{Binding Matches}" Margin="14,0,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                        HorizontalContentAlignment="Stretch" Padding="6,2"
                                                        Command="{Binding DataContext.OpenMatchCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface.Raised}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding LineLabel}" FontSize="9"
                                                                   HorizontalAlignment="Right" Margin="0,0,8,0"
                                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                                   Foreground="{DynamicResource Text.Faint}"/>
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   editor:MatchHighlight.Start="{Binding PreviewColumn}"
                                                                   editor:MatchHighlight.Length="{Binding Length}"
                                                                   editor:MatchHighlight.Text="{Binding LineText}"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ══════════ DEBUG panel ══════════
                 Adapters are not bundled and none ships installed, so this leads with WHAT IS
                 ACTUALLY AVAILABLE and the exact install command — never a Start button that
                 silently does nothing. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,10,10,10"
                          Visibility="{Binding IsDebugPanelActive, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <!-- Target + transport controls -->
                    <TextBlock Text="{Binding DebugTargetLabel}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="26"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource Button.Flat.Background}" CornerRadius="4"
                                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Flat.Hover.Background}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <Button Command="{Binding StartDebugCommand}" IsEnabled="{Binding CanDebugActiveFile}"
                                Visibility="{Binding IsNotDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.startDebug}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Success}"/>
                        </Button>
                        <Button Command="{Binding ContinueDebugCommand}" IsEnabled="{Binding IsPausedAtBreakpoint}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.continueDebug}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Success}"/>
                        </Button>
                        <Button Command="{Binding StepOverCommand}" IsEnabled="{Binding IsPausedAtBreakpoint}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.stepOver}">
                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.1}"/>
                        </Button>
                        <Button Command="{Binding StepIntoCommand}" IsEnabled="{Binding IsPausedAtBreakpoint}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.stepInto}">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.1}"/>
                        </Button>
                        <Button Command="{Binding StepOutCommand}" IsEnabled="{Binding IsPausedAtBreakpoint}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.stepOut}">
                            <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.1}"/>
                        </Button>
                        <Button Command="{Binding PauseDebugCommand}" IsEnabled="{Binding CanPauseDebug}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc ide.pauseDebug}">
                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Warning}"/>
                        </Button>
                        <Button Command="{Binding StopDebugCommand}"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"
                                ToolTip="{services:Loc editor.stopDebug}">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.3}"/>
                        </Button>
                        <Button Command="{Binding ShowDebugCommand}" ToolTip="{services:Loc editor.refreshAdapters}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Text.Muted}"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding DebugStatus}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Status.Warning}"/>

                    <!-- Installed adapters -->
                    <TextBlock Text="{services:Loc editor.adapters}" FontSize="9" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding DebugAdapters}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="7,5" CornerRadius="4"
                                        Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Language}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="9" Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstallHint}" FontSize="9" TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   Visibility="{Binding IsAvailable, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Call stack -->
                    <TextBlock Text="{services:Loc editor.callStack}" FontSize="9" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,4"
                               Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"/>
                    <ListBox ItemsSource="{Binding CallStack}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" MaxHeight="130" Margin="0,0,0,10"
                             Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="10"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Location}" FontSize="9"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Variables -->
                    <TextBlock Text="{services:Loc editor.variables}" FontSize="9" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,4"
                               Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding DebugVariables}" Margin="0,0,0,10"
                                  Visibility="{Binding IsDebugging, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Accent.1}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Type}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Breakpoints -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc editor.breakpoints}" FontSize="9" FontWeight="Bold"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding ClearBreakpointsCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                ToolTip="{services:Loc editor.clearBreakpoints}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{services:Loc editor.noBreakpoints}" FontSize="9" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Breakpoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Breakpoints}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Editor.Breakpoint}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Cursor="Hand" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Command="{Binding DataContext.GoToBreakpointCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding FilePath}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding Label}" FontSize="10"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button Grid.Column="2" Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Padding="4,0"
                                            Command="{Binding DataContext.RemoveBreakpointCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource Text.Faint}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Debug console -->
                    <TextBlock Text="{services:Loc editor.debugConsole}" FontSize="9" FontWeight="Bold"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Editor.Background}" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}" Height="140">
                        <TextBox x:Name="DebugOut" Text="{Binding DebugConsole, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 Background="Transparent" BorderThickness="0" Padding="7,4"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="OnDebugOutputChanged"/>
                    </Border>
                    <Border Background="{DynamicResource Surface.Input}" CornerRadius="4" Margin="0,4,0,0"
                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&gt;" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                       Foreground="{DynamicResource Status.Warning}"
                                       VerticalAlignment="Center" Margin="7,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding DebugEvalInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0,5,7,5"
                                     Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Status.Warning}"
                                     FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                     ToolTip="{services:Loc editor.evaluateTip}"
                                     KeyDown="OnDebugEvalKeyDown"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═════════════ EDITOR CENTER ═════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Tab strip -->
                <RowDefinition Height="Auto"/>   <!-- Merge-conflict banner -->
                <RowDefinition Height="*"/>      <!-- Code area + minimap (or the diff editor) -->
                <RowDefinition Height="Auto"/>   <!-- Terminal drawer -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Editor -->
                <ColumnDefinition Width="Auto"/> <!-- PREVIEW split (built-in browser) -->
            </Grid.ColumnDefinitions>

            <!-- ══════════ PREVIEW split — the built-in browser the agent drives (Dev Preview) ══════════
                 Its own column over all rows, so no WPF overlay (diff editor, banner) ever sits on top of the
                 page's native window. The page itself belongs to BrowserService and survives page switches. -->
            <preview:PreviewDock Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                                 Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={StaticResource BoolVis}}"/>

            <!-- Tab strip -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Bg.Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- PREVIEW split toggle -->
                    <!-- IsChecked lives in the app-wide PreviewViewModel: this view is rebuilt on every visit. -->
                    <ToggleButton x:Name="PreviewToggle" Grid.Column="2" Margin="0,3,8,3" Padding="8,3" Cursor="Hand"
                                  IsChecked="{Binding IsDockOpen, Source={x:Static vm:PreviewViewModel.Current}, Mode=TwoWay}"
                                  ToolTip="{services:Loc preview.toggleTip}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="Transparent" BorderThickness="1" CornerRadius="4"
                                        BorderBrush="{DynamicResource Border.Subtle}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.1.Tint.Strong}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Accent.1}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc preview.title}" FontSize="11" Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource EditorTabTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Preview / open externally: review the result the way the agent's user would —
                         HTML opens in the browser, anything else in its default app. -->
                    <Button Grid.Column="1" Margin="6,3,8,3" Padding="8,3" Cursor="Hand"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            Click="OnPreviewClick"
                            Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}"
                            ToolTip="{services:Loc editor.previewTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Status.Success}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc editor.preview}" FontSize="11" Foreground="{DynamicResource Status.Success}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════ MERGE-CONFLICT banner ══════════
                 Appears whenever the open buffer still has git's markers in it. Resolutions edit the
                 TAB (undoable, saved deliberately) — never the file behind the user's back. -->
            <Border Grid.Row="1" Padding="12,8" BorderThickness="0,0,0,1"
                    Background="{DynamicResource Banner.Danger.Background}" BorderBrush="{DynamicResource Accent.3}"
                    Visibility="{Binding HasConflicts, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource Accent.3}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConflictSummary}" FontSize="11"
                                   Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding AcceptAllOursCommand}" Cursor="Hand"
                                Padding="8,3" Margin="8,0,4,0" FontSize="10"
                                Background="{DynamicResource Button.Flat.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                Foreground="{DynamicResource Button.Flat.Foreground}"
                                ToolTip="{services:Loc editor.acceptAllCurrentTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{services:Loc editor.acceptAllCurrent}"/>
                        </Button>
                        <Button Grid.Column="3" Command="{Binding AcceptAllTheirsCommand}" Cursor="Hand"
                                Padding="8,3" FontSize="10"
                                Background="{DynamicResource Button.Flat.Background}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                Foreground="{DynamicResource Button.Flat.Foreground}"
                                ToolTip="{services:Loc editor.acceptAllIncomingTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{services:Loc editor.acceptAllIncoming}"/>
                        </Button>
                    </Grid>

                    <!-- Per-conflict rows -->
                    <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0" MaxHeight="190">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="5"
                                        Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Button HorizontalAlignment="Left" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                    Command="{Binding DataContext.GoToConflictCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{services:Loc editor.jumpToConflict}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Accent.1}"/>
                                            </Button>
                                            <TextBlock Text="{Binding OursSummary}" FontSize="9" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Status.Success}"/>
                                            <TextBlock Text="{Binding OursPreview}" FontSize="10" MaxHeight="42"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TheirsSummary}" FontSize="9" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Status.Warning}"/>
                                            <TextBlock Text="{Binding TheirsPreview}" FontSize="10" MaxHeight="42"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="Button">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Padding" Value="8,3"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="MinWidth" Value="92"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Button.Flat.Foreground}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{DynamicResource Button.Flat.Background}" CornerRadius="4"
                                                                        BorderBrush="{DynamicResource Border.Default}"
                                                                        BorderThickness="1"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Flat.Hover.Background}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </StackPanel.Resources>
                                            <Button Command="{Binding DataContext.AcceptOursCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{services:Loc editor.acceptCurrent}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.AcceptTheirsCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{services:Loc editor.acceptIncoming}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.AcceptBothCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{services:Loc editor.acceptBoth}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Code area + minimap -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- Editor (line gutter + TextBox) -->
                <Grid Grid.Column="0" Background="{DynamicResource Bg.Window}">
                    <!-- Empty state when no tab open -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.Faint}" Opacity="0.5"/>
                        <TextBlock Text="{services:Loc editor.openFileHint}"
                                   Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource Text.Muted}"/>
                        <TextBlock Text="{services:Loc editor.askAiHint}"
                                   Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Text.Faint}" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Editor surface — AvalonEdit (real syntax highlighting + built-in gutter).
                         Content sync, neon theme, caret-follow and the changed-region glow renderer
                         are wired in code-behind (CodeEditorView.xaml.cs). -->
                    <avalonedit:TextEditor x:Name="Editor"
                                           Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}"
                                           FontFamily="{DynamicResource Font.Mono.Display}" FontSize="13"
                                           Background="{DynamicResource Editor.Background}"
                                           Foreground="{DynamicResource Editor.Foreground}"
                                           LineNumbersForeground="{DynamicResource Editor.LineNumber}"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           BorderThickness="0"
                                           Padding="8,12,0,12"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Minimap — real document overview: line bars + draggable viewport (MinimapControl) -->
                <Border Grid.Column="1" Background="{DynamicResource Editor.Minimap.Background}"
                        BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border.Subtle}"
                        Visibility="{Binding HasActiveTab, Converter={StaticResource BoolVis}}">
                    <editor:MinimapControl x:Name="Minimap" Margin="0,4"/>
                </Border>
            </Grid>

            <!-- ══════════ SIDE-BY-SIDE DIFF editor ══════════
                 Covers the code area while active. One virtualized list with four columns rather than
                 two synced editors: alignment is then structural and cannot drift apart on scroll. -->
            <!-- Bg.Window makes the overlay opaque over the editor; Editor.Background on top gives it the same
                 code surface as the editor (transparent in Midnight, a light page in Classic). -->
            <Border Grid.Row="2" Background="{DynamicResource Bg.Window}"
                    Visibility="{Binding IsDiffViewActive, Converter={StaticResource BoolVis}}">
                <Grid Background="{DynamicResource Editor.Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource Bg.Panel}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiffTitle}" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding DiffSummary}" FontSize="10" Margin="12,0,10,0"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Width="22" Height="22" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseDiffCommand}"
                                    ToolTip="{services:Loc editor.closeDiff}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Column captions -->
                    <Grid Grid.Row="1" Background="{DynamicResource Surface.Sunken}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{services:Loc editor.diffHead}" FontSize="9" Padding="6,3"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}"/>
                        <TextBlock Grid.Column="3" Text="{services:Loc editor.diffWorking}" FontSize="9" Padding="6,3"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}"/>
                    </Grid>

                    <!-- Rows -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding DiffRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding LeftLine}" FontSize="10"
                                               HorizontalAlignment="Right" Padding="0,1,8,1"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <Border x:Name="leftCell" Grid.Column="1" Background="Transparent">
                                        <TextBlock Text="{Binding LeftText}" FontSize="11" Padding="6,1"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="NoWrap"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding RightLine}" FontSize="10"
                                               HorizontalAlignment="Right" Padding="0,1,8,1"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}"/>
                                    <Border x:Name="rightCell" Grid.Column="3" Background="Transparent">
                                        <TextBlock Text="{Binding RightText}" FontSize="11" Padding="6,1"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="NoWrap"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                        <Setter TargetName="leftCell" Property="Background" Value="{DynamicResource Editor.Diff.Removed.Background}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Added">
                                        <Setter TargetName="rightCell" Property="Background" Value="{DynamicResource Editor.Diff.Added.Background}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Modified">
                                        <Setter TargetName="leftCell" Property="Background" Value="{DynamicResource Editor.Diff.Removed.Background}"/>
                                        <Setter TargetName="rightCell" Property="Background" Value="{DynamicResource Editor.Diff.Added.Background}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Terminal drawer — a REAL persistent PowerShell in the project folder -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Bg.Panel}">
                <StackPanel>
                    <!-- Header row (click to expand/collapse) -->
                    <Button Command="{Binding ToggleTerminalCommand}" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Padding="14,6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc editor.terminal}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="·" Margin="8,0" FontSize="11" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            <TextBlock Text="pwsh" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE70E;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTerminalOpen}" Value="False">
                                                <Setter Property="Text" Value="&#xE70D;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource Status.Success}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <!-- Expanded terminal: output + input line -->
                    <Grid Visibility="{Binding IsTerminalOpen, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="170"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TerminalOut" Grid.Row="0"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 Background="{DynamicResource Editor.Background}" BorderThickness="0"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                 Padding="12,6"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextChanged="OnTerminalOutputChanged"/>
                        <Grid Grid.Row="1" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&gt;" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                       Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Border Grid.Column="1" Background="{DynamicResource Surface.Input}" CornerRadius="4"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <TextBox Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="8,4"
                                         Foreground="{DynamicResource Text.Primary}"
                                         CaretBrush="{DynamicResource Status.Warning}"
                                         FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                         KeyDown="OnTerminalInputKeyDown"
                                         PreviewKeyDown="OnTerminalInputPreviewKeyDown"/>
                            </Border>
                            <Button Grid.Column="2" Command="{Binding InterruptTerminalCommand}" Cursor="Hand"
                                    Margin="6,0,0,0" Padding="8,3" Background="Transparent" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    ToolTip="{services:Loc ide.stopTerminalTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Danger}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Accent.3}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════ CHAT PANEL (right) ═════════════ -->
        <Border x:Name="EditorChatPanel" Grid.Column="2" Width="400" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Border.Subtle}"
                Background="{DynamicResource Sidebar.Background}">
            <ContentControl Content="{Binding ChatVM}"/>
        </Border>

        <!-- Drag a panel's edge to resize it (remembered); double-click puts it back. Each grip straddles the edge
             (negative margin) so it never covers a whole scroll bar or the breakpoint gutter. -->
        <views:ResizeGrip Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-3,0"
                          Key="editor.explorer" MinSize="160" MaxSize="640"
                          Target="{Binding ElementName=ExplorerPanel}"/>
        <views:ResizeGrip Grid.Column="2" HorizontalAlignment="Left" Margin="-3,0,0,0" OnLeftEdge="True"
                          Key="editor.chat" MinSize="280" MaxSize="1200"
                          Target="{Binding ElementName=EditorChatPanel}"/>
    </Grid>
</UserControl>
