<UserControl x:Class="CluadeX.Views.Billing.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services">
    <!-- Credit & plan price for the account on screen (DataContext: BillingAccountViewModel), inside the Budgets card. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CluadeX;component/Views/Billing/BillingStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
        <Border Height="1" Background="{DynamicResource Border.Subtle}" Margin="0,14,0,12"/>
        <DockPanel>
            <ComboBox x:Name="AccountPicker" DockPanel.Dock="Right" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                      DisplayMemberPath="Label" Width="210" Margin="12,0,0,0" VerticalAlignment="Center"
                      AutomationProperties.Name="{services:Loc usage.billingProvider}"
                      Visibility="{Binding CanPick, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding LegacyCreditText}" Style="{StaticResource Note}" Margin="0,8,0,0"
                   Visibility="{Binding HasLegacyCredit, Converter={StaticResource BoolVis}}"/>

        <!-- An API account: the credit entered off its billing page, counted down by what CluadeX spent since -->
        <StackPanel x:Name="CreditEditor" Margin="0,10,0,0" Visibility="{Binding IsApiBilling, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"
                       Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding BalanceDetail}" Style="{StaticResource Note}" Margin="0,2,0,0"/>
            <TextBlock Text="{services:Loc usage.balanceInput}" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
            <WrapPanel>
                <TextBox x:Name="BalanceBox" Text="{Binding BalanceInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                         Width="150" Margin="0,0,8,6" AutomationProperties.Name="{services:Loc usage.balanceInput}"/>
                <Button Content="{services:Loc usage.balanceSave}" Command="{Binding SetBalanceCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="14,5" Margin="0,0,8,6" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=BalanceBox}"/>
                <Button Content="{services:Loc usage.balanceClear}" Command="{Binding ClearBalanceCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="12,5" Margin="0,0,8,6" Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
                <Button Content="{services:Loc usage.billing}" Command="{Binding OpenSiteCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="12,5" Margin="0,0,8,6" Visibility="{Binding HasSite, Converter={StaticResource BoolVis}}"/>
            </WrapPanel>
            <TextBlock Text="{services:Loc billing.account.replaceNote}" Style="{StaticResource Note}" FontSize="11"
                       Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <!-- A plan CLI: the monthly fee and the day it started -->
        <StackPanel x:Name="PlanEditor" Margin="0,10,0,0" Visibility="{Binding IsPackageBilling, Converter={StaticResource BoolVis}}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{services:Loc usage.packagePrice}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PackagePriceBox" Text="{Binding PackagePriceInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                             Width="150" AutomationProperties.Name="{services:Loc usage.packagePrice}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="{services:Loc usage.packageStart}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="PackageStartPicker" SelectedDate="{Binding PackageStartDate}" DisplayDateEnd="{Binding Today, Mode=OneWay}" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Button Content="{services:Loc usage.packageSave}" Command="{Binding SavePackageCommand}" Style="{StaticResource PrimaryButton}"
                            Padding="14,5" Margin="0,0,8,0"/>
                    <Button Content="{services:Loc usage.balanceClear}" Command="{Binding ClearPackageCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="12,5" Margin="0,0,8,0" Visibility="{Binding HasPackage, Converter={StaticResource BoolVis}}"/>
                    <!-- The plan's own usage page (Claude Dev: claude.ai), as the old spend window's billing button offered -->
                    <Button Content="{services:Loc usage.billing}" Command="{Binding OpenSiteCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="12,5" Visibility="{Binding HasSite, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{services:Loc usage.packageNote}" Style="{StaticResource Note}" FontSize="11"/>
        </StackPanel>

        <TextBlock Text="{Binding BalanceError}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Status.Danger}" Margin="0,6,0,0"
                   Visibility="{Binding BalanceError, Converter={StaticResource BoolVis}}"/>
    </StackPanel>
</UserControl>
