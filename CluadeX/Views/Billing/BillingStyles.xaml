<!-- The Billing page's card look, shared by its sections that live in their own files (SavingsPanel, AccountPanel).
     Same values as BillingView.xaml's own Card / CardTitle / Muted / Chip. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Surface.Card.Flat}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Muted, wrapping: notes under a card -->
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Date pickers in the theme's input colours (the stock one is white in every theme) -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Input.Caret}"/>
        <!-- The stock template draws its own white frame inside the picker: just the text -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" Margin="2,0"/>
                        <ContentControl x:Name="PART_Watermark" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A small logo tile: the vendor's mark on white (collapsed when no mark is bundled) -->
    <DataTemplate x:Key="MiniLogo">
        <Border Width="18" Height="18" CornerRadius="5" Background="White" Padding="2" Margin="0,0,6,0"
                Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}">
            <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
        </Border>
    </DataTemplate>
</ResourceDictionary>
