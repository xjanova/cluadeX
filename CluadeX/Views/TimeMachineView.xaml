<UserControl x:Class="CluadeX.Views.TimeMachineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             d:DataContext="{d:DesignInstance Type=vm:TimeMachineViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             FontFamily="{DynamicResource Font.Ui.Display}"
             Background="{DynamicResource Bg.Window}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <vm:CommitRelativeTimeConverter x:Key="CommitTime"/>
        <Style x:Key="NeonPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Panel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{DynamicResource Shadow.Panel}"/>
        </Style>

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Glass.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Glass.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Glass.Foreground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Glass.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Glass.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimaryButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="{DynamicResource Button.Accent.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Accent.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Accent.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Effect" Value="{DynamicResource Glow.Button.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Accent.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chip — RadioButton styled as pill -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.1.Tint.Strong}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Commit row template -->
        <DataTemplate x:Key="CommitRowTemplate" DataType="{x:Type m:CommitInfo}">
            <Button Click="OnCommitClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" Padding="14,10,18,10" CornerRadius="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Commit sphere -->
                                <Grid Grid.Column="0" Width="26" Height="26" Margin="6,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <!-- Halo -->
                                    <Ellipse Width="42" Height="42" Margin="-8" Opacity="0.5"
                                             Fill="{DynamicResource TimeMachine.Halo.Ai}">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="6"/>
                                        </Ellipse.Effect>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiAuthored}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource TimeMachine.Halo.Human}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- Core sphere with radial highlight -->
                                    <Ellipse Width="26" Height="26" StrokeThickness="1.5"
                                             Fill="{DynamicResource TimeMachine.Sphere.Ai}"
                                             Stroke="{DynamicResource TimeMachine.Sphere.Ai.Stroke}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiAuthored}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource TimeMachine.Sphere.Human}"/>
                                                        <Setter Property="Stroke" Value="{DynamicResource TimeMachine.Sphere.Human.Stroke}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- Specular highlight -->
                                    <Ellipse Width="8" Height="5" Margin="2,3,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Fill="{DynamicResource TimeMachine.Highlight}" IsHitTestVisible="False"/>
                                    <!-- HEAD indicator: pulsing outer ring -->
                                    <Ellipse Width="34" Height="34" StrokeThickness="2" Stroke="{DynamicResource Status.Success}"
                                             Visibility="{Binding IsHead, Converter={StaticResource BoolVis}}"
                                             Opacity="0.7" IsHitTestVisible="False"
                                             Effect="{DynamicResource Glow.TimeMachine.Head}">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.3" To="0.95" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ShortSha}"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                                                BorderThickness="1" BorderBrush="{DynamicResource Status.Success.Border}"
                                                Background="{DynamicResource Status.Success.Tint}"
                                                Visibility="{Binding IsHead, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="HEAD" FontSize="9"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Status.Success}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="6,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="2,0" Padding="5,1" CornerRadius="3"
                                                            BorderThickness="1" BorderBrush="{DynamicResource Accent.2.Border.Strong}"
                                                            Background="{DynamicResource Accent.2.Tint}">
                                                        <TextBlock Text="{Binding}" FontSize="9"
                                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                                   Foreground="{DynamicResource Accent.2}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" Margin="0,2,0,0"
                                               FontSize="13" Foreground="{DynamicResource Text.Primary}"
                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Author}" FontSize="10"
                                                   Foreground="{Binding IsAiAuthored, Converter={StaticResource AiBoolBrush}}"/>
                                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock Text="{Binding Date, Converter={StaticResource CommitTime}}" FontSize="10"
                                                   Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock Text="{Binding FilesChanged}" FontSize="10"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock Text="{services:Loc timemachine.filesSuffix}" FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                                   Foreground="{DynamicResource Diff.Added}">
                                            <Run Text="+"/>
                                            <Run Text="{Binding Additions, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                                   Margin="6,0,0,0" Foreground="{DynamicResource Diff.Deleted}">
                                            <Run Text="−"/>
                                            <Run Text="{Binding Deletions, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- File change row in tab strip -->
        <DataTemplate x:Key="FileChangeTabTemplate" DataType="{x:Type m:CommitFileChange}">
            <Button Click="OnFileClick" Tag="{Binding}" Margin="2,0"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    Foreground="{DynamicResource Text.Muted}"
                    Padding="8,4" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status, Converter={StaticResource FileStatusText}}"
                                           Margin="0,0,6,0" FontSize="10"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Status.Warning}"/>
                                <TextBlock Text="{Binding Path}" FontSize="11"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Diff line template -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type m:DiffLine}">
            <Border BorderThickness="3,0,0,0" Background="{Binding Kind, Converter={StaticResource DiffKindBg}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="Transparent"/>
                </Border.BorderBrush>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="+">
                                <Setter Property="BorderBrush" Value="{DynamicResource Diff.Added}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="-">
                                <Setter Property="BorderBrush" Value="{DynamicResource Diff.Deleted}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="@">
                                <Setter Property="BorderBrush" Value="{DynamicResource Diff.Hunk}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NewLineNo}" TextAlignment="Right"
                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                               Foreground="{DynamicResource Text.Faint}"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" TextAlignment="Center"
                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                               FontWeight="Bold"
                               Foreground="{Binding Kind, Converter={StaticResource DiffKindBrush}}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Content}"
                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                               Foreground="{Binding Kind, Converter={StaticResource DiffKindBrush}}"
                               TextWrapping="NoWrap" VerticalAlignment="Center"
                               Padding="0,2"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->
        <!-- Nebula background — radial gradient + 4 depth orbs                -->
        <!-- ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Backdrop.TimeMachine}"/>

        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <!-- 4 depth orbs with subtle drift animation -->
            <Ellipse Width="220" Height="220" Margin="-50,80,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.22">
                <Ellipse.Fill><DynamicResource ResourceKey="Backdrop.Orb.1"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="orb1Tr"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetName="orb1Tr"
                                                 Storyboard.TargetProperty="Y"
                                                 From="-10" To="10" Duration="0:0:9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="180" Height="180" Margin="0,40,80,0"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.2">
                <Ellipse.Fill><DynamicResource ResourceKey="Backdrop.Orb.2"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="orb2Tr"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetName="orb2Tr"
                                                 Storyboard.TargetProperty="Y"
                                                 From="8" To="-8" Duration="0:0:11" BeginTime="0:0:2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="240" Height="240" Margin="0,0,200,80"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.18">
                <Ellipse.Fill><DynamicResource ResourceKey="Backdrop.Orb.3"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="orb3Tr"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetName="orb3Tr"
                                                 Storyboard.TargetProperty="Y"
                                                 From="-12" To="12" Duration="0:0:14" BeginTime="0:0:5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="160" Height="160" Margin="180,0,0,40"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.16">
                <Ellipse.Fill><DynamicResource ResourceKey="Backdrop.Orb.4"/></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="orb4Tr"/></Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetName="orb4Tr"
                                                 Storyboard.TargetProperty="Y"
                                                 From="6" To="-6" Duration="0:0:8" BeginTime="0:0:1.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>

        <!-- ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->
        <!-- Main content                                                       -->
        <!-- ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo orb with spinning halo -->
                    <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center">
                        <Ellipse Width="46" Height="46" Opacity="0.5" Fill="{DynamicResource PageIcon.TimeMachine.Halo}">
                            <Ellipse.Effect><BlurEffect Radius="10"/></Ellipse.Effect>
                            <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                            <Ellipse.RenderTransform><RotateTransform x:Name="haloRotate"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="15">
                                            <DoubleAnimation Storyboard.TargetName="haloRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource PageIcon.TimeMachine.Background}" Effect="{DynamicResource Glow.PageIcon.TimeMachine}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc timemachine.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{services:Loc timemachine.subtitle}"
                                       FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                            <Border Margin="12,0,0,0" Padding="6,2" CornerRadius="3"
                                    Background="{DynamicResource Surface.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                    Visibility="{Binding CurrentBranchName, Converter={StaticResource BoolVis}}">
                                <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Accent.1}">
                                    <Run Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding CurrentBranchName, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton GroupName="TmFilter" Content="{services:Loc timemachine.filterAll}" IsChecked="{Binding FilterAllChecked, Mode=OneWay}"
                                     Command="{Binding ShowAllCommand}"
                                     Style="{StaticResource FilterChip}" Margin="0,0,6,0"/>
                        <RadioButton GroupName="TmFilter" Content="{services:Loc timemachine.filterAgent}"
                                     IsChecked="{Binding FilterAgentChecked, Mode=OneWay}"
                                     Command="{Binding ShowAgentOnlyCommand}"
                                     Style="{StaticResource FilterChip}" Margin="0,0,12,0"/>
                        <Border Width="1" Background="{DynamicResource Border.Subtle}" Margin="0,4,12,4"/>
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource NeonButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc tm.refresh}" FontFamily="{DynamicResource Font.Ui}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="{services:Loc tm.project}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                  MinWidth="380" MaxWidth="640" Margin="0,0,18,0"
                                  ToolTip="{Binding SelectedProject.Path}"/>
                        <TextBlock Text="{services:Loc tm.day}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Text.Muted}" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDayOption}" MinWidth="200" Margin="0,0,8,0"/>
                        <Button Content="{services:Loc tm.allDays}" Command="{Binding ClearDayCommand}"
                                Style="{StaticResource NeonButton}"
                                Visibility="{Binding HasDayFilter, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══ SPLIT CONTENT ═══ -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ LEFT: timeline panel ═══ -->
                <Border Grid.Column="0" Style="{StaticResource NeonPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header strip -->
                        <Border Grid.Row="0" Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Accent.3}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Effect="{DynamicResource Glow.Accent.3.Small}"/>
                                <TextBlock Text="{services:Loc timemachine.timeline}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" Margin="10,0,0,0"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding VisibleCount, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding CommitCount, Mode=OneWay}"/>
                                    <Run Text="{services:Loc timemachine.commitsSuffix}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Restore points kept before agent edits (CheckpointService) -->
                        <Border Grid.Row="1" Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                                Visibility="{Binding HasRestorePoints, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc tm.restorePoints}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource Text.Primary}" Margin="4,0,0,6"/>
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding RestorePoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                                                        Background="{DynamicResource State.Fill.Faint}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Text.Primary}"/>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                                                <Run Text="{Binding When, Mode=OneWay}"/>
                                                                <Run Text="  ·  "/>
                                                                <Run Text="{Binding FileList, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Style="{StaticResource NeonButton}"
                                                                Content="{services:Loc tm.restoreHere}"
                                                                Command="{Binding DataContext.AskRestorePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Commit list with spine -->
                        <Grid Grid.Row="2">
                            <!-- Spine layers — drawn behind ItemsControl -->
                            <Grid HorizontalAlignment="Left" Margin="36,12,0,12">
                                <Rectangle Width="6" Margin="-3,0,0,0" Opacity="0.18" Fill="{DynamicResource TimeMachine.Spine}">
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="4"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                                <Rectangle Width="2" Margin="-1,0,0,0" Opacity="0.7" Fill="{DynamicResource TimeMachine.Spine}"/>
                                <Rectangle Width="1" Margin="-0.5,0,0,0" Fill="{DynamicResource TimeMachine.Highlight}"/>
                            </Grid>

                            <!-- Rewind beam (animated overlay) -->
                            <Rectangle x:Name="RewindBeam" Width="10" Height="100"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="32,0,0,0" Opacity="0"
                                       Visibility="{Binding IsRewinding, Converter={StaticResource BoolVis}}"
                                       Fill="{DynamicResource TimeMachine.Beam}" Effect="{DynamicResource Glow.TimeMachine.Beam}">
                                <Rectangle.RenderTransform><TranslateTransform x:Name="beamTr"/></Rectangle.RenderTransform>
                            </Rectangle>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,8,0,16">
                                <ItemsControl ItemsSource="{Binding VisibleCommits}"
                                              ItemTemplate="{StaticResource CommitRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ RIGHT: detail + diff ═══ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Commit detail card -->
                    <Border Grid.Row="0" Style="{StaticResource NeonPanel}" Padding="20"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <!-- corner glow -->
                            <Ellipse Width="220" Height="220" Margin="0,-50,-50,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     IsHitTestVisible="False" Fill="{DynamicResource TimeMachine.CornerGlow}">
                                <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                            </Ellipse>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                        VerticalAlignment="Top"
                                        Background="{Binding SelectedIsAi, Converter={StaticResource AiBoolAvatar}}"
                                        Effect="{DynamicResource Glow.TimeMachine.Avatar}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22"
                                               Foreground="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE99A;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIsAi}" Value="False">
                                                        <Setter Property="Text" Value="&#xE77B;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="6,2" CornerRadius="4"
                                                Background="{DynamicResource State.Fill.Faint}"
                                                BorderThickness="1" BorderBrush="{DynamicResource Border.Default}">
                                            <TextBlock Text="{Binding SelectedShortSha}"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       FontSize="11" Foreground="{DynamicResource Text.Primary}"/>
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Accent.1}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedBranch, Converter={StaticResource BoolVis}}">
                                            <Run Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding SelectedBranch, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Margin="10,0,0,0" Text="·" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="10,0,0,0" Text="{Binding SelectedTime}" FontSize="11"
                                                   Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedMessage}" Margin="0,8,0,0"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{services:Loc tm.byPrefix}" Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedAuthor}" FontSize="11"
                                                   Foreground="{Binding SelectedIsAi, Converter={StaticResource AiBoolBrush}}"/>
                                        <TextBlock Margin="14,0,0,0" Text="{Binding SelectedFilesCount}"
                                                   FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                                   Foreground="{DynamicResource Text.Muted}"/>
                                        <TextBlock Text="{services:Loc tm.filesWord}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                        <TextBlock Margin="14,0,0,0" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Diff.Added}">
                                            <Run Text="+"/>
                                            <Run Text="{Binding SelectedAdditions, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Margin="6,0,0,0" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Diff.Deleted}">
                                            <Run Text="−"/>
                                            <Run Text="{Binding SelectedDeletions, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button Command="{Binding OpenConfirmCommand}"
                                            Style="{StaticResource NeonPrimaryButton}" Margin="0,0,0,6"
                                            IsEnabled="{Binding HasSelection}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc timemachine.rewindHere}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding BranchFromCommand}"
                                            Style="{StaticResource NeonButton}" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc timemachine.branchHere}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CherryPickCommand}"
                                            Style="{StaticResource NeonButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc timemachine.cherryPick}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Diff panel -->
                    <Border Grid.Row="2" Style="{StaticResource NeonPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Diff header / file tabs -->
                            <Border Grid.Row="0" Padding="14,10" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Border.Subtle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="&#xE17C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="{DynamicResource Accent.1}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{services:Loc timemachine.changes}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="10,0,0,0" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Faint}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SelectedFile.Path, Mode=OneWay, TargetNullValue='(select a file)'}"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled" Margin="12,0,0,0">
                                        <ItemsControl ItemsSource="{Binding Files}"
                                                      ItemTemplate="{StaticResource FileChangeTabTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Diff lines -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto" Padding="0,8">
                                <ItemsControl ItemsSource="{Binding DiffLines}"
                                              ItemTemplate="{StaticResource DiffLineTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="20,6" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.StatusBar.Background}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolVis}}">
                <!-- Read-only TextBox, not a TextBlock: after a rewind this line holds the snapshot branch and
                     stash names needed to get back, so they must be selectable / copyable. -->
                <TextBox Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap"
                         FontFamily="{DynamicResource Font.Mono.Display}"
                         Foreground="{DynamicResource Text.Secondary}"
                         CaretBrush="{DynamicResource Accent.1}"/>
            </Border>
        </Grid>

        <!-- ═══ CONFIRM REWIND DIALOG ═══ -->
        <Grid Background="{DynamicResource Bg.Scrim.Dialog}"
              Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolVis}}">
            <Border Width="460" Padding="24" Style="{StaticResource NeonPanel}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="46" Height="46" CornerRadius="11"
                                Background="{DynamicResource Button.Accent.Background}" Effect="{DynamicResource Glow.TimeMachine.Rewind}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="22" Foreground="{DynamicResource Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{services:Loc timemachine.rewindConfirmTitle}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Text.Muted}"
                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                Working changes will be auto-stashed. Your history is preserved.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource State.Fill.Faint}" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShortSha}" FontSize="11"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Faint}"/>
                            <TextBlock Text="{Binding SelectedMessage}" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Text.Primary}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="{services:Loc timemachine.snapshotBranch}"
                              IsChecked="{Binding CreateSnapshot}" Margin="0,0,0,18"
                              Foreground="{DynamicResource Text.Secondary}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{services:Loc timemachine.cancel}" Style="{StaticResource NeonButton}"
                                Margin="0,0,8,0" Command="{Binding CancelConfirmCommand}"/>
                        <Button Command="{Binding ConfirmRewindCommand}"
                                Style="{StaticResource NeonPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc timemachine.confirmRewind}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ CONFIRM RESTORE POINT ═══ -->
        <Grid Background="{DynamicResource Bg.Scrim.Dialog}"
              Visibility="{Binding IsPointConfirmOpen, Converter={StaticResource BoolVis}}">
            <Border Width="480" Padding="24" Style="{StaticResource NeonPanel}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{services:Loc tm.pointConfirmTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc tm.pointConfirmBody}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <Border Background="{DynamicResource State.Fill.Faint}" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding PendingPoint.Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock Text="{Binding PendingPoint.When}" FontSize="11" Margin="0,4,0,0"
                                       FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Faint}"/>
                            <TextBlock Text="{Binding PendingPoint.FileList}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{services:Loc timemachine.cancel}" Style="{StaticResource NeonButton}"
                                Margin="0,0,8,0" Command="{Binding CancelRestorePointCommand}"/>
                        <Button Content="{services:Loc tm.restoreHere}" Style="{StaticResource NeonPrimaryButton}"
                                Command="{Binding ConfirmRestorePointCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ REWIND OVERLAY ═══ (its rings start on Loaded; code-behind pauses them while it is collapsed) -->
        <Grid x:Name="RewindOverlay" Background="{DynamicResource Bg.Scrim.Busy}"
              Visibility="{Binding IsRewinding, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="220" Height="220">
                    <!-- Concentric expanding rings -->
                    <Ellipse Width="220" Height="220" StrokeThickness="2" Stroke="{DynamicResource Accent.3}" Opacity="0">
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform><ScaleTransform x:Name="ring1Scale" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ring1Scale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ring1Scale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.9" To="0" Duration="0:0:2.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="220" Height="220" StrokeThickness="2" Stroke="{DynamicResource Accent.1}" Opacity="0">
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform><ScaleTransform x:Name="ring2Scale" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.55">
                                        <DoubleAnimation Storyboard.TargetName="ring2Scale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ring2Scale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.9" To="0" Duration="0:0:2.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="220" Height="220" StrokeThickness="2" Stroke="{DynamicResource Accent.3}" Opacity="0">
                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform><ScaleTransform x:Name="ring3Scale" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.1">
                                        <DoubleAnimation Storyboard.TargetName="ring3Scale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetName="ring3Scale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.4" To="1.6" Duration="0:0:2.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.9" To="0" Duration="0:0:2.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Center orb with spinning rewind icon -->
                    <Border Width="80" Height="80" CornerRadius="40"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource TimeMachine.Rewind.Orb}" Effect="{DynamicResource Glow.TimeMachine.Rewind.Orb}">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="{DynamicResource Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="rewindIconRotate"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="rewindIconRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="-360" Duration="0:0:1.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Border>
                </Grid>

                <TextBlock Text="{services:Loc timemachine.rewinding}" Margin="0,24,0,0" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TimeMachine.Rewind.Title}"/>
                <TextBlock Text="{services:Loc timemachine.rewindSteps}"
                           Margin="0,6,0,0" FontSize="11"
                           FontFamily="{DynamicResource Font.Mono.Display}"
                           Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
