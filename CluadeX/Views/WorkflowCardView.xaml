<UserControl x:Class="CluadeX.Views.WorkflowCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services">
    <!-- The workflow card (docs/agent-orchestration.md §3). DataContext: ViewModels.WorkflowCard. Nothing animates. -->
    <UserControl.Resources>
        <!-- one dot per agent, coloured by its state -->
        <Style x:Key="WfDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Fill" Value="{DynamicResource Text.Faint}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="running"><Setter Property="Fill" Value="{DynamicResource Accent.1}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="checking"><Setter Property="Fill" Value="{DynamicResource Accent.1}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done"><Setter Property="Fill" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="cached"><Setter Property="Fill" Value="{DynamicResource Status.Info}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed"><Setter Property="Fill" Value="{DynamicResource Status.Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="stopped"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="skipped"><Setter Property="Fill" Value="{DynamicResource Status.Warning}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WfFlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{DynamicResource Border.Subtle}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="20,6,0,4" Padding="14,10" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Accent.1.Border.Soft}">
        <StackPanel>
            <!-- header: name · agents · elapsed · status, Stop / Resume, expand -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Accent.1}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Faint}"/>
                    <TextBlock Text="{Binding AgentsText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Faint}"/>
                    <TextBlock x:Name="ElapsedText" Text="{Binding Elapsed}" FontSize="12" FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Faint}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StopButton" Style="{StaticResource WfFlatButton}" Command="{Binding StopCommand}" Margin="0,0,6,0"
                            ToolTip="{services:Loc orch.wf.stopTip}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{services:Loc orch.wf.stop}" FontSize="11.5" Foreground="{DynamicResource Text.Primary}"/>
                    </Button>
                    <Button x:Name="ResumeButton" Style="{StaticResource WfFlatButton}" Command="{Binding ResumeCommand}" Margin="0,0,6,0"
                            ToolTip="{services:Loc orch.wf.resumeTip}" IsEnabled="{Binding CanResume}"
                            Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{services:Loc orch.wf.resume}" FontSize="11.5" Foreground="{DynamicResource Accent.1}"/>
                    </Button>
                    <Button x:Name="ExpandButton" Style="{StaticResource WfFlatButton}" Command="{Binding ToggleCommand}" Padding="6,3"
                            ToolTip="{services:Loc orch.wf.expandTip}">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Muted}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- one dot per agent -->
            <ItemsControl x:Name="Dots" ItemsSource="{Binding Rows}" Margin="21,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><Ellipse Style="{StaticResource WfDot}" ToolTip="{Binding Label}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Note}" Margin="21,2,0,0" FontSize="11.5" Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>

            <!-- expanded: estimate, spend, verdicts; phase → agent rows → transcript -->
            <StackPanel Margin="21,6,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding EstimateText}" FontSize="11" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock Text="{Binding SpentText}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Faint}" Visibility="{Binding HasVerdicts, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding VerdictsText}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                               Visibility="{Binding HasVerdicts, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Faint}" Visibility="{Binding HasMerge, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding MergeText}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                               Visibility="{Binding HasMerge, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <ItemsControl x:Name="PhaseList" ItemsSource="{Binding Phases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                    <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                               Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="10,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Button Style="{StaticResource WfFlatButton}" Command="{Binding ToggleCommand}" Padding="4,2"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0"
                                                        ToolTip="{services:Loc orch.wf.rowTip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Style="{StaticResource WfDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Margin="10,0,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource Text.Muted}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Spent}" Margin="10,0,0,0" FontSize="11" MinWidth="44"
                                                                   TextAlignment="Right" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                                                    </Grid>
                                                </Button>
                                                <!-- the transcript: what it was asked, what it answered -->
                                                <Border Margin="16,2,0,6" Padding="10,6" CornerRadius="6" Background="{DynamicResource State.Fill.Faint}"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{services:Loc orch.wf.transcript.prompt}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Muted}"/>
                                                        <TextBox Text="{Binding Prompt, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                 TextWrapping="Wrap" FontSize="11" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                                 Foreground="{DynamicResource Text.Secondary}"/>
                                                        <TextBlock Text="{services:Loc orch.wf.transcript.answer}" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource Text.Muted}" Visibility="{Binding HasAnswer, Converter={StaticResource BoolVis}}"/>
                                                        <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                 TextWrapping="Wrap" FontSize="11" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                                                 FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Primary}"
                                                                 Visibility="{Binding HasAnswer, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{services:Loc orch.wf.transcript.error}" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource Status.Danger}" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Status.Danger}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
