<UserControl x:Class="CluadeX.Views.HookLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HookLibraryViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>

        <!-- Card per bundled hook -->
        <DataTemplate x:Key="HookCardTemplate" DataType="{x:Type m:HookBundle}">
            <Button Click="OnHookClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                                Background="{StaticResource NeonCardFill}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4CDFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource NeonMonoFont}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource NeonInk0Brush}"/>
                            <!-- Phase chip -->
                            <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="{StaticResource NeonCyanBrush}"
                                    Background="#224CDFFF">
                                <TextBlock Text="{Binding Phase}" FontSize="9" FontWeight="Bold"
                                           FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonCyanBrush}"/>
                            </Border>
                            <!-- Risk chip (color depends on risk) -->
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="{StaticResource NeonAmberBrush}"
                                    Background="#22FFD166">
                                <TextBlock Text="{Binding Category}" FontSize="9"
                                           FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonAmberBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{StaticResource NeonInk2Brush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Toggle switch — a CheckBox styled as a pill -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              VerticalAlignment="Center" Margin="14,0,0,0"
                              Click="OnToggleClick" Tag="{Binding}" Cursor="Hand">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="track" Width="42" Height="22" CornerRadius="11"
                                        BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                                        Background="#22000000">
                                    <Ellipse x:Name="knob" Width="16" Height="16"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="2,0,0,0" Fill="{StaticResource NeonInk2Brush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="#445CFFB0"/>
                                        <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource NeonMintBrush}"/>
                                        <Setter TargetName="knob" Property="Fill" Value="{StaticResource NeonMintBrush}"/>
                                        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#225CFFB0" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7F141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5CFFB0" Offset="0"/>
                                <GradientStop Color="#4CDFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#5CFFB0" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc hooks.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0">
                            <Run Text="{services:Loc hooks.bundledCount}"/>
                            <Run Text="{Binding EnabledCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc hooks.enabledSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Margin="0,0,8,0" Padding="8,5" FontSize="11"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#22000000" Foreground="{StaticResource NeonInk0Brush}"
                                 BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                                 FontFamily="{StaticResource NeonMonoFont}"
                                 VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <VisualBrush x:Key="hint" TileMode="None" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="{services:Loc hooks.filter}" Foreground="{StaticResource NeonInk3Brush}" FontSize="11"
                                                   FontFamily="{StaticResource NeonMonoFont}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="&#xE838; Bundle folder" FontFamily="Segoe UI"
                                Command="{Binding OpenBundleFolderCommand}"
                                Padding="12,7" Margin="0,0,6,0" Cursor="Hand"
                                Background="#7028326E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                Foreground="{StaticResource NeonInk0Brush}" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="&#xE72C; Refresh" FontFamily="Segoe UI"
                                Command="{Binding RefreshCommand}"
                                Padding="12,7" Cursor="Hand"
                                Background="#7028326E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                Foreground="{StaticResource NeonInk0Brush}" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Border Grid.Column="0" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Bundles}"
                                      ItemTemplate="{StaticResource HookCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="2" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title bar -->
                        <StackPanel Grid.Row="0" Margin="20,20,20,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5CFFB0" Offset="0"/>
                                            <GradientStop Color="#4CDFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#5CFFB0" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/>
                                    </Border.Effect>
                                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk0Brush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Padding="6,2" CornerRadius="3" Background="#224CDFFF"
                                                BorderThickness="1" BorderBrush="{StaticResource NeonCyanBrush}">
                                            <TextBlock Text="{Binding Selected.Phase}" FontSize="9" FontWeight="Bold"
                                                       FontFamily="{StaticResource NeonMonoFont}"
                                                       Foreground="{StaticResource NeonCyanBrush}"/>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                Background="#22FFD166"
                                                BorderThickness="1" BorderBrush="{StaticResource NeonAmberBrush}">
                                            <TextBlock Text="{Binding Selected.Category}" FontSize="9"
                                                       FontFamily="{StaticResource NeonMonoFont}"
                                                       Foreground="{StaticResource NeonAmberBrush}"/>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                Background="#22FF6B6B"
                                                BorderThickness="1" BorderBrush="#FF6B6B">
                                            <TextBlock Text="{Binding Selected.Risk, StringFormat='risk: {0}'}" FontSize="9"
                                                       FontFamily="{StaticResource NeonMonoFont}"
                                                       Foreground="#FF6B6B"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.Description}" FontSize="13"
                                       Foreground="{StaticResource NeonInk1Brush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                               Foreground="{StaticResource NeonInk3Brush}">
                                        <Run Text="{services:Loc hooks.matcherLabel}"/>
                                        <Run Text="{Binding Selected.Matcher}" Foreground="{StaticResource NeonCyanBrush}"/>
                                        <Run Text="{services:Loc hooks.timeoutLabel}"/>
                                        <Run Text="{Binding Selected.TimeoutMs}" Foreground="{StaticResource NeonCyanBrush}"/>
                                        <Run Text="ms"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedScriptPath}" FontSize="10"
                                               FontFamily="{StaticResource NeonMonoFont}"
                                               Foreground="{StaticResource NeonInk3Brush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="{services:Loc hooks.toggle}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="{Binding Selected}"
                                        Padding="14,8" Cursor="Hand"
                                        Background="#445CFFB0" BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                                        Foreground="{StaticResource NeonInk0Brush}" FontSize="11" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Script preview -->
                        <Border Grid.Row="1" Margin="20,8,20,20" Padding="14" CornerRadius="6"
                                Background="#7011152E"
                                BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{services:Loc hooks.scriptPreview}" FontFamily="{StaticResource NeonMonoFont}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding SelectedScriptContent, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource NeonInk1Brush}"
                                             Padding="0" TextWrapping="NoWrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource NeonLineBrush}" Background="#88141838">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{StaticResource NeonMonoFont}"
                           Foreground="{StaticResource NeonInk2Brush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
