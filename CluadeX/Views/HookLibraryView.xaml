<UserControl x:Class="CluadeX.Views.HookLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HookLibraryViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">
    <UserControl.Resources>

        <!-- Card per bundled hook -->
        <DataTemplate x:Key="HookCardTemplate" DataType="{x:Type m:HookBundle}">
            <Button Click="OnHookClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Surface.Card}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.Card.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <!-- Phase chip -->
                            <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="{DynamicResource Accent.1}"
                                    Background="{DynamicResource Accent.1.Tint}">
                                <TextBlock Text="{Binding Phase}" FontSize="9" FontWeight="Bold"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Accent.1}"/>
                            </Border>
                            <!-- Risk chip (color depends on risk) -->
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="{DynamicResource Status.Warning}"
                                    Background="{DynamicResource Status.Warning.Tint}">
                                <TextBlock Text="{Binding Category}" FontSize="9"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Status.Warning}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Toggle switch — a CheckBox styled as a pill -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              VerticalAlignment="Center" Margin="14,0,0,0"
                              Click="OnToggleClick" Tag="{Binding}" Cursor="Hand">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="track" Width="42" Height="22" CornerRadius="11"
                                        BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                        Background="{DynamicResource Surface.Inset}">
                                    <Ellipse x:Name="knob" Width="16" Height="16"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="2,0,0,0" Fill="{DynamicResource Text.Muted}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="{DynamicResource Status.Success.Tint.Strong}"/>
                                        <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                        <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Status.Success}"/>
                                        <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Success}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                            Background="{DynamicResource IconTile.Success-Accent.1}"
                            Effect="{DynamicResource Glow.IconTile.Success}">
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc hooks.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0">
                            <Run Text="{services:Loc hooks.bundledCount}"/>
                            <Run Text="{Binding EnabledCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc hooks.enabledSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Margin="0,0,8,0" Padding="8,5" FontSize="11"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Surface.Inset}" Foreground="{DynamicResource Text.Primary}"
                                 BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                 FontFamily="{DynamicResource Font.Mono.Display}"
                                 VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <VisualBrush x:Key="hint" TileMode="None" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="{services:Loc hooks.filter}" Foreground="{DynamicResource Text.Faint}" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Mono.Display}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <!-- Own template: the Windows one turned the border its own blue on hover / focus whatever
                                 the theme said. Same shape; Midnight's Input.Plain.* tokens hold those Windows blues. -->
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Input.Plain.Hover.Border}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Input.Plain.Focus.Border}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button FontFamily="Segoe UI"
                                Command="{Binding OpenBundleFolderCommand}"
                                Padding="12,7" Margin="0,0,6,0" Cursor="Hand"
                                Background="{DynamicResource Button.Action.Background}" BorderBrush="{DynamicResource Button.Action.Border}" BorderThickness="1"
                                Foreground="{DynamicResource Button.Action.Foreground}" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc hooklib.bundleFolder}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button FontFamily="Segoe UI"
                                Command="{Binding RefreshCommand}"
                                Padding="12,7" Cursor="Hand"
                                Background="{DynamicResource Button.Action.Background}" BorderBrush="{DynamicResource Button.Action.Border}" BorderThickness="1"
                                Foreground="{DynamicResource Button.Action.Foreground}" FontSize="11">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc hooklib.refresh}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                        CornerRadius="10" Effect="{DynamicResource Shadow.Panel.Soft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Bundles}"
                                      ItemTemplate="{StaticResource HookCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="2" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title bar -->
                        <StackPanel Grid.Row="0" Margin="20,20,20,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="14"
                                        Background="{DynamicResource IconTile.Success-Accent.1}"
                                        Effect="{DynamicResource Glow.IconTile.Large.Success}">
                                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                               Foreground="{DynamicResource IconTile.Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Padding="6,2" CornerRadius="3" Background="{DynamicResource Accent.1.Tint}"
                                                BorderThickness="1" BorderBrush="{DynamicResource Accent.1}">
                                            <TextBlock Text="{Binding Selected.Phase}" FontSize="9" FontWeight="Bold"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Accent.1}"/>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                Background="{DynamicResource Status.Warning.Tint}"
                                                BorderThickness="1" BorderBrush="{DynamicResource Status.Warning}">
                                            <TextBlock Text="{Binding Selected.Category}" FontSize="9"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Status.Warning}"/>
                                        </Border>
                                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                Background="{DynamicResource Status.Danger.Tint}"
                                                BorderThickness="1" BorderBrush="{DynamicResource Status.Danger}">
                                            <TextBlock FontSize="9"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Status.Danger}">
                                                <Run Text="{services:Loc hooklib.riskPrefix}"/><Run Text="{Binding Selected.Risk, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.Description}" FontSize="13"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}">
                                        <Run Text="{services:Loc hooks.matcherLabel}"/>
                                        <Run Text="{Binding Selected.Matcher}" Foreground="{DynamicResource Accent.1}"/>
                                        <Run Text="{services:Loc hooks.timeoutLabel}"/>
                                        <Run Text="{Binding Selected.TimeoutMs}" Foreground="{DynamicResource Accent.1}"/>
                                        <Run Text="{services:Loc hooklib.msSuffix}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedScriptPath}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="{services:Loc hooks.toggle}"
                                        Command="{Binding ToggleCommand}"
                                        CommandParameter="{Binding Selected}"
                                        Padding="14,8" Cursor="Hand"
                                        Background="{DynamicResource Status.Success.Tint.Strong}" BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                        Foreground="{DynamicResource Text.Primary}" FontSize="11" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Script preview -->
                        <Border Grid.Row="1" Margin="20,8,20,20" Padding="14" CornerRadius="6"
                                Background="{DynamicResource Surface.Input}"
                                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{services:Loc hooks.scriptPreview}" FontFamily="{DynamicResource Font.Mono.Display}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding SelectedScriptContent, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Secondary}"
                                             Padding="0" TextWrapping="NoWrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Page.Footer.Background}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{DynamicResource Font.Mono.Display}"
                           Foreground="{DynamicResource Text.Muted}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
