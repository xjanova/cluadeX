<UserControl x:Class="CluadeX.Views.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PluginManagerViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>

        <!-- Installed plugin card -->
        <DataTemplate x:Key="InstalledPluginCard" DataType="{x:Type m:PluginInfo}">
            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                    BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                    Background="{StaticResource NeonCardFill}"
                    Cursor="Hand" MouseLeftButtonDown="OnInstalledClick" Tag="{Binding}">
                <Border.ToolTip>
                    <StackPanel Margin="4" MaxWidth="320">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{StaticResource NeonInk1Brush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4CDFFF" Offset="0"/>
                                <GradientStop Color="#A672FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#4CDFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeonInk0Brush}"/>
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Margin="8,0,0,0"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource NeonInk2Brush}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Enabled badge -->
                    <Border Grid.Column="2" Padding="6,2" CornerRadius="3" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#22FF6E6E"/>
                                <Setter Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Background" Value="#225CFFB0"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource NeonMintBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="9" FontFamily="{StaticResource NeonMonoFont}" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="OFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource NeonRedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Text" Value="ON"/>
                                            <Setter Property="Foreground" Value="{StaticResource NeonMintBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Catalog plugin card -->
        <DataTemplate x:Key="CatalogPluginCard" DataType="{x:Type m:CatalogPlugin}">
            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                    BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                    Background="{StaticResource NeonCardFill}"
                    Cursor="Hand" MouseLeftButtonDown="OnCatalogClick" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8AA6" Offset="0"/>
                                <GradientStop Color="#FF5EC4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5EC4" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource NeonInk0Brush}"/>
                            <Border Padding="5,1" CornerRadius="3" Margin="8,0,0,0"
                                    Background="#22A672FF"
                                    BorderBrush="{StaticResource NeonVioletBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Category}" FontSize="9"
                                           FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonVioletBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource NeonInk2Brush}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Installed badge -->
                    <Border Grid.Column="2" Padding="6,2" CornerRadius="3" VerticalAlignment="Top"
                            Background="#225CFFB0"
                            BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="INSTALLED" FontSize="9" FontWeight="Bold"
                                   FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonMintBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Filter tab (RadioButton) -->
        <Style x:Key="PluginTabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NeonInk2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{StaticResource NeonLineBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#384CDFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid neon button -->
        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="#7028326E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B22E3870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background" Value="{StaticResource NeonRewindGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonMagentaBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF5EC4" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- Background glow -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#22FF5EC4" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7F141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8AA6" Offset="0"/>
                                <GradientStop Color="#A672FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5EC4" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle, FallbackValue=Plugins}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock Text="{Binding PageSubtitle, FallbackValue='Extend CluadeX with hooks, commands, and ready-to-use automations'}"
                                   FontSize="11" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Plugins folder"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddPluginCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Install custom"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: list (left, tab toggle on top) + detail (right) -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIST -->
                <Border Grid.Column="0" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab chips -->
                        <Border Grid.Row="0" Padding="14,12,14,10" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource NeonLineBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabInstalled" GroupName="PluginsTab" IsChecked="True"
                                             Style="{StaticResource PluginTabChip}"
                                             Checked="OnTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock>
                                            <Run Text="Installed"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Plugins.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabCatalog" GroupName="PluginsTab"
                                             Style="{StaticResource PluginTabChip}"
                                             Checked="OnTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock>
                                            <Run Text="Catalog"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CatalogPlugins.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Catalog filter (only when catalog tab is on) -->
                        <Border Grid.Row="1" Margin="14,10,14,4" Padding="8,0"
                                Background="#7011152E"
                                BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsChecked, ElementName=TabCatalog, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource NeonInk2Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource NeonInk0Brush}"
                                         CaretBrush="{StaticResource NeonCyanBrush}"
                                         FontSize="11" Padding="0,7" VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lists -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,8,14,12">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Plugins}"
                                              ItemTemplate="{StaticResource InstalledPluginCard}"
                                              Visibility="{Binding IsChecked, ElementName=TabInstalled, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding CatalogPlugins}"
                                              ItemTemplate="{StaticResource CatalogPluginCard}"
                                              Visibility="{Binding IsChecked, ElementName=TabCatalog, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- DETAIL -->
                <Border Grid.Column="2" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlugin, Converter={StaticResource NullToCollapsed}, ConverterParameter=Invert}" Value="Visible"/>
                                        <DataTrigger Binding="{Binding SelectedCatalogPlugin, Converter={StaticResource NullToCollapsed}, ConverterParameter=Invert}" Value="Visible"/>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                       Foreground="{StaticResource NeonInk3Brush}" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Pick a plugin on the left to see details"
                                       FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource NeonInk2Brush}"/>
                        </StackPanel>

                        <!-- INSTALLED detail -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                      Visibility="{Binding SelectedPlugin, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="56" Height="56" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4CDFFF" Offset="0"/>
                                                <GradientStop Color="#A672FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#4CDFFF" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPlugin.Name}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonInk0Brush}"/>
                                        <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                                   Foreground="{StaticResource NeonInk3Brush}" Margin="0,4,0,0">
                                            <Run Text="v"/><Run Text="{Binding SelectedPlugin.Version, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SelectedPlugin.Path, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="#11FFFFFF"
                                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedPlugin.Description}" FontSize="13"
                                               Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding EnableCommand}" Style="{StaticResource NeonPrimary}"
                                            Visibility="{Binding SelectedPlugin.Enabled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Enable"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DisableCommand}" Style="{StaticResource NeonAction}"
                                            Visibility="{Binding SelectedPlugin.Enabled, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Disable"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- CATALOG detail -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                      Visibility="{Binding SelectedCatalogPlugin, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="56" Height="56" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF8AA6" Offset="0"/>
                                                <GradientStop Color="#FF5EC4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF5EC4" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding SelectedCatalogPlugin.Icon}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCatalogPlugin.Name}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonInk0Brush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Padding="6,2" CornerRadius="3"
                                                    Background="#22A672FF"
                                                    BorderBrush="{StaticResource NeonVioletBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding SelectedCatalogPlugin.Category}"
                                                           FontSize="9" FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonVioletBrush}"/>
                                            </Border>
                                            <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                    Background="#225CFFB0"
                                                    BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                                                    Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="INSTALLED" FontSize="9" FontWeight="Bold"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonMintBrush}"/>
                                            </Border>
                                            <TextBlock FontSize="10" Margin="8,0,0,0"
                                                       FontFamily="{StaticResource NeonMonoFont}"
                                                       Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center">
                                                <Run Text="v"/><Run Text="{Binding SelectedCatalogPlugin.Version, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="#11FFFFFF"
                                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedCatalogPlugin.Description}" FontSize="13"
                                               Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"/>
                                </Border>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="#7011152E"
                                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedCatalogPlugin.HookSummary, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="HOOKS" FontFamily="{StaticResource NeonMonoFont}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedCatalogPlugin.HookSummary}"
                                                   FontSize="12" Foreground="{StaticResource NeonInk1Brush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding InstallCatalogCommand}" Style="{StaticResource NeonPrimary}"
                                            Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Install"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding UninstallCatalogCommand}" Style="{StaticResource NeonAction}"
                                            Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Uninstall"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
