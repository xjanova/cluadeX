<UserControl x:Class="CluadeX.Views.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PluginManagerViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">
    <UserControl.Resources>

        <!-- Installed plugin card -->
        <DataTemplate x:Key="InstalledPluginCard" DataType="{x:Type vm:InstalledPluginItem}">
            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                    BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Surface.Card}"
                    Cursor="Hand" MouseLeftButtonDown="OnInstalledClick" Tag="{Binding Plugin}">
                <Border.ToolTip>
                    <StackPanel Margin="4" MaxWidth="320">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                            Background="{DynamicResource IconTile.Accent.1-2}"
                            Effect="{DynamicResource Glow.IconTile.Small.Accent.1}">
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource IconTile.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{services:Loc pluginsm.placeholderNote}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"
                                   Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <!-- Enabled badge -->
                    <Border Grid.Column="2" Padding="6,2" CornerRadius="3" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Status.Success.Tint}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding EnabledLabel}" FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Catalog plugin card -->
        <DataTemplate x:Key="CatalogPluginCard" DataType="{x:Type vm:CatalogPluginItem}">
            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                    BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Surface.Card}"
                    Cursor="Hand" MouseLeftButtonDown="OnCatalogClick" Tag="{Binding Plugin}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                            Background="{DynamicResource IconTile.Accent.4-3}"
                            Effect="{DynamicResource Glow.IconTile.Small.Accent.3}">
                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <Border Padding="5,1" CornerRadius="3" Margin="8,0,0,0"
                                    Background="{DynamicResource Accent.2.Tint}"
                                    BorderBrush="{DynamicResource Accent.2}" BorderThickness="1">
                                <TextBlock Text="{Binding Category}" FontSize="9"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Accent.2}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Installed / coming-soon badges -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Border Padding="6,2" CornerRadius="3"
                                Background="{DynamicResource Status.Success.Tint}"
                                BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc plugins.installedCaps}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Success}"/>
                        </Border>
                        <Border Padding="6,2" CornerRadius="3" Margin="0,4,0,0"
                                Background="{DynamicResource Status.Warning.Tint}"
                                BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1"
                                Visibility="{Binding IsComingSoon, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc pluginsm.comingSoon}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Warning}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Filter tab (RadioButton) -->
        <Style x:Key="PluginTabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.1.Tint.Strong}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Solid neon button -->
        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Foreground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Action.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Action.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Primary.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Primary.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Primary.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Effect" Value="{DynamicResource Glow.Button.Action.Primary}"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- Background glow -->
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Accent.3}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                            Background="{DynamicResource IconTile.Accent.4-2}"
                            Effect="{DynamicResource Glow.IconTile.Accent.3}">
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle, FallbackValue=Plugins}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding PageSubtitle}"
                                   FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Accent.1}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc plugins.folder}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddPluginCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc plugins.installCustom}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc plugins.refresh}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: list (left, tab toggle on top) + detail (right) -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIST -->
                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab chips -->
                        <Border Grid.Row="0" Padding="14,12,14,10" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Border.Subtle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabInstalled" GroupName="PluginsTab" IsChecked="True"
                                             Style="{StaticResource PluginTabChip}"
                                             Checked="OnTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock>
                                            <Run Text="{services:Loc plugins.tabInstalled}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Plugins.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabCatalog" GroupName="PluginsTab"
                                             Style="{StaticResource PluginTabChip}"
                                             Checked="OnTabChanged">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock>
                                            <Run Text="{services:Loc plugins.tabCatalog}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CatalogPlugins.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Catalog filter (only when catalog tab is on) -->
                        <Border Grid.Row="1" Margin="14,10,14,4" Padding="8,0"
                                Background="{DynamicResource Surface.Input}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsChecked, ElementName=TabCatalog, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource Text.Primary}"
                                         CaretBrush="{DynamicResource Accent.1}"
                                         FontSize="11" Padding="0,7" VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lists -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,8,14,12">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Plugins}"
                                              ItemTemplate="{StaticResource InstalledPluginCard}"
                                              Visibility="{Binding IsChecked, ElementName=TabInstalled, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding CatalogPlugins}"
                                              ItemTemplate="{StaticResource CatalogPluginCard}"
                                              Visibility="{Binding IsChecked, ElementName=TabCatalog, Converter={StaticResource BoolVis}}"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- DETAIL -->
                <Border Grid.Column="2" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid>
                        <!-- Empty state — shown when current tab has nothing selected -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=TabInstalled}" Value="True"/>
                                                <Condition Binding="{Binding SelectedPlugin}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=TabCatalog}" Value="True"/>
                                                <Condition Binding="{Binding SelectedCatalogPlugin}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                       Foreground="{DynamicResource Text.Faint}" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{services:Loc plugins.pickHint}"
                                       FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"/>
                        </StackPanel>

                        <!-- INSTALLED detail — only when Installed tab AND a plugin is selected -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=TabInstalled}" Value="True"/>
                                                <Condition Binding="{Binding SelectedPlugin, Converter={StaticResource NullToCollapsed}}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="56" Height="56" CornerRadius="14"
                                            Background="{DynamicResource IconTile.Accent.1-2}"
                                            Effect="{DynamicResource Glow.IconTile.Accent.1}">
                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                                   Foreground="{DynamicResource IconTile.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPluginItem.Name}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   Foreground="{DynamicResource Text.Faint}" Margin="0,4,0,0">
                                            <Run Text="v"/><Run Text="{Binding SelectedPlugin.Version, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SelectedPlugin.Path, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="{DynamicResource State.Fill.Faint}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedPluginItem.Description}" FontSize="13"
                                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                </Border>

                                <Border Padding="12" CornerRadius="6" Margin="0,0,0,14"
                                        Background="{DynamicResource Status.Warning.Tint}"
                                        BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1"
                                        Visibility="{Binding SelectedPluginItem.IsPlaceholder, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{services:Loc pluginsm.placeholderDetail}" FontSize="12"
                                               Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding EnableCommand}" Style="{StaticResource NeonPrimary}"
                                            Visibility="{Binding SelectedPlugin.Enabled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc plugins.enable}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DisableCommand}" Style="{StaticResource NeonAction}"
                                            Visibility="{Binding SelectedPlugin.Enabled, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc plugins.disable}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- CATALOG detail — only when Catalog tab AND a catalog plugin is selected -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=TabCatalog}" Value="True"/>
                                                <Condition Binding="{Binding SelectedCatalogPlugin, Converter={StaticResource NullToCollapsed}}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="56" Height="56" CornerRadius="14"
                                            Background="{DynamicResource IconTile.Accent.4-3}"
                                            Effect="{DynamicResource Glow.IconTile.Accent.3}">
                                        <TextBlock Text="{Binding SelectedCatalogPlugin.Icon}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCatalogItem.Name}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Padding="6,2" CornerRadius="3"
                                                    Background="{DynamicResource Accent.2.Tint}"
                                                    BorderBrush="{DynamicResource Accent.2}" BorderThickness="1">
                                                <TextBlock Text="{Binding SelectedCatalogPlugin.Category}"
                                                           FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Accent.2}"/>
                                            </Border>
                                            <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0"
                                                    Background="{DynamicResource Status.Success.Tint}"
                                                    BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                                    Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{services:Loc plugins.installedCaps}" FontSize="9" FontWeight="Bold"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Status.Success}"/>
                                            </Border>
                                            <TextBlock FontSize="10" Margin="8,0,0,0"
                                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center">
                                                <Run Text="v"/><Run Text="{Binding SelectedCatalogPlugin.Version, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="{DynamicResource State.Fill.Faint}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedCatalogItem.Description}" FontSize="13"
                                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                </Border>

                                <Border Padding="14" CornerRadius="6" Margin="0,0,0,14"
                                        Background="{DynamicResource Surface.Input}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                        Visibility="{Binding SelectedCatalogItem.HookSummary, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc plugins.hooks}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedCatalogItem.HookSummary}"
                                                   FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Padding="12" CornerRadius="6" Margin="0,0,0,14"
                                        Background="{DynamicResource Status.Warning.Tint}"
                                        BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1"
                                        Visibility="{Binding SelectedCatalogItem.IsComingSoon, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{services:Loc pluginsm.comingSoonDetail}" FontSize="12"
                                               Foreground="{DynamicResource Status.Warning}" TextWrapping="Wrap"/>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding InstallCatalogCommand}" Style="{StaticResource NeonPrimary}"
                                            Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc plugins.install}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding UninstallCatalogCommand}" Style="{StaticResource NeonAction}"
                                            Visibility="{Binding SelectedCatalogPlugin.IsInstalled, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc plugins.uninstall}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
