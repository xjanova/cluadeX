<UserControl x:Class="CluadeX.Views.RoutinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services">
    <UserControl.Resources>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource GlowTextBox}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Page.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                Background="{DynamicResource Page.Header.Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc routine.page.title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc routine.page.subtitle}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{services:Loc routine.page.add}" Command="{Binding NewCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The routines -->
            <Grid>
                <TextBlock Text="{services:Loc routine.page.empty}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                           Margin="4,8" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Padding="14,11" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,10,0"
                                                  Style="{StaticResource ModernCheckBox}" ToolTip="{services:Loc routine.page.on}"
                                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Title" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource State.Fill.Faint}"
                                                        Visibility="{Binding ByAi, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{services:Loc routine.page.byAi}" FontSize="10.5" Foreground="{DynamicResource Accent.1}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap">
                                                <Run Text="{Binding When, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Next, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock x:Name="LastLine" Text="{Binding Last}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Muted}"/>
                                            <TextBlock Text="{Binding Project}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Faint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="{services:Loc routine.page.runNow}" Style="{StaticResource Small}"
                                                    Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{services:Loc routine.page.openChat}" Style="{StaticResource Small}"
                                                    Visibility="{Binding HasChat, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{services:Loc routine.page.edit}" Style="{StaticResource Small}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{services:Loc routine.page.delete}" Style="{StaticResource Small}"
                                                    Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Last}" Value="">
                                        <Setter TargetName="LastLine" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- The editor -->
            <Border Grid.Column="1" Width="400" Margin="16,0,0,0" Padding="18,14" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Card.Flat}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                    <StackPanel>
                        <TextBlock Text="{services:Loc routine.page.name}" Style="{StaticResource Kicker}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>

                        <TextBlock Text="{services:Loc routine.page.prompt}" Style="{StaticResource Kicker}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>

                        <TextBlock Text="{services:Loc routine.page.project}" Style="{StaticResource Kicker}"/>
                        <TextBox Text="{Binding EditProject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                 FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"/>
                        <StackPanel Visibility="{Binding HasProjects, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc routine.page.pickProject}" FontSize="10.5" Margin="0,6,0,3"
                                       Foreground="{DynamicResource Text.Faint}"/>
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding PickProject}" FontSize="11.5"/>
                        </StackPanel>

                        <TextBlock Text="{services:Loc routine.page.when}" Style="{StaticResource Kicker}"/>
                        <WrapPanel>
                            <RadioButton Content="{services:Loc routine.page.kindDaily}" IsChecked="{Binding KindDaily}" Style="{StaticResource Choice}"/>
                            <RadioButton Content="{services:Loc routine.page.kindInterval}" IsChecked="{Binding KindInterval}" Style="{StaticResource Choice}"/>
                            <RadioButton Content="{services:Loc routine.page.kindOnce}" IsChecked="{Binding KindOnce}" Style="{StaticResource Choice}"/>
                        </WrapPanel>

                        <!-- On days -->
                        <StackPanel Visibility="{Binding KindDaily, Converter={StaticResource BoolVis}}">
                            <ItemsControl ItemsSource="{Binding Days}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding On}" Margin="0,0,10,4"
                                                  Style="{StaticResource ModernCheckBox}" Foreground="{DynamicResource Text.Secondary}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{services:Loc routine.page.time}" Style="{StaticResource Kicker}"/>
                            <TextBox Text="{Binding EditTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Width="90"
                                     HorizontalAlignment="Left" FontFamily="{DynamicResource Font.Mono}"/>
                        </StackPanel>

                        <!-- Every … -->
                        <StackPanel Visibility="{Binding KindInterval, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc routine.page.minutes}" Style="{StaticResource Kicker}"/>
                            <TextBox Text="{Binding EditMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Width="90"
                                     HorizontalAlignment="Left" FontFamily="{DynamicResource Font.Mono}"/>
                        </StackPanel>

                        <!-- Once -->
                        <StackPanel Visibility="{Binding KindOnce, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc routine.page.date}" Style="{StaticResource Kicker}"/>
                                    <TextBox Text="{Binding EditOnceDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Width="120"
                                             FontFamily="{DynamicResource Font.Mono}" ToolTip="yyyy-MM-dd"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{services:Loc routine.page.time}" Style="{StaticResource Kicker}"/>
                                    <TextBox Text="{Binding EditOnceTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Width="90"
                                             FontFamily="{DynamicResource Font.Mono}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding EditSameChat}" Margin="0,16,0,0"
                                  Style="{StaticResource ModernCheckBox}" Foreground="{DynamicResource Text.Secondary}">
                            <TextBlock Text="{services:Loc routine.page.sameChat}" TextWrapping="Wrap" MaxWidth="320"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding EditCatchUp}" Margin="0,8,0,0"
                                  Style="{StaticResource ModernCheckBox}" Foreground="{DynamicResource Text.Secondary}">
                            <TextBlock Text="{services:Loc routine.page.catchUp}" TextWrapping="Wrap" MaxWidth="320"/>
                        </CheckBox>

                        <TextBlock Text="{Binding EditError}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Status.Danger}" Visibility="{Binding HasEditError, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{services:Loc routine.page.cancel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                                    Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="{services:Loc routine.page.save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="14,5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" VerticalAlignment="Bottom" Margin="24,0,24,4" FontSize="11.5"
                   Foreground="{DynamicResource Accent.1}"/>

        <!-- Confirm delete -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource Bg.Scrim.Dialog}"
              Visibility="{Binding IsDeleteOpen, Converter={StaticResource BoolVis}}">
            <Border Width="420" Padding="22" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Dialog.Background}" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteText}" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource Text.Primary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{services:Loc routine.page.cancel}" Command="{Binding CancelDeleteCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Padding="12,5"/>
                        <Button Content="{services:Loc routine.page.delete}" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource DangerButton}" Padding="12,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
