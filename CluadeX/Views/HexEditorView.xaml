<UserControl x:Class="CluadeX.Views.HexEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HexEditorViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>
        <!-- Hex row template — virtualized into a ListBox -->
        <DataTemplate x:Key="HexRowTemplate" DataType="{x:Type m:HexRow}">
            <Border Padding="0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding OffsetHex}"
                               FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                               Foreground="{StaticResource NeonInk3Brush}"
                               Padding="14,2,12,2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding HexDisplay}"
                               FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                               Foreground="{StaticResource NeonInk0Brush}"
                               Padding="0,2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding AsciiDisplay}"
                               FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                               Foreground="{StaticResource NeonCyanBrush}"
                               Padding="12,2,14,2" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="HexListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30A672FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result row -->
        <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type m:HexSearchResult}">
            <Button Command="{Binding DataContext.JumpToResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent" BorderThickness="0" Padding="12,8" Cursor="Hand"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A4CDFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="{Binding OffsetHex}" FontSize="11" FontWeight="SemiBold"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonAmberBrush}"/>
                    <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,2,0,0"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk1Brush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="HexButton" TargetType="Button">
            <Setter Property="Background" Value="#7028326E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B22E3870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HexTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#7011152E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource NeonMonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HexInspectorRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="HexInspectorLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="84"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HexInspectorValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NeonMonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- background glow -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.6">
                    <GradientStop Color="#284CDFFF" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- toolbar -->
                <RowDefinition Height="Auto"/>  <!-- find panel -->
                <RowDefinition Height="*"/>     <!-- main split -->
                <RowDefinition Height="Auto"/>  <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ═══ TOOLBAR ═══ -->
            <Border Grid.Row="0" Padding="18,12" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#80141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4CDFFF" Offset="0"/>
                                    <GradientStop Color="#A672FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#4CDFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Hex Editor" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource NeonInk0Brush}"/>
                            <TextBlock Text="Binary file viewer + AI-driven patcher"
                                       FontSize="10" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- File actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Command="{Binding OpenCommand}" Style="{StaticResource HexButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Open"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource HexButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveAsCommand}" Style="{StaticResource HexButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Save As"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{StaticResource NeonLineBrush}" Margin="6,4,12,4"/>
                        <Button Command="{Binding UndoCommand}" Style="{StaticResource HexButton}" ToolTip="Undo (Ctrl+Z)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Undo"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RedoCommand}" Style="{StaticResource HexButton}" ToolTip="Redo (Ctrl+Y)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Redo"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{StaticResource NeonLineBrush}" Margin="6,4,12,4"/>
                        <Button Command="{Binding ToggleFindCommand}" Style="{StaticResource HexButton}" ToolTip="Find / Replace (Ctrl+F)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Find"/>
                            </StackPanel>
                        </Button>
                        <TextBox Style="{StaticResource HexTextBox}" Width="160"
                                 Text="{Binding GotoInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Go to offset (e.g. 0x1A00 or 6656)"/>
                        <Button Command="{Binding GotoCommand}" Style="{StaticResource HexButton}" Margin="6,0,0,0">
                            <TextBlock Text="Go"/>
                        </Button>
                    </StackPanel>

                    <!-- Inspector toggle -->
                    <Button Grid.Column="2" Command="{Binding ToggleInspectorCommand}"
                            Style="{StaticResource HexButton}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="Inspector"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ FIND PANEL ═══ -->
            <Border Grid.Row="1" Padding="18,10" BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource NeonLineBrush}"
                    Background="#5511152E"
                    Visibility="{Binding ShowFindPanel, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <RadioButton Content="HEX" GroupName="FindMode" Foreground="{StaticResource NeonInk1Brush}"
                                     IsChecked="{Binding SearchModeHex}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <RadioButton Content="TEXT" GroupName="FindMode" Foreground="{StaticResource NeonInk1Brush}"
                                     IsChecked="{Binding SearchModeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Style="{StaticResource HexTextBox}" Width="200"
                             Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Pattern to find"/>
                    <Button Command="{Binding FindCommand}" Style="{StaticResource HexButton}" Margin="6,0">
                        <TextBlock Text="Find All"/>
                    </Button>
                    <Button Command="{Binding FindNextCommand}" Style="{StaticResource HexButton}">
                        <TextBlock Text="Next ▶"/>
                    </Button>
                    <Border Width="1" Background="{StaticResource NeonLineBrush}" Margin="10,4,10,4"/>
                    <TextBlock Text="Replace with:" Foreground="{StaticResource NeonInk2Brush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource HexTextBox}" Width="160"
                             Text="{Binding ReplacePattern, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Replacement bytes (same length)"/>
                    <Button Command="{Binding ReplaceAllCommand}" Style="{StaticResource HexButton}" Margin="6,0,0,0">
                        <TextBlock Text="Replace All"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ MAIN SPLIT ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320" x:Name="InspectorColumn"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: hex grid -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- column header -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>  <!-- pager -->
                    </Grid.RowDefinitions>

                    <!-- Column header strip -->
                    <Border Grid.Row="0" Padding="14,6" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource NeonLineBrush}" Background="#3311152E">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OFFSET"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource NeonInk3Brush}"/>
                            <TextBlock Grid.Column="1" Text="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource NeonInk3Brush}"/>
                            <TextBlock Grid.Column="2" Text="ASCII"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource NeonInk3Brush}"
                                       Padding="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Hex rows -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                             ItemTemplate="{StaticResource HexRowTemplate}"
                             ItemContainerStyle="{StaticResource HexListBoxItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="OnRowSelectionChanged"
                             x:Name="HexRowsList">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer Padding="0" Background="Transparent" BorderThickness="0"
                                                          CanContentScroll="True"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <!-- Pager -->
                    <Border Grid.Row="2" Padding="14,8" BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource NeonLineBrush}" Background="#3311152E">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Command="{Binding PagePrevCommand}" Style="{StaticResource HexButton}"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="◀ Prev page"/>
                                </Button>
                                <Button Command="{Binding PageNextCommand}" Style="{StaticResource HexButton}">
                                    <TextBlock Text="Next page ▶"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                       Foreground="{StaticResource NeonInk2Brush}">
                                <Run Text="Showing "/>
                                <Run Text="{Binding WindowStartHex, Mode=OneWay}"/>
                                <Run Text=" → "/>
                                <Run Text="{Binding WindowEndHex, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding CopyHexCommand}" Style="{StaticResource HexButton}">
                                    <TextBlock Text="Copy hex"/>
                                </Button>
                                <Button Command="{Binding CopyAsciiCommand}" Style="{StaticResource HexButton}">
                                    <TextBlock Text="Copy ASCII"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT: inspector + search results -->
                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource NeonLineBrush}"
                        Background="#7011152E"
                        Visibility="{Binding ShowInspector, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- file info -->
                            <RowDefinition Height="Auto"/>  <!-- inspector -->
                            <RowDefinition Height="Auto"/>  <!-- patch -->
                            <RowDefinition Height="*"/>     <!-- search results -->
                        </Grid.RowDefinitions>

                        <!-- File info card -->
                        <Border Grid.Row="0" Padding="14,12" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource NeonLineBrush}">
                            <StackPanel Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding FileInfo.DetectedType}" FontWeight="SemiBold"
                                           Foreground="{StaticResource NeonAmberBrush}" FontSize="12"/>
                                <TextBlock Margin="0,4,0,0" FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonInk1Brush}">
                                    <Run Text="Size: "/>
                                    <Run Text="{Binding FileInfo.SizeDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonInk2Brush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Magic: "/>
                                    <Run Text="{Binding FileInfo.MagicHex, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonInk3Brush}" TextWrapping="Wrap">
                                    <Run Text="SHA-256: "/>
                                    <Run Text="{Binding FileInfo.Sha256, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Data inspector -->
                        <Border Grid.Row="1" Padding="14,12" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource NeonLineBrush}">
                            <StackPanel>
                                <TextBlock Text="INSPECTOR" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Inspector.OffsetHex}" FontSize="11"
                                           FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonCyanBrush}" Margin="0,0,0,6"/>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="int8" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Int8}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="uint8" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.UInt8}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="int16 (LE)" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Int16Le}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="uint16 (LE)" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.UInt16Le}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="int32 (LE)" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Int32Le}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="uint32 (LE)" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.UInt32Le}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="int64 (LE)" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Int64Le}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="float32" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Float32}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="float64" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Float64}" Style="{StaticResource HexInspectorValue}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="UTF-8" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Utf8}" Style="{StaticResource HexInspectorValue}"
                                               Foreground="{StaticResource NeonMintBrush}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource HexInspectorRow}">
                                    <TextBlock Text="UTF-16 LE" Style="{StaticResource HexInspectorLabel}"/>
                                    <TextBlock Text="{Binding Inspector.Utf16Le}" Style="{StaticResource HexInspectorValue}"
                                               Foreground="{StaticResource NeonMintBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Manual patch -->
                        <Border Grid.Row="2" Padding="14,12" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource NeonLineBrush}">
                            <StackPanel>
                                <TextBlock Text="PATCH AT SELECTION" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource HexTextBox}"
                                         Text="{Binding PatchInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Bytes to write (hex). Same length as current selection — does not extend file."/>
                                <Button Command="{Binding ApplyPatchCommand}" Style="{StaticResource HexButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="Apply patch"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Search results -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="14,10" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource NeonLineBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SEARCH RESULTS" FontWeight="SemiBold" FontSize="10"
                                               Foreground="{StaticResource NeonInk3Brush}"/>
                                    <TextBlock Text="{Binding SearchResults.Count, StringFormat=' · {0}'}"
                                               FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                               Foreground="{StaticResource NeonAmberBrush}"/>
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}"
                                     ItemTemplate="{StaticResource SearchResultTemplate}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="3" Padding="18,8" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource NeonLineBrush}"
                    Background="#88141838">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusBarText}" FontSize="11"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk1Brush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="11"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonCyanBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
