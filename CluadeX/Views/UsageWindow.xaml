<Window x:Class="CluadeX.Views.UsageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:CluadeX.Services"
 Title="{services:Loc usage.title}" Width="1120" Height="860" MinWidth="420" MinHeight="300"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource Dialog.Background}" FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Text.Soft}">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Padding" Value="14,12"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource Dialog.Card.Background}"/><Setter Property="BorderBrush" Value="{DynamicResource Dialog.Card.Border}"/>
  </Style>
  <Style x:Key="Kicker" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
  </Style>
  <Style x:Key="DotPlot" TargetType="ItemsControl">
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ContentPresenter">
    <Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/>
   </Style></Setter.Value></Setter>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
    <Ellipse Width="7" Height="7" Margin="-3.5,-3.5,0,0" Fill="{Binding Color}" ToolTip="{Binding Tip}"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="16" Background="{DynamicResource Dialog.Background}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="8,0,8,12">
   <TextBlock Text="{services:Loc usage.title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
   <TextBlock Text="{Binding RangeLabel}" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer x:Name="UsageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <StackPanel Margin="8,0,8,12">
    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
     <StackPanel>
      <TextBlock Text="{services:Loc usage.rangeLabel}" Style="{StaticResource Kicker}"/>
      <WrapPanel Margin="0,8,0,0">
       <ComboBox x:Name="RangePicker" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" Width="168" Margin="0,0,10,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
        <TextBlock Text="{services:Loc usage.from}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <DatePicker x:Name="FromPicker" SelectedDate="{Binding StartDate}" DisplayDateEnd="{Binding Today, Mode=OneWay}" Width="140"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
        <TextBlock Text="{services:Loc usage.to}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <DatePicker x:Name="ToPicker" SelectedDate="{Binding EndDate}" DisplayDateEnd="{Binding Today, Mode=OneWay}" Width="140"/>
       </StackPanel>
       <Button x:Name="ApplyRangeButton" Content="{services:Loc usage.applyRange}" Command="{Binding ApplyDatesCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock Text="{Binding RangeError}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Danger.Soft}" Visibility="{Binding RangeError, Converter={StaticResource BoolVis}}"/>
      <WrapPanel Margin="0,6,0,6">
       <TextBlock Text="{services:Loc usage.providerLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <Button Content="{services:Loc usage.all}" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,0"/>
       <Button Content="{services:Loc usage.none}" Command="{Binding SelectNoneCommand}" Style="{StaticResource SecondaryButton}" Padding="10,3"/>
       <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" Margin="12,0,0,0"/>
      </WrapPanel>
      <ItemsControl x:Name="ProviderFilters" ItemsSource="{Binding Providers}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource Dialog.Card.Border}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,8">
         <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Center">
          <StackPanel Orientation="Horizontal">
           <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Color}" Margin="5,0,6,0"/>
           <StackPanel>
            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Text.Primary}"/>
            <TextBlock Text="{Binding TotalText}" FontSize="10.5" Foreground="{DynamicResource Text.Muted}"/>
           </StackPanel>
          </StackPanel>
         </CheckBox>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding TokensText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Text.Soft.Secondary}"/>
      <TextBlock Text="{services:Loc usage.coverageNote}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Text.Muted}"/>
     </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Periods}" Margin="0,10,0,0">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
       <TextBlock Text="{Binding Title}" Style="{StaticResource Kicker}"/>
       <TextBlock Text="{Binding Paid}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Without}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource Card}" Margin="0,10,8,0">
     <StackPanel>
      <TextBlock Text="{services:Loc usage.providerChart}" Style="{StaticResource Kicker}"/>
      <ItemsControl ItemsSource="{Binding ProviderLines}" Margin="0,8,0,4">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,14,5">
        <Border Background="{Binding Color}" Width="14" Height="3" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBlock Text="{Binding Label}" FontSize="11"/>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Margin="0,8,0,0">
       <CheckBox Content="{services:Loc usage.cumulative}" IsChecked="{Binding IsCumulative}" Margin="0,0,18,6"/>
       <CheckBox Content="{services:Loc usage.compareSavings}" IsChecked="{Binding ShowSavings}" Margin="0,0,18,6"/>
       <TextBlock Text="{Binding BucketText}" Foreground="{DynamicResource Text.Muted}" FontSize="11" VerticalAlignment="Center"/>
      </WrapPanel>
      <TextBlock Text="{Binding LineSaved}" Foreground="{DynamicResource Status.Success}" FontSize="13" Margin="0,3,0,4"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="0,0,8,0">
        <TextBlock Text="{Binding LineScaleTop}" FontSize="10" Foreground="{DynamicResource Text.Muted}"/>
        <TextBlock Text="$0" FontSize="10" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Bottom"/>
       </Grid>
       <Grid x:Name="PlotArea" Grid.Column="1" SizeChanged="Plot_SizeChanged">
        <Grid IsHitTestVisible="False">
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Border BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Dialog.Card.Border}"/>
         <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Dialog.Card.Border}"/>
         <Border Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Dialog.Card.Border}"/>
        </Grid>
        <Grid Visibility="{Binding ShowSavings, Converter={StaticResource BoolVis}}">
         <Polygon Points="{Binding GapArea}" Fill="{DynamicResource Status.Success.Tint}"/>
         <Polyline Points="{Binding BaseLine}" Stroke="{DynamicResource Text.Muted}" StrokeThickness="2" StrokeDashArray="3,2" ToolTip="{services:Loc usage.lineWithout}"/>
         <Polyline Points="{Binding PaidLine}" Stroke="{DynamicResource Text.Primary}" StrokeThickness="2" ToolTip="{services:Loc usage.selectedTotal}"/>
        </Grid>
        <ItemsControl x:Name="SeriesChart" ItemsSource="{Binding ProviderLines}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Grid>
          <Polyline Points="{Binding Points}" Stroke="{Binding Color}" StrokeThickness="2.5" StrokeLineJoin="Round" ToolTip="{Binding Label}"/>
          <ItemsControl ItemsSource="{Binding Dots}" Style="{StaticResource DotPlot}"/>
         </Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{services:Loc usage.noSelectedData}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
       </Grid>
       <Grid Grid.Row="1" Grid.Column="1" Margin="0,7,0,0">
        <TextBlock Text="{Binding LineFirstDay}" FontSize="10" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding LineLastDay}" FontSize="10" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right"/>
       </Grid>
      </Grid>
      <TextBlock Text="{services:Loc usage.comparisonLegend}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0" Visibility="{Binding ShowSavings, Converter={StaticResource BoolVis}}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,10,8,0"><StackPanel>
     <TextBlock Text="{services:Loc usage.dailyTitle}" Style="{StaticResource Kicker}"/>
     <ItemsControl ItemsSource="{Binding Bars}" Margin="0,12,0,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="1,0" ToolTip="{Binding Tip}" Background="Transparent">
       <Grid Height="150"><StackPanel VerticalAlignment="Bottom">
        <Border Height="{Binding SavedHeight}" Background="{DynamicResource Status.Success.Tint}"/>
        <ItemsControl ItemsSource="{Binding Segments}"><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding Height}" Background="{Binding Color}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel><Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Dialog.Card.Border}"/></Grid>
       <TextBlock Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{DynamicResource Text.Muted}"/>
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel></Border>
    <Border x:Name="MonthlyTotalsCard" Style="{StaticResource Card}" Margin="0,10,8,0"><StackPanel>
     <TextBlock Text="{services:Loc usage.monthlyTitle}" Style="{StaticResource Kicker}"/>
     <TextBlock Text="{services:Loc usage.monthlyDesc}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Text.Muted}"/>
     <ItemsControl x:Name="MonthlyReport" ItemsSource="{Binding MonthlyTotals}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource Dialog.Card.Border}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
       <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"/>
       <WrapPanel Margin="0,8,0,0">
        <StackPanel MinWidth="135" Margin="0,0,16,8"><TextBlock Text="{services:Loc usage.monthApi}" Style="{StaticResource Kicker}"/><TextBlock Text="{Binding Api}" FontSize="17"/></StackPanel>
        <StackPanel MinWidth="135" Margin="0,0,16,8"><TextBlock Text="{services:Loc usage.monthPackages}" Style="{StaticResource Kicker}"/><TextBlock Text="{Binding Packages}" FontSize="17"/></StackPanel>
        <StackPanel MinWidth="135" Margin="0,0,16,8"><TextBlock Text="{services:Loc usage.monthTotal}" Style="{StaticResource Kicker}"/><TextBlock Text="{Binding Total}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Margin="0,0,0,8"><TextBlock Text="{services:Loc usage.monthSaved}" Style="{StaticResource Kicker}"/>
         <TextBlock Text="{Binding Saved}" FontSize="17" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Status.Danger.Soft}"/></DataTrigger></Style.Triggers>
         </Style></TextBlock.Style></TextBlock>
        </StackPanel>
       </WrapPanel>
       <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,10,8,0"><StackPanel>
     <TextBlock Text="{services:Loc usage.byRangeTitle}" Style="{StaticResource Kicker}"/>
     <ItemsControl ItemsSource="{Binding Savings}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="5"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,10,4"/>
       <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Status.Success}"/>
       <Grid Grid.Row="1" Grid.ColumnSpan="2"><Border Background="{DynamicResource Surface.Raised}" CornerRadius="2"/>
        <Border HorizontalAlignment="Left" Background="{DynamicResource Status.Success}" CornerRadius="2" RenderTransformOrigin="0,0.5">
         <Border.Width><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/></Border.Width>
         <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform>
        </Border>
       </Grid>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <Border x:Name="ProviderBillingCard" Style="{StaticResource Card}" Margin="0,10,8,0"><StackPanel>
     <TextBlock Text="{services:Loc usage.billingProvider}" Style="{StaticResource Kicker}"/>
     <ComboBox x:Name="BillingProviderPicker" ItemsSource="{Binding BillingProviders}" SelectedItem="{Binding SelectedBillingProvider}" DisplayMemberPath="Label" Width="220" HorizontalAlignment="Left" Margin="0,8,0,8"/>
     <TextBlock Text="{Binding LegacyCreditText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,8" Visibility="{Binding HasLegacyCredit, Converter={StaticResource BoolVis}}"/>
     <StackPanel Visibility="{Binding IsApiBilling, Converter={StaticResource BoolVis}}">
     <TextBlock Text="{Binding BalanceText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,8,0,0" Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
     <TextBlock Text="{Binding BalanceDetail}" TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0" Foreground="{DynamicResource Text.Muted}"/>
     <TextBlock Text="{services:Loc usage.balanceInput}" FontSize="11" Margin="0,10,0,5"/>
     <WrapPanel>
      <TextBox Text="{Binding BalanceInput, UpdateSourceTrigger=PropertyChanged}" Width="145" Padding="7,5" Margin="0,0,8,5" Background="{DynamicResource Dialog.Input.Background}" BorderBrush="{DynamicResource Dialog.Input.Border}" Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}"/>
      <Button Content="{services:Loc usage.balanceSave}" Command="{Binding SetBalanceCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,8,5"/>
      <Button Content="{services:Loc usage.balanceClear}" Command="{Binding ClearBalanceCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,8,5" Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
      <Button Content="{services:Loc usage.billing}" Command="{Binding OpenBillingCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,8,5" Visibility="{Binding HasBilling, Converter={StaticResource BoolVis}}"/>
     </WrapPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding IsPackageBilling, Converter={StaticResource BoolVis}}">
      <TextBlock Text="{services:Loc usage.packagePrice}" FontSize="12"/>
      <TextBox x:Name="PackagePriceBox" Text="{Binding PackagePriceInput, UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left" Padding="7,5" Margin="0,5,0,8" Background="{DynamicResource Dialog.Input.Background}" Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{services:Loc usage.packageStart}" FontSize="12"/>
      <DatePicker SelectedDate="{Binding PackageStartDate}" DisplayDateEnd="{Binding Today, Mode=OneWay}" Width="150" HorizontalAlignment="Left" Margin="0,5,0,8"/>
      <WrapPanel>
       <Button Content="{services:Loc usage.packageSave}" Command="{Binding SavePackageCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,8,8"/>
       <Button Content="{services:Loc usage.balanceClear}" Command="{Binding ClearPackageCommand}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock Text="{services:Loc usage.packageNote}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"/>
     </StackPanel>
     <TextBlock Text="{Binding BalanceError}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Danger.Soft}" Visibility="{Binding BalanceError, Converter={StaticResource BoolVis}}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,10,8,0"><StackPanel>
     <TextBlock Text="{services:Loc usage.strategyTitle}" Style="{StaticResource Kicker}"/>
     <TextBlock Text="{services:Loc usage.strategyRangeDesc}" TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0" Foreground="{DynamicResource Text.Muted}"/>
     <TextBlock Text="{services:Loc usage.strategyNone}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding HasStrategies, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
     <ItemsControl ItemsSource="{Binding Strategies}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Dialog.Card.Border}" BorderThickness="0,0,0,1" Padding="0,8">
      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,5,0,0">
        <TextBlock Margin="0,0,15,4"><Run Text="{services:Loc usage.strategyRuns}"/><Run Text=": "/><Run Text="{Binding Runs}"/></TextBlock>
        <TextBlock Margin="0,0,15,4"><Run Text="{services:Loc usage.strategySuccess}"/><Run Text=": "/><Run Text="{Binding Success}"/></TextBlock>
        <TextBlock Margin="0,0,15,4"><Run Text="{services:Loc usage.strategyPerRun}"/><Run Text=": "/><Run Text="{Binding CostPerRun}"/></TextBlock>
        <TextBlock Margin="0,0,15,4"><Run Text="{services:Loc usage.strategyTime}"/><Run Text=": "/><Run Text="{Binding TimePerRun}"/></TextBlock>
        <TextBlock Margin="0,0,15,4"><Run Text="{services:Loc usage.strategyTotal}"/><Run Text=": "/><Run Text="{Binding Total}"/></TextBlock>
       </WrapPanel>
      </StackPanel>
     </Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
    <TextBlock Text="{services:Loc usage.note}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,12,8,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
