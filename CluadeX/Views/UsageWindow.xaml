<Window x:Class="CluadeX.Views.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="{services:Loc usage.title}" Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Text.Soft}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Dialog.Card.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Dialog.Card.Border}"/>
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono.Display}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}"
            Background="{DynamicResource Dialog.Background}" Effect="{DynamicResource Shadow.Dialog}">
        <StackPanel Margin="24,20,24,20">

            <!-- ── Header (drag handle) ── -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc usage.title}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc usage.subtitle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Text.Soft.Secondary}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" VerticalAlignment="Top" Cursor="Hand"
                        Click="Close_Click" IsCancel="True" ToolTip="{services:Loc usage.close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="15">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── Provider filter (only when several were used) + the 30 days' tokens ── -->
            <Grid Margin="0,14,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                            Visibility="{Binding HasProviderChoice, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{services:Loc usage.providerLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Label"
                              MinWidth="170" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TokensText}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Soft.Secondary}"/>
            </Grid>

            <!-- ── Today / 7 days / 30 days ── -->
            <ItemsControl ItemsSource="{Binding Periods}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Kicker}"/>
                                <TextBlock Text="{Binding Paid}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Without}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Text.Soft.Secondary}"
                                           Visibility="{Binding HasUse, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding Saved}" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Status.Success}"
                                           Visibility="{Binding HasUse, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Running total, 14 days: paid (glowing) vs without savings (dashed); the green band between = saved ── -->
            <Border Style="{StaticResource Card}" Margin="0,10,8,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc usage.lineTitle}" Style="{StaticResource Kicker}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent.1}" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc usage.legendPaid}" FontSize="11" Margin="5,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Soft.Secondary}"/>
                                <Line X1="0" X2="14" Y1="1.5" Y2="1.5" Stroke="{DynamicResource Text.Muted}" StrokeThickness="2"
                                      StrokeDashArray="2,1.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc usage.lineWithout}" FontSize="11" Margin="5,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Soft.Secondary}"/>
                                <Border Width="12" Height="10" CornerRadius="2" Background="{DynamicResource Status.Success.Tint}"
                                        BorderBrush="{DynamicResource Status.Success.Border}" BorderThickness="1" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc usage.legendSaved}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Soft.Secondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LineSaved}" FontSize="20" FontWeight="Bold" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Status.Success}"/>
                    </Grid>

                    <Grid Margin="0,14,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding LineScaleTop}" FontSize="9.5" FontFamily="{DynamicResource Font.Mono}" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Top"/>
                        <Canvas Grid.Column="1" Width="620" Height="170" ClipToBounds="False">
                            <!-- grid -->
                            <Line X1="0" X2="620" Y1="0" Y2="0" Stroke="{DynamicResource Dialog.Card.Border}" StrokeDashArray="3,4"/>
                            <Line X1="0" X2="620" Y1="56.7" Y2="56.7" Stroke="{DynamicResource Dialog.Card.Border}" StrokeDashArray="3,4"/>
                            <Line X1="0" X2="620" Y1="113.3" Y2="113.3" Stroke="{DynamicResource Dialog.Card.Border}" StrokeDashArray="3,4"/>
                            <Line X1="0" X2="620" Y1="170" Y2="170" Stroke="{DynamicResource Dialog.Card.Border}"/>
                            <!-- under the paid line: accent fading out -->
                            <Polygon Points="{Binding PaidArea}" Fill="{DynamicResource Accent.1}" Opacity="0.3">
                                <Polygon.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Polygon.OpacityMask>
                            </Polygon>
                            <!-- the savings band -->
                            <Polygon Points="{Binding GapArea}" Fill="{DynamicResource Status.Success.Tint}" Opacity="0.85"/>
                            <!-- without savings -->
                            <Polyline Points="{Binding BaseLine}" Stroke="{DynamicResource Text.Muted}" StrokeThickness="2"
                                      StrokeDashArray="3,2" StrokeLineJoin="Round"/>
                            <!-- paid, glowing: a wide soft stroke under the line -->
                            <Polyline Points="{Binding PaidLine}" Stroke="{DynamicResource Accent.1}" StrokeThickness="10"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.22">
                                <Polyline.Effect><BlurEffect Radius="6"/></Polyline.Effect>
                            </Polyline>
                            <Polyline Points="{Binding PaidLine}" Stroke="{DynamicResource Accent.1}" StrokeThickness="3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <!-- dots (hover for the day's totals) -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding BaseDots}" Width="620" Height="170">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="7" Height="7" Margin="-3.5,-3.5,0,0" Fill="{DynamicResource Dialog.Card.Background}"
                                             Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.5" ToolTip="{Binding Tip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding PaidDots}" Width="620" Height="170">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="16" Height="16" Margin="-8,-8,0,0" Background="Transparent" ToolTip="{Binding Tip}" Cursor="Hand">
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent.1}"
                                                 Stroke="{DynamicResource Dialog.Card.Background}" StrokeThickness="2"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LineFirstDay}" FontSize="10" FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding LineLastDay}" FontSize="10" FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 14-day stacked bars: paid at the bottom, saved on top; the whole bar = without savings ── -->
            <Border Style="{StaticResource Card}" Margin="0,10,8,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc usage.chartTitle}" Style="{StaticResource Kicker}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent.1}" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc usage.legendPaid}" FontSize="11" Margin="5,0,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Soft.Secondary}"/>
                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Status.Success.Tint}"
                                    BorderBrush="{DynamicResource Status.Success.Border}" BorderThickness="1" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc usage.legendSaved}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Soft.Secondary}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Bars}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0" ToolTip="{Binding Tip}" Background="Transparent">
                                    <Grid Height="150">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border Height="{Binding SavedHeight}" CornerRadius="3,3,0,0" Background="{DynamicResource Status.Success.Tint}"
                                                    BorderBrush="{DynamicResource Status.Success.Border}" BorderThickness="1,1,1,0"/>
                                            <Border Height="{Binding PaidHeight}" Background="{DynamicResource Accent.1}"/>
                                        </StackPanel>
                                        <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Dialog.Card.Border}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>

                <!-- ── Where the savings came from ── -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{services:Loc usage.byTitle}" Style="{StaticResource Kicker}"/>
                        <ItemsControl ItemsSource="{Binding Savings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Soft}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Status.Success}"/>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource Surface.Raised}" CornerRadius="2"/>
                                            <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Status.Success}"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.Width><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/></Border.Width>
                                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Credit left (estimate: no provider has a balance API) ── -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{services:Loc usage.balanceTitle}" Style="{StaticResource Kicker}"/>
                        <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding BalanceDetail}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Soft.Secondary}"/>
                        <TextBlock Text="{services:Loc usage.balanceInput}" FontSize="11" Margin="0,10,0,4" Foreground="{DynamicResource Text.Muted}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BalanceInput, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12.5"
                                     Background="{DynamicResource Dialog.Input.Background}" BorderBrush="{DynamicResource Dialog.Input.Border}"
                                     Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}"/>
                            <Button Grid.Column="1" Content="{services:Loc usage.balanceSave}" Style="{StaticResource PrimaryButton}"
                                    Padding="12,5" FontSize="12" Margin="6,0,0,0" Command="{Binding SetBalanceCommand}" IsDefault="True"/>
                            <Button Grid.Column="2" Content="{services:Loc usage.balanceClear}" Style="{StaticResource SecondaryButton}"
                                    Padding="10,5" FontSize="12" Margin="6,0,0,0" Command="{Binding ClearBalanceCommand}"
                                    Visibility="{Binding HasBalance, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding BalanceError}" FontSize="11.5" Margin="0,4,0,0" Foreground="{DynamicResource Status.Danger.Soft}"
                                   Visibility="{Binding BalanceError, Converter={StaticResource BoolVis}}"/>
                        <Button Content="{services:Loc usage.billing}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Padding="10,5" FontSize="12" Margin="0,10,0,0" Command="{Binding OpenBillingCommand}"
                                Visibility="{Binding HasBilling, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{services:Loc usage.note}" FontSize="11" TextWrapping="Wrap" Margin="0,12,8,0"
                       Foreground="{DynamicResource Text.Muted}"/>
        </StackPanel>
    </Border>
</Window>
