<UserControl x:Class="CluadeX.Views.AgentGraph.AgentGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:views="clr-namespace:CluadeX.Views"
             Focusable="False">
    <!-- The agent map as a node canvas (owner 2026-11-07: "ทำเป็นโหนด ซูมเข้าออกได้ ลากวาง"): the main agent and every
         sub-agent are nodes joined by curves (Services/Agents/AgentGraphMath.cs); the wheel zooms toward the cursor,
         dragging the background pans, dragging a node moves it, a click opens that agent's own window
         (AgentDetailWindow). Nodes and edges are made in code (AgentGraphView.xaml.cs) from the two templates below.
         Every endless storyboard is a Motion loop: it runs only while its agent works and the canvas is on screen. -->
    <UserControl.Resources>
        <!-- the main agent: a halo breathes round it while any sub-agent works (DataContext = the map's ChatMessage) -->
        <DataTemplate x:Key="RootCard">
            <Grid Width="168" Height="42">
                <Grid IsHitTestVisible="False">
                    <Border CornerRadius="22" Margin="-9" Background="{DynamicResource Accent.1.Glow}" Opacity="0.35"/>
                    <Border CornerRadius="18" Margin="-4" Background="{DynamicResource Accent.1.Glow}" Opacity="0.6"/>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- RootBreathe: begun once by Motion while LoopOn and on screen, removed when either ends -->
                            <Setter Property="views:Motion.Loop">
                                <Setter.Value>
                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="24">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.55" Duration="0:0:1.4" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0.3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AgentMapRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AgentMapRunning}" Value="True">
                                    <Setter Property="views:Motion.LoopOn" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <Border CornerRadius="14" Background="{DynamicResource Surface.Card.Flat}">
                    <Border CornerRadius="14" Padding="14,6" BorderThickness="1.5"
                            Background="{DynamicResource Accent.1.Tint.Faint}" BorderBrush="{DynamicResource Accent.1}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc agentmap.main}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- one sub-agent (DataContext = its AgentNode): the card the map always had, at a fixed size so the layout is exact -->
        <DataTemplate x:Key="NodeCard">
            <Grid Width="232" Height="118">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="NodeArrive">
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(views:Motion.ShiftY)" From="-10" To="0" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding JustFailed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="NodeShake">
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(views:Motion.ShiftX)">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-6"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="5"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-3"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="2"/>
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.38" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- working: its rim glows in the theme's gradient, breathing -->
                <Border CornerRadius="11" Margin="-2.5" BorderThickness="2" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource Accent.Gradient}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- NodeGlow: begun once by Motion while LoopOn and on screen, removed when either ends -->
                            <Setter Property="views:Motion.Loop">
                                <Setter.Value>
                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="24">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="0.9" Duration="0:0:1.2" AutoReverse="True">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="views:Motion.LoopOn" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border x:Name="Card" CornerRadius="9" Padding="10,8" BorderThickness="1.5" ToolTip="{services:Loc agentgraph.openTip}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Surface.Card.Flat}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Success.Border}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Border}"/>
                                    <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                    <!-- finished on screen: a green wash that comes and goes, once -->
                    <Border Margin="-10,-8" CornerRadius="8" Background="{DynamicResource Status.Success.Tint}" Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JustDone}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="NodeWash">
                                                <Storyboard FillBehavior="Stop">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- avatar: what kind of agent (explore = magnifier, general = wrench, a specialist = star)
                             on its colour; a ring arc turns round it while it works; the end as a badge -->
                        <Grid Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Accent.1.Tint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KindClass}" Value="explore">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Info.Tint}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindClass}" Value="specialist">
                                                <Setter Property="Fill" Value="{DynamicResource Accent.3.Tint}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding KindGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KindClass}" Value="explore">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Info}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KindClass}" Value="specialist">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent.3}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse Margin="-3" StrokeThickness="2" StrokeDashArray="7 100" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource Accent.1}" IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <!-- NodeSpin: begun once by Motion while LoopOn and on screen, removed when either ends -->
                                        <Setter Property="views:Motion.Loop">
                                            <Setter.Value>
                                                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                    <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Spin)"
                                                                     From="0" To="360" Duration="0:0:1.2"/>
                                                </Storyboard>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="views:Motion.LoopOn" Value="True"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <!-- done: a green check badge that pops in when it finishes on screen -->
                            <Border Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-3,-3" Background="{DynamicResource Status.Success}" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Surface.Card.Flat}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="6.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.OnStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding JustDone}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="NodePop">
                                                        <Storyboard FillBehavior="Stop">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(views:Motion.Scale)">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.45"/>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="0.9"/>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="1"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <!-- failed / stopped: a red cross badge -->
                            <Border Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-3,-3" Background="{DynamicResource Status.Danger}" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Surface.Card.Flat}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="6" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.OnStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="2" CornerRadius="6" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource Surface.Raised}">
                            <TextBlock Text="{Binding Kind}" FontSize="9.5" FontFamily="{DynamicResource Font.Mono}"
                                       Foreground="{DynamicResource Text.Muted}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Task}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="30"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Secondary}"/>
                    <!-- what it does now; how it ended — an error reads as one (danger), and wraps so it can be read -->
                    <TextBlock Text="{Binding Action}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Font.Mono}" ToolTip="{Binding Action}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="MaxHeight" Value="42"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatsText}" FontSize="9.5" Margin="0,3,0,0"
                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                    <!-- its foot: a light running along it while it works; then a line in the colour of its end -->
                    <Grid Height="2" Margin="0,7,0,0">
                        <Border CornerRadius="1" Background="{DynamicResource State.Fill.Faint}"/>
                        <Border CornerRadius="1" Opacity="0.7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Rectangle RadiusX="1" RadiusY="1" Fill="{DynamicResource Accent.Gradient}" IsHitTestVisible="False">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00000000" Offset="0.25"/>
                                    <GradientStop Color="#FF000000" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="0.75"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <!-- NodeSweep: begun once by Motion while LoopOn and on screen, removed when either ends -->
                                    <Setter Property="views:Motion.Loop">
                                        <Setter.Value>
                                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Sweep)"
                                                                 From="-0.8" To="0.8" Duration="0:0:1.4">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="views:Motion.LoopOn" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="CanvasButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="7,4" MinWidth="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Accent.1.Border.Soft}"
            Background="{DynamicResource Surface.Card.Flat}">
        <Grid>
            <!-- the canvas: a dot grid that moves and scales with the view, the edges under the nodes -->
            <Border x:Name="Viewport" Background="Transparent" Cursor="SizeAll" ClipToBounds="True" Margin="1">
                <Canvas x:Name="World">
                    <Canvas x:Name="EdgeLayer" IsHitTestVisible="False"/>
                    <Canvas x:Name="NodeLayer"/>
                </Canvas>
            </Border>

            <!-- zoom bar, top right -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" CornerRadius="8" Padding="2"
                    Background="{DynamicResource Surface.Raised}" BorderThickness="1" BorderBrush="{DynamicResource Accent.1.Border.Soft}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource CanvasButton}" Click="ZoomOut_Click" ToolTip="{services:Loc agentgraph.zoomOut}">
                        <TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="38" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="10.5" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource CanvasButton}" Click="ZoomIn_Click" ToolTip="{services:Loc agentgraph.zoomIn}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Border Width="1" Margin="3,4" Background="{DynamicResource Accent.1.Border.Soft}"/>
                    <Button x:Name="FitButton" Style="{StaticResource CanvasButton}" Click="Fit_Click" ToolTip="{services:Loc agentgraph.fit}">
                        <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="ResetButton" Style="{StaticResource CanvasButton}" Click="Reset_Click" ToolTip="{services:Loc agentgraph.reset}">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- how to use it, bottom left (quiet) -->
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,7" IsHitTestVisible="False"
                       Text="{services:Loc agentgraph.hint}" FontSize="10" Foreground="{DynamicResource Text.Muted}" Opacity="0.85"/>
        </Grid>
    </Border>
</UserControl>
