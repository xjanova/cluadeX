<Window x:Class="CluadeX.Views.AgentGraph.AgentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        xmlns:views="clr-namespace:CluadeX.Views"
        Title="{Binding Title}" Width="520" Height="640" MinWidth="380" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" ShowInTaskbar="True" ShowActivated="True"
        FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Text.Soft}">
    <!-- One sub-agent, live (AgentDetailViewModel): opened from its node on the agent map, beside the chat, never modal. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono.Display}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
        </Style>
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}"
            Background="{DynamicResource Dialog.Background}" Effect="{DynamicResource Shadow.Dialog}">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (drag handle): kind avatar, label, state pill, pin, close -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" DataContext="{Binding Node}">
                    <Ellipse Style="{StaticResource AgentAvatar.Disc}"/>
                    <TextBlock Text="{Binding AvatarGlyph, NotifyOnTargetUpdated=True}" FontSize="15" Style="{StaticResource AgentAvatar.Glyph}"/>
                    <!-- a ring turns round it while it works -->
                    <Ellipse Margin="-3" StrokeThickness="2" StrokeDashArray="9 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                             IsHitTestVisible="False">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource AgentAvatar.Ring}">
                                <Setter Property="views:Motion.Loop">
                                    <Setter.Value>
                                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                            <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Spin)" From="0" To="360" Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="views:Motion.LoopOn" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Node.Label}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Surface.Raised}">
                            <TextBlock Text="{Binding Node.Kind}" FontSize="10" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Accent.2.Tint}"
                                DataContext="{Binding Node}" Visibility="{Binding HasTier, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource AgentTier.Text}"/>
                        </Border>
                    </StackPanel>
                    <Border x:Name="StatePill" HorizontalAlignment="Left" CornerRadius="8" Padding="8,1" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Accent.1.Tint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Node.IsDone}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Status.Success.Tint}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Node.IsFailed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StateText" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Node.IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Node.IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <ToggleButton Grid.Column="2" x:Name="PinButton" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,4,0"
                              Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Cursor="Hand"
                              Checked="Pin_Changed" Unchecked="Pin_Changed" ToolTip="{services:Loc agentdetail.pin}"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Muted}"/>
                <Button Grid.Column="3" Width="30" Height="30" VerticalAlignment="Top" Click="Close_Click"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Cursor="Hand" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="0" ToolTip="{services:Loc agentdetail.close}"/>
            </Grid>

            <!-- Facts: model · time · tools · cost; the task; what it runs now (or how it ended) -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <WrapPanel>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel>
                            <TextBlock Text="{services:Loc agentdetail.model}" Style="{StaticResource ChipLabel}"/>
                            <TextBlock Text="{Binding ModelText}" Style="{StaticResource ChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel>
                            <TextBlock Text="{services:Loc agentdetail.time}" Style="{StaticResource ChipLabel}"/>
                            <TextBlock x:Name="ElapsedValue" Text="{Binding ElapsedText}" Style="{StaticResource ChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel>
                            <TextBlock Text="{services:Loc agentdetail.tools}" Style="{StaticResource ChipLabel}"/>
                            <TextBlock Text="{Binding ToolsText}" Style="{StaticResource ChipValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel>
                            <TextBlock Text="{services:Loc agentdetail.cost}" Style="{StaticResource ChipLabel}"/>
                            <TextBlock Text="{Binding CostText}" Style="{StaticResource ChipValue}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <TextBlock Text="{services:Loc agentdetail.task}" Style="{StaticResource Kicker}" Margin="2,6,0,4"/>
                <TextBox Text="{Binding Node.Task, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                         Background="Transparent" FontSize="12.5" Foreground="{DynamicResource Text.Primary}" MaxHeight="90"
                         VerticalScrollBarVisibility="Auto"/>
                <Border CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Accent.1.Tint.Faint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Node.IsDone}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Status.Success.Tint}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Node.IsFailed}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding NowLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}"/>
                        <TextBox x:Name="NowText" Text="{Binding Node.Action, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Padding="0" Margin="0,2,0,0" Background="Transparent" FontSize="12" FontFamily="{DynamicResource Font.Mono}"
                                 Foreground="{DynamicResource Text.Primary}" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <!-- steer it: stop this one agent (never the chat's run), or write to it — it reads that at its next step.
                     Disabled with the reason when it ended, is stopping, or is a CLI's / the dispatcher's own agent. -->
                <Border x:Name="SteerBox" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Background="{DynamicResource State.Fill.Faint}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12.5"
                                     VerticalContentAlignment="Center" IsEnabled="{Binding CanSend}" ToolTip="{services:Loc agentdetail.send.tip}"
                                     AcceptsReturn="False" MaxLength="4000"
                                     Background="{DynamicResource Input.Background}" Foreground="{DynamicResource Text.Primary}"
                                     BorderBrush="{DynamicResource Border.Subtle}" CaretBrush="{DynamicResource Accent.1}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{services:Loc agentdetail.send.placeholder}" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                       IsHitTestVisible="False" Foreground="{DynamicResource Text.Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="SendButton" Grid.Column="1" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="6,0,0,0" Padding="12,5" Content="{services:Loc agentdetail.send}"/>
                            <!-- a cheap/mid agent can be moved up to the run's own model from its next step -->
                            <Button x:Name="UpgradeButton" Grid.Column="2" Command="{Binding UpgradeCommand}" Style="{StaticResource SecondaryButton}"
                                    Margin="6,0,0,0" Padding="10,5" ToolTip="{services:Loc agentdetail.upgrade.tip}"
                                    Visibility="{Binding CanUpgrade, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{services:Loc agentdetail.upgrade}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="3" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"
                                    Margin="6,0,0,0" Padding="10,5" ToolTip="{services:Loc agentdetail.stop.tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{services:Loc agentdetail.stop}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ControlNoteText" Text="{Binding ControlNote}" Margin="1,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Muted}" Visibility="{Binding HasControlNote, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding SendError}" Margin="1,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Status.Danger}" Visibility="{Binding HasSendError, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Activity.Count}" Style="{StaticResource Kicker}" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{services:Loc agentdetail.steps}" Style="{StaticResource Kicker}"/>
                </DockPanel>
            </StackPanel>

            <!-- Every step: a status mark, what it ran, how long; a click opens its result -->
            <Grid Grid.Row="2">
                <TextBlock Text="{services:Loc agentdetail.waiting}" FontSize="12" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                           Visibility="{Binding WaitingFirstStep, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{services:Loc agentdetail.notKept}" FontSize="12" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                           Visibility="{Binding ActivityNotKept, Converter={StaticResource Vis}}"/>
                <ScrollViewer x:Name="StepScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasActivity, Converter={StaticResource Vis}}">
                    <ItemsControl x:Name="StepList" ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5" CornerRadius="8" Padding="9,7" Background="{DynamicResource State.Fill.Faint}"
                                        Cursor="Hand" MouseLeftButtonUp="Step_Click">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <!-- running: a small turning arc -->
                                                <Ellipse StrokeThickness="2" StrokeDashArray="4 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                                         Stroke="{DynamicResource Accent.1}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="views:Motion.Loop">
                                                                <Setter.Value>
                                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Spin)" From="0" To="360" Duration="0:0:1"/>
                                                                    </Storyboard>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="views:Motion.LoopOn" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Status.Success}" Visibility="{Binding IsOk, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Status.Danger}" Visibility="{Binding IsError, Converter={StaticResource Vis}}"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" FontFamily="{DynamicResource Font.Mono}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10.5" Margin="8,1,0,0"
                                                       FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                                        </Grid>
                                        <!-- the result's first line; the whole of it once opened -->
                                        <TextBlock Text="{Binding ResultPreview}" Margin="24,3,0,0" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="24,5,0,0" Padding="7,5"
                                                 MaxHeight="260" VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                                 Background="{DynamicResource Surface.Card.Flat}" BorderThickness="0" Foreground="{DynamicResource Text.Primary}"
                                                 Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
