<UserControl x:Class="CluadeX.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>

        <!-- Badge styles for permission actions -->
        <Style x:Key="AllowBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DenyBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AskBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="700">

            <!-- Page Title -->
            <TextBlock Text="{services:Loc perms.title}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,0,0,4"/>
            <TextBlock Text="{services:Loc perms.subtitle}"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="13" Margin="0,0,0,8"/>

            <!-- ═══════ RULES LIST ═══════ -->
            <TextBlock Text="{services:Loc perms.activeRules}" Style="{StaticResource SectionTitle}" Margin="0,4,0,12"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule}"
                             Background="Transparent"
                             BorderThickness="0"
                             MinHeight="60"
                             MaxHeight="350"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Sunken}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Sunken}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Badge -->
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Action}" Value="Allow">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Action}" Value="Deny">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ActionLabel}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource Badge.Rule.Foreground}"/>
                                    </Border>

                                    <!-- Scope -->
                                    <TextBlock Grid.Column="1" Text="{Binding ScopeLabel}" FontSize="12"
                                               Foreground="{DynamicResource Text.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontFamily="{DynamicResource Font.Mono.Display}"/>

                                    <!-- Pattern -->
                                    <TextBlock Grid.Column="2" Text="{Binding Pattern}" FontSize="13"
                                               Foreground="{DynamicResource Text.Primary}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Text="{services:Loc permsm.noRules}"
                               Foreground="{DynamicResource Text.Muted}" FontSize="12"
                               Margin="4,8,0,4" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Remove button -->
                    <Button Content="{services:Loc perms.removeSelected}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RemoveRuleCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════ ADD RULE ═══════ -->
            <TextBlock Text="{services:Loc perms.addRule}" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Pattern -->
                    <TextBlock Text="{services:Loc perms.pattern}" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="{services:Loc perms.patternDesc}"
                               Style="{StaticResource SettingDesc}"/>
                    <TextBox Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                    <!-- Scope -->
                    <TextBlock Text="{services:Loc perms.scope}" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="{services:Loc permsm.scopeDesc}"
                               Style="{StaticResource SettingDesc}"/>
                    <ComboBox ItemsSource="{Binding ScopeOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding NewScope}"
                              Style="{StaticResource ModernComboBox}"
                              Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{services:Loc perms.addAllow}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddAllowCommand}" Margin="0,0,12,0"/>
                        <Button Content="{services:Loc perms.addDeny}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddDenyCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════ ACTIONS ═══════ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,24">
                <Button Content="{services:Loc perms.save}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                <Button Content="{services:Loc perms.refresh}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
