<UserControl x:Class="CluadeX.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:models="clr-namespace:CluadeX.Models"
             xmlns:helpers="clr-namespace:CluadeX.Helpers"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:agentgraph="clr-namespace:CluadeX.Views.AgentGraph"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             views:CharacterLook.Show="{DynamicResource Fx.Flourish}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <views:ThumbnailSourceConverter x:Key="ThumbSource"/>
        <views:FileNameOfConverter x:Key="FileNameOf"/>
        <views:FileGlyphConverter x:Key="FileGlyph"/>
        <conv:RoleToBrushConverter x:Key="RoleBrush"/>
        <conv:RoleToBackgroundConverter x:Key="RoleBg"/>
        <conv:RoleToLabelConverter x:Key="RoleLabel"/>
        <conv:RoleToAlignmentConverter x:Key="RoleAlign"/>
        <conv:RoleToMarginConverter x:Key="RoleMargin"/>
        <conv:RoleToCornerRadiusConverter x:Key="RoleCorner"/>
        <conv:RoleToPaddingConverter x:Key="RolePadding"/>
        <conv:InverseBoolConverter x:Key="InvertBool"/>
        <conv:BoolToStringConverter x:Key="BoolStr"/>
        <conv:ContextUsageBrushConverter x:Key="CtxBrush"/>
        <conv:ContextLedGateConverter x:Key="CtxLedGate"/>

        <!-- ═══ Who is talking (ChatCharacter): her round portrait and her name on a chip of her colour. The boxes she
             opens (question, options, permission) and the composer wear her colour where views:CharacterLook.Show is
             Visible — the theme's Fx.Flourish, set on this view's root; Classic keeps every box in its own look. ═══ -->
        <DataTemplate x:Key="CxCharTag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="30" Height="30" VerticalAlignment="Center" Panel.ZIndex="1">
                    <Ellipse Fill="{DynamicResource Bg.Elevated}"/>
                    <!-- her face fills the circle (ChatCharacter.FaceBrush: a square around her face in her picture) -->
                    <Ellipse Stroke="{Binding AccentBrush}" StrokeThickness="2" Fill="{Binding FaceBrush}"/>
                </Grid>
                <Border Background="{Binding AccentBrush}" CornerRadius="9" Padding="12,2,10,3" Margin="-8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{Binding OnAccentBrush}" FontSize="11.5" FontWeight="SemiBold"
                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ The AI's avatar beside her words (AiAvatar). Her face and colour where the theme shows the girls
             (views:CharacterLook.Show), CluadeX's logo otherwise. Shown on a reply and on the row the agent is working
             in: Typing while a tool runs or the reply streams, Reading while she waits on the model (thinking). ═══ -->
        <Style x:Key="CxAiAvatar" TargetType="views:AiAvatar">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Mode" Value="Idle"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                    <Setter Property="Face" Value="{Binding DataContext.ActiveCharacter.FaceBrush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                    <Setter Property="Accent" Value="{Binding DataContext.ActiveCharacter.AccentBrush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}"/>
                        <Condition Binding="{Binding IsStreaming}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Mode" Value="Typing"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Mode" Value="Typing"/>
                </DataTrigger>
                <!-- the live status pill: a tool's line = at the laptop; no tool (waiting on the model) = over the book -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                        <Condition Binding="{Binding IsStreaming}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Mode" Value="Typing"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                        <Condition Binding="{Binding IsStreaming}" Value="True"/>
                        <Condition Binding="{Binding ToolKind}" Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Mode" Value="Reading"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The box's main button (Answer / Allow): a fill of her colour, text in whichever of ink or white reads on it -->
        <Style x:Key="CxCharPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                    <Setter Property="Background" Value="{Binding Character.AccentBrush}"/>
                    <Setter Property="Foreground" Value="{Binding Character.OnAccentBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="RenderTransform">
                                            <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An ask_user option: a pill. Its DataContext is the option text; the question is the ItemsControl's. -->
        <Style x:Key="CxCharPill" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Surface.Chip}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource State.Hover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- her look: hovering fills the pill with her colour -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:CharacterLook.Show" Value="Visible"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="pill" Property="Background" Value="{Binding DataContext.Character.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                <Setter Property="Foreground" Value="{Binding DataContext.Character.OnAccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                    <Setter Property="Background" Value="{Binding DataContext.Character.TintBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    <Setter Property="BorderBrush" Value="{Binding DataContext.Character.AccentBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Colours and fonts: every one is a theme token ({DynamicResource …}, Resources/Themes/Tokens.md), so
             this view follows a theme switch live. The old "neon retheme" block that redefined the Catppuccin keys
             here is gone — never re-add a colour key to these resources: a DynamicResource lookup finds a local
             key before the theme's. -->

        <!-- ═══ Reusable Pulse Animation Style ═══ -->
        <Style x:Key="PulseDot" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseAnim">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                    From="0.3" To="1.0" Duration="0:0:0.4" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseAnim"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ New chat page (ChatViewModel.Starters) ═══ -->
        <!-- Its sizes: ChatView.xaml.cs swaps in the compact ones on NewChatPage when the chat is narrow (docked in the editor). -->
        <sys:Double x:Key="Starter.Tile.Width">134</sys:Double>
        <sys:Double x:Key="Starter.Tile.Height">98</sys:Double>
        <sys:Double x:Key="Starter.Title.Size">30</sys:Double>
        <!-- A starter's icon in its tone (StarterTemplate.Tone): theme colours only, so every theme paints its own. -->
        <Style x:Key="StarterGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="2"><Setter Property="Foreground" Value="{DynamicResource Accent.2}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="3"><Setter Property="Foreground" Value="{DynamicResource Accent.3}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="4"><Setter Property="Foreground" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="5"><Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="6"><Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="7"><Setter Property="Foreground" Value="{DynamicResource Status.Info}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A tile: the card lights its edge and glows on hover (Fx.Card.Glow: none in Classic). No animation. -->
        <Style x:Key="StarterTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="{DynamicResource Starter.Tile.Width}"/>
            <Setter Property="Height" Value="{DynamicResource Starter.Tile.Height}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="14" BorderThickness="1"
                                Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Default}">
                            <Border x:Name="Shine" CornerRadius="13" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter TargetName="Tile" Property="Effect" Value="{DynamicResource Fx.Card.Glow}"/>
                                <Setter TargetName="Shine" Property="Background" Value="{DynamicResource State.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Background" Value="{DynamicResource State.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A project in the starter's question. -->
        <Style x:Key="StarterProjectRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="10" BorderThickness="1" Padding="12,8"
                                Background="{DynamicResource State.Fill.Faint}" BorderBrush="{DynamicResource Border.Subtle}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource State.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Elevated}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- The side panel moves here, under the composer, when the chat is too narrow to keep it beside (ChatView.xaml.cs) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ THE CHAT'S REFERENCE (CX-8cf58c2a), pinned above the messages ═══
             Owner 2026-11-09: a copyable id per chat, so the owner, the team and the AI can say which chat they mean. Row 0 of
             its own (a slim strip), not an overlay on the messages: it never moves with the scroll and never sits under the
             Ctrl+F bar or the floating plan card (both float over the top of row 1). Hidden on the new-chat page (no rows yet).
             A click copies it (ChatView.xaml.cs ChatRefChip_Click); a drag over the text selects it instead. -->
        <Grid x:Name="ChatRefBar" Grid.Row="0" MaxWidth="1000" Margin="24,6,24,0"
              Visibility="{Binding Messages.Count, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
            <Border x:Name="ChatRefChip" HorizontalAlignment="Right" CornerRadius="10" BorderThickness="1" Padding="9,1,2,1"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource State.Fill.Faint}" Cursor="Hand"
                    ToolTip="{services:Loc chat.ref.tip}" AutomationProperties.AutomationId="CxChat.RefChip"
                    AutomationProperties.Name="{Binding CurrentChatRef}"
                    Visibility="{Binding CurrentChatRef, Converter={StaticResource BoolVis}}"
                    PreviewMouseLeftButtonUp="ChatRefChip_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="#" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="ChatRefText" Text="{Binding CurrentChatRef, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" VerticalAlignment="Center" Cursor="Hand"
                             Foreground="{DynamicResource Text.Secondary}" SelectionBrush="{DynamicResource Accent.1}"
                             Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.AutomationId="CxChat.RefText">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="{services:Loc chat.ref.copied}" FontSize="11" Foreground="{DynamicResource Status.Success}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding ChatRefCopied, Converter={StaticResource BoolVis}}"/>
                    <Button x:Name="ChatRefCopyButton" Width="22" Height="20" FontSize="11" Margin="3,0,0,0"
                            Command="{Binding CopyChatRefCommand}" ToolTip="{services:Loc chat.ref.copyTip}"
                            AutomationProperties.AutomationId="CxChat.RefCopy">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE8C8;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChatRefCopied}" Value="True">
                                        <Setter Property="Content" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ IN-CHAT SEARCH BAR (Ctrl+F) ═══ -->
        <Border Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="10"
                Background="{DynamicResource Bg.Panel}"
                Padding="12,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Surface.Sunken}"
                Visibility="{Binding IsChatSearchVisible, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource Text.Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="ChatSearchBox"
                         Text="{Binding ChatSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource GlowTextBox}"
                         FontSize="13" FontFamily="{DynamicResource Font.Mono}"
                         Padding="8,4" Height="28"/>
                <TextBlock Grid.Column="2"
                           Foreground="{DynamicResource Text.Muted}"
                           FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                           VerticalAlignment="Center" Margin="8,0">
                    <Run Text="{Binding SearchMatchCount, Mode=OneWay}"/><Run Text="{services:Loc chat.search.matchesSuffix}"/>
                </TextBlock>
                <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource IconButton}" FontSize="10" Padding="4,4"
                        Command="{Binding CloseChatSearchCommand}"
                        ToolTip="{services:Loc chat.closeSearchTip}"/>
            </Grid>
        </Border>

        <!-- ═══ NEW CHAT BACKDROP: every girl, faint, behind the empty chat (Views/GirlsBackdrop). Classic hides it. ═══ -->
        <Border Grid.Row="1" IsHitTestVisible="False" Visibility="{DynamicResource Fx.Flourish}">
            <views:GirlsBackdrop x:Name="NewChatBackdrop" Opacity="0.2"
                                 Visibility="{Binding Messages.Count, Converter={StaticResource BoolVis}, ConverterParameter=Invert, FallbackValue=Visible}"/>
        </Border>

        <!-- ═══ CHAT MESSAGES AREA (Virtualized) ═══ -->
        <Grid Grid.Row="1" Background="Transparent">
                <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}" Margin="0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         SelectionMode="Single"
                         HorizontalContentAlignment="Stretch">
                    <!-- Room above the first message for the branch chips, which always show. The plan card floats over the
                         chat and comes and goes, so it keeps no room (a padding that followed it would jolt the list each time). -->
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Padding" Value="0,12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStickyBranches}" Value="True">
                                    <Setter Property="Padding" Value="0,64,0,12"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <!-- Use slim scrollbar style for the ListBox's internal ScrollViewer -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              CanContentScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- ═══ "Steps" off: the transcript is the conversation, not the log ═══
                                     Collapsing the CONTAINER (not the content) is what makes the row take
                                     zero height — a hidden bubble inside a live ListBoxItem still leaves
                                     its margin behind and the chat reads as full of blank gaps.

                                     Five deliberate exemptions, checked as extra Conditions below: a
                                     FAILED tool, a tool carrying a file DIFF, a tool that returned an IMAGE
                                     (what the agent looked at), permission requests, and the LIVE balloon
                                     (IsLive: the work row the running call folds into — once background calls
                                     fold into one row, no "⏵ Running…" line of its own is added, so hiding
                                     this row left the chat silent for minutes; owner 2026-10-20: "ไม่แสดง
                                     อะไรให้รู้ว่ากำลังทำอะไรอยู่"). It folds away again when the run moves on.
                                     Those are things the user has to decide or verify; hiding them would
                                     be the UI concealing its own state, which is the bug this whole
                                     session has been about. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}"/>
                                        <Condition Binding="{Binding DataContext.ShowAgentInternals, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                        <Condition Binding="{Binding HasError}" Value="False"/>
                                        <Condition Binding="{Binding HasDiff}" Value="False"/>
                                        <Condition Binding="{Binding ThumbnailPath, Converter={StaticResource BoolVis}}" Value="Collapsed"/>
                                        <Condition Binding="{Binding IsLive}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                                <!-- A line the agent wrote before its next call lives inside the running balloon now -->
                                <DataTrigger Binding="{Binding FoldedIntoBalloon}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- A LIVE status row (the "⏳ waiting" / "⏵ Reading…" line, IsStreaming) stays
                                     visible with Steps off — it is the only sign the agent is working. Finished
                                     status rows are internals and collapse. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                                        <Condition Binding="{Binding DataContext.ShowAgentInternals, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                        <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                                <!-- A finished "⏵ Reading main.gd" line of a TOOL folds away even with Steps on: the tool's
                                     own row right after it says the same, with the result and the time. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                                        <Condition Binding="{Binding IsStreaming}" Value="False"/>
                                        <Condition Binding="{Binding ToolKind, Converter={StaticResource BoolVis}}" Value="Visible"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.Thinking}"/>
                                        <Condition Binding="{Binding DataContext.ShowAgentInternals, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Two rows: the collapsible thinking block sits ABOVE the row's content. Row 1 holds
                                 exactly one of the role-specific bodies below — each is Visible for its own role
                                 only. (The grid had no rows and the normal bubble was hidden only for AgentStatus,
                                 so on a permission prompt it was drawn on top with an opaque background and took
                                 every click meant for Allow / Deny: no "Ask" could be answered with the mouse.) -->
                            <!-- The reading column: at most 1000 px wide, centred (Stretch + MaxWidth centres in WPF). -->
                            <Grid Margin="24,1,24,1" MaxWidth="1000"
                                  MouseEnter="MessageBubble_MouseEnter"
                                  MouseLeave="MessageBubble_MouseLeave">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ═══ Thinking Block (collapsible) ═══ -->
                                <Border Grid.Row="0" HorizontalAlignment="Left"
                                        Margin="20,2,40,2"
                                        Background="{DynamicResource State.Fill.Faint}"
                                        CornerRadius="8" Padding="10,4"
                                        Visibility="{Binding HasThinking, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Cursor="Hand"
                                                    MouseLeftButtonDown="ThinkingHeader_Click">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{DynamicResource Accent.2}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc chat.thinkingToggle}" FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource Accent.2}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE76C;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThinkingExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#xE76B;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border MaxHeight="200" Margin="0,4,0,0"
                                                Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolVis}}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding ThinkingContent}"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           FontSize="11" FontStyle="Italic"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ ask_user: the agent's question, its options and a free answer — a card with a girl
                                     standing beside it (a random one per question, Assets\Girls). It glides in; the girl
                                     sways gently while the question waits and leaves once it is answered. ═══ -->
                                <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="12,10,40,6">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Question}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="14"/>
                                    </Grid.RenderTransform>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.55">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The girl: bottom-aligned with the card, leaning in over its left edge (not in a theme
                                         whose Fx.Flourish is Collapsed — Classic) -->
                                    <Grid Visibility="{DynamicResource Fx.Flourish}" Panel.ZIndex="2" VerticalAlignment="Bottom">
                                    <Image views:AmbientAnimation.WhileVisible="True" Source="{Binding QuestionGirlImage}" Height="210" VerticalAlignment="Bottom" Margin="0,-18,-16,-6"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Panel.ZIndex="2"
                                           RenderTransformOrigin="0.5,1">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QuestionAnswered}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding QuestionGirlImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                        <Image.Effect>
                                            <DropShadowEffect Color="{Binding QuestionGirlGlow}" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                                        </Image.Effect>
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="-1.2"/>
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard x:Name="AmbientChat1">
                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                                         From="-1.2" To="1.2" Duration="0:0:2.6">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    </Grid>

                                    <Border Grid.Column="1" CornerRadius="14" Padding="16,12,16,10"
                                            Background="{DynamicResource Bg.Elevated}" MinWidth="280"
                                            AutomationProperties.AutomationId="CxGuard.QuestionCard">
                                        <!-- the theme's look; with the flourishes on (not Classic), the look of the girl who asks -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                <Setter Property="Effect" Value="{DynamicResource Fx.Card.Glow}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                        <Setter Property="BorderBrush" Value="{Binding Character.AccentBrush}"/>
                                                        <Setter Property="Effect" Value="{Binding Character.GlowEffect}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- a soft tint over the card's surface: the theme accent, or her colour washed from her corner -->
                                            <Border CornerRadius="12" Margin="-15,-11,-15,-9" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.1}"/>
                                                        <Setter Property="Opacity" Value="0.07"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                                                                <Setter Property="Background" Value="{Binding Character.WashBrush}"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel>
                                                <!-- who asks: her portrait and name (not in Classic) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{DynamicResource Fx.Flourish}"
                                                            AutomationProperties.AutomationId="CxGuard.QuestionWho">
                                                    <ContentControl Content="{Binding Character}" ContentTemplate="{StaticResource CxCharTag}" Focusable="False"/>
                                                    <TextBlock Text="{services:Loc chat.who.asks}" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <!-- several questions on one card: which step is on screen (owner 2026-11-06: ย้อนกลับหรือเดินหน้าได้) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" AutomationProperties.AutomationId="CxGuard.QuestionStepBar"
                                                            Visibility="{Binding ShowsStepBar, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{services:Loc chat.ask.step}" Foreground="{DynamicResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource Accent.1}" FontSize="11.5" FontWeight="SemiBold"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{services:Loc chat.ask.review}" Foreground="{DynamicResource Text.Muted}" FontSize="11.5" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" Visibility="{Binding OnReview, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                                <!-- the question as Markdown: code in it gets its own box with a Copy button, like a reply -->
                                                <StackPanel helpers:MarkdownHelper.Markdown="{Binding QuestionShown}" Margin="0,0,0,10"
                                                            AutomationProperties.AutomationId="CxGuard.QuestionText"/>
                                                <StackPanel Visibility="{Binding QuestionAnswered, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                    <!-- a step's option buttons: one pick moves on; on a multi-select step each one ticks -->
                                                    <ItemsControl ItemsSource="{Binding StepChoices}" Margin="0,0,0,6"
                                                                  Visibility="{Binding ShowsStepChoices, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Shown}" Style="{StaticResource CxCharPill}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        AutomationProperties.AutomationId="CxGuard.QuestionStepOption"
                                                                        Click="QuestionStepOption_Click"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding QuestionOptions}" Margin="0,0,0,6"
                                                                  Visibility="{Binding HasQuestionOptions, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Style="{StaticResource CxCharPill}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        AutomationProperties.AutomationId="CxGuard.QuestionOption"
                                                                        Click="QuestionOption_Click"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Back: the step before, with its answer as it was left -->
                                                        <Button Content="{services:Loc chat.ask.back}" Padding="12,4" Margin="0,0,8,0" FontSize="12.5"
                                                                Style="{StaticResource CxCharPill}" AutomationProperties.AutomationId="CxGuard.QuestionBack"
                                                                Visibility="{Binding CanStepBack, Converter={StaticResource BoolVis}}" Click="QuestionBack_Click"/>
                                                        <Grid Grid.Column="1" MinWidth="200" Visibility="{Binding ShowsAnswerBox, Converter={StaticResource BoolVis}}">
                                                        <!-- The plain box (Classic: its implicit TextBox style must reach it, so it carries no Style) -->
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <TextBox AutomationProperties.AutomationId="CxGuard.QuestionAnswer" Text="{Binding AnswerDraft, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Padding="8,5"
                                                                     ToolTip="{services:Loc chat.ask.placeholder}" KeyDown="QuestionBox_KeyDown"/>
                                                        </Grid>
                                                        <!-- …and in her look: the theme's input surface edged in her colour -->
                                                        <Grid Visibility="{DynamicResource Fx.Flourish}">
                                                            <TextBox AutomationProperties.AutomationId="CxGuard.QuestionAnswer" Text="{Binding AnswerDraft, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Padding="8,5"
                                                                     ToolTip="{services:Loc chat.ask.placeholder}" KeyDown="QuestionBox_KeyDown"
                                                                     Background="{DynamicResource Surface.Input}" Foreground="{DynamicResource Text.Primary}"
                                                                     CaretBrush="{DynamicResource Text.Primary}" BorderBrush="{Binding Character.FrameBrush}">
                                                                <TextBox.Template>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden"
                                                                                          HorizontalScrollBarVisibility="Hidden"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                                <Setter TargetName="box" Property="BorderBrush" Value="{Binding Character.AccentBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </TextBox.Template>
                                                            </TextBox>
                                                        </Grid>
                                                        </Grid>
                                                        <Button Grid.Column="2" Content="{services:Loc chat.ask.send}" Padding="14,4" Margin="8,0,0,0"
                                                                FontSize="12.5" Style="{StaticResource CxCharPrimary}" AutomationProperties.AutomationId="CxGuard.QuestionSend" Click="QuestionSend_Click"
                                                                Visibility="{Binding StepIsLast, Converter={StaticResource BoolVis}}"/>
                                                        <Button Grid.Column="2" Content="{services:Loc chat.ask.next}" Padding="14,4" Margin="8,0,0,0"
                                                                FontSize="12.5" Style="{StaticResource CxCharPrimary}" AutomationProperties.AutomationId="CxGuard.QuestionNext" Click="QuestionNext_Click"
                                                                Visibility="{Binding StepIsLast, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- ═══ Permission Request: inline Yes/No prompt ═══ -->
                                <!-- The one who asks stands beside her prompt, full figure, as she does beside a question (owner
                                     2026-10-18: "รูปเต็มตัวอวาต้า ที่ต้องอยู่ข้างกล่องโต้ตอบทำไมไม่ขึ้น"). Not on the red prompt,
                                     not in Classic (Fx.Flourish), and gone once the prompt is answered. -->
                                <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="20,4,40,4">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.PermissionRequest}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Visibility="{DynamicResource Fx.Flourish}" Panel.ZIndex="2" VerticalAlignment="Bottom">
                                        <Image Source="{Binding Character.Image}" Height="170" VerticalAlignment="Bottom" Margin="0,-18,-14,-4"
                                               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"
                                               AutomationProperties.AutomationId="CxGuard.PermissionGirl">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PermissionAnswered}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPermissionDanger}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                            <Image.Effect>
                                                <DropShadowEffect Color="{Binding Character.Accent}" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                                            </Image.Effect>
                                        </Image>
                                    </Grid>
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="CxGuard.PermissionCard">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="CornerRadius" Value="0,6,6,0"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Background" Value="{DynamicResource Chat.Permission.Background}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}"/>
                                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.PermissionRequest}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- With the flourishes on (not Classic): the look of the girl who asks -->
                                                <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                                                    <Setter Property="CornerRadius" Value="4,12,12,4"/>
                                                    <Setter Property="Padding" Value="12,8,14,10"/>
                                                    <Setter Property="Background" Value="{Binding Character.WashBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{Binding Character.AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="4,1.5,1.5,1.5"/>
                                                </DataTrigger>
                                                <!-- The red prompt: a delete aimed at a drive, the root or a home folder (Safety.DangerApproval).
                                                     Last, so it wins over her look: it stays red whoever asks. -->
                                                <DataTrigger Binding="{Binding IsPermissionDanger}" Value="True">
                                                    <Setter Property="CornerRadius" Value="0,6,6,0"/>
                                                    <Setter Property="Padding" Value="10,6"/>
                                                    <Setter Property="Background" Value="{DynamicResource Chat.Diff.Removed.Background}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                                    <Setter Property="BorderThickness" Value="4,2,2,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- who asks: her portrait and name (not in Classic, never on the red prompt) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" AutomationProperties.AutomationId="CxGuard.PermissionWho">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible"/>
                                                                <Condition Binding="{Binding IsPermissionDanger}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ContentControl Content="{Binding Character}" ContentTemplate="{StaticResource CxCharTag}" Focusable="False"/>
                                            <TextBlock Text="{services:Loc chat.who.permission}" Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <!-- Dangerous action: say so in red, in plain words, with the guard's full finding -->
                                        <StackPanel Margin="0,0,0,8"
                                                    Visibility="{Binding IsPermissionDanger, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <TextBlock Text="{services:Loc chat.perm.danger.title}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{services:Loc chat.perm.danger.body}" FontSize="12" Margin="0,4,0,4"
                                                       Foreground="{DynamicResource Status.Danger.Soft}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding PermissionDanger, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                     Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap" MaxHeight="180"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible"/>
                                                                    <Condition Binding="{Binding IsPermissionDanger}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{Binding Character.AccentBrush}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PermissionHeadlineText}"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       FontSize="13" FontFamily="{DynamicResource Font.Ui.Display}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="640"
                                                       AutomationProperties.AutomationId="CxGuard.PermissionHeadline"/>
                                        </StackPanel>
                                        <!-- In people's words (Safety.PermissionExplainer): where, the result, how risky, the dangerous
                                             parts said plainly — then the real command, folded, for whoever wants to read it -->
                                        <StackPanel Margin="22,0,0,8" MaxWidth="640" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasPermissionPlain, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionPlain">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- why it asks, in the asking tool's own words -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{services:Loc perm.label.note}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Muted}" Margin="0,3,10,0"
                                                           Visibility="{Binding HasPermissionNote, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PermissionPlain.Note}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasPermissionNote, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{services:Loc perm.label.where}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Muted}" Margin="0,0,10,3"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PermissionPlain.Where}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{services:Loc perm.label.effect}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Muted}" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PermissionPlain.Effect}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <!-- the risk, coloured by level -->
                                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left" Margin="0,0,0,6"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionRisk">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="Low">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="High">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="Danger">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                                                <Setter Property="Background" Value="{DynamicResource Chat.Diff.Removed.Background}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PermissionPlain.RiskText}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="Low">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="High">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PermissionRiskLevel}" Value="Danger">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- what is dangerous here, never folded away -->
                                            <ItemsControl ItemsSource="{Binding PermissionPlain.Warnings}" Margin="0,0,0,6"
                                                          Visibility="{Binding HasPermissionWarnings, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                                                          AutomationProperties.AutomationId="CxGuard.PermissionWarnings">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='⚠ {0}'}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Status.Danger}" TextWrapping="Wrap" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- the real command / tool, folded -->
                                            <Expander Style="{StaticResource ToolExpander}" IsExpanded="False"
                                                      AutomationProperties.AutomationId="CxGuard.PermissionTechnical">
                                                <Expander.Header>
                                                    <TextBlock Text="{services:Loc perm.tech}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                                </Expander.Header>
                                                <TextBox Text="{Binding PermissionPlain.Technical, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                         Background="{DynamicResource Surface.Sunken}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                         Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" MaxHeight="200" Padding="8,6"
                                                         VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
                                            </Expander>
                                        </StackPanel>
                                        <!-- Preview diff of the change being requested (file edits/writes) -->
                                        <Border Background="{DynamicResource Surface.Sunken}"
                                                CornerRadius="6" Padding="0,4,0,4" Margin="22,0,0,8"
                                                Visibility="{Binding HasDiff, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DiffStat}" FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}" Margin="10,2,10,4"/>
                                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DiffLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Display}" FontFamily="{DynamicResource Font.Mono}"
                                                                           FontSize="11" Padding="10,0" TextWrapping="NoWrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:EditDiffKind.Add}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Success.Soft}"/>
                                                                                    <Setter Property="Background" Value="{DynamicResource Chat.Diff.Added.Background}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:EditDiffKind.Remove}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger.Soft}"/>
                                                                                    <Setter Property="Background" Value="{DynamicResource Chat.Diff.Removed.Background}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:EditDiffKind.Hunk}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Chat.Diff.Hunk.Foreground}"/>
                                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- Allow / Deny until answered; then the outcome, localized. A WrapPanel: with four buttons a
                                             narrow chat (docked beside the editor) cut the last ones off — Deny included (owner 2026-10-20). -->
                                        <WrapPanel Orientation="Horizontal" Margin="22,0,0,-6"
                                                   Visibility="{Binding PermissionAnswered, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                            <Button Content="{services:Loc chat.allow}" Padding="14,3" Margin="0,0,8,6"
                                                    Style="{StaticResource CxCharPrimary}"
                                                    FontSize="12"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionAllow"
                                                    Visibility="{Binding IsPermissionDanger, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                                                    Click="PermissionAllow_Click"/>
                                            <!-- The red prompt's yes says what it is: running something that deletes -->
                                            <Button Content="{services:Loc chat.perm.danger.allow}" Padding="14,3" Margin="0,0,8,6"
                                                    FontSize="12" FontWeight="Bold" Foreground="White"
                                                    Background="{DynamicResource Status.Danger}" BorderBrush="{DynamicResource Status.Danger}"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionAllowDanger"
                                                    Visibility="{Binding IsPermissionDanger, Converter={StaticResource BoolVis}}"
                                                    Click="PermissionAllow_Click"/>
                                            <!-- An MCP tool no policy judged: allow it for the rest of this chat (one ChatGPT session asked 18×) -->
                                            <Button Content="{services:Loc chat.perm.allowChat}" Padding="14,3" Margin="0,0,8,6"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="12"
                                                    ToolTip="{services:Loc chat.perm.allowChat.tip}"
                                                    Visibility="{Binding PermissionCanAllowForChat, Converter={StaticResource BoolVis}}"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionAllowChat"
                                                    Click="PermissionAllowChat_Click"/>
                                            <!-- The same, for every chat until midnight (owner 2026-10-20: "อนุญาตทั้งวัน") -->
                                            <Button Content="{services:Loc chat.perm.allowDay}" Padding="14,3" Margin="0,0,8,6"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="12"
                                                    ToolTip="{services:Loc chat.perm.allowDay.tip}"
                                                    Visibility="{Binding PermissionCanAllowForChat, Converter={StaticResource BoolVis}}"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionAllowDay"
                                                    Click="PermissionAllowDay_Click"/>
                                            <!-- A folder outside the project: remember it, never ask again (owner 2026-10-18) -->
                                            <Button Content="{services:Loc chat.perm.allowAlways}" Padding="14,3" Margin="0,0,8,6"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="12"
                                                    ToolTip="{services:Loc chat.perm.allowAlways.tip}"
                                                    Visibility="{Binding PermissionCanAllowAlways, Converter={StaticResource BoolVis}}"
                                                    Click="PermissionAllowAlways_Click"/>
                                            <Button Content="{services:Loc chat.deny}" Padding="14,3" Margin="0,0,0,6"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="12"
                                                    AutomationProperties.AutomationId="CxGuard.PermissionDeny"
                                                    Click="PermissionDeny_Click"/>
                                        </WrapPanel>
                                        <Grid Margin="22,0,0,0"
                                              Visibility="{Binding PermissionAnswered, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{services:Loc chat.perm.allowed}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Success}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermissionOutcome}" Value="{x:Static models:PermissionOutcome.Allowed}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PermissionAllowedForChat}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PermissionAllowedForDay}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PermissionAllowedAlways}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{services:Loc chat.perm.allowedChat}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Success}"
                                                       Visibility="{Binding PermissionAllowedForChat, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{services:Loc chat.perm.allowedDay}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Success}"
                                                       Visibility="{Binding PermissionAllowedForDay, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{services:Loc chat.perm.allowedAlways}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Success}"
                                                       Visibility="{Binding PermissionAllowedAlways, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{services:Loc chat.perm.denied}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Danger}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermissionOutcome}" Value="{x:Static models:PermissionOutcome.Denied}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{services:Loc chat.perm.cancelled}" FontSize="12" FontStyle="Italic"
                                                       Foreground="{DynamicResource Text.Tertiary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermissionOutcome}" Value="{x:Static models:PermissionOutcome.Cancelled}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{services:Loc chat.perm.dismissed}" FontSize="12" FontStyle="Italic"
                                                       Foreground="{DynamicResource Text.Tertiary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PermissionOutcome}" Value="{x:Static models:PermissionOutcome.Dismissed}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <!-- ═══ Compaction marker: where the model's context now starts ═══ -->
                                <Border Grid.Row="1" Margin="40,10,40,10" Padding="12,8" CornerRadius="8"
                                        Background="{DynamicResource Accent.1.Tint.Faint}" BorderBrush="{DynamicResource Accent.1.Border.Soft}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ContextSummary}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{services:Loc chat.compact.markerTitle}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{services:Loc chat.compact.marker}" FontSize="11" Margin="20,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        <!-- Bound, not local: the ListBox recycles containers, and a local IsExpanded
                                             would carry over to whichever row reuses this one. -->
                                        <Expander Margin="16,4,0,0" Style="{StaticResource ToolExpander}" IsExpanded="{Binding IsExpanded}">
                                            <Expander.Header>
                                                <TextBlock Text="{services:Loc chat.compact.showSummary}" FontSize="11"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </Expander.Header>
                                            <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="6" Padding="10,8"
                                                    Margin="0,4,0,0" MaxHeight="300">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding Content}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ AgentStatus: what the agent is running right now. Live: a soft pill with three
                                     bouncing dots and a light sweeping across it, so it reads as "working" at a glance
                                     while the words still say what runs. Finished: a quiet muted line. ═══ -->
                                <!-- live: her avatar at the right, the pill beside it (at the laptop for a tool, over a book
                                     while she waits on the model) -->
                                <Grid Grid.Row="1" HorizontalAlignment="Right">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                                                        <Condition Binding="{Binding IsStreaming}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <views:AiAvatar Margin="0,0,0,0" VerticalAlignment="Center" Style="{StaticResource CxAiAvatar}"/>
                                </Grid>
                                <Border Grid.Row="1" Padding="10,4,12,4" CornerRadius="12" BorderThickness="1" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="18,2,40,2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}"/>
                                                        <Condition Binding="{Binding IsStreaming}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource Surface.Chip}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Margin" Value="40,4,50,4"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- the sweep: a soft band of light gliding left → right over the live pill -->
                                        <Grid Visibility="{DynamicResource Fx.Flourish}" IsHitTestVisible="False">
                                        <Rectangle views:AmbientAnimation.WhileVisible="True" IsHitTestVisible="False" Margin="-10,-4,-12,-4"
                                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <LinearGradientBrush.RelativeTransform>
                                                        <TranslateTransform X="-1"/>
                                                    </LinearGradientBrush.RelativeTransform>
                                                    <GradientStop Color="{DynamicResource Fx.Sweep.Edge}" Offset="0.3"/>
                                                    <GradientStop Color="{DynamicResource Fx.Sweep.Mid}" Offset="0.5"/>
                                                    <GradientStop Color="{DynamicResource Fx.Sweep.Edge}" Offset="0.7"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard x:Name="AmbientChat2">
                                                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                            <DoubleAnimation Storyboard.TargetProperty="Fill.RelativeTransform.(TranslateTransform.X)"
                                                                             From="-1" To="1" Duration="0:0:1.8">
                                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- live: three dots bouncing one after another -->
                                            <StackPanel views:AmbientAnimation.WhileVisible="True" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0"
                                                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                                <StackPanel.Resources>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Width" Value="5"/>
                                                        <Setter Property="Height" Value="5"/>
                                                        <Setter Property="Margin" Value="1.5,0"/>
                                                        <Setter Property="Fill" Value="{DynamicResource Accent.1}"/>
                                                        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Ellipse x:Name="Dot1"/>
                                                <Ellipse x:Name="Dot2"/>
                                                <Ellipse x:Name="Dot3"/>
                                                <StackPanel.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard x:Name="AmbientChat3">
                                                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" Duration="0:0:1.1">
                                                                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                 From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                 From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                 From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0.32">
                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </StackPanel.Triggers>
                                            </StackPanel>
                                            <!-- finished: a small muted dot -->
                                            <Ellipse Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource Text.Muted}" Opacity="0.5"
                                                     Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                            <!-- Status text + elapsed time -->
                                            <TextBlock Text="{Binding Content}" FontSize="12" FontFamily="{DynamicResource Font.Ui}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ToolElapsedTime}"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="10" FontFamily="{DynamicResource Font.Mono}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding ToolElapsedTime, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ═══ The agent's plan (todo_write): a checklist card that updates in place ═══ -->
                                <!-- As wide as a reply at most (a wide window does not stretch five short steps across it); the
                                     steps wrap inside it, so a narrow window still reads every word. -->
                                <Border Grid.Row="1" Margin="20,6,0,4" Padding="14,10,14,8" CornerRadius="8" BorderThickness="1"
                                        MaxWidth="780" HorizontalAlignment="Left" MinWidth="260"
                                        Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}"
                                        Visibility="{Binding IsPlan, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Status.Success}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlanHeader}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- what the request is to the chat (todo_write scope): first task / continuation / new task -->
                                            <Border Grid.Column="2" CornerRadius="9" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                    Background="{DynamicResource State.Fill.Faint}" BorderBrush="{DynamicResource Border.Subtle}"
                                                    ToolTip="{services:Loc plan.scope.tip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlanScope}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource Text.Muted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{services:Loc plan.scope.continuation}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlanScope}" Value="first_task">
                                                                    <Setter Property="Text" Value="{services:Loc plan.scope.first_task}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PlanScope}" Value="new_task">
                                                                    <Setter Property="Text" Value="{services:Loc plan.scope.new_task}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding PlanElapsed}" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                        <!-- how far the plan is: the same gliding line as the floating card (Views/Motion.Fraction) -->
                                        <Grid Height="3" Margin="0,8,0,6">
                                            <Border CornerRadius="1.5" Background="{DynamicResource State.Fill.Faint}"/>
                                            <Border CornerRadius="1.5" views:Motion.Fraction="{Binding PlanProgress, Mode=OneWay}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.Gradient}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlanProgress}" Value="1">
                                                                <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <!-- each step plays its state (Resources/Theme.xaml, PLAN STEPS): the ring turns on the one at work, a check pops when one finishes -->
                                        <ItemsControl ItemsSource="{Binding PlanItems}" Margin="-6,0,0,0" views:Motion.Accent="{DynamicResource Accent.1}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource PlanStepRow}" Margin="0,1">
                                                        <StackPanel>
                                                            <!-- a grid, not a horizontal stack: the words wrap to the room the card has -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlanStepMark}" Focusable="False"
                                                                                VerticalAlignment="Top" Margin="0,0,9,0"/>
                                                                <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource PlanStepText}">
                                                                    <Run Text="{Binding Number, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                            <!-- under the active step: what runs now (sub-agents, workflows, background commands) -->
                                                            <TextBlock Text="{Binding Running}" Margin="27,1,0,1" FontSize="11"
                                                                       Foreground="{DynamicResource Accent.1}"
                                                                       Visibility="{Binding HasRunning, Converter={StaticResource BoolVis}}"/>
                                                            <!-- the step its run was on when it ended (Stop, or a chat read back later) -->
                                                            <TextBlock Text="{services:Loc plan.step.stopped}" Margin="27,1,0,1" FontSize="11"
                                                                       Foreground="{DynamicResource Status.Warning}"
                                                                       Visibility="{Binding IsStopped, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Workflow card (docs/agent-orchestration.md §3) ═══ -->
                                <ContentControl Grid.Row="1" Content="{Binding Workflow}" Focusable="False"
                                                Visibility="{Binding ShowsWorkflowCard, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate><views:WorkflowCardView/></DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <!-- ═══ Split-chat chips: the chats this command split off, each with the sidebar's own state ═══ -->
                                <Border Grid.Row="1" Margin="20,6,0,4" Padding="12,8" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}"
                                        Visibility="{Binding IsSplitChips, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc orch.splits.header}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding SplitChips}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,6,4" Padding="9,3" Cursor="Hand" ToolTip="{services:Loc orch.splits.openTip}"
                                                            Command="{Binding DataContext.GoToChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Chip" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                                                        BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource State.Fill.Faint}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                     Fill="{DynamicResource Text.Faint}"/>
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Text.Primary}"/>
                                                            <TextBlock x:Name="StateText" Text="{services:Loc orch.splits.idle}" Margin="6,0,0,0" FontSize="11"
                                                                       Foreground="{DynamicResource Text.Muted}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RunStatus}" Value="working">
                                                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Accent.1}"/>
                                                            <Setter TargetName="StateText" Property="Text" Value="{services:Loc orch.splits.working}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatus}" Value="waiting">
                                                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Status.Warning}"/>
                                                            <Setter TargetName="StateText" Property="Text" Value="{services:Loc orch.splits.waiting}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatus}" Value="done">
                                                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Status.Success}"/>
                                                            <Setter TargetName="StateText" Property="Text" Value="{services:Loc orch.splits.done}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatus}" Value="failed">
                                                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                                            <Setter TargetName="StateText" Property="Text" Value="{services:Loc orch.splits.failed}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatus}" Value="stopped">
                                                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Status.Danger.Soft}"/>
                                                            <Setter TargetName="StateText" Property="Text" Value="{services:Loc orch.splits.stopped}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Watch card (watch_ci / watch_process): what it waits for, where it stands, Cancel ═══ -->
                                <Border Grid.Row="1" Margin="20,6,0,4" Padding="12,8" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}"
                                        Visibility="{Binding ShowsWatchCard, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <Grid DataContext="{Binding WatchCard}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource Text.Muted}"/>
                                            <TextBlock Text="{Binding Times}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Text.Faint}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Text.Muted}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}">
                                                <Run Text="{services:Loc watch.card.note}"/><Run Text="{Binding Note, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{services:Loc watch.cancel}" ToolTip="{services:Loc watch.cancelTip}"
                                                Command="{Binding CancelCommand}" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                                                AutomationProperties.AutomationId="WatchCancel"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Border>

                                <!-- ═══ Next-step box (wrap_up): recap, one question, one or two answers ═══ -->
                                <Border Grid.Row="1" Margin="20,8,0,4" Padding="14,10" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource Accent.1.Tint.Faint}" BorderBrush="{DynamicResource Accent.1.Border.Soft}"
                                        Visibility="{Binding ShowsNextStep, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <StackPanel DataContext="{Binding NextStep}">
                                        <TextBlock Text="{services:Loc orch.next.title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent.1}"/>
                                        <TextBlock Text="{Binding Recap}" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{Binding Ask}" Margin="0,8,0,0" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Primary}" Visibility="{Binding HasAsk, Converter={StaticResource BoolVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0"
                                                      Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="Act" Command="{Binding Command}" Margin="0,0,8,0" Padding="14,5" Cursor="Hand">
                                                        <!-- a style setter, not a local value: the primary trigger below must win over it -->
                                                        <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/></Style></Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                                                        Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Accent.1.Border.Soft}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock x:Name="ActText" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Text.Primary}"/>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter TargetName="Act" Property="Background" Value="{DynamicResource Accent.1}"/>
                                                            <Setter TargetName="ActText" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding PickedText}" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                                   Visibility="{Binding IsAnswered, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ What changed this turn: files, +/−, one plain line; before/after pictures for a screen ═══ -->
                                <!-- Collapsed unless the row is one, and its template only applies when it is: an ordinary row pays
                                     nothing for it. No animation: it is a still record of the turn. -->
                                <ContentControl Grid.Row="1" Margin="20,8,0,4" Focusable="False" Content="{Binding TurnChanges}"
                                                Visibility="{Binding ShowsTurnChanges, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                                                AutomationProperties.AutomationId="CxChat.TurnChanges">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,10" CornerRadius="10" BorderThickness="1"
                                                    Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Accent.1}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{services:Loc changes.title}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" FontFamily="{DynamicResource Font.Mono}" FontSize="12" VerticalAlignment="Center"
                                                                   ToolTip="{services:Loc changes.totalTip}">
                                                            <Run Text="{Binding AddedText, Mode=OneWay}" Foreground="{DynamicResource Status.Success}"/>
                                                            <Run Text=" "/><Run Text="{Binding RemovedText, Mode=OneWay}" Foreground="{DynamicResource Status.Danger}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Line}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding OpenCommand}" Cursor="Hand" ToolTip="{services:Loc changes.openTip}"
                                                                        HorizontalContentAlignment="Stretch" Margin="0,1">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd" CornerRadius="6" Padding="6,3" Background="Transparent">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                                   Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                        <TextBlock Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                            <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Text.Faint}"/><Run
                                                                                 Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Text.Primary}"/>
                                                                        </TextBlock>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                            <Border CornerRadius="4" Padding="5,0" Margin="0,0,8,0" Background="{DynamicResource Accent.1.Tint}"
                                                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}">
                                                                                <TextBlock Text="{services:Loc changes.new}" FontSize="10.5" Foreground="{DynamicResource Accent.1}"/>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding AddedText}" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                                                                                       Foreground="{DynamicResource Status.Success}" Margin="0,0,6,0"/>
                                                                            <TextBlock Text="{Binding RemovedText}" FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                                                                                       Foreground="{DynamicResource Status.Danger}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding MoreText}" Margin="6,2,0,0" FontSize="11.5" Foreground="{DynamicResource Text.Muted}"
                                                               Visibility="{Binding HasMore, Converter={StaticResource BoolVis}}"/>
                                                    <!-- Before / after: the last picture of the app before the first screen edit and after the last -->
                                                    <Grid Margin="0,10,0,0" Visibility="{Binding HasPictures, Converter={StaticResource BoolVis}}"
                                                          ToolTip="{services:Loc changes.picTip}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MaxWidth="260"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{services:Loc changes.before}" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,4"/>
                                                            <Button Padding="0" Cursor="Hand" Tag="{Binding BeforeImage}" Click="ToolThumbnail_Click">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                                                                Background="{DynamicResource Bg.Window}" Padding="2"><ContentPresenter/></Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Image Source="{Binding BeforePicture}" MaxHeight="140" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="10,18,10,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{services:Loc changes.after}" FontSize="11" Foreground="{DynamicResource Accent.1}" Margin="0,0,0,4"/>
                                                            <Button Padding="0" Cursor="Hand" Tag="{Binding AfterImage}" Click="ToolThumbnail_Click">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Accent.1.Border.Soft}"
                                                                                Background="{DynamicResource Bg.Window}" Padding="2"><ContentPresenter/></Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Image Source="{Binding AfterPicture}" MaxHeight="140" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <!-- ═══ Agent map: the sub-agents this command started, as a live tree (open by default, folds) ═══ -->
                                <!-- Alive only while a sub-agent works (owner 2026-11-03: "อยากให้ปรับปรุงการแจงเอเจนให้สวย มีอนิเมชั่นกว่านี้"):
                                     the root breathes and its line flows while any runs; a running node's ring turns, its line
                                     flows, its rim glows and a light runs along its foot. Every endless storyboard here is
                                     a MultiDataTrigger on IsRunning AND IsVisible, so it stops when the node ends, the card folds
                                     or the row scrolls away — a Loaded trigger once kept every finished node animating, hidden,
                                     forever. An end plays once (JustDone: the badge pops, JustFailed: the card shakes). -->
                                <Border Grid.Row="1" Margin="20,6,0,4" Padding="14,10" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Accent.1.Border.Soft}"
                                        Visibility="{Binding IsAgentMap, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Accent.1}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding AgentMapHeader}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsAgentMapOpen, Mode=TwoWay}" Cursor="Hand"
                                                          ToolTip="{services:Loc agentmap.hide}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="6,3">
                                                            <TextBlock x:Name="chev" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                       Foreground="{DynamicResource Text.Muted}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="chev" Property="Text" Value="&#xE70D;"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>
                                        <!-- how many came back (done, failed or stopped): glides to each new count; green once all are
                                             home, amber when one of them failed -->
                                        <Grid Height="3" Margin="0,8,0,0">
                                            <Border CornerRadius="1.5" Background="{DynamicResource State.Fill.Faint}"/>
                                            <Border CornerRadius="1.5" views:Motion.Fraction="{Binding AgentMapProgress, Mode=OneWay}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.Gradient}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding AgentMapRunning}" Value="False"/>
                                                                    <Condition Binding="{Binding AgentMapHasFailures}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding AgentMapRunning}" Value="False"/>
                                                                    <Condition Binding="{Binding AgentMapHasFailures}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- the map itself: a node canvas (Views/AgentGraph) — made only for an agent map row, folded with the header -->
                                        <ContentControl Margin="0,12,0,2" Content="{Binding}" Focusable="False"
                                                        Visibility="{Binding IsAgentMapOpen, Converter={StaticResource BoolVis}}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAgentMap}" Value="True">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate><agentgraph:AgentGraphView/></DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Normal chat bubble ═══ -->
                                <!-- Hidden for every role that has its own body above. -->
                                <Grid Grid.Row="1">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.AgentStatus}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.PermissionRequest}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Thinking}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ContextSummary}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Question}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlan}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAgentMap}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOrchestrationCard}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatars: the user's on the left; the AI's on the right, the end her speech bubble points
                                         to (owner 2026-10-29). She moves while she works (AiAvatar, style CxAiAvatar). -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,8,10,0" VerticalAlignment="Top"
                                            Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.User}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <views:AiAvatar Grid.Column="2" Margin="4,5,0,0" VerticalAlignment="Top" Style="{StaticResource CxAiAvatar}"/>

                                    <!-- The bubbles' tails: a small point from the bubble's top corner to the avatar beside it -->
                                    <Path Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,-7,0"
                                          Data="M0,0 L8,6 L0,12 Z" Fill="{Binding Role, Converter={StaticResource RoleBg}}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,16,0,0"
                                          Data="M8,0 L0,6 L8,12 Z" Fill="{Binding Role, Converter={StaticResource RoleBg}}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.User}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                <Border Grid.Column="1"
                                        HorizontalAlignment="{Binding Role, Converter={StaticResource RoleAlign}}"
                                        Margin="{Binding Role, Converter={StaticResource RoleMargin}}"
                                        Background="{Binding Role, Converter={StaticResource RoleBg}}"
                                        CornerRadius="{Binding Role, Converter={StaticResource RoleCorner}}"
                                        Padding="{Binding Role, Converter={StaticResource RolePadding}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}">
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
                                                </DataTrigger>
                                                <!-- The running balloon: the row the agent's background calls are folding into right now -->
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                    <Setter Property="Effect" Value="{DynamicResource Fx.Card.Glow}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>  <!-- the running balloon's live line -->
                                        </Grid.RowDefinitions>

                                        <!-- Live line of the running balloon: what runs right now, three dots and a light gliding by.
                                             The calls themselves are boxes inside (open the row); the answer comes outside. -->
                                        <Border Grid.Row="7" Margin="0,6,0,0" Padding="10,5" CornerRadius="10" ClipToBounds="True"
                                                Background="{DynamicResource Surface.Chip}"
                                                Visibility="{Binding IsLive, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <Grid>
                                                <Grid Visibility="{DynamicResource Fx.Flourish}" IsHitTestVisible="False" Margin="-10,-5">
                                                    <Rectangle views:AmbientAnimation.WhileVisible="True">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                                                                <GradientStop Color="{DynamicResource Fx.Sweep.Edge}" Offset="0.3"/>
                                                                <GradientStop Color="{DynamicResource Fx.Sweep.Mid}" Offset="0.5"/>
                                                                <GradientStop Color="{DynamicResource Fx.Sweep.Edge}" Offset="0.7"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                        <Rectangle.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard x:Name="AmbientChat4">
                                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Fill.RelativeTransform.(TranslateTransform.X)"
                                                                                         From="-1" To="1" Duration="0:0:1.8">
                                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Rectangle.Triggers>
                                                    </Rectangle>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel views:AmbientAnimation.WhileVisible="True" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Width" Value="5"/>
                                                                <Setter Property="Height" Value="5"/>
                                                                <Setter Property="Margin" Value="1.5,0"/>
                                                                <Setter Property="Fill" Value="{DynamicResource Accent.1}"/>
                                                                <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Ellipse x:Name="LiveDot1"/>
                                                        <Ellipse x:Name="LiveDot2"/>
                                                        <Ellipse x:Name="LiveDot3"/>
                                                        <StackPanel.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard x:Name="AmbientChat5">
                                                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30" Duration="0:0:1.1">
                                                                        <DoubleAnimation Storyboard.TargetName="LiveDot1" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                         From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0"/>
                                                                        <DoubleAnimation Storyboard.TargetName="LiveDot2" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                         From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0.16"/>
                                                                        <DoubleAnimation Storyboard.TargetName="LiveDot3" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                         From="0" To="-4" Duration="0:0:0.28" AutoReverse="True" BeginTime="0:0:0.32"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </StackPanel.Triggers>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LiveText}" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Typed during the run, not read yet: Send now has the agent read it at once (a user
                                             bubble is never the running balloon, so the two never share this row) -->
                                        <Button Grid.Row="7" Margin="0,6,0,0" Padding="9,2" Cursor="Hand" HorizontalAlignment="Left"
                                                ToolTip="{services:Loc chat.steer.sendNowTip}"
                                                Visibility="{Binding IsQueuedNote, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                                                Command="{Binding DataContext.SendNowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                                            BorderBrush="{DynamicResource Accent.1}" Background="{DynamicResource State.Fill.Faint}">
                                                        <TextBlock Text="{services:Loc chat.steer.sendNow}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent.1}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>


                                        <!-- Row 0: Role label + Tool Badge + Success/Fail + Hover Actions -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.User}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="{Binding Role, Converter={StaticResource RoleLabel}}"
                                                           Foreground="{Binding Role, Converter={StaticResource RoleBrush}}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           FontFamily="{DynamicResource Font.Ui.Display}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.System}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Tool row: its icon, what it did, on what -->
                                                <TextBlock Text="{Binding ToolGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ToolVerb}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Visibility="{Binding HasToolVerb, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <TextBlock Text="{Binding ToolTarget}" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                                           VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Content}"
                                                           Visibility="{Binding HasToolVerb, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <!-- Rows saved before the verbs existed: the old name and summary -->
                                                <TextBlock Text="{Binding ToolName}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent.1}"
                                                           FontSize="12" FontFamily="{DynamicResource Font.Mono}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ToolName, Converter={StaticResource BoolVis}}" Value="Visible"/>
                                                                        <Condition Binding="{Binding HasToolVerb}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Content}" VerticalAlignment="Center" MaxWidth="440"
                                                           Foreground="{DynamicResource Text.Primary}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Content}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}"/>
                                                                        <Condition Binding="{Binding HasToolVerb}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Collapsed group count badge -->
                                                <Border CornerRadius="8" Padding="5,1" Margin="4,0,0,0"
                                                        Background="{DynamicResource Accent.2}"
                                                        Visibility="{Binding IsCollapsedGroup, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding CollapsedCount}"
                                                               Foreground="{DynamicResource Bg.Elevated}"
                                                               FontSize="11" FontWeight="Bold"
                                                               FontFamily="{DynamicResource Font.Mono}"/>
                                                </Border>

                                                <!-- Interrupted indicator -->
                                                <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                        Background="{DynamicResource Chat.Badge.Danger.Background}"
                                                        Visibility="{Binding IsInterrupted, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{services:Loc chat.interrupted}" FontSize="11"
                                                               Foreground="{DynamicResource Status.Danger}"
                                                               FontFamily="{DynamicResource Font.Mono}"/>
                                                </Border>

                                                <!-- Retry countdown -->
                                                <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                        Background="{DynamicResource Chat.Badge.Warning.Background}"
                                                        Visibility="{Binding IsRetrying, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding RetryCountdown}" FontSize="11"
                                                               Foreground="{DynamicResource Status.Warning}"
                                                               FontFamily="{DynamicResource Font.Mono}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- ═══ Right side: the diff's +/-, the tool's outcome and time; hover: Copy + Retry ═══ -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DiffAddedText}" Foreground="{DynamicResource Status.Success}" FontSize="12"
                                                       FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Visibility="{Binding DiffAddedText, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                            <TextBlock Text="{Binding DiffRemovedText}" Foreground="{DynamicResource Status.Danger}" FontSize="12"
                                                       FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Visibility="{Binding DiffRemovedText, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ToolSuccess}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Status.Success}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{services:Loc chat.tool.failed}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ToolSuccess}" Value="True">
                                                                    <Setter Property="Text" Value="{services:Loc chat.tool.done}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ToolElapsedTime}" Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="11" FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Visibility="{Binding ToolElapsedTime, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsHovered, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                                <!-- Copy message -->
                                                <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource IconButton}"
                                                        FontSize="10" Padding="4,2" Margin="2,0"
                                                        ToolTip="{services:Loc chat.copyMessageTip}"
                                                        Click="CopyMessage_Click"
                                                        Tag="{Binding Content}"/>
                                                <!-- Explain simply: the reply again in plain words (a finished reply only) -->
                                                <Button Content="{services:Loc vibe.explain.button}"
                                                        Style="{StaticResource IconButton}" FontFamily="{DynamicResource Font.Ui}"
                                                        Width="Auto" Height="Auto" VerticalAlignment="Center"
                                                        FontSize="11" Padding="6,2" Margin="2,0"
                                                        ToolTip="{services:Loc vibe.explain.tip}"
                                                        Click="ExplainMessage_Click"
                                                        AutomationProperties.AutomationId="CxChat.ExplainSimply"
                                                        Visibility="{Binding CanExplainSimply, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <!-- Go back to this point of the chat, here or in a new chat. These two are words on an
                                                     IconButton: without their own font and size its icon font draws squares and its 36 px clips them. -->
                                                <Button Content="{services:Loc chat.rewindHere}"
                                                        Style="{StaticResource IconButton}" FontFamily="{DynamicResource Font.Ui}"
                                                        Width="Auto" Height="Auto" VerticalAlignment="Center"
                                                        FontSize="11" Padding="6,2" Margin="2,0"
                                                        ToolTip="{services:Loc chat.rewindHereTip}"
                                                        Click="RewindMessage_Click"
                                                        Visibility="{Binding CanRewind, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <Button Content="{services:Loc chat.forkHere}"
                                                        Style="{StaticResource IconButton}" FontFamily="{DynamicResource Font.Ui}"
                                                        Width="Auto" Height="Auto" VerticalAlignment="Center"
                                                        FontSize="11" Padding="6,2" Margin="2,0"
                                                        ToolTip="{services:Loc chat.forkHereTip}"
                                                        Click="ForkMessage_Click"
                                                        Visibility="{Binding CanRewind, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                                <!-- Retry: only on a failed REPLY (CanRetry), never on a tool row —
                                                     retrying one re-ran the whole agent turn. -->
                                                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource IconButton}"
                                                        FontSize="10" Padding="4,2" Margin="2,0"
                                                        ToolTip="{services:Loc chat.retryTip}"
                                                        Click="RetryMessage_Click"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                                            </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Tool Arguments (truncated, structured) -->
                                        <Border Grid.Row="1" Margin="0,4,0,0"
                                                Background="{DynamicResource Bg.Window}"
                                                CornerRadius="4" Padding="8,5"
                                                MaxHeight="120">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}"/>
                                                                <Condition Binding="{Binding ToolArguments, Converter={StaticResource BoolVis}}" Value="Visible"/>
                                                                <Condition Binding="{Binding HasGroupSteps}" Value="False"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding ToolArguments}"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           MaxHeight="100"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- A folded group, opened: each call it holds as its own small box, gliding in one by one -->
                                        <ItemsControl Grid.Row="1" Margin="0,6,0,2" ItemsSource="{Binding GroupSteps}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasGroupSteps}" Value="True"/>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,4" Padding="10,5" CornerRadius="8" BorderThickness="1"
                                                            Background="{DynamicResource Surface.Inset}" BorderBrush="{DynamicResource Border.Subtle}" Opacity="0">
                                                        <Border.RenderTransform><TranslateTransform X="-10"/></Border.RenderTransform>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="0" Duration="0:0:0.35">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Accent.1}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Verb}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Target}" FontSize="11.5" FontFamily="{DynamicResource Font.Mono}"
                                                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Target}" Visibility="{Binding HasTarget, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Elapsed}" FontSize="10" FontFamily="{DynamicResource Font.Mono}"
                                                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                       Visibility="{Binding HasElapsed, Converter={StaticResource BoolVis}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Row 2: the images the user attached, then the message content (Markdown) -->
                                        <StackPanel Grid.Row="2">
                                        <ItemsControl ItemsSource="{Binding AttachedImages}" Margin="0,2,0,4"
                                                      Visibility="{Binding HasAttachedImages, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="ToolThumbnail_Click" Cursor="Hand" Margin="0,0,8,6"
                                                            ToolTip="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                                                                        BorderBrush="{DynamicResource Border.Default}">
                                                                    <Image Source="{Binding Converter={StaticResource ThumbSource}}"
                                                                           MaxHeight="180" MaxWidth="260" Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- …and the other files, as chips; a click shows the copy in Explorer -->
                                        <ItemsControl ItemsSource="{Binding AttachedFiles}" Margin="0,2,0,4"
                                                      Visibility="{Binding HasAttachedFiles, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="AttachedFile_Click" Cursor="Hand" Margin="0,0,8,6"
                                                            ToolTip="{services:Loc chat.attach.openFolder}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Padding="8,4" CornerRadius="8" BorderThickness="1"
                                                                        BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Sunken}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Converter={StaticResource FileGlyph}}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                                   Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding Converter={StaticResource FileNameOf}}" FontFamily="{DynamicResource Font.Ui}" FontSize="12"
                                                                                   Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" MaxWidth="260"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="0,2,0,0"
                                                    helpers:MarkdownHelper.Markdown="{Binding Content}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                        </StackPanel>
                                        </StackPanel>

                                        <!-- Row 3: Typing Indicator -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsStreaming}" Value="True"/>
                                                                <Condition Binding="{Binding Content}" Value=""/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent.2}" Margin="0,0,4,0"
                                                     Style="{StaticResource PulseDot}"/>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent.2}" Margin="0,0,4,0"
                                                     Style="{StaticResource PulseDot}"/>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent.2}"
                                                     Style="{StaticResource PulseDot}"/>
                                            <TextBlock Text="{services:Loc chat.thinkingInline}"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontSize="11" FontStyle="Italic"
                                                       FontFamily="{DynamicResource Font.Ui.Display}"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <!-- Row 4: inline diff (file edits) + collapsible tool output -->
                                        <StackPanel Grid.Row="4" Margin="0,2,0,0">

                                        <!-- Image the tool returned (a screenshot): a small thumbnail of the saved
                                             file; click opens it full size. Only a path is bound — never the bytes. -->
                                        <Button HorizontalAlignment="Left" Margin="0,0,0,6"
                                                Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                Tag="{Binding ThumbnailPath}" Click="ToolThumbnail_Click"
                                                ToolTip="{services:Loc chat.thumbnail.tip}"
                                                Visibility="{Binding ThumbnailPath, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Surface.Raised.Strong}"
                                                            Background="{DynamicResource Bg.Window}" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbSource}}"
                                                       MaxHeight="120" MaxWidth="240" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Button>

                                        <!-- The edit: one summary line; the before / after diff is built only when opened -->
                                        <ToggleButton IsChecked="{Binding DiffExpanded}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                      Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                                                      Visibility="{Binding HasDiff, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                                                      ToolTip="{services:Loc chat.diff.toggleTip}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{DynamicResource State.Fill.Faint}" CornerRadius="5" Padding="8,2">
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Secondary}">
                                                            <Run x:Name="Chevron" Text="▸ "/><Run Text="{services:Loc chat.diff.show}"/>
                                                            <Run Text="  "/><Run Text="{Binding DiffAddedText, Mode=OneWay}" Foreground="{DynamicResource Status.Success}"/>
                                                            <Run Text=" "/><Run Text="{Binding DiffRemovedText, Mode=OneWay}" Foreground="{DynamicResource Status.Danger}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Chevron" Property="Text" Value="▾ "/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                                Background="{DynamicResource Surface.Sunken}" Margin="0,4,0,2" ClipToBounds="True"
                                                Visibility="{Binding DiffExpanded, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Chat.Diff.Removed.Background}" Padding="10,4">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource Status.Danger}">
                                                        <Run Text="− "/><Run Text="{services:Loc chat.diff.before}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource Chat.Diff.Added.Background}" Padding="10,4">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource Status.Success}">
                                                        <Run Text="+ "/><Run Text="{services:Loc chat.diff.after}"/>
                                                    </TextBlock>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                    <ItemsControl ItemsSource="{Binding DiffPairs}" Margin="0,2,0,4"
                                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid TextElement.FontFamily="{DynamicResource Font.Mono}" TextElement.FontSize="11">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="36"/><ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- hunk header across both sides -->
                                                                    <TextBlock Grid.ColumnSpan="4" Text="{Binding Hunk}" Foreground="{DynamicResource Chat.Diff.Hunk.Foreground}"
                                                                               FontStyle="Italic" Padding="10,2"
                                                                               Visibility="{Binding IsHunk, Converter={StaticResource BoolVis}}"/>
                                                                    <Border Grid.ColumnSpan="2">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding OldKind}" Value="{x:Static models:EditDiffKind.Remove}">
                                                                                        <Setter Property="Background" Value="{DynamicResource Chat.Diff.Removed.Background}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <Border Grid.Column="2" Grid.ColumnSpan="2">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding NewKind}" Value="{x:Static models:EditDiffKind.Add}">
                                                                                        <Setter Property="Background" Value="{DynamicResource Chat.Diff.Added.Background}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding OldNo}" Foreground="{DynamicResource Text.Muted}" TextAlignment="Right" Padding="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding OldText}" TextTrimming="CharacterEllipsis" Padding="0,0,8,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding OldKind}" Value="{x:Static models:EditDiffKind.Remove}">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger.Soft}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Text="{Binding NewNo}" Foreground="{DynamicResource Text.Muted}" TextAlignment="Right" Padding="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding NewText}" TextTrimming="CharacterEllipsis" Padding="0,0,8,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding NewKind}" Value="{x:Static models:EditDiffKind.Add}">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success.Soft}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <!-- Raw tool output (collapsible) -->
                                        <Expander IsExpanded="{Binding IsExpanded}">
                                            <Expander.Header>
                                                <TextBlock Foreground="{DynamicResource Text.Muted}" FontSize="11">
                                                    <Run Text="{services:Loc chat.showOutput}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding ToolOutputLines, Mode=OneWay}"/>
                                                    <Run Text="{services:Loc chat.linesSuffix}"/>
                                                </TextBlock>
                                            </Expander.Header>
                                            <Border Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                                    MaxHeight="300">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding ToolOutput}"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="11" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </Border>
                                            <Expander.Style>
                                                <Style TargetType="Expander" BasedOn="{StaticResource ToolExpander}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Role}" Value="{x:Static models:MessageRole.ToolAction}"/>
                                                                <Condition Binding="{Binding ToolOutput, Converter={StaticResource BoolVis}}" Value="Visible"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                        </Expander>
                                        </StackPanel>

                                        <!-- Row 5: Error bar with retry hint — only where Retry is actually offered -->
                                        <Border Grid.Row="5" Margin="0,4,0,0" Padding="6,3"
                                                Background="{DynamicResource Status.Danger.Tint}" CornerRadius="4"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Status.Danger}"
                                                       FontFamily="{DynamicResource Font.Ui.Display}">
                                                <Run Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                                <Run Text="{services:Loc chat.errorHover}"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Row 6: Footer — streaming dots + timestamp -->
                                        <StackPanel Grid.Row="6" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <!-- Compact streaming indicator -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,6,0"
                                                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}}">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent.2}" Margin="1,0"
                                                         Style="{StaticResource PulseDot}"/>
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent.2}" Margin="1,0"
                                                         Style="{StaticResource PulseDot}"/>
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent.2}" Margin="1,0"
                                                         Style="{StaticResource PulseDot}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.User}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Grid><!-- close gutter+bubble Grid -->
                            </Grid><!-- close message wrapper Grid -->
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ═══ The plan, floating over the top of the chat; branch chips jump between related chats ═══
                     A new plan floats in for a few seconds (longer while the mouse is on it), then the card shows only
                     while the plan card in the chat is scrolled out of view (ChatViewModel.Plan: FloatingPlanShows).
                     Shown and hidden from code (ChatView.xaml.cs SyncStickyBar): it slides in and fades out. -->
                <Border x:Name="StickyPlanBar" VerticalAlignment="Top" Margin="22,8,30,0" CornerRadius="12"
                        BorderThickness="2" BorderBrush="{Binding StickyPlanCharacter.AccentBrush}"
                        Background="{DynamicResource Dialog.Background}" Effect="{DynamicResource Shadow.Dialog}"
                        MaxWidth="900" HorizontalAlignment="Stretch" Visibility="Collapsed"
                        MouseEnter="StickyPlanBar_MouseEnter" MouseLeave="StickyPlanBar_MouseLeave">
                    <!-- her colour washed over the theme's own surface, so the text stays the theme's to keep readable -->
                    <Border Padding="12,9,12,9" CornerRadius="10" Background="{Binding StickyPlanCharacter.WashBrush}">
                    <StackPanel>
                        <Grid Visibility="{Binding StickyBarShowsPlan, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- close the plan bar mid-way (it comes back only for a new plan; it also goes once all is done) -->
                            <Button Grid.Column="4" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6,3" Margin="4,0,0,0"
                                    Style="{StaticResource IconButton}" Command="{Binding DismissStickyPlanCommand}"
                                    ToolTip="{services:Loc chat.plan.closeTip}"/>
                            <!-- who is writing this plan: her portrait and name, the colour of the whole bar -->
                            <ContentControl Content="{Binding StickyPlanCharacter}" ContentTemplate="{StaticResource CxCharTag}" Focusable="False"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                                <!-- "แผนงาน 5/12": the count ticks (a short rise and fade-in) each time it moves on -->
                                <TextBlock DockPanel.Dock="Left" Text="{Binding StickyPlanHeader, Mode=OneWay, NotifyOnTargetUpdated=True}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard>
                                                <Storyboard FillBehavior="Stop">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.35"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(views:Motion.ShiftY)" From="5" To="0" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Left" Text="  ·  " FontSize="13" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StickyPlanNow, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StickyPlanNow, Mode=OneWay}"
                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button Grid.Column="2" Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="6,3" Margin="8,0,0,0"
                                    Style="{StaticResource IconButton}" Command="{Binding OpenPlanWindowCommand}"
                                    ToolTip="{services:Loc plan.open.tip}"/>
                            <ToggleButton Grid.Column="3" Margin="4,0,0,0" Padding="6,3" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsStickyPlanExpanded}" ToolTip="{services:Loc chat.plan.expandTip}"
                                          Foreground="{DynamicResource Text.Muted}" FontFamily="Segoe MDL2 Assets" FontSize="11">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="&#xE70D;"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="&#xE70E;"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                        <!-- progress line: glides to each new value (Views/Motion.Fraction) instead of jumping -->
                        <Grid Height="5" Margin="0,8,0,0" Visibility="{Binding StickyBarShowsPlan, Converter={StaticResource BoolVis}}">
                            <Border CornerRadius="2.5" Background="{DynamicResource State.Fill.Faint}"/>
                            <Border CornerRadius="2.5" Background="{Binding StickyPlanCharacter.AccentBrush}"
                                    views:Motion.Fraction="{Binding StickyPlanProgress, Mode=OneWay}"/>
                        </Grid>
                        <!-- the whole plan, when expanded: a long plan scrolls inside the card instead of covering the chat -->
                        <!-- every step plays its state (Resources/Theme.xaml, PLAN STEPS), in the colour of who writes the plan -->
                        <Border Visibility="{Binding StickyBarShowsPlan, Converter={StaticResource BoolVis}}">
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" MaxHeight="300" Margin="-4,8,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      Visibility="{Binding IsStickyPlanExpanded, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding StickyPlanItems}"
                                      views:Motion.Accent="{Binding StickyPlanCharacter.AccentBrush}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource PlanStepRow}" Margin="0,1">
                                        <StackPanel>
                                            <!-- a grid, not a horizontal stack: the words get the room that is left, so a long step trims (whole text in the tip) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlanStepMark}" Focusable="False"
                                                                VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text}" VerticalAlignment="Center" Style="{StaticResource PlanStepText}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Running}" Margin="27,1,0,1" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}"
                                                       Visibility="{Binding HasRunning, Converter={StaticResource BoolVis}}"/>
                                            <!-- the chat's run ended on this step (Stop, or it finished without ticking it) -->
                                            <TextBlock Text="{services:Loc plan.step.stopped}" Margin="27,1,0,1" FontSize="11"
                                                       Foreground="{DynamicResource Status.Warning}"
                                                       Visibility="{Binding IsStopped, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        </Border>
                        <!-- related chats: where this one branched from, and its branches -->
                        <ItemsControl ItemsSource="{Binding StickyBranches}" Margin="0,8,0,0"
                                      Visibility="{Binding HasStickyBranches, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,4" Padding="9,3" Cursor="Hand" ToolTip="{services:Loc chat.plan.goTip}"
                                            Command="{Binding DataContext.GoToChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding SessionId}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chip" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                                        BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource State.Fill.Faint}">
                                                    <TextBlock FontSize="11.5" MaxWidth="320" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Text.Primary}"/>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </Border>
                </Border>
        </Grid>

        <!-- ═══ NEW CHAT PAGE: "what do you want to make?" (ChatViewModel.Starters) ═══ -->
        <!-- A starter asks which project first (a new chat has no folder), then fills an editable prompt into the box.
             It never sends: the [bracketed] part is selected for the user to type over (ChatView.xaml.cs). -->
        <ScrollViewer x:Name="NewChatPage" Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Messages.Count, Converter={StaticResource BoolVis}, ConverterParameter=Invert, FallbackValue=Visible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,24,16,24" MaxWidth="900">
                <TextBlock Text="{services:Loc starter.title}"
                           Foreground="{DynamicResource Accent.Gradient}"
                           FontSize="{DynamicResource Starter.Title.Size}" FontWeight="Bold"
                           FontFamily="{DynamicResource Font.Ui.Display}"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <TextBlock Text="{services:Loc starter.subtitle}"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="14" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Margin="0,8,0,0" MaxWidth="560"/>

                <!-- The starters -->
                <ItemsControl x:Name="StarterList" ItemsSource="{Binding StarterTemplates}" Margin="0,24,0,0" Focusable="False"
                              Visibility="{Binding IsChoosingStarterProject, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StarterTile}" ToolTip="{Binding Hint}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.PickStarterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <Border Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Center"
                                            Background="{DynamicResource State.Fill.Faint}" BorderThickness="1"
                                            BorderBrush="{DynamicResource Border.Subtle}">
                                        <TextBlock Text="{Binding Glyph}" FontSize="19" Style="{StaticResource StarterGlyph}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Margin="4,9,4,0" MaxWidth="122"
                                               FontSize="12.5" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Ui.Display}"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Which project? -->
                <Border x:Name="StarterProjectCard" Margin="0,24,0,0" MaxWidth="580" Padding="20,18" CornerRadius="16"
                        BorderThickness="1" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Accent.1.Border}"
                        Effect="{DynamicResource Fx.Card.Glow}"
                        Visibility="{Binding IsChoosingStarterProject, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Margin="0,0,12,0"
                                    Background="{DynamicResource State.Fill.Faint}" DataContext="{Binding PendingStarter}">
                                <TextBlock Text="{Binding Glyph}" FontSize="18" Style="{StaticResource StarterGlyph}"/>
                            </Border>
                            <TextBlock Text="{Binding StarterProjectTitle}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Ui.Display}"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding StarterWillReplaceInput, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Status.Warning}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StarterReplaceWarning" Text="{services:Loc starter.project.replaceWarning}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Status.Warning}"/>
                        </StackPanel>

                        <TextBlock Text="{services:Loc starter.project.recent}" Margin="0,14,0,4" FontSize="11"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Visibility="{Binding HasStarterProjects, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl x:Name="StarterProjectList" ItemsSource="{Binding StarterProjects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource StarterProjectRow}" ToolTip="{Binding Path}"
                                            AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.UseStarterProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Accent.2}" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Text.Muted}" FontFamily="{DynamicResource Font.Mono}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource Accent.1.Tint}"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{services:Loc starter.project.current}" FontSize="10.5"
                                                           Foreground="{DynamicResource Accent.1}"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{services:Loc starter.project.empty}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Visibility="{Binding HasStarterProjects, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="StarterBrowseButton" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,4,8,0"
                                    Command="{Binding BrowseStarterProjectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{services:Loc starter.project.browse}" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StarterNoProjectButton" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,4,8,0"
                                    ToolTip="{services:Loc starter.project.noneTip}"
                                    Command="{Binding StarterWithoutProjectCommand}">
                                <TextBlock Text="{services:Loc starter.project.none}" FontSize="12.5"/>
                            </Button>
                            <Button x:Name="StarterCancelButton" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,4,0,0"
                                    Command="{Binding CancelStarterCommand}">
                                <TextBlock Text="{services:Loc starter.project.cancel}" FontSize="12.5"/>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenFolderCommand}"
                            Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{services:Loc chat.openProjectFolder}" FontFamily="{DynamicResource Font.Ui.Display}"
                                       FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding CloneRepoCommand}"
                            Padding="14,8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{DynamicResource Accent.2}"/>
                            <TextBlock Text="{services:Loc chat.connectRepo}" FontFamily="{DynamicResource Font.Ui.Display}"
                                       FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{services:Loc chat.openHint}"
                           Foreground="{DynamicResource Text.Muted}"
                           FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ════ STRATEGIC COMPACTION TOAST (Sprint 2 #2) ════ -->
        <!-- Non-blocking nudge that fires at logical breakpoints (50+ tool calls /
             ctx ≥ 60% / ctx ≥ 75%) BEFORE the urgent warning bar below. Severity
             drives the color: info=cyan, warn=amber, critical=red. -->
        <Border Grid.Row="2" Padding="14,10" Margin="16,6,16,0" CornerRadius="10" MaxWidth="1060"
                BorderThickness="1"
                Visibility="{Binding ShowCompactionToast, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Default = info (cyan). Whole brush / effect tokens only: an inline DropShadowEffect
                         or SolidColorBrush inside a style setter is sealed and cannot follow a theme. -->
                    <Setter Property="Background" Value="{DynamicResource Accent.1.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.1.Border}"/>
                    <Setter Property="Effect" Value="{DynamicResource Glow.Toast.Info}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactionToastSeverity}" Value="warn">
                            <Setter Property="Background" Value="{DynamicResource Status.Warning.Tint}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning.Border}"/>
                            <Setter Property="Effect" Value="{DynamicResource Glow.Toast.Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CompactionToastSeverity}" Value="critical">
                            <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Border}"/>
                            <Setter Property="Effect" Value="{DynamicResource Glow.Toast.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- Glyph · text with the actions under it · dismiss. The actions used to be columns of their own: in a
                     narrow chat (docked beside the editor) the text was squeezed to a sliver and "Compact now" stretched
                     into a tall block (owner's screenshot, 2026-10-13). Under the text they fit any width. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Severity glyph -->
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompactionToastSeverity}" Value="warn">
                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CompactionToastSeverity}" Value="critical">
                                    <Setter Property="Text" Value="&#xE783;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompactionToastTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{Binding CompactionToastReason}" FontSize="11"
                               Foreground="{DynamicResource Text.Secondary}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <WrapPanel>
                    <!-- Compact now (primary action) -->
                    <Button Padding="12,6" Margin="0,8,6,0" Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding AcceptCompactionToastCommand}"
                            Background="{DynamicResource Accent.2}" BorderThickness="0" Foreground="{DynamicResource Text.OnAccent}"
                            ToolTip="{services:Loc chat.compactNowTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.2.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc chat.compactNow}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Snooze 10 turns -->
                    <Button Padding="10,6" Margin="0,8,10,0" Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding SnoozeCompactionToastCommand}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Surface.Raised.Strong}" BorderThickness="1"
                            Foreground="{DynamicResource Text.Secondary}"
                            ToolTip="{services:Loc chat.snoozeTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc chat.snooze}" FontSize="11"/>
                        </StackPanel>
                    </Button>

                        <!-- Stop asking: compact by itself from now on (also in Settings) -->
                        <CheckBox IsChecked="{Binding AutoCompactWhenSuggested}" Margin="0,8,0,0" VerticalAlignment="Center"
                                  ToolTip="{services:Loc chat.toast.autoCompactTip}">
                            <TextBlock Text="{services:Loc chat.toast.autoCompact}" FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>

                <!-- Dismiss (x) -->
                <Button Grid.Column="2" Width="28" Height="28" Cursor="Hand" VerticalAlignment="Top"
                        Command="{Binding DismissCompactionToastCommand}"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{services:Loc chat.dismissTip}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="14">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- CONTEXT WARNING BAR with action buttons -->
        <!-- Hidden when the strategic compaction toast is active to avoid visual stacking at Row 3 -->
        <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource Banner.Warning.Background}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Surface.Sunken}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowContextWarning}" Value="True"/>
                                <Condition Binding="{Binding ShowCompactionToast}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource Status.Warning}"/>
                    <ProgressBar Value="{Binding ContextUsagePercent}" Maximum="100"
                                 Width="120" Height="8"
                                 Style="{StaticResource ContextProgressBar}"
                                 Foreground="{Binding ContextUsagePercent, Converter={StaticResource CtxBrush}}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ContextUsageText}"
                               Foreground="{DynamicResource Status.Warning}"
                               FontSize="11" FontWeight="SemiBold"
                               FontFamily="{DynamicResource Font.Mono}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ContextWarningText}"
                           Foreground="{DynamicResource Status.Warning}"
                           FontSize="11" FontFamily="{DynamicResource Font.Ui.Display}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Compact button -->
                <Button Grid.Column="2" Padding="8,3" Margin="4,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompactCommand}"
                        ToolTip="{services:Loc chat.compactTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{services:Loc chat.compact}" FontFamily="{DynamicResource Font.Ui.Display}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- New Chat button -->
                <Button Grid.Column="3" Padding="10,4" Margin="4,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewSessionCommand}"
                        ToolTip="{services:Loc chat.newChatTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{services:Loc chat.newChat}" FontFamily="{DynamicResource Font.Ui.Display}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- COMPOSER — one card under the reading column: a status line (what the agent is doing, context left), the
             box, and along its bottom edge the controls that used to be spread over two bars: model, thinking, effort,
             approvals, budget, the cost estimate, batch, and send. -->
        <Border Grid.Row="3" Background="{DynamicResource Bg.Elevated}" Padding="16,4,16,12">
            <Grid MaxWidth="1060">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Who answers this chat: her tag on the card's top edge (not in Classic) -->
                <ContentControl x:Name="ComposerWho" Grid.Row="1" Panel.ZIndex="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-15,16,0" IsHitTestVisible="False" Focusable="False"
                                Content="{Binding ActiveCharacter}" ContentTemplate="{StaticResource CxCharTag}"
                                Visibility="{DynamicResource Fx.Flourish}"
                                AutomationProperties.AutomationId="CxGuard.ComposerWho"/>

                <!-- The card -->
                <Border x:Name="ComposerCard" Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="14,10,10,8"
                        AllowDrop="True" PreviewDragOver="Composer_PreviewDragOver" PreviewDrop="Composer_PreviewDrop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Surface.Input}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                </Trigger>
                                <!-- With the flourishes on (not Classic): framed in the colour of the girl answering this chat
                                     (the cowork room: the member answering now) — softer until the box has the focus -->
                                <DataTrigger Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible">
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="BorderBrush" Value="{Binding ActiveCharacter.FrameBrush}"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding (views:CharacterLook.Show), RelativeSource={RelativeSource Self}}" Value="Visible"/>
                                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{Binding ActiveCharacter.AccentBrush}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Images attached to the next message (Ctrl+V, drop, "+"), each with its ×; then the other files -->
                        <StackPanel Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding PendingImages}" Margin="0,0,0,8"
                                      Visibility="{Binding HasPendingImages, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,10,0">
                                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}"
                                                Background="{DynamicResource Surface.Sunken}" ClipToBounds="True">
                                            <Image Source="{Binding Converter={StaticResource ThumbSource}}" Height="60" MaxWidth="110"
                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Cursor="Hand"
                                                Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="{services:Loc chat.attach.remove}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Bg.Elevated}"
                                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="0,0,0,8"
                                      Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4,8,0" Padding="8,4,4,4" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Sunken}"
                                            ToolTip="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Converter={StaticResource FileGlyph}}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Converter={StaticResource FileNameOf}}" FontFamily="{DynamicResource Font.Ui}" FontSize="12"
                                                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" MaxWidth="220"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Margin="6,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemovePendingFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{services:Loc chat.attach.removeFile}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Bg.Elevated}"
                                                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                       Foreground="{DynamicResource Text.Primary}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <!-- Borderless: the card is the box. -->
                            <TextBox x:Name="InputBox" Style="{x:Null}"
                                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Text.Primary}"
                                     SelectionBrush="{DynamicResource Accent.1}"
                                     FontFamily="{DynamicResource Font.Ui}" FontSize="14"
                                     MinHeight="44" MaxHeight="200"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="InputBox_MentionKeys" TextChanged="InputBox_MentionChanged"
                                     SelectionChanged="InputBox_MentionCaret"/>
                            <!-- @-mentions: the project's files and names that match what follows the "@" (ChatView.Mentions.cs) -->
                            <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Top" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                                <Border Width="420" MaxHeight="320" CornerRadius="10" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                        Background="{DynamicResource Bg.Elevated}" BorderBrush="{DynamicResource Border.Default}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="{services:Loc vibe.mention.title}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="6,2,6,4"/>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{services:Loc vibe.mention.hint}" FontSize="10.5"
                                                   Foreground="{DynamicResource Text.Faint}" Margin="6,4,6,0"/>
                                        <TextBlock DockPanel.Dock="Top" x:Name="MentionEmpty" FontSize="12" Foreground="{DynamicResource Text.Muted}"
                                                   Margin="6,4" Visibility="Collapsed"/>
                                        <ListBox x:Name="MentionList" BorderThickness="0" Background="Transparent" Focusable="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseLeftButtonUp="MentionList_Click"
                                                 AutomationProperties.AutomationId="CxChat.MentionList">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="Ic" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Text.Primary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSymbol}" Value="True">
                                                            <Setter TargetName="Ic" Property="Text" Value="&#xE943;"/>
                                                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Popup>
                            <!-- While a reply runs the box stays open: Enter sends to it (it reads it at its next step) -->
                            <TextBlock FontFamily="{DynamicResource Font.Ui}" FontSize="14"
                                       Foreground="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Top" Margin="2,0,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding UserInput, Converter={StaticResource BoolVis}, ConverterParameter=Invert, FallbackValue=Visible}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{services:Loc chat.placeholder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                <Setter Property="Text" Value="{services:Loc chat.steer.placeholder}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Options, then the mic / send / stop buttons. A narrow composer (the chat docked beside the editor)
                             moves the buttons to a row of their own: see ChatView.ApplyComposerLayout. -->
                        <Grid x:Name="ComposerStrip" Grid.Row="2" Margin="0,8,0,0" SizeChanged="ComposerStrip_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <WrapPanel x:Name="ComposerOptions" Orientation="Horizontal" VerticalAlignment="Center" ItemHeight="34"
                                       TextElement.FontSize="12" TextElement.FontFamily="{DynamicResource Font.Ui}">
                                <!-- The project's errors from the last build / test / check: one click hands them to the AI -->
                                <Button x:Name="ErrorChip" Command="{Binding FixErrorsCommand}" Cursor="Hand" Margin="0,2,8,2" VerticalAlignment="Center"
                                        ToolTip="{Binding ErrorChipTip}" AutomationProperties.AutomationId="CxChat.ErrorChip"
                                        Visibility="{Binding HasErrorChip, Converter={StaticResource BoolVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="13" Padding="10,4" BorderThickness="1"
                                                    Background="{DynamicResource Status.Danger.Tint}" BorderBrush="{DynamicResource Status.Danger.Border}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Status.Danger.Soft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Status.Danger}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ErrorChipText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Status.Danger}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- "+": the switches and actions that don't need a pill of their own -->
                                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,2,8,2"
                                        Click="MoreButton_Click" ToolTip="{services:Loc chat.more.tip}">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Text.Secondary}"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{services:Loc chat.attach.image}" Click="AttachImage_Click"
                                                      ToolTip="{services:Loc chat.attach.dropHint}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{services:Loc chat.attach.file}" Click="AttachFile_Click"
                                                      ToolTip="{services:Loc chat.attach.fileHint}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{services:Loc chat.agentLabel}" IsCheckable="True" IsChecked="{Binding AgenticMode}" ToolTip="{services:Loc chat.agentTip}"/>
                                            <MenuItem Header="{services:Loc chat.autonomousLabel}" IsCheckable="True" IsChecked="{Binding AutonomousMode}" ToolTip="{services:Loc chat.autoTip}"/>
                                            <MenuItem Header="{services:Loc chat.showThinkingLabel}" IsCheckable="True" IsChecked="{Binding ShowThinking}" ToolTip="{services:Loc chat.thinkingTip}"/>
                                            <MenuItem Header="{services:Loc chat.stepsLabel}" IsCheckable="True" IsChecked="{Binding ShowAgentInternals}" ToolTip="{services:Loc chat.stepsTip}"/>
                                            <MenuItem Header="{services:Loc chat.autoRunLabel}" IsCheckable="True" IsChecked="{Binding AutoExecute}" ToolTip="{services:Loc chat.autoRunWarnTip}"/>
                                            <MenuItem Header="{services:Loc chat.side.toggle}" IsCheckable="True" IsChecked="{Binding ShowSidePanel}"/>
                                            <Separator/>
                                            <MenuItem Header="{services:Loc chat.reviewTip}" Command="{Binding ReviewCodeCommand}"
                                                      Visibility="{Binding HasProject, Converter={StaticResource BoolVis}}"/>
                                            <MenuItem Header="{services:Loc chat.openProjectTip}" Command="{Binding OpenFolderCommand}"/>
                                            <MenuItem Header="{services:Loc chat.clearChatTip}" Command="{Binding ClearChatCommand}"/>
                                            <MenuItem Header="{services:Loc chat.newChat}" Command="{Binding NewSessionCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <!-- Folders open for this chat (project + related ones) -->
                                <Border Margin="0,2,8,2" Padding="8,3" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface.Raised}" ToolTip="{Binding OpenFoldersTip}"
                                        Visibility="{Binding HasExtraFolders, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding OpenFoldersText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"/>
                                </Border>
                                <!-- Model (an API provider with a key): shows its price; a model on this PC is named over it -->
                                <Grid Margin="0,2,8,2" VerticalAlignment="Center"
                                      Visibility="{Binding HasChatModelChoices, Converter={StaticResource BoolVis}}">
                                    <!-- The model box opens the full-screen picker (ModelPickerOverlay): provider first, then its models. -->
                                    <!-- Owner 2026-11-06: it names the model that really answers now, glows in her colour while this
                                         chat's run works, and is locked for that time (the command's CanExecute; the tooltip says why). -->
                                    <Button x:Name="ChatModelBox" Command="{Binding OpenModelPickerCommand}" MinWidth="180" Cursor="Hand" FontSize="13"
                                            ToolTip="{Binding ModelButtonTip}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.AutomationId="ChatModelBox">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource Dropdown.Background}" BorderBrush="{DynamicResource Dropdown.Border}"
                                                        BorderThickness="1" CornerRadius="8" Padding="8,3,10,3">
                                                    <!-- her glow, invisible until the run works (then it breathes) -->
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{Binding ModelButtonGlow}" BlurRadius="14" ShadowDepth="0" Opacity="0"/>
                                                    </Border.Effect>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Dropdown.Hover.Border}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsModelButtonLocked}" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{Binding ModelButtonGlow}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="Breathe">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                     From="0.25" To="0.95" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Breathe"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel LastChildFill="True">
                                            <!-- a chevron to open; a lock while the run works -->
                                            <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Dropdown.Arrow}"
                                                           Visibility="{Binding IsModelButtonLocked, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Accent.2}"
                                                           Visibility="{Binding IsModelButtonLocked, Converter={StaticResource BoolVis}}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding HasModelButtonText, Converter={StaticResource BoolVis}}">
                                                <!-- the vendor's girl, a round portrait of her face (ChatCharacter.FaceBrush); not in Classic -->
                                                <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{DynamicResource Fx.Flourish}">
                                                    <Ellipse Stroke="{DynamicResource Accent.1}" StrokeThickness="1.2" Fill="{Binding ModelButtonFace}"/>
                                                </Grid>
                                                <!-- the model that really answers ("Opus 5.5", a CLI's default as the model it ran, the loaded GGUF) -->
                                                <TextBlock Text="{Binding ModelButtonText}" FontFamily="{DynamicResource Font.Mono}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dropdown.Foreground}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                <TextBlock Text="{Binding ModelButtonPrice}" FontSize="11" Foreground="{DynamicResource Status.Warning}"
                                                           FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           ToolTip="{services:Loc chat.model.priceTip}"
                                                           Visibility="{Binding ModelButtonPrice, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding LiveEffortSuffix}"
                                                           FontSize="11" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Accent.2}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding SelectedChatModel, Converter={StaticResource NullToCollapsed}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ChatModelPlaceholder}" Foreground="{DynamicResource Text.Muted}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,30,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowModelPlaceholder, Converter={StaticResource BoolVis}}"/>
                                </Grid>

                                <!-- A model on this PC (GGUF): only while one answers the chat — shown for every provider, it
                                     let a Claude chat load a GGUF and switch itself to Local without a word. -->
                                <!-- A DockPanel, not a StackPanel: in a narrow composer (the chat docked in the Edit page) the
                                     picker gives up width instead of pushing its refresh button out of sight. -->
                                <DockPanel Margin="0,2,8,2" VerticalAlignment="Center" LastChildFill="True"
                                            Visibility="{Binding ShowLocalModelPicker, Converter={StaticResource BoolVis}}">
                                    <TextBlock DockPanel.Dock="Right" Text="{services:Loc chat.loading}" Foreground="{DynamicResource Status.Warning}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Visibility="{Binding IsLoadingModel, Converter={StaticResource BoolVis}}"/>
                                    <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshModelsCommand}" ToolTip="{services:Loc chat.refreshModelsTip}"
                                            Width="26" Height="26" FontSize="11" Margin="2,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedLocalModel}"
                                              Style="{StaticResource ModernComboBox}" Padding="10,4" FontSize="13" MinWidth="120" MaxWidth="240"
                                              HorizontalAlignment="Left" ToolTip="{services:Loc chat.selectModelTip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding QuantizationType}" FontSize="11" Foreground="{DynamicResource Accent.2}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>

                                <CheckBox IsChecked="{Binding ExtendedThinkingEnabled}" Foreground="{DynamicResource Accent.2}"
                                          Visibility="{Binding ThinkToggleVisible, Converter={StaticResource BoolVis}}"
                                          VerticalAlignment="Center" Margin="0,2,10,2" ToolTip="{services:Loc chat.extendedThinkingTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{services:Loc chat.think}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Ultra: this chat may run multi-agent workflows (off by default, per chat) -->
                                <CheckBox x:Name="UltraToggle" IsChecked="{Binding IsUltra}" Foreground="{DynamicResource Accent.2}"
                                          VerticalAlignment="Center" Margin="0,2,10,2" ToolTip="{services:Loc orch.ultraTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{services:Loc orch.ultra}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Colibri: read-only sub-agents on the model already loaded on this PC instead of a cheap API model
                                     (the same setting as Settings ▸ Agent and the Colibri card); shown once a local engine is installed -->
                                <CheckBox x:Name="LocalAgentsToggle" IsChecked="{Binding SubAgentsOnLocal}" Foreground="{DynamicResource Accent.2}"
                                          Visibility="{Binding LocalAgentsSwitchVisible, Converter={StaticResource BoolVis}}"
                                          VerticalAlignment="Center" Margin="0,2,10,2" ToolTip="{services:Loc orch.localAgentsTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{services:Loc orch.localAgents}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Design: this chat's design turns bring the UI Studio forward. Hidden for now (owner 2026-11-09):
                                     a turn follows the Code page only (DesignGate.Enabled) -->
                                <CheckBox x:Name="DesignToggle" IsChecked="{Binding IsDesignMode}" Foreground="{DynamicResource Accent.2}"
                                          Visibility="{Binding DesignModeAvailable, Converter={StaticResource BoolVis}}"
                                          VerticalAlignment="Center" Margin="0,2,10,2" ToolTip="{services:Loc chat.designTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{services:Loc chat.design}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Smart skills: each turn offers only the skills that fit it (on by default; the Skills page sets the default) -->
                                <CheckBox x:Name="SkillPickToggle" IsChecked="{Binding IsSkillAutoPick}" Foreground="{DynamicResource Accent.2}"
                                          VerticalAlignment="Center" Margin="0,2,10,2" ToolTip="{Binding SkillPickTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{services:Loc chat.skillPick}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center"
                                            Visibility="{Binding EffortVisible, Converter={StaticResource BoolVis}}">
                                    <TextBlock x:Name="EffortLabel" Text="{services:Loc chat.effort}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                                               Margin="0,0,5,0" ToolTip="{services:Loc chat.effortTip}"/>
                                    <!-- "auto → medium": while a run works under auto, the closed box shows the level it really uses -->
                                    <ComboBox x:Name="EffortBox" ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding ReasoningEffort}"
                                              Style="{StaticResource ModernComboBox}" Padding="10,4" FontSize="13" MinWidth="92"
                                              Tag="{Binding LiveEffortLevel}" ToolTip="{services:Loc chat.effortTip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Accent.2}">
                                                        <Run Text="→ "/><Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}, Mode=OneWay}"/>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}"/>
                                                                            <Condition Binding="{Binding}" Value="auto"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- What really answers: the model the response named and the effort the request really carried
                                     ("Opus 5.5 · auto → high (bug fix)"); for every provider, also those without an effort -->
                                <Border x:Name="LiveEffortChip" CornerRadius="6" Padding="8,3" Margin="0,2,8,2" VerticalAlignment="Center"
                                        Background="{DynamicResource State.Fill.Faint}" ToolTip="{Binding LiveModelEffortTip}"
                                        AutomationProperties.AutomationId="CxChat.LiveModelEffort">
                                    <TextBlock Text="{Binding LiveModelEffortText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                               FontFamily="{DynamicResource Font.Mono}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                </Border>

                                <!-- Approvals: ask first / accept edits in the project / allow everything in this chat
                                     (confirmed; the user's Deny and Ask rules and code run in their browser still apply). -->
                                <ComboBox x:Name="ApprovalBox" ItemsSource="{Binding ApprovalChoices}"
                                          SelectedValuePath="Key" SelectedValue="{Binding ApprovalMode}"
                                          Style="{StaticResource ModernComboBox}" Padding="10,4" FontSize="13" MinWidth="150"
                                          Margin="0,2,8,2" VerticalAlignment="Center" ToolTip="{services:Loc chat.approval.tip}">
                                    <!-- An item template, not DisplayMemberPath: the closed box then shows the label too, and follows the language. -->
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Spend: a paid run stops and asks once it has spent this much -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center"
                                            Visibility="{Binding HasBillingPage, Converter={StaticResource BoolVis}}">
                                    <TextBlock x:Name="BudgetLabel" Text="{services:Loc chat.budget.label}" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"
                                               Margin="0,0,5,0" ToolTip="{services:Loc chat.budget.tip}"/>
                                    <ComboBox x:Name="BudgetBox" ItemsSource="{Binding BudgetChoices}"
                                              SelectedValuePath="Usd" SelectedValue="{Binding RunBudgetUsd}"
                                              Style="{StaticResource ModernComboBox}" Padding="10,4" FontSize="13" MinWidth="86"
                                              ToolTip="{services:Loc chat.budget.tip}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Before a run: what a step should cost (tooltip: the arithmetic and how many steps the budget buys) -->
                                <Border CornerRadius="6" Padding="8,4" Margin="0,2,8,2" VerticalAlignment="Center"
                                        Background="{DynamicResource State.Fill.Faint}" ToolTip="{Binding EstimateTip}"
                                        Visibility="{Binding EstimateShortText, Converter={StaticResource BoolVis}}">
                                    <TextBlock x:Name="EstimateLabel" Text="{Binding EstimateShortText}" Foreground="{DynamicResource Text.Secondary}" FontSize="12"/>
                                </Border>

                                <!-- How full the AI's memory is, and when a compaction comes (tooltip) — beside the cost -->
                                <Border x:Name="ContextGauge" CornerRadius="6" Padding="8,4" Margin="0,2,8,2" VerticalAlignment="Center"
                                        Background="{DynamicResource State.Fill.Faint}" ToolTip="{Binding ContextGaugeTip}"
                                        AutomationProperties.AutomationId="CxChat.ContextGauge"
                                        Visibility="{Binding ContextGaugeText, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="34" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Border Background="{DynamicResource Led.Off}" CornerRadius="3"/>
                                            <Border CornerRadius="3" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" Width="34"
                                                    Background="{Binding ContextUsagePercent, Converter={StaticResource CtxBrush}}">
                                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding ContextFraction}"/></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ContextGaugeText}" Foreground="{DynamicResource Text.Secondary}" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Follow edits: this chat's edits open in the editor while it is on screen (per chat) -->
                                <CheckBox x:Name="FollowEditsBox" IsChecked="{Binding FollowEditsHere}" VerticalAlignment="Center" Margin="0,2,10,2"
                                          ToolTip="{services:Loc chat.follow.tip}">
                                    <TextBlock Text="{services:Loc chat.follow.label}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </CheckBox>

                                <!-- Batch: the next questions go out at half price through the provider's batch API and the
                                     answer lands in this chat later. Only shown when the active provider has one. -->
                                <CheckBox IsChecked="{Binding BatchMode}" Foreground="{DynamicResource Status.Success}"
                                          VerticalAlignment="Center" Margin="0,2,6,2" ToolTip="{services:Loc chat.batchTip}"
                                          Visibility="{Binding CanUseBatch, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{services:Loc chat.batchLabel}" FontSize="12" VerticalAlignment="Center"/>
                                </CheckBox>
                                <TextBlock Text="{Binding BatchPendingText}" Foreground="{DynamicResource Status.Success}"
                                           VerticalAlignment="Center" Margin="0,2,8,2" ToolTip="{services:Loc chat.batch.pendingTip}"
                                           Visibility="{Binding BatchPendingText, Converter={StaticResource BoolVis}}"/>
                            </WrapPanel>

                            <StackPanel x:Name="ComposerButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <!-- Speak instead of typing: Chrome's free speech-to-text; the words land in the box, unsent -->
                                <Button x:Name="MicButton" Content="&#xE720;" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleDictationCommand}" Margin="0,0,6,0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,8"
                                        ToolTip="{services:Loc chat.mic.tip}"
                                        Visibility="{Binding IsDictating, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                <Button x:Name="MicOnButton" Content="&#xE720;" Command="{Binding ToggleDictationCommand}" Margin="0,0,6,0"
                                        Background="{DynamicResource Status.Danger}" Foreground="White"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,8"
                                        ToolTip="{services:Loc chat.mic.stopTip}"
                                        Visibility="{Binding IsDictating, Converter={StaticResource BoolVis}}">
                                    <Button.Style>
                                        <!-- Pulses only while listening: a forever-animation on a collapsed button would keep WPF rendering frames. -->
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDictating}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="MicPulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.7"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="MicPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Live voice (Settings › Voice, off by default): a GPT-Live call; the meter shows its cost by the second -->
                                <TextBlock x:Name="LiveMeter" Text="{Binding LiveVoiceMeter}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                           Visibility="{Binding IsLiveVoice, Converter={StaticResource BoolVis}}"/>
                                <Button x:Name="LiveButton" Content="&#xE717;" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleLiveVoiceCommand}" Margin="0,0,6,0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,8"
                                        ToolTip="{services:Loc chat.live.tip}"
                                        Visibility="{Binding ShowLiveButton, Converter={StaticResource BoolVis}}"/>
                                <Button x:Name="LiveOnButton" Content="&#xE778;" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleLiveVoiceCommand}" Margin="0,0,6,0"
                                        Background="{DynamicResource Status.Danger}" Foreground="White"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,8"
                                        ToolTip="{services:Loc chat.live.stopTip}"
                                        Visibility="{Binding IsLiveVoice, Converter={StaticResource BoolVis}}"/>
                                <!-- Plan window: this chat's plan, add items, go back to / branch from a step -->
                                <Button Content="&#xE9D5;" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding OpenPlanWindowCommand}"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="12,8"
                                        ToolTip="{services:Loc plan.open.tip}"/>
                                <Button Content="&#xE725;" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SendMessageCommand}"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="14,8"
                                        ToolTip="{services:Loc chat.send}"/>
                                <!-- Pause: finish this step, then stop cleanly — Resume (or "continue") goes on, even after a restart -->
                                <Button Content="&#xE769;" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding PauseGenerationCommand}"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="14,8"
                                        ToolTip="{services:Loc chat.pause.tip}"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}"/>
                                <Button Content="&#xE768;" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                        Command="{Binding ResumeGenerationCommand}"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="14,8"
                                        ToolTip="{services:Loc chat.pause.resumeTip}"
                                        Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"/>
                                <Button Content="&#xE71A;" Style="{StaticResource DangerButton}"
                                        Command="{Binding StopGenerationCommand}"
                                        FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="14,8"
                                        ToolTip="{services:Loc chat.stop}"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ RIGHT PANEL — the project's files, the last image the agent looked at, its last run ═══ -->
        <!-- SidePanelHost: the view hides it only inside the Edit page (which has its own explorer and terminal). On a
             narrow chat it first gives up width, then moves under the composer across the whole width (ChatView.xaml.cs). -->
        <Grid x:Name="SidePanelHost" Grid.Column="1" Grid.RowSpan="4">
        <Border x:Name="SidePanel" Width="300" Background="{DynamicResource Bg.Panel}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0"
                Visibility="{Binding SidePanelVisible, Converter={StaticResource BoolVis}}">
            <Grid>
                <!-- Row 0 held the project's files; they live in the left sidebar under the chats now (ProjectFilesPanel). -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The last image the agent looked at (a game screenshot, a page it opened) -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="14,8,14,10"
                        Visibility="{Binding LatestImagePath, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{services:Loc chat.side.image}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="4,2"
                                    Style="{StaticResource IconButton}" Width="Auto" Height="Auto"
                                    Tag="{Binding LatestImagePath}" Click="ToolThumbnail_Click" ToolTip="{services:Loc chat.thumbnail.tip}"/>
                        </Grid>
                        <!-- A click on the picture circles that spot, attaches it and starts the question in the box -->
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Bg.Window}"
                                Padding="2" Cursor="Cross" ToolTip="{services:Loc vibe.ask.hint}">
                            <Image x:Name="SidePicture" Source="{Binding LatestImagePath, Converter={StaticResource ThumbSource}}" MaxHeight="160" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" Tag="{Binding LatestImagePath}"
                                   MouseLeftButtonUp="SidePicture_Click" AutomationProperties.AutomationId="CxChat.SidePicture"/>
                        </Border>
                        <TextBlock Text="{services:Loc vibe.ask.hint}" FontSize="10.5" Foreground="{DynamicResource Text.Faint}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- The output of the last command / build / test -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="14,8,14,12"
                        Visibility="{Binding LatestRunOutput, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{services:Loc chat.side.run}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding LatestRunTitle}" FontSize="11" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,6" ToolTip="{Binding LatestRunTitle}"/>
                        <Border CornerRadius="6" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                Padding="8,6" MaxHeight="190">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding LatestRunOutput}" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                           Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!-- Drag the panel's left edge to resize it (remembered); double-click puts it back to 300. -->
        <!-- Stacked under the composer (a narrow or portrait window): drag the panel's TOP edge to share the height
             between the conversation and the files (remembered). Shown only while stacked (ChatView.xaml.cs). -->
        <views:ResizeGrip x:Name="SidePanelHeightGrip" Vertical="True" VerticalAlignment="Top" OnLeftEdge="True"
                          Key="chat.sidePanel.height" MinSize="120" MaxSize="900"
                          Target="{Binding ElementName=SidePanel}" Visibility="Collapsed"/>
        <views:ResizeGrip x:Name="SidePanelGrip" HorizontalAlignment="Left" OnLeftEdge="True" Key="chat.sidePanel" MinSize="220" MaxSize="760"
                          Target="{Binding ElementName=SidePanel}"
                          Visibility="{Binding SidePanelVisible, Converter={StaticResource BoolVis}}"/>
        </Grid>
    </Grid>
</UserControl>
