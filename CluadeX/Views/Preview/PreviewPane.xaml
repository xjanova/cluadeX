<UserControl x:Class="CluadeX.Views.Preview.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:preview="clr-namespace:CluadeX.Views.Preview"
             Background="{DynamicResource Bg.Window}">
    <UserControl.Resources>
        <Style x:Key="PreviewIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewTextButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Preview.Page.Button.Background}" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource Border.Default}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Preview.Page.Button.Hover.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- status line -->
            <RowDefinition Height="*"/>      <!-- page -->
            <RowDefinition Height="Auto"/>   <!-- console -->
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar: badge · address · go · reload · viewport · driving · pop-out ═══ -->
        <Border Grid.Row="0" Padding="6,4" Background="{DynamicResource Preview.Toolbar.Background}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding Badge, Converter={StaticResource BoolVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Preview.Badge.Local.Background}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Preview.Badge.External.Background}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource Surface.Input}" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Default}">
                    <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Padding="6,3"
                             Foreground="{DynamicResource Text.Primary}" CaretBrush="{DynamicResource Focus.Ring}"
                             FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                             ToolTip="{services:Loc preview.addressTip}"
                             KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus" LostKeyboardFocus="OnAddressBlur"/>
                </Border>

                <Button Grid.Column="2" Style="{StaticResource PreviewIconButton}" Margin="4,0,0,0"
                        Command="{Binding NavigateCommand}" ToolTip="{services:Loc preview.go}">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Accent.1}"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource PreviewIconButton}"
                        Command="{Binding ReloadCommand}" ToolTip="{services:Loc preview.reload}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>

                <Button Grid.Column="4" Margin="6,0,0,0" Cursor="Hand" Command="{Binding ToggleViewportCommand}"
                        ToolTip="{services:Loc preview.viewportTip}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource Button.Ghost.Background}" CornerRadius="10" Padding="8,2" BorderThickness="1"
                                    BorderBrush="{DynamicResource Border.Default}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Ghost.Hover.Background}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,5,0"
                                   Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewportLabel}" FontSize="10" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="5" Margin="6,0,0,0" CornerRadius="10" Padding="7,2" Background="{DynamicResource Preview.Driving.Background}"
                        VerticalAlignment="Center" ToolTip="{services:Loc preview.drivingTip}"
                        Visibility="{Binding IsAgentDriving, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Status.Warning}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc preview.driving}" FontSize="10" Foreground="{DynamicResource Status.Warning}"/>
                    </StackPanel>
                </Border>

                <Button x:Name="PopOutButton" Grid.Column="6" Style="{StaticResource PreviewIconButton}" Margin="4,0,0,0"
                        Command="{Binding PopOutCommand}" ToolTip="{services:Loc preview.popout}">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>

                <!-- Close the page: stops the engine (a game keeps running at full speed off-screen otherwise) -->
                <Button x:Name="ClosePageButton" Grid.Column="7" Style="{StaticResource PreviewIconButton}" Margin="2,0,0,0"
                        Command="{Binding ClosePageCommand}" ToolTip="{services:Loc preview.closePage}"
                        Visibility="{Binding HasPage, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Status (errors from the address bar, crash note) ═══ -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="10" Margin="8,3" TextWrapping="Wrap"
                   Foreground="{DynamicResource Status.Warning}"
                   Visibility="{Binding Status, Converter={StaticResource BoolVis}}"/>

        <!-- ═══ The page ═══ -->
        <Grid Grid.Row="2" Background="{DynamicResource Preview.Page.Background}">
            <!-- The page's window (a PreviewPaneHost, created while this pane is loaded and destroyed when it leaves the
                 tree). Shown only when the page exists and is here — an HwndHost paints over anything in its area. -->
            <Grid x:Name="HostSlot"/>

            <!-- A full-window overlay of the main window (command palette, model loading) is open: the page's native
                 window would paint over it, so the page steps aside (it keeps running off-screen). -->
            <StackPanel x:Name="CoveredState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource Preview.Page.Icon}"/>
                <TextBlock Text="{services:Loc preview.covered}" FontSize="11" Margin="0,8,0,0" MaxWidth="320" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Preview.Page.Muted}"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Preview.Page.Icon}"/>
                <TextBlock Text="{services:Loc preview.empty.title}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Preview.Page.Foreground}"/>
                <TextBlock Text="{services:Loc preview.empty.hint}" FontSize="11" Margin="0,6,0,0" MaxWidth="320"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Preview.Page.Muted}"/>
            </StackPanel>

            <!-- Engine missing: the command that fixes it, and a button that really copies it -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                        Visibility="{Binding IsEngineMissing, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{services:Loc preview.engineMissing}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                           TextAlignment="Center" Foreground="{DynamicResource Preview.Page.Foreground}"/>
                <TextBox Text="{Binding InstallCommand, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,0" Padding="6,4"
                         FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource PreviewTextButton}" Command="{Binding CopyInstallCommand}">
                        <TextBlock Text="{Binding CopyLabel}"/>
                    </Button>
                    <Button Style="{StaticResource PreviewTextButton}" Margin="8,0,0,0" Command="{Binding CheckEngineCommand}">
                        <TextBlock Text="{services:Loc preview.checkAgain}"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Locked (license / switched off) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                        Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{services:Loc preview.locked}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Preview.Page.Foreground}"/>
                <TextBlock Text="{Binding LockedReason}" FontSize="11" Margin="0,6,0,0" MaxWidth="380" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{DynamicResource Preview.Page.Muted}"/>
            </StackPanel>

            <!-- The page is in the other preview window -->
            <StackPanel x:Name="ElsewhereState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                <TextBlock Text="{services:Loc preview.elsewhere}" FontSize="12" Foreground="{DynamicResource Preview.Page.Foreground}" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PreviewTextButton}" Margin="0,8,0,0" HorizontalAlignment="Center" Click="OnBringHere">
                    <TextBlock Text="{services:Loc preview.bringHere}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Console mini-panel ═══ -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Input}"
                Visibility="{Binding HasPage, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding ToggleConsoleCommand}" Cursor="Hand" Padding="8,4" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0"
                                       Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc preview.console}" FontSize="10" Foreground="{DynamicResource Text.Muted}"/>
                            <TextBlock Text="·" Margin="6,0" FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                            <TextBlock Text="{Binding ConsoleSummary}" FontSize="10" Foreground="{DynamicResource Text.Secondary}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource PreviewIconButton}" Command="{Binding ClearConsoleCommand}">
                        <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="ConsoleScroll" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsConsoleOpen, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{services:Loc preview.consoleEmpty}" FontSize="10" Margin="10,2,10,6"
                                   Foreground="{DynamicResource Text.Faint}"
                                   Visibility="{Binding ConsoleLines.Count, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding ConsoleLines}" Margin="8,0,8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
