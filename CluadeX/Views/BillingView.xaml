<UserControl x:Class="CluadeX.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:billing="clr-namespace:CluadeX.Views.Billing">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface.Card.Flat}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
        </Style>
        <!-- A logo tile: the vendor's mark on white (its published colours read the same in every theme) -->
        <DataTemplate x:Key="LogoTile">
            <Grid Width="30" Height="30">
                <Border CornerRadius="8" Background="White" Padding="4"
                        Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}">
                    <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                </Border>
                <Border CornerRadius="8" Background="{DynamicResource Surface.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}"
                        Visibility="{Binding IsBadge, Converter={StaticResource BoolVis}}">
                    <Viewbox Margin="3" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text.Secondary}"/>
                    </Viewbox>
                </Border>
                <Border CornerRadius="8" Background="{DynamicResource Accent.Gradient}"
                        Visibility="{Binding IsAll, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Page.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="24,16,24,12" Background="{DynamicResource Page.Header.Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc billing.title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc billing.subtitle}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ItemsControl ItemsSource="{Binding Ranges}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="BillingRange" IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand" Margin="0,0,4,0">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="B" CornerRadius="8" Padding="10,4" BorderThickness="1"
                                                    Background="{DynamicResource Surface.Chip}" BorderBrush="{DynamicResource Border.Subtle}">
                                                <TextBlock x:Name="T" Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{services:Loc billing.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Provider tabs -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}" Padding="20,0,20,0"
                Background="{DynamicResource Page.Header.Background}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                <ItemsControl ItemsSource="{Binding Tabs}" AutomationProperties.Name="Providers">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,2,0" AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="B" Padding="10,8,14,9" CornerRadius="10,10,0,0" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LogoTile}" VerticalAlignment="Center"/>
                                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="N" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                                        <TextBlock Text="{Binding MonthText}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="U" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent.1}" Visibility="Hidden"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource State.Hover.Subtle}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource State.Selected}"/>
                                                <Setter TargetName="U" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="N" Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
            <Grid Margin="20,16,20,24">
                <!-- Nothing recorded yet -->
                <Border Style="{StaticResource Card}" Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560" Margin="0,40,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Accent.1}"/>
                        <TextBlock Text="{services:Loc billing.empty.title}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{services:Loc billing.empty.body}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{DynamicResource Text.Muted}"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <!-- What this tab's dollars mean -->
                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,12">
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap">
                            <Run Text="{Binding TabTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding KindNote, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Today / this week / this month / all time -->
                    <ItemsControl ItemsSource="{Binding Periods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="A" Text="{Binding Amount}" FontSize="22" FontWeight="Bold" Margin="0,4,0,2"
                                                   Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasUse}" Value="False">
                                        <Setter TargetName="A" Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tokens in the chart range -->
                    <Border Style="{StaticResource Card}" Margin="0,12,10,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding RangeText}" Style="{StaticResource Muted}" DockPanel.Dock="Right"/>
                                <TextBlock Text="{services:Loc billing.tokens.title}" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TokenCells}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,12,0" ToolTip="{Binding Note}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="V" Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Reported}" Value="False">
                                                <Setter TargetName="V" Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Spend over time -->
                    <Border Style="{StaticResource Card}" Margin="0,12,10,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding ChartTotal}" FontSize="12.5" FontWeight="SemiBold" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Legend}" Margin="0,6,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                            <Border x:Name="Sw" Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center"/>
                                            <Border x:Name="Ln" Width="14" Height="2" Background="{DynamicResource Chart.Line}" VerticalAlignment="Center"
                                                    Visibility="Collapsed"/>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLine}" Value="True">
                                                <Setter TargetName="Sw" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Ln" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <billing:SpendChart Height="210" Bars="{Binding Bars}" LineBrush="{DynamicResource Chart.Line}"
                                                    GridBrush="{DynamicResource Border.Subtle}" TextBrush="{DynamicResource Text.Muted}"/>
                                <TextBlock Text="{Binding ChartScale}" Style="{StaticResource Muted}" FontSize="10.5"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,-6,0,0"/>
                                <TextBlock Text="{services:Loc billing.chart.noUse}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasRangeData, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Models | top chats -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{services:Loc billing.models.title}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc billing.models.none}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                           Visibility="{Binding HasModels, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                <ItemsControl ItemsSource="{Binding Models}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                    <TextBlock Text="{Binding Provider}" Style="{StaticResource Muted}" Margin="8,1,0,0"
                                                               Visibility="{Binding HasProvider, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{DynamicResource Text.Secondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Cost}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                                </StackPanel>
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Margin="0,5,0,4"
                                                        Background="{DynamicResource State.Fill.Faint}">
                                                    <Border CornerRadius="2" Background="{Binding Color}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Share}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Muted}">
                                                    <Run Text="{Binding Tokens, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Requests, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{services:Loc billing.chats.title}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc billing.chats.none}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasChats, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                <ItemsControl ItemsSource="{Binding Chats}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Cost}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"/>
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Margin="0,5,0,4"
                                                        Background="{DynamicResource State.Fill.Faint}">
                                                    <Border CornerRadius="2" Background="{DynamicResource Accent.1}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Share}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Muted}">
                                                    <Run Text="{Binding Providers, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Tokens, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Requests, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SubAgents, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Budgets and limits -->
                    <Border Style="{StaticResource Card}" Margin="0,12,10,0">
                        <StackPanel>
                            <TextBlock Text="{services:Loc billing.budget.title}" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding Budgets}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <DockPanel>
                                                <TextBlock x:Name="D" Text="{Binding Detail}" FontSize="12" DockPanel.Dock="Right"
                                                           Foreground="{DynamicResource Text.Secondary}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                            </DockPanel>
                                            <Border x:Name="M" Height="6" CornerRadius="3" Margin="0,6,0,0" Background="{DynamicResource State.Fill.Faint}"
                                                    Visibility="{Binding HasMeter, Converter={StaticResource BoolVis}}">
                                                <Border x:Name="F" CornerRadius="3" Background="{DynamicResource Status.Success}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Fraction}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Reached}" Value="True">
                                                <Setter TargetName="F" Property="Background" Value="{DynamicResource Status.Danger}"/>
                                                <Setter TargetName="D" Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
