<Window x:Class="CluadeX.Views.DgxSparkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="CluadeX · DGX Spark" Width="680" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Text.Soft}">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono.Display}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Brand.Spark: NVIDIA-style green, used as a colour only (no NVIDIA logo in the app). -->
    <Border Margin="18" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border.Spark}"
            Background="{DynamicResource Dialog.Background.Spark}" Effect="{DynamicResource Shadow.Dialog}">

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,20">

            <!-- ── Header (drag handle) ── -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top"
                        Background="{DynamicResource Spark.Avatar.Background}" Effect="{DynamicResource Glow.Spark.Avatar}">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource Spark.Avatar.Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,2,10,0">
                    <TextBlock Text="{services:Loc spark.title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{services:Loc spark.subtitle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Text.Soft.Secondary}"/>
                    <TextBlock Text="{Binding ActiveLine}" FontSize="11.5" Margin="0,6,0,0"
                               FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Brand.Spark}"
                               Visibility="{Binding HasActiveLine, Converter={StaticResource BoolVis}}"/>
                    <!-- Why the context window got smaller again: CluadeX left the Spark and gave the old size back. -->
                    <TextBlock Text="{Binding ContextNote}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Status.Warning.Soft}"
                               Visibility="{Binding HasContextNote, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <Button Grid.Column="2" Width="30" Height="30" VerticalAlignment="Top" Cursor="Hand"
                        Click="Close_Click" ToolTip="{services:Loc spark.close}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="15">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Text.Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Text="{services:Loc spark.how}" TextWrapping="Wrap" FontSize="12.5" Margin="0,16,0,0"
                       Foreground="{DynamicResource Text.Soft.Secondary}"/>

            <!-- ── Connect ── -->
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{services:Loc spark.hostTitle}" Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Dialog.Input.Background}" CornerRadius="8" BorderBrush="{DynamicResource Dialog.Input.Border.Spark}" BorderThickness="1" Padding="12,0">
                        <Grid>
                            <TextBlock Text="{services:Loc spark.hostPlaceholder}" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="13"
                                       Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding HostInput, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                            <TextBox x:Name="HostBox" Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Soft}" CaretBrush="{DynamicResource Brand.Spark}"
                                     FontFamily="{DynamicResource Font.Mono.Display}" FontSize="13" Padding="0,9"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="{services:Loc spark.connect}" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Padding="18,8" IsDefault="True"
                            Command="{Binding ConnectCommand}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource Brand.Spark}"
                             Visibility="{Binding IsProbing, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            <!-- ── Result of the last action ── -->
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Success.Soft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Status.Danger.Soft}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Models ── -->
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{services:Loc spark.modelsTitle}" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,10" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Dialog.Card.Background}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Dialog.Card.Border}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Spark.Card.Active.Background}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brand.Spark.Border}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <Border Margin="8,0,0,0" CornerRadius="6" Padding="6,0" Background="{DynamicResource Spark.Chip.Hover.Background}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{services:Loc spark.recommended}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brand.Spark}"/>
                                            </Border>
                                            <Border Margin="6,0,0,0" CornerRadius="6" Padding="6,0" Background="{DynamicResource Status.Success.Tint}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{services:Loc spark.installed}" FontSize="10"
                                                           Foreground="{DynamicResource Status.Success}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UseText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Soft.Secondary}"/>
                                        <TextBlock Text="{Binding Facts}" FontSize="11" Margin="0,2,0,0"
                                                   FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Muted}"
                                                   Visibility="{Binding Facts, Converter={StaticResource BoolVis}}"/>
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsPulling, Converter={StaticResource BoolVis}}">
                                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}" BorderThickness="0"
                                                         Background="{DynamicResource Surface.Badge}" Foreground="{DynamicResource Brand.Spark}"/>
                                            <TextBlock Text="{Binding PullStatus}" FontSize="10.5" Margin="0,3,0,0"
                                                       FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="{services:Loc spark.pull}" Style="{StaticResource SecondaryButton}"
                                                Padding="12,6" FontSize="12"
                                                Command="{Binding DataContext.PullCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanPull, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="{services:Loc spark.cancel}" Style="{StaticResource SecondaryButton}"
                                                Padding="12,6" FontSize="12"
                                                Command="{Binding DataContext.CancelPullCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsPulling, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="{services:Loc spark.use}" Style="{StaticResource PrimaryButton}"
                                                Padding="16,6" FontSize="12"
                                                Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanUse, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{services:Loc spark.inUse}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brand.Spark}" VerticalAlignment="Center" Margin="6,0"
                                                   Visibility="{Binding IsInUse, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{services:Loc spark.speedNote}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource Text.Soft.Muted}"/>
                <TextBlock Text="{services:Loc spark.lanNote}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource Text.Soft.Muted}"/>
            </StackPanel>

            <!-- ── The bundle (the only purchase link: the XMAN Studio campaign page) ── -->
            <Border Margin="0,18,0,0" CornerRadius="12" Padding="16,12" BorderThickness="1"
                    BorderBrush="{DynamicResource Spark.Campaign.Border}" Background="{DynamicResource Spark.Campaign.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc spark.campaignTitle}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource Status.Warning}"/>
                        <TextBlock Text="{services:Loc spark.campaignBody}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{services:Loc spark.campaignButton}" Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0" Padding="16,8" VerticalAlignment="Center"
                            Command="{Binding OpenCampaignCommand}"/>
                </Grid>
            </Border>

            <!-- ── Footer ── -->
            <Button Content="{services:Loc spark.close}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Padding="16,6" FontSize="12" Margin="0,18,0,0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
