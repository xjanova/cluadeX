<UserControl x:Class="CluadeX.Views.InstinctsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstinctsViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>

        <!-- Card for each instinct -->
        <DataTemplate x:Key="InstinctCardTemplate" DataType="{x:Type m:Instinct}">
            <Button Click="OnInstinctClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                                Background="{StaticResource NeonCardFill}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4CDFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <!-- Pattern + tier chip + promoted badge -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Pattern}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeonInk0Brush}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Padding="6,1" CornerRadius="3" Margin="6,0,0,0"
                                Background="#22FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding ConfidenceTier}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="2" Padding="5,1" CornerRadius="3" Margin="6,0,0,0"
                                Background="#225CFFB0"
                                BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                                Visibility="{Binding Promoted, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc instincts.promotedBadge}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonMintBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Brain sync chip -->
                    <Border Padding="5,1" CornerRadius="3" HorizontalAlignment="Left" Margin="0,0,0,6"
                            Background="#22A672FF"
                            BorderBrush="{StaticResource NeonVioletBrush}" BorderThickness="1"
                            Visibility="{Binding SyncedToBrain, Converter={StaticResource BoolVis}}">
                        <TextBlock FontSize="9" FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonVioletBrush}">
                            <Run Text="🧠 SYNCED · "/>
                            <Run Text="{Binding BrainNoteId, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Confidence bar -->
                    <Grid Margin="0,0,0,4">
                        <Border Height="4" CornerRadius="2" Background="#15FFFFFF"/>
                        <Border Height="4" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.Background>
                            <Border.Width>
                                <MultiBinding StringFormat="{}{0}">
                                    <Binding Path="Confidence"/>
                                </MultiBinding>
                            </Border.Width>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Stats row -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonInk3Brush}">
                            <Run Text="conf "/>
                            <Run Text="{Binding Confidence, Mode=OneWay, StringFormat={}{0:P0}}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource NeonInk3Brush}"/>
                        <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonCyanBrush}">
                            <Run Text="seen "/>
                            <Run Text="{Binding OccurrenceCount, Mode=OneWay}"/>
                            <Run Text="×"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource NeonInk3Brush}"/>
                        <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonMintBrush}">
                            <Run Text="✓"/>
                            <Run Text="{Binding AcceptCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource NeonInk3Brush}"/>
                        <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonRedBrush}">
                            <Run Text="✗"/>
                            <Run Text="{Binding RejectCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource NeonInk3Brush}"/>
                        <TextBlock Text="{Binding RelativeLastSeen}" FontSize="10"
                                   FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonInk3Brush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="#7028326E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B22E3870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5CFFB0" Offset="0"/>
                        <GradientStop Color="#4CDFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource NeonMintBrush}"/>
            <Setter Property="Foreground" Value="#06071A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#5CFFB0" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonDanger" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="BorderBrush" Value="{StaticResource NeonRedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NeonRedBrush}"/>
        </Style>

        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#7011152E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#22FFD166" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7F141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFD166" Offset="0"/>
                                <GradientStop Color="#FF5EC4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD166" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc instincts.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0">
                            <Run Text="{services:Loc instincts.subtitle}"/>
                            <Run Text="{Binding StrongCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.strongSuffix}"/>
                            <Run Text="{Binding EmergingCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.emergingSuffix}"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.totalSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Brain status chip -->
                        <Border Padding="8,5" CornerRadius="6" Margin="0,0,6,0"
                                BorderThickness="1" VerticalAlignment="Center"
                                ToolTip="{Binding BrainStatusText}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A8388BD"/>
                                    <Setter Property="BorderBrush" Value="#558388BD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrainAvailable}" Value="True">
                                            <Setter Property="Background" Value="#22A672FF"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource NeonVioletBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock FontSize="10" FontFamily="{StaticResource NeonMonoFont}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="OFFLINE"/>
                                            <Setter Property="Foreground" Value="{StaticResource NeonInk3Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BrainAvailable}" Value="True">
                                                    <Setter Property="Text" Value="BRAIN"/>
                                                    <Setter Property="Foreground" Value="{StaticResource NeonVioletBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding SyncAllStrongCommand}" Style="{StaticResource NeonAction}"
                                IsEnabled="{Binding BrainAvailable}"
                                ToolTip="{services:Loc instincts.syncAllTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.syncAllStrong}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.export}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.import}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenStoreFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.storeFolder}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.refresh}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: list + detail -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIST -->
                <Border Grid.Column="0" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Instincts}"
                                      ItemTemplate="{StaticResource InstinctCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <!-- DETAIL + ADD-NEW COMPOSER -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource NeonPanelFill}"
                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                           Foreground="{StaticResource NeonInk3Brush}" Opacity="0.5"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{services:Loc instincts.pickHint}"
                                           FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NeonInk2Brush}"/>
                            </StackPanel>

                            <!-- Detail content -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Selected.Pattern}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk0Brush}" TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <!-- Confidence + stats strip -->
                                    <Border Padding="14" CornerRadius="6" Margin="0,0,0,12"
                                            Background="#3328326E"
                                            BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{services:Loc instincts.confidence}" FontSize="9" FontWeight="Bold"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonInk3Brush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Padding="6,1" CornerRadius="3" Margin="10,0,0,0"
                                                        Background="#22FFFFFF" BorderThickness="1">
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush Color="{Binding Selected.ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                                    </Border.BorderBrush>
                                                    <TextBlock Text="{Binding Selected.ConfidenceTier}"
                                                               FontSize="9" FontWeight="Bold"
                                                               FontFamily="{StaticResource NeonMonoFont}">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{Binding Selected.ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Margin="10,0,0,0" FontSize="14" FontWeight="Bold"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonInk0Brush}"
                                                           Text="{Binding Selected.Confidence, Mode=OneWay, StringFormat={}{0:P0}}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonCyanBrush}">
                                                    <Run Text="seen "/>
                                                    <Run Text="{Binding Selected.OccurrenceCount, Mode=OneWay}"/>
                                                    <Run Text="×"/>
                                                </TextBlock>
                                                <TextBlock Text=" · " Margin="6,0" Foreground="{StaticResource NeonInk3Brush}"/>
                                                <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonMintBrush}">
                                                    <Run Text="✓ "/>
                                                    <Run Text="{Binding Selected.AcceptCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text=" · " Margin="6,0" Foreground="{StaticResource NeonInk3Brush}"/>
                                                <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonRedBrush}">
                                                    <Run Text="✗ "/>
                                                    <Run Text="{Binding Selected.RejectCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text=" · last " Margin="10,0,0,0" FontSize="11"
                                                           Foreground="{StaticResource NeonInk3Brush}"/>
                                                <TextBlock Text="{Binding Selected.RelativeLastSeen}" FontSize="11"
                                                           FontFamily="{StaticResource NeonMonoFont}"
                                                           Foreground="{StaticResource NeonInk2Brush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Trigger -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                            Background="#11FFFFFF"
                                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.when}" FontFamily="{StaticResource NeonMonoFont}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Selected.Trigger, TargetNullValue='(not set)'}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                            Background="#11FFFFFF"
                                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.do}" FontFamily="{StaticResource NeonMonoFont}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Selected.Action, TargetNullValue='(not set)'}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Promoted-to-skill banner -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,14"
                                            Background="#225CFFB0"
                                            BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                                            Visibility="{Binding Selected.Promoted, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.promotedToSkill}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource NeonMintBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Selected.PromotedSkillPath}"
                                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="10"
                                                       Foreground="{StaticResource NeonInk1Brush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Vote / promote / delete actions -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding AcceptCommand}" Style="{StaticResource NeonAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                           Foreground="{StaticResource NeonMintBrush}"/>
                                                <TextBlock Text="{services:Loc instincts.accept}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RejectCommand}" Style="{StaticResource NeonAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                           Foreground="{StaticResource NeonRedBrush}"/>
                                                <TextBlock Text="{services:Loc instincts.reject}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding PromoteCommand}" Style="{StaticResource NeonPrimary}"
                                                IsEnabled="{Binding CanPromoteSelected}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.promote}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SyncToBrainCommand}" Style="{StaticResource NeonAction}"
                                                IsEnabled="{Binding BrainAvailable}"
                                                ToolTip="{services:Loc instincts.syncOneTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.syncToBrain}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource NeonDanger}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.delete}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Add-new composer -->
                    <Border Grid.Row="1" Background="{StaticResource NeonPanelFill}"
                            BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="{services:Loc instincts.addManual}"
                                       FontFamily="{StaticResource NeonMonoFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource NeonTextBox}"
                                     Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{services:Loc instincts.patternTip}"
                                     Tag="Pattern (e.g. 'Run dotnet build after every .cs edit')"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NeonTextBox}" Margin="0,0,4,8"
                                         Text="{Binding NewTrigger, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.triggerTip}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource NeonTextBox}" Margin="4,0,0,8"
                                         Text="{Binding NewAction, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.actionTip}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NeonTextBox}" Margin="0"
                                         Text="{Binding NewTags, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.tagsTip}"/>
                                <Button Grid.Column="1" Command="{Binding AddCommand}" Style="{StaticResource NeonPrimary}"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc instincts.addInstinct}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource NeonLineBrush}" Background="#88141838">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk2Brush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StorePath}" FontSize="10"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk3Brush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
