<UserControl x:Class="CluadeX.Views.InstinctsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstinctsViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">
    <UserControl.Resources>

        <!-- Card for each instinct -->
        <DataTemplate x:Key="InstinctCardTemplate" DataType="{x:Type m:Instinct}">
            <Button Click="OnInstinctClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Surface.Card}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.Card.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <!-- Pattern + tier chip + promoted badge -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Pattern}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Padding="6,1" CornerRadius="3" Margin="6,0,0,0"
                                Background="{DynamicResource Surface.Badge}" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding ConfidenceTier}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="2" Padding="5,1" CornerRadius="3" Margin="6,0,0,0"
                                Background="{DynamicResource Status.Success.Tint}"
                                BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                Visibility="{Binding Promoted, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc instincts.promotedBadge}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Success}"/>
                        </Border>
                    </Grid>

                    <!-- Brain sync chip -->
                    <Border Padding="5,1" CornerRadius="3" HorizontalAlignment="Left" Margin="0,0,0,6"
                            Background="{DynamicResource Accent.2.Tint}"
                            BorderBrush="{DynamicResource Accent.2}" BorderThickness="1"
                            Visibility="{Binding SyncedToBrain, Converter={StaticResource BoolVis}}">
                        <TextBlock FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Accent.2}">
                            <Run Text="{services:Loc inst.syncedChip}"/>
                            <Run Text="{Binding BrainNoteId, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Confidence bar -->
                    <Grid Margin="0,0,0,4">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource State.Hover.Subtle}"/>
                        <Border Height="4" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.Background>
                            <Border.Width>
                                <MultiBinding StringFormat="{}{0}">
                                    <Binding Path="Confidence"/>
                                </MultiBinding>
                            </Border.Width>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- Stats row -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}">
                            <Run Text="{services:Loc inst.confPrefix}"/>
                            <Run Text="{Binding Confidence, Mode=OneWay, StringFormat={}{0:P0}}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                        <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Accent.1}">
                            <Run Text="{services:Loc inst.seenPrefix}"/>
                            <Run Text="{Binding OccurrenceCount, Mode=OneWay}"/>
                            <Run Text="×"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                        <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Status.Success}">
                            <Run Text="✓"/>
                            <Run Text="{Binding AcceptCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                        <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Status.Danger}">
                            <Run Text="✗"/>
                            <Run Text="{Binding RejectCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource Text.Faint}"/>
                        <TextBlock Text="{Binding RelativeLastSeen}" FontSize="10"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Foreground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Action.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Action.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Success.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Success.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Success.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Effect" Value="{DynamicResource Glow.Button.Action.Success}"/>
        </Style>

        <Style x:Key="NeonDanger" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
        </Style>

        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent.1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Warning}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                            Background="{DynamicResource IconTile.Warning-Accent.3}"
                            Effect="{DynamicResource Glow.IconTile.Warning}">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc instincts.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0">
                            <Run Text="{services:Loc instincts.subtitle}"/>
                            <Run Text="{Binding StrongCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.strongSuffix}"/>
                            <Run Text="{Binding EmergingCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.emergingSuffix}"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc instincts.totalSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Brain status chip -->
                        <Border Padding="8,5" CornerRadius="6" Margin="0,0,6,0"
                                BorderThickness="1" VerticalAlignment="Center"
                                ToolTip="{Binding BrainStatusText}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Status.Neutral.Tint}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Neutral.Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrainAvailable}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Accent.2.Tint}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.2}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="OFFLINE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BrainAvailable}" Value="True">
                                                    <Setter Property="Text" Value="BRAIN"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.2}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding SyncAllStrongCommand}" Style="{StaticResource NeonAction}"
                                IsEnabled="{Binding BrainAvailable}"
                                ToolTip="{services:Loc instincts.syncAllTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.syncAllStrong}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.export}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.import}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenStoreFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.storeFolder}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc instincts.refresh}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: list + detail -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIST -->
                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Instincts}"
                                      ItemTemplate="{StaticResource InstinctCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <!-- DETAIL + ADD-NEW COMPOSER -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                            Margin="0,0,0,16" Effect="{DynamicResource Shadow.Panel.Soft}">
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                           Foreground="{DynamicResource Text.Faint}" Opacity="0.5"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{services:Loc instincts.pickHint}"
                                           FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>

                            <!-- Detail content -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Selected.Pattern}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <!-- Confidence + stats strip -->
                                    <Border Padding="14" CornerRadius="6" Margin="0,0,0,12"
                                            Background="{DynamicResource Surface.Raised.Strong}"
                                            BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{services:Loc instincts.confidence}" FontSize="9" FontWeight="Bold"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Faint}"
                                                           VerticalAlignment="Center"/>
                                                <Border Padding="6,1" CornerRadius="3" Margin="10,0,0,0"
                                                        Background="{DynamicResource Surface.Badge}" BorderThickness="1">
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush Color="{Binding Selected.ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                                    </Border.BorderBrush>
                                                    <TextBlock Text="{Binding Selected.ConfidenceTier}"
                                                               FontSize="9" FontWeight="Bold"
                                                               FontFamily="{DynamicResource Font.Mono.Display}">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{Binding Selected.ConfidenceColorHex, Converter={StaticResource HexToColor}}"/>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Margin="10,0,0,0" FontSize="14" FontWeight="Bold"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Selected.Confidence, Mode=OneWay, StringFormat={}{0:P0}}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Accent.1}">
                                                    <Run Text="{services:Loc inst.seenPrefix}"/>
                                                    <Run Text="{Binding Selected.OccurrenceCount, Mode=OneWay}"/>
                                                    <Run Text="×"/>
                                                </TextBlock>
                                                <TextBlock Text=" · " Margin="6,0" Foreground="{DynamicResource Text.Faint}"/>
                                                <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Status.Success}">
                                                    <Run Text="✓ "/>
                                                    <Run Text="{Binding Selected.AcceptCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text=" · " Margin="6,0" Foreground="{DynamicResource Text.Faint}"/>
                                                <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Status.Danger}">
                                                    <Run Text="✗ "/>
                                                    <Run Text="{Binding Selected.RejectCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{services:Loc inst.lastPrefix}" Margin="10,0,0,0" FontSize="11"
                                                           Foreground="{DynamicResource Text.Faint}"/>
                                                <TextBlock Text="{Binding Selected.RelativeLastSeen}" FontSize="11"
                                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Trigger -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                            Background="{DynamicResource State.Fill.Faint}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.when}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Selected.Trigger, TargetNullValue='(not set)'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                            Background="{DynamicResource State.Fill.Faint}"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.do}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Selected.Action, TargetNullValue='(not set)'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Promoted-to-skill banner -->
                                    <Border Padding="12" CornerRadius="6" Margin="0,0,0,14"
                                            Background="{DynamicResource Status.Success.Tint}"
                                            BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                            Visibility="{Binding Selected.Promoted, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{services:Loc instincts.promotedToSkill}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Status.Success}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Selected.PromotedSkillPath}"
                                                       FontFamily="{DynamicResource Font.Mono.Display}" FontSize="10"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Vote / promote / delete actions -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding AcceptCommand}" Style="{StaticResource NeonAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource Status.Success}"/>
                                                <TextBlock Text="{services:Loc instincts.accept}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RejectCommand}" Style="{StaticResource NeonAction}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource Status.Danger}"/>
                                                <TextBlock Text="{services:Loc instincts.reject}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding PromoteCommand}" Style="{StaticResource NeonPrimary}"
                                                IsEnabled="{Binding CanPromoteSelected}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.promote}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SyncToBrainCommand}" Style="{StaticResource NeonAction}"
                                                IsEnabled="{Binding BrainAvailable}"
                                                ToolTip="{services:Loc instincts.syncOneTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧠" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.syncToBrain}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource NeonDanger}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{services:Loc instincts.delete}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Add-new composer -->
                    <Border Grid.Row="1" Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="{services:Loc instincts.addManual}"
                                       FontFamily="{DynamicResource Font.Mono.Display}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource NeonTextBox}"
                                     Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{services:Loc instincts.patternTip}"
                                     Tag="Pattern (e.g. 'Run dotnet build after every .cs edit')"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NeonTextBox}" Margin="0,0,4,8"
                                         Text="{Binding NewTrigger, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.triggerTip}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource NeonTextBox}" Margin="4,0,0,8"
                                         Text="{Binding NewAction, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.actionTip}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NeonTextBox}" Margin="0"
                                         Text="{Binding NewTags, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{services:Loc instincts.tagsTip}"/>
                                <Button Grid.Column="1" Command="{Binding AddCommand}" Style="{StaticResource NeonPrimary}"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc instincts.addInstinct}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Page.Footer.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Muted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StorePath}" FontSize="10"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Faint}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
