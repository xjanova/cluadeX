<Window x:Class="CluadeX.Views.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluadeX Pet" Width="240" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False">
    <!-- Transparent pixels are click-through: only the pet itself (and its speech bubble) catch the mouse. -->
    <Grid>
        <!-- Just above the pet's head; grows upward with longer lines. -->
        <Border x:Name="Bubble" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4,0,4,98"
                MaxWidth="210" Padding="9,5" CornerRadius="10" Opacity="0"
                Background="#F7FFFDF8" BorderBrush="#33281C2B" BorderThickness="1" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
            </Border.Effect>
            <TextBlock x:Name="BubbleText" FontSize="12" TextWrapping="Wrap" Foreground="#281C2B"
                       FontFamily="Segoe UI, Leelawadee UI"/>
        </Border>
        <Image x:Name="Sprite" Width="96" Height="96" VerticalAlignment="Bottom" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="Hand" RenderTransformOrigin="0.5,1">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Flip" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="Wobble" Angle="0"/>
                    <TranslateTransform x:Name="Nudge" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="Fx" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,92"
                   FontSize="16" Foreground="#E5485D" IsHitTestVisible="False" Opacity="0"/>
    </Grid>
</Window>
