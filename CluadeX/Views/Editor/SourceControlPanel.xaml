<UserControl x:Class="CluadeX.Views.Editor.SourceControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:editor="clr-namespace:CluadeX.Views.Editor"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CodeEditorViewModel}"
             x:Name="Root" Height="340" MinHeight="150"
             FontFamily="{DynamicResource Font.Ui}" FontSize="12">
    <!-- The Source Control panel of the Code Editor's Explorer (owner 2026-11-04: "ทำให้ชัดเจนขึ้น เครื่องมือมากขึ้นหน่อย
         สมเป็นโปรแกรมชั้นเลิศ"). Behaviour: ViewModels/CodeEditorViewModel.GitPanel.cs. Every colour is a theme token
         (DynamicResource), so the light themes (Classic) get readable badges too. Its own resources only: the page's
         StaticResources are not used here, so the panel also renders in a harness without the app. -->
    <UserControl.Resources>
        <editor:ScmBoolVisConverter x:Key="ScmVis"/>

        <!-- Icon button: header tools, group and row actions. Focusable — the panel is driven by keyboard too. -->
        <Style x:Key="ScmIconBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScmRowIconBtn" TargetType="Button" BasedOn="{StaticResource ScmIconBtn}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Branch chip -->
        <Style x:Key="ScmChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface.Badge}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1.Border}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Commit (primary) and its dropdown half -->
        <Style x:Key="ScmPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Primary.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Primary.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Primary.Border}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Tag" Value="6,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Primary.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Primary.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small text button (Initialize repository, footer Save / Save all) -->
        <Style x:Key="ScmTextBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Flat.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Flat.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Flat.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group header (STAGED CHANGES / CHANGES): the whole left part folds the group -->
        <Style x:Key="ScmGroupBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" Padding="4,3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One changed file. Click / Enter = review its diff; the actions show on hover or keyboard focus. -->
        <Style x:Key="ScmRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" Padding="6,1,2,1" MinHeight="26">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListRow.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListRow.Selected.Background}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The row actions: hidden until the row is hovered or has the keyboard -->
        <Style x:Key="ScmRowActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status badge colour per kind (theme tokens Git.* — darker in the light themes) -->
        <Style x:Key="ScmBadge" TargetType="Grid">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Git.Modified}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added"><Setter Property="TextElement.Foreground" Value="{DynamicResource Git.Added}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Untracked"><Setter Property="TextElement.Foreground" Value="{DynamicResource Git.Added}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Deleted"><Setter Property="TextElement.Foreground" Value="{DynamicResource Git.Deleted}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Renamed"><Setter Property="TextElement.Foreground" Value="{DynamicResource Git.Renamed}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conflict"><Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Unknown"><Setter Property="TextElement.Foreground" Value="{DynamicResource Text.Muted}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ScmRowTemplate">
            <Button Style="{StaticResource ScmRow}" ToolTip="{Binding RowTooltip}"
                    AutomationProperties.Name="{Binding Path}"
                    Command="{Binding DataContext.ShowDiffCommand, RelativeSource={RelativeSource AncestorType=editor:SourceControlPanel}}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Style="{StaticResource ScmBadge}" Width="18" Height="18" Margin="0,0,8,0" ToolTip="{Binding KindLabel}">
                        <Border CornerRadius="4" Opacity="0.18"
                                Background="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="{Binding Letter}" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding FileName, Mode=OneWay}" FontSize="12">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeletedKind}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                        <Run Text="  "/><Run Text="{Binding Folder, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Style="{StaticResource ScmRowActions}" Margin="4,0,0,0">
                        <Button Style="{StaticResource ScmRowIconBtn}" Content="&#xE8E5;"
                                ToolTip="{services:Loc scm.row.open}" AutomationProperties.Name="{services:Loc scm.row.open}"
                                Command="{Binding DataContext.OpenChangeCommand, RelativeSource={RelativeSource AncestorType=editor:SourceControlPanel}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource ScmRowIconBtn}" Content="&#xE7A7;"
                                ToolTip="{services:Loc scm.row.discard}" AutomationProperties.Name="{services:Loc scm.row.discard}"
                                Visibility="{Binding CanDiscard, Converter={StaticResource ScmVis}}"
                                Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=editor:SourceControlPanel}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource ScmRowIconBtn}" Content="&#xE710;"
                                ToolTip="{services:Loc scm.row.stage}" AutomationProperties.Name="{services:Loc scm.row.stage}"
                                Visibility="{Binding IsStaged, Converter={StaticResource ScmVis}, ConverterParameter=Invert}"
                                Command="{Binding DataContext.StageCommand, RelativeSource={RelativeSource AncestorType=editor:SourceControlPanel}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource ScmRowIconBtn}" Content="&#xE738;"
                                ToolTip="{services:Loc scm.row.unstage}" AutomationProperties.Name="{services:Loc scm.row.unstage}"
                                Visibility="{Binding IsStaged, Converter={StaticResource ScmVis}}"
                                Command="{Binding DataContext.UnstageCommand, RelativeSource={RelativeSource AncestorType=editor:SourceControlPanel}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header: title + count + tools -->
                <RowDefinition Height="Auto"/>  <!-- Branch chip -->
                <RowDefinition Height="Auto"/>  <!-- Busy strip -->
                <RowDefinition Height="*"/>     <!-- Body: not-a-repo / no git / commit box + groups -->
                <RowDefinition Height="Auto"/>  <!-- Footer: file actions -->
            </Grid.RowDefinitions>

            <!-- Drag the top edge to make the panel taller (remembered); double-click restores 340 px -->
            <views:ResizeGrip Grid.Row="0" Vertical="True" OnLeftEdge="True" VerticalAlignment="Top" Margin="0,-4,0,0"
                              Key="editor.sourceControl" MinSize="150" MaxSize="900"
                              Target="{Binding ElementName=Root}" ToolTip="{services:Loc scm.resizeTip}"/>

            <!-- ── Header ── -->
            <Grid Grid.Row="0" Margin="12,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{services:Loc editor.sourceControl}" FontSize="11" FontWeight="Bold"
                           FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Muted}"
                           VerticalAlignment="Center"/>
                <Border x:Name="CountBadge" Grid.Column="1" Margin="8,0,0,0" Padding="7,1" MinWidth="20" CornerRadius="9"
                        Background="{DynamicResource Accent.1.Tint.Strong}" VerticalAlignment="Center"
                        ToolTip="{services:Loc scm.countTip}"
                        Visibility="{Binding GitTotalChanges, Converter={StaticResource ScmVis}}">
                    <TextBlock Text="{Binding GitTotalChanges}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Accent.1}"/>
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasGitRepo, Converter={StaticResource ScmVis}}">
                        <Button Style="{StaticResource ScmIconBtn}" Content="&#xE895;" Command="{Binding FetchCommand}"
                                IsEnabled="{Binding IsGitIdle}"
                                ToolTip="{services:Loc scm.fetchTip}" AutomationProperties.Name="{services:Loc scm.fetchTip}"/>
                        <Button Style="{StaticResource ScmIconBtn}" Content="&#xE896;" Command="{Binding PullCommand}"
                                IsEnabled="{Binding IsGitIdle}"
                                ToolTip="{services:Loc scm.pullTip}" AutomationProperties.Name="{services:Loc scm.pullTip}"/>
                        <Button Style="{StaticResource ScmIconBtn}" Content="&#xE898;" Command="{Binding PushCurrentCommand}"
                                IsEnabled="{Binding IsGitIdle}"
                                ToolTip="{services:Loc scm.pushTip}" AutomationProperties.Name="{services:Loc scm.pushTip}"/>
                    </StackPanel>
                    <Button Style="{StaticResource ScmIconBtn}" Content="&#xE72C;" Command="{Binding RefreshGitCommand}"
                            ToolTip="{services:Loc scm.refreshTip}" AutomationProperties.Name="{services:Loc scm.refreshTip}"/>
                    <Button x:Name="MoreButton" Style="{StaticResource ScmIconBtn}" Content="&#xE712;" Click="OnMoreMenu"
                            Visibility="{Binding HasGitRepo, Converter={StaticResource ScmVis}}"
                            ToolTip="{services:Loc scm.moreTip}" AutomationProperties.Name="{services:Loc scm.moreTip}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem Header="{services:Loc scm.menu.newBranch}" Command="{Binding NewBranchCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="SwitchBranchMenu" Header="{services:Loc scm.menu.switchBranch}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{services:Loc scm.menu.stash}" Command="{Binding StashCommand}"
                                          ToolTip="{services:Loc scm.menu.stashTip}">
                                    <MenuItem.Icon><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding GitStashPopLabel}" Command="{Binding StashPopCommand}"
                                          IsEnabled="{Binding GitStashCount, Converter={StaticResource ScmVis}, ConverterParameter=Bool}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{services:Loc scm.menu.discardAll}" Command="{Binding DiscardAllCommand}"
                                          IsEnabled="{Binding HasUnstagedChanges}">
                                    <MenuItem.Icon><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Status.Danger}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{services:Loc scm.menu.pushAll}" Command="{Binding PushAllCommand}"
                                          ToolTip="{services:Loc editor.pushAllTip}">
                                    <MenuItem.Icon><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{services:Loc scm.menu.openFolder}" Command="{Binding OpenRepoFolderCommand}">
                                    <MenuItem.Icon><ContentControl Style="{StaticResource FolderIconOpen}" Width="14" Height="11.4" HorizontalAlignment="Left"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Branch chip: the current branch, ↑ahead ↓behind its upstream; click to switch / create ── -->
            <Button x:Name="BranchChip" Grid.Row="1" Style="{StaticResource ScmChip}" Margin="12,2,12,6"
                    Click="OnBranchMenu" ToolTip="{Binding GitBranchTooltip}"
                    AutomationProperties.Name="{Binding GitBranchTooltip}"
                    Visibility="{Binding HasGitRepo, Converter={StaticResource ScmVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0"
                               Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding GitBranch}" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncText" Grid.Column="2" Text="{Binding GitSyncText}" Margin="8,0,6,0"
                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- ── Busy: what is running (one git operation at a time) ── -->
            <StackPanel x:Name="BusyRow" Grid.Row="2" Margin="12,0,12,6"
                        Visibility="{Binding IsGitBusy, Converter={StaticResource ScmVis}}">
                <Border x:Name="BusyTrack" Height="2" CornerRadius="1" ClipToBounds="True" Background="{DynamicResource Progress.Track}">
                    <Border x:Name="BusyBar" Width="70" HorizontalAlignment="Left" CornerRadius="1" Background="{DynamicResource Accent.1}">
                        <Border.RenderTransform><TranslateTransform x:Name="BusyShift"/></Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock Text="{Binding GitBusyText}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Text.Muted}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- ── Body ── -->
            <Grid Grid.Row="3">
                <!-- git is not installed -->
                <StackPanel x:Name="NoGitState" Margin="16,8,16,8" VerticalAlignment="Top"
                            Visibility="{Binding IsGitMissing, Converter={StaticResource ScmVis}}">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Status.Warning}"/>
                    <TextBlock Text="{services:Loc scm.noGit.title}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc scm.noGit.body}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>

                <!-- a folder that is not a repository -->
                <StackPanel x:Name="NotRepoState" Margin="16,8,16,8" VerticalAlignment="Top"
                            Visibility="{Binding IsNotGitRepo, Converter={StaticResource ScmVis}}">
                    <ContentControl Style="{StaticResource FolderIcon}" Width="26" Height="21.1" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Loc scm.notRepo.title}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc scm.notRepo.body}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <Button Style="{StaticResource ScmTextBtn}" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Command="{Binding InitRepoCommand}" IsEnabled="{Binding IsGitIdle}" FontSize="12" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource FolderIconNew}" Width="14" Height="11.4" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="{services:Loc scm.notRepo.init}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- a repository: commit box, then the two groups -->
                <Grid x:Name="RepoState" Visibility="{Binding HasGitRepo, Converter={StaticResource ScmVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="CommitBoxFrame" Grid.Row="0" Margin="12,0,12,0" CornerRadius="6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Surface.Input}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommitBox" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="88"
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                     Padding="8,8,4,8" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.1}" SelectionBrush="{DynamicResource Editor.Selection}"
                                     PreviewKeyDown="OnCommitBoxKeyDown"
                                     ToolTip="{services:Loc scm.commitBoxTip}"
                                     AutomationProperties.Name="{services:Loc scm.commitPlaceholder}"/>
                            <TextBlock IsHitTestVisible="False" Text="{services:Loc scm.commitPlaceholder}" Margin="11,9,4,0"
                                       FontSize="12" Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding CommitMessage, Converter={StaticResource ScmVis}, ConverterParameter=Invert}"/>
                            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,4,4,0">
                                <Button Style="{StaticResource ScmRowIconBtn}" Content="✨" FontFamily="Segoe UI Emoji" FontSize="12"
                                        Command="{Binding DraftCommitMessageCommand}"
                                        Visibility="{Binding IsNotDraftingCommit, Converter={StaticResource ScmVis}}"
                                        ToolTip="{services:Loc scm.aiDraftTip}" AutomationProperties.Name="{services:Loc scm.aiDraftTip}"/>
                                <Button Style="{StaticResource ScmRowIconBtn}" Content="&#xE71A;" Foreground="{DynamicResource Status.Warning}"
                                        Command="{Binding CancelDraftCommand}"
                                        Visibility="{Binding IsDraftingCommit, Converter={StaticResource ScmVis}}"
                                        ToolTip="{services:Loc scm.aiCancelTip}" AutomationProperties.Name="{services:Loc scm.aiCancelTip}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SubjectHint" Grid.Row="1" Margin="13,4,12,0" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding CommitSubjectHint}" Foreground="{DynamicResource Status.Warning}"
                               Visibility="{Binding IsCommitSubjectLong, Converter={StaticResource ScmVis}}"/>

                    <!-- Commit | ▾ (Commit & Push) -->
                    <Grid Grid.Row="2" Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CommitButton" Style="{StaticResource ScmPrimaryBtn}" Command="{Binding CommitCommand}"
                                IsEnabled="{Binding IsGitIdle}" ToolTip="{Binding CommitButtonTip}"
                                AutomationProperties.Name="{Binding CommitButtonLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CommitButtonLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CommitMenuButton" Grid.Column="1" Style="{StaticResource ScmPrimaryBtn}" Tag="0,6,6,0"
                                Padding="9,0" Margin="1,0,0,0" Click="OnCommitMenu" IsEnabled="{Binding IsGitIdle}"
                                ToolTip="{services:Loc scm.commitMenuTip}" AutomationProperties.Name="{services:Loc scm.commitMenuTip}">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CommitMenu">
                                    <MenuItem Header="{services:Loc scm.menu.commit}" InputGestureText="Ctrl+Enter" Command="{Binding CommitCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{services:Loc scm.menu.commitPush}" InputGestureText="Ctrl+Shift+Enter" Command="{Binding CommitAndPushCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="6,0,6,8">
                            <!-- STAGED CHANGES -->
                            <StackPanel x:Name="StagedGroup" Visibility="{Binding HasStagedChanges, Converter={StaticResource ScmVis}}">
                                <Grid Margin="0,2,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource ScmGroupBtn}" Command="{Binding ToggleStagedGroupCommand}"
                                            AutomationProperties.Name="{services:Loc scm.group.staged}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Width="14" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStagedExpanded}" Value="False">
                                                                <Setter Property="Text" Value="&#xE76C;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{services:Loc scm.group.staged}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" Background="{DynamicResource Surface.Badge}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GitStagedChanges.Count}" FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Secondary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource ScmRowIconBtn}" Content="&#xE738;" Margin="0,0,2,0"
                                            Command="{Binding UnstageAllCommand}" IsEnabled="{Binding IsGitIdle}"
                                            ToolTip="{services:Loc scm.unstageAllTip}" AutomationProperties.Name="{services:Loc scm.unstageAllTip}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding GitStagedChanges}" ItemTemplate="{StaticResource ScmRowTemplate}"
                                              Focusable="False" Margin="0,0,0,6"
                                              Visibility="{Binding IsStagedExpanded, Converter={StaticResource ScmVis}}"/>
                            </StackPanel>

                            <!-- CHANGES -->
                            <StackPanel x:Name="ChangesGroup" Visibility="{Binding HasUnstagedChanges, Converter={StaticResource ScmVis}}">
                                <Grid Margin="0,2,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource ScmGroupBtn}" Command="{Binding ToggleChangesGroupCommand}"
                                            AutomationProperties.Name="{services:Loc scm.group.changes}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Width="14" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChangesExpanded}" Value="False">
                                                                <Setter Property="Text" Value="&#xE76C;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{services:Loc scm.group.changes}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" Background="{DynamicResource Surface.Badge}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GitUnstagedChanges.Count}" FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                                           Foreground="{DynamicResource Text.Secondary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource ScmRowIconBtn}" Content="&#xE7A7;"
                                            Command="{Binding DiscardAllCommand}" IsEnabled="{Binding IsGitIdle}"
                                            ToolTip="{services:Loc scm.discardAllTip}" AutomationProperties.Name="{services:Loc scm.discardAllTip}"/>
                                    <Button Grid.Column="2" Style="{StaticResource ScmRowIconBtn}" Content="&#xE710;" Margin="0,0,2,0"
                                            Command="{Binding StageAllCommand}" IsEnabled="{Binding IsGitIdle}"
                                            ToolTip="{services:Loc scm.stageAllTip}" AutomationProperties.Name="{services:Loc scm.stageAllTip}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding GitUnstagedChanges}" ItemTemplate="{StaticResource ScmRowTemplate}"
                                              Focusable="False"
                                              Visibility="{Binding IsChangesExpanded, Converter={StaticResource ScmVis}}"/>
                            </StackPanel>

                            <!-- Clean: nothing to commit -->
                            <StackPanel x:Name="CleanState" Margin="10,10,10,4"
                                        Visibility="{Binding IsGitClean, Converter={StaticResource ScmVis}}">
                                <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center"
                                        Background="{DynamicResource Status.Success.Tint}" BorderBrush="{DynamicResource Status.Success.Border}" BorderThickness="1">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Status.Success}"/>
                                </Border>
                                <TextBlock Text="{services:Loc scm.clean.title}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,6"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Text.Secondary}">
                                    <Run Text="{Binding GitLastCommitHash, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono.Display}"
                                         Foreground="{DynamicResource Accent.1}"/><Run Text=" "/><Run Text="{Binding GitLastCommitSubject, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding GitLastCommitWhen}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Faint}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ── Footer: FILE actions (not git) — kept apart so Save is never mistaken for Commit ── -->
            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" Padding="12,5,12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{services:Loc scm.footer.files}" FontSize="11" Foreground="{DynamicResource Text.Faint}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ScmTextBtn}" Command="{Binding SaveActiveCommand}" Margin="0,0,4,0"
                            ToolTip="{services:Loc ide.saveTip}" AutomationProperties.Name="{services:Loc editor.save}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc editor.save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ScmTextBtn}" Command="{Binding SaveAllCommand}"
                            ToolTip="{services:Loc ide.saveAllTip}" AutomationProperties.Name="{services:Loc editor.saveAll}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc editor.saveAll}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
