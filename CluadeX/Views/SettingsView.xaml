<UserControl x:Class="CluadeX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:services="clr-namespace:CluadeX.Services">

    <UserControl.Resources>
        <!-- ── Neon retheme — local override of Catppuccin keys ── -->
        <SolidColorBrush x:Key="CrustBrush"    Color="#06071A"/>
        <SolidColorBrush x:Key="MantleBrush"   Color="#0A0C22"/>
        <SolidColorBrush x:Key="BaseBrush"     Color="#0F1230"/>
        <SolidColorBrush x:Key="Surface0Brush" Color="#1A11152E"/>
        <SolidColorBrush x:Key="Surface1Brush" Color="#2828326E"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#3828326E"/>
        <SolidColorBrush x:Key="Overlay0Brush" Color="#8388BD"/>
        <SolidColorBrush x:Key="Overlay1Brush" Color="#A0A6CC"/>
        <SolidColorBrush x:Key="Subtext0Brush" Color="#C0C6EE"/>
        <SolidColorBrush x:Key="Subtext1Brush" Color="#D8DCF5"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#E8ECFF"/>
        <SolidColorBrush x:Key="BlueBrush"     Color="#4CDFFF"/>
        <SolidColorBrush x:Key="LavenderBrush" Color="#A672FF"/>
        <SolidColorBrush x:Key="SapphireBrush" Color="#4CDFFF"/>
        <SolidColorBrush x:Key="SkyBrush"      Color="#4CDFFF"/>
        <SolidColorBrush x:Key="TealBrush"     Color="#4CDFFF"/>
        <SolidColorBrush x:Key="GreenBrush"    Color="#5CFFB0"/>
        <SolidColorBrush x:Key="YellowBrush"   Color="#FFD166"/>
        <SolidColorBrush x:Key="PeachBrush"    Color="#FFD166"/>
        <SolidColorBrush x:Key="MaroonBrush"   Color="#FF8AA6"/>
        <SolidColorBrush x:Key="RedBrush"      Color="#FF6E6E"/>
        <SolidColorBrush x:Key="MauveBrush"    Color="#A672FF"/>
        <SolidColorBrush x:Key="PinkBrush"     Color="#FF8AA6"/>
        <SolidColorBrush x:Key="RosewaterBrush" Color="#FFD166"/>
        <SolidColorBrush x:Key="FlamBrush"     Color="#FF8AA6"/>
        <FontFamily x:Key="MainFont">Space Grotesk, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Code, Consolas</FontFamily>

        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:EqualsToVisibilityConverter x:Key="EqVis"/>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- one setting = text on the left, control on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- Category navigation item -->
        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-12,0,0,0" Background="{StaticResource BlueBrush}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1428326E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A4CDFFF"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ Header ═══════ -->
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{services:Loc settings.title}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource MainFont}"/>
                <TextBlock Text="{services:Loc settings.subtitle}" Foreground="{StaticResource Subtext0Brush}"
                           FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource GreenBrush}" FontSize="12"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ Category navigation ═══════ -->
            <StackPanel Margin="0,0,20,0">
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=provider}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.provider}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=model}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.model}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=agent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.agent}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=autonomous}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.autonomous}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=memory}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.memory}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=local}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.local}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=general}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.general}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- ═══════ Category content ═══════ -->
            <ScrollViewer Grid.Column="1" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,12,24">

                    <!-- ─────────────── AI PROVIDER ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=provider}">
                        <TextBlock Text="{services:Loc settings.cat.provider}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.provider}" Style="{StaticResource SectionDesc}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="{services:Loc settings.card.connection}" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="#1A5CFFB0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource GreenBrush}">
                                            <Run Text="●"/><Run Text=" "/><Run Text="{Binding ActiveProviderName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{services:Loc settings.activeProvider}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.providerChoose}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}"
                                          Width="260" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <TextBlock Text="{services:Loc settings.localGgufNotice}" Foreground="{StaticResource TealBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Visibility="{Binding IsLocalSelected, Converter={StaticResource BoolVis}}"/>

                                <!-- API key -->
                                <StackPanel Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{services:Loc settings.apiKey}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Style="{StaticResource SettingDesc}" Text="{services:Loc settings.apiKeyDesc}"/>
                                    <TextBlock Margin="0,2,0,8" FontSize="11">
                                        <Hyperlink NavigateUri="{Binding ApiKeyLink}" RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{StaticResource BlueBrush}">
                                            <Run Text="{Binding ApiKeyLinkText, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MaskedApiKey, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding ProviderApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding ShowApiKey}" Margin="8,0,0,0" Padding="12,0"
                                                      MinWidth="72" ToolTip="{services:Loc settings.apiKeyToggleTooltip}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{services:Loc settings.apiKeyShow}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowApiKey}" Value="True">
                                                                <Setter Property="Text" Value="{services:Loc settings.apiKeyHide}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>

                                <!-- Workspace ID (Anthropic) — keys not scoped to one workspace must name it per request -->
                                <StackPanel Visibility="{Binding IsAnthropicSelected, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{services:Loc settings.workspaceId}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{services:Loc settings.workspaceIdDesc}" Style="{StaticResource SettingDesc}"/>
                                    <TextBlock Margin="0,2,0,8" FontSize="11">
                                        <Hyperlink NavigateUri="{Binding WorkspacesLink}" RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{StaticResource BlueBrush}">
                                            <Run Text="{services:Loc settings.workspaceIdLink}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBox Text="{Binding ProviderWorkspaceId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"/>
                                </StackPanel>

                                <!-- Base URL — only providers that read it -->
                                <StackPanel Visibility="{Binding SupportsBaseUrl, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{services:Loc settings.baseUrl}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{services:Loc settings.baseUrlDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"/>
                                </StackPanel>

                                <!-- Model -->
                                <StackPanel Visibility="{Binding IsLocalSelected, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" Margin="0,0,0,8">
                                    <TextBlock Text="{services:Loc settings.model}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Not IsEditable: ModernComboBox has no edit box, and WPF stops updating
                                             SelectionBoxItem on an editable combo — the pick rendered as an empty box.
                                             A free-form ID goes in the custom model ID field below. -->
                                        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ProviderModel}"
                                                  HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButton}"
                                                FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshModelsCommand}"
                                                ToolTip="{services:Loc settings.refreshModels}" Margin="6,0,0,0"
                                                Visibility="{Binding CanRefreshModels, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                    <CheckBox Content="{services:Loc settings.useCustomModel}" IsChecked="{Binding UseCustomModel}" Margin="0,4,0,6"/>
                                    <TextBox Text="{Binding ProviderCustomModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             Visibility="{Binding UseCustomModel, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                    <Button Content="{services:Loc settings.testConnection}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"
                                            Visibility="{Binding CanTestConnection, Converter={StaticResource BoolVis}}"/>
                                    <Button Content="{services:Loc settings.applyProvider}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyProviderCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConnectionTestResult}" Foreground="{StaticResource TealBrush}"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding ShowLicenseShortcut, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc settings.licenseOpen}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─────────────── MODEL & OUTPUT ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=model}">
                        <TextBlock Text="{services:Loc settings.cat.model}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.model}" Style="{StaticResource SectionDesc}"/>

                        <Border Style="{StaticResource Card}" Background="#144CDFFF" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{services:Loc settings.chatBarHint}" Foreground="{StaticResource Subtext1Brush}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="660"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.generation}" Style="{StaticResource CardTitle}"/>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.maxOutputTokens}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.maxOutputTokensDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">
                                            <Run Text="{services:Loc settings.temperature}"/><Run Text="  "/><Run Text="{Binding Temperature, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{StaticResource BlueBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{services:Loc settings.temperatureDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>

                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">
                                            <Run Text="{services:Loc settings.topP}"/><Run Text="  "/><Run Text="{Binding TopP, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{StaticResource BlueBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{services:Loc settings.topPDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Value="{Binding TopP}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.claude}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.promptCaching}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.cachingDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding PromptCachingEnabled}" Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.thinkingBudget}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.thinkingBudgetDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ThinkingBudgetTokens, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─────────────── AGENT ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=agent}">
                        <TextBlock Text="{services:Loc settings.cat.agent}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.agent}" Style="{StaticResource SectionDesc}"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.workflow}" Style="{StaticResource CardTitle}"/>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.maxSteps}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.maxStepsTip}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MaxAgentIterations, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.idleTimeout}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.idleTimeoutTip}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding InteractiveRequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.readBeforeEdit}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.readBeforeEditDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnforceReadBeforeEdit}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.autoVerify}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.autoVerifyDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoVerifyAfterEditEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{services:Loc settings.verifyCommand}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{services:Loc settings.verifyCommandTip}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding AutoVerifyCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.maxAutoFix}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.maxAutoFixDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MaxAutoFixAttempts, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.escalate}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.escalateDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EscalationEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.knowledge}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.brainRecall}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.brainRecallDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
