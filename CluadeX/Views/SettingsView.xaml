                                                           TextWrapping="Wrap" MaxWidth="560"
                                                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox Text="{Binding SelectedBatchAnswer, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
