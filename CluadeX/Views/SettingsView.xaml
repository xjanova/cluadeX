                                                    <Border Background="{StaticResource Surface0Brush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MauveBrush}"/>
