                                        <TextBlock Text="{services:Loc settings.modelReview}" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding ReviewModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                                 FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{services:Loc settings.modelHardFix}" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Text="{Binding HardFixModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                                 FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
