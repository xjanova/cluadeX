                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.desktop}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.desktopDesc}" Style="{StaticResource SettingDesc}"/>
