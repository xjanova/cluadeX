                                    <TextBlock Text="{services:Loc settings.modelCheap}" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding CheapModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" IsEnabled="{Binding SubAgentAutoModel}">
                                    <TextBlock Text="{services:Loc settings.modelMid}" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding MidModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10" IsEnabled="{Binding SubAgentAutoModel}">
                                    <TextBlock Text="{services:Loc settings.modelDeep}" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Text="{Binding DeepModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
