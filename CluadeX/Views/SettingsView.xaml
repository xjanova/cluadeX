                                        <TextBlock Text="{services:Loc settings.contextSizeDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ContextSizeOptions}" SelectedItem="{Binding ContextSize}"
                                              Width="130" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">
                                            <Run Text="{services:Loc settings.repeatPenalty}"/><Run Text="  "/><Run Text="{Binding RepeatPenalty, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/>
                                        </TextBlock>
                                        <TextBlock Text="{services:Loc settings.repetitionPenaltyDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Value="{Binding RepeatPenalty}" Minimum="1" Maximum="2" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="{services:Loc settings.customBackend}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{services:Loc settings.customBackendTip}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CustomLlamaCppBackendPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"/>
                                        <Button Grid.Column="1" Content="&#xED25;" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding BrowseBackendDirCommand}" Margin="6,0,0,0" ToolTip="{services:Loc settings.browseTip}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.toolCalling}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.nativeToolUse}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.nativeToolUseDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LocalNativeToolUseEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.toolRepair}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.toolRepairDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LocalToolCallRepairEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.planFirst}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.planFirstDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding PlanFirstForceToolEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.midLoopReminder}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.midLoopReminderDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding MidLoopReminderEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0" IsEnabled="{Binding MidLoopReminderEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.remindEvery}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding MidLoopReminderEvery, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.sampling}" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Top-K" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" ToolTip="{services:Loc settings.zeroDisabled}"/>
                                    <TextBox Grid.Column="1" Text="{Binding TopK, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumBox}"
                                             Margin="16,0,0,10" ToolTip="{services:Loc settings.zeroDisabled}"/>
                                    <TextBlock Grid.Row="1" Text="Min-P" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" ToolTip="{services:Loc settings.zeroDisabled}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinP, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumBox}"
                                             Margin="16,0,0,10" ToolTip="{services:Loc settings.zeroDisabled}"/>
                                    <TextBlock Grid.Row="2" Text="{services:Loc settings.repeatWindow}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"
                                               Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolVis}}"
                                               ToolTip="{services:Loc settings.repeatWindowTip}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RepeatPenaltyTokens, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolVis}}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,10" ToolTip="{services:Loc settings.repeatWindowTip}"/>
                                    <TextBlock Grid.Row="3" Text="{services:Loc settings.toolCallTemp}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"
                                               ToolTip="{services:Loc settings.toolCallTempTip}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ToolCallTemperature, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0" ToolTip="{services:Loc settings.toolCallTempTip}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.files}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.modelStorageDir}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.modelStorageDirDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ModelDirectory, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WideBox}"/>
                                    <Button Grid.Column="1" Content="&#xED25;" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                                            Command="{Binding BrowseModelDirCommand}" Margin="6,0,0,0" ToolTip="{services:Loc settings.browseTip}"/>
                                    <Button Grid.Column="2" Content="&#xE838;" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                                            Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding ModelDirectory}"
                                            Margin="4,0,0,0" ToolTip="{services:Loc settings.openFolderTip}"/>
                                </Grid>
                                <TextBlock Text="{services:Loc settings.hfToken}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.apiTokenDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MaskedHuggingFaceToken, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                             Visibility="{Binding ShowHuggingFaceToken, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                    <TextBox Text="{Binding HuggingFaceToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             Visibility="{Binding ShowHuggingFaceToken, Converter={StaticResource BoolVis}}"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding ShowHuggingFaceToken}" Margin="8,0,0,0" Padding="12,0" MinWidth="72"
                                                  Style="{StaticResource PlainToggle}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{services:Loc settings.apiKeyShow}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowHuggingFaceToken}" Value="True">
                                                            <Setter Property="Text" Value="{services:Loc settings.apiKeyHide}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>
                                            </views:MasonryPanel>
                    </StackPanel>

                    <!-- ─────────────── GENERAL ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=general}">
                        <TextBlock Text="{services:Loc settings.cat.general}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.general}" Style="{StaticResource SectionDesc}"/>
<views:MasonryPanel MinColumnWidth="460" Gap="14">

                        <!-- Appearance: the theme picker (Views/Settings/ThemePicker.xaml) — applies live, remembered -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.appearance}" Style="{StaticResource CardTitle}"/>
                                <settingsviews:ThemePicker/>
                            </StackPanel>
                        </Border>

                        <!-- More tools: the pages that left the activity bar (still on Ctrl+K and their Ctrl+number keys) -->

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.language}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.uiLanguage}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.uiLanguageDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UiLanguageOptions}" SelectedItem="{Binding UiLanguage}"
                                              Width="150" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.editor}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.autoOpenEditor}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoOpenEditorOnAgentEdit}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.liveEditFollow}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LiveEditFollow}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.liveCodingAnimation}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LiveCodingAnimationEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.storage}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.dataFolder}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.dataFolderDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataRootDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                             FontFamily="{DynamicResource Font.Mono.Display}"/>
                                    <Button Grid.Column="1" Content="&#xE838;" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                                            Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding DataRootDisplay}"
                                            Margin="6,0,0,0" ToolTip="{services:Loc settings.openFolderTip}"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Accent.1}" FontSize="11" Margin="0,0,0,16"
                                           Text="{services:Loc settings.portableMode}"
                                           Visibility="{Binding IsPortable, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.license}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LicenseStatus}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.licenseDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.licenseOpen}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.maintenance}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{services:Loc settings.checkUpdates}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}">
                                            <Run Text="{services:Loc settings.updatesDesc}"/><Run Text=" "/><Run Text="{Binding DataContext.AppVersion, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                            Command="{Binding DataContext.CheckUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.checkUpdates}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.resetDefaults}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.resetDefaultsDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{services:Loc settings.resetDefaults}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResetDefaultsCommand}" Foreground="{DynamicResource Status.Danger}"
                                            VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                                            </views:MasonryPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
