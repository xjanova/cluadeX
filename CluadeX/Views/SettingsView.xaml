                                    <CheckBox Grid.Column="1" IsChecked="{Binding EscalationEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Effort-aware dispatch: when to fan out, on which model (Services/Agents/DispatchPolicy.cs) -->
