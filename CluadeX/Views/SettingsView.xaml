                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.maxParallel}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.maxParallelDesc}" Style="{StaticResource SettingDesc}"/>
