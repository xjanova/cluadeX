                                        <TextBlock Text="{services:Loc settings.specFixMinutesDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding SpeculativeFixMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <!-- sub-agent tiers: auto model picks cheap / mid / deep per sub-agent -->
                                <TextBlock Text="{services:Loc settings.tiers}" Style="{StaticResource SettingLabel}" Margin="0,8,0,0"/>
