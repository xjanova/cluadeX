                                        <TextBlock Text="{services:Loc settings.tierEscalate}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.tierEscalateDesc}" Style="{StaticResource SettingDesc}"/>
