                                             FontFamily="{DynamicResource Font.Mono.Display}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{services:Loc settings.desktopHotkey}" Style="{StaticResource SettingDesc}" Margin="0,8,0,0"/>
                                </StackPanel>
