                                        <TextBlock Text="{services:Loc settings.autoModel}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.autoModelDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SubAgentAutoModel}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" IsEnabled="{Binding SubAgentAutoModel}">
