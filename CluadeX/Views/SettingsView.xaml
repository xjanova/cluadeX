<UserControl x:Class="CluadeX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:settingsviews="clr-namespace:CluadeX.Views.Settings"
             xmlns:views="clr-namespace:CluadeX.Views">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:EqualsToVisibilityConverter x:Key="EqVis"/>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- one setting = text on the left, control on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WideBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- Show / hide toggles (API key, Hugging Face token). Their own template: the Windows one painted its own
             grey and blues whatever the theme said. Same shape and trigger order as that template; Midnight's
             Button.Plain.* tokens hold those Windows colours, so it looks exactly as before. -->
        <Style x:Key="PlainToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Button.Plain.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Plain.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Plain.Foreground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Hover.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Pressed.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Checked.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Checked.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of the memories list: own template (the Windows one tinted hover / selection in its own blue);
             same shape, Midnight's ListRow.* tokens hold those Windows colours. -->
        <Style x:Key="PlainListRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListRow.Hover.Background}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListRow.Hover.Border}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListRow.Selected.Inactive.Background}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListRow.Selected.Inactive.Border}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListRow.Selected.Background}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListRow.Selected.Border}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category navigation item -->
        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsNav.Foreground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-12,0,0,0" Background="{DynamicResource SettingsNav.Indicator}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SettingsNav.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SettingsNav.Selected.Background}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsNav.Selected.Foreground}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ Header ═══════ -->
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{services:Loc settings.title}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui.Display}"/>
                <TextBlock Text="{services:Loc settings.subtitle}" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding SaveStatus}" FontSize="12" MaxWidth="460" TextWrapping="Wrap"
                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ Category navigation ═══════ -->
            <StackPanel Margin="0,0,20,0">
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=provider}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.provider}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=model}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.model}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=agent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.agent}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=autonomous}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.autonomous}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=memory}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.memory}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=voice}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.voice}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=local}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.local}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SettingsNavItem}"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource NavConverter}, ConverterParameter=general}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.cat.general}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- ═══════ Category content ═══════ -->
            <ScrollViewer Grid.Column="1" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1600" Margin="0,0,16,24">

                    <!-- ─────────────── AI PROVIDER ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=provider}">
                        <TextBlock Text="{services:Loc settings.cat.provider}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.provider}" Style="{StaticResource SectionDesc}"/>
<views:MasonryPanel MinColumnWidth="460" Gap="14">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="{services:Loc settings.card.connection}" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="{DynamicResource Status.Success.Tint.Faint}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Status.Success}">
                                            <Run Text="●"/><Run Text=" "/><Run Text="{services:Loc settings.inUse}"/><Run Text=" "/><Run Text="{Binding ActiveProviderName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- This card only CONFIGURES a provider; the chat's model box is what switches the one that answers. -->
                                <TextBlock Text="{services:Loc settings.activeProvider}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.providerChoose}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ProviderPicker" ItemsSource="{Binding ProviderChoicesView}" SelectedValuePath="Type" SelectedValue="{Binding SelectedProvider}"
                                          Width="320" HorizontalAlignment="Left" Margin="0,0,0,16" MaxDropDownHeight="420">
                                    <!-- grouped: cloud APIs · installed CLIs · OpenAI-compatible services · on this PC · other -->
                                    <ComboBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name.Title}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Muted}" Margin="6,8,6,2" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ComboBox.GroupStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Each mark on a white tile, so its own colours read in light and dark themes. -->
                                                <Border Width="20" Height="20" CornerRadius="4" Background="White" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Image Source="{Binding Logo}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="Bold" Foreground="#333"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasLogo, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- OpenAI-compatible services: how to get a key, free use, and the key page -->
                                <Border Visibility="{Binding ShowProviderGuide, Converter={StaticResource BoolVis}}" Margin="0,0,0,16"
                                        Padding="12" CornerRadius="8" Background="{DynamicResource Accent.1.Tint.Faint}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="White" Margin="0,0,10,0">
                                                <Grid>
                                                    <Image Source="{Binding ProviderLogo}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding ProviderBadge}" FontSize="10" FontWeight="Bold" Foreground="#333"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasProviderLogo, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{services:Loc settings.agg.guide}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProviderGuideSteps}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource Text.Body}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{services:Loc settings.agg.free}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent.1}"/>
                                        <TextBlock Text="{Binding ProviderGuideFree}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource Text.Body}" Margin="0,2,0,8"/>
                                        <TextBlock FontSize="12" Visibility="{Binding HasProviderKeyPage, Converter={StaticResource BoolVis}}">
                                            <Hyperlink NavigateUri="{Binding ProviderKeyPage}" RequestNavigate="Hyperlink_RequestNavigate"
                                                       Foreground="{DynamicResource Accent.1}">
                                                <Run Text="{services:Loc settings.agg.open}"/><Run Text=" → "/><Run Text="{Binding ProviderKeyPage, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{services:Loc settings.agg.noKeyNeeded}" FontSize="11" Foreground="{DynamicResource Status.Success}"
                                                   Margin="0,6,0,0" Visibility="{Binding IsLocalServerSelected, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Little or nothing to set (CLIs, BrainX, Colibri, GGUF): one line, and the page that has the rest -->
                                <Border Visibility="{Binding ProviderNote, Converter={StaticResource BoolVis}}" Margin="0,0,0,16"
                                        Padding="12,10" CornerRadius="8" Background="{DynamicResource Accent.1.Tint.Faint}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProviderNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.Body}"/>
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"
                                                Content="{services:Loc settings.openModelsPage}" CommandParameter="Models"
                                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding ShowModelsPageButton, Converter={StaticResource BoolVis}}"/>
                                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"
                                                Content="{services:Loc settings.openPluginsPage}" CommandParameter="Plugins"
                                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding ShowPluginsPageButton, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- API key: required for the cloud services, optional for a server on this PC or a custom endpoint -->
                                <StackPanel Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding ApiKeyLabel}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Style="{StaticResource SettingDesc}" Text="{Binding ApiKeyHelp}"/>
                                    <TextBlock Margin="0,2,0,2" FontSize="11" Visibility="{Binding HasApiKeyLink, Converter={StaticResource BoolVis}}">
                                        <Hyperlink NavigateUri="{Binding ApiKeyLink}" RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{DynamicResource Accent.1}">
                                            <Run Text="{Binding ApiKeyLinkText, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MaskedApiKey, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                        <TextBox Text="{Binding ProviderApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolVis}}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding ShowApiKey}" Margin="8,0,0,0" Padding="12,0"
                                                      Style="{StaticResource PlainToggle}"
                                                      MinWidth="72" ToolTip="{services:Loc settings.apiKeyToggleTooltip}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{services:Loc settings.apiKeyShow}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowApiKey}" Value="True">
                                                                <Setter Property="Text" Value="{services:Loc settings.apiKeyHide}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ToggleButton>
                                    </Grid>
                                    <!-- Keys saved on another PC / Windows account (portable copy): DPAPI can't read them here. -->
                                    <TextBlock Text="{Binding SecretsNotice}" Foreground="{DynamicResource Status.Warning}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding SecretsNotice, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <!-- Workspace ID (Anthropic) — keys not scoped to one workspace must name it per request -->
                                <StackPanel Visibility="{Binding IsAnthropicSelected, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{services:Loc settings.workspaceId}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{services:Loc settings.workspaceIdDesc}" Style="{StaticResource SettingDesc}"/>
                                    <TextBlock Margin="0,2,0,8" FontSize="11">
                                        <Hyperlink NavigateUri="{Binding WorkspacesLink}" RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="{DynamicResource Accent.1}">
                                            <Run Text="{services:Loc settings.workspaceIdLink}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBox Text="{Binding ProviderWorkspaceId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"/>
                                </StackPanel>

                                <!-- Prompt caching (Anthropic only: the cache marks are Claude API's) — a page-wide setting, shown here
                                     beside the rest of the Claude API's details instead of a card of its own on Model & output -->
                                <Grid Style="{StaticResource Row}" Visibility="{Binding IsAnthropicSelected, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.promptCaching}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.cachingDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding PromptCachingEnabled}" Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>

                                <!-- Base URL: typed where it has to be (Azure, a custom endpoint, Ollama, LM Studio / vLLM);
                                     behind a switch for a fixed-address service that still takes a proxy; never for the others -->
                                <CheckBox Content="{services:Loc settings.baseUrlOverride}" IsChecked="{Binding ShowBaseUrlOverride}" Margin="0,0,0,12"
                                          Visibility="{Binding BaseUrlIsAdvanced, Converter={StaticResource BoolVis}}"/>
                                <StackPanel Visibility="{Binding ShowBaseUrlBox, Converter={StaticResource BoolVis}}" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding BaseUrlLabel}" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="{Binding BaseUrlHelp}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"/>
                                    <TextBlock Text="{Binding BaseUrlHint}" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding HasBaseUrlHint, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <!-- Model: not for llama.cpp / the GGUF runner (Models page), BrainX (the room) or Colibri (its plugin) -->
                                <StackPanel Visibility="{Binding ShowModelFields, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="{services:Loc settings.model}" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Not IsEditable: ModernComboBox has no edit box, and WPF stops updating
                                             SelectionBoxItem on an editable combo — the pick rendered as an empty box.
                                             A free-form ID goes in the custom model ID field below. -->
                                        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ProviderModel}"
                                                  HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButton}"
                                                FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshModelsCommand}"
                                                ToolTip="{services:Loc settings.refreshModels}" Margin="6,0,0,0"
                                                Visibility="{Binding CanRefreshModels, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                    <CheckBox Content="{services:Loc settings.useCustomModel}" IsChecked="{Binding UseCustomModel}" Margin="0,4,0,6"/>
                                    <TextBox Text="{Binding ProviderCustomModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             Visibility="{Binding UseCustomModel, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                    <Button Content="{services:Loc settings.testConnection}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"
