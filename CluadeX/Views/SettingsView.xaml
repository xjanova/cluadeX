                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.minP}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.zeroDisabled}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding MinP, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.repeatWindow}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.repeatWindowTip}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding RepeatPenaltyTokens, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.toolCallTemp}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.toolCallTempTip}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ToolCallTemperature, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.files}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.modelStorageDir}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.modelStorageDirDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ModelDirectory, UpdateSourceTrigger=LostFocus}" Style="{StaticResource WideBox}"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                            Command="{Binding BrowseModelDirCommand}" Margin="6,0,0,0" ToolTip="{services:Loc settings.browseTip}">
                                            <ContentControl Style="{StaticResource FolderIconOpen}" Width="16" Height="13"/>
                                        </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                            Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding ModelDirectory}"
                                            Margin="4,0,0,0" ToolTip="{services:Loc settings.openFolderTip}">
                                            <ContentControl Style="{StaticResource FolderIconOpen}" Width="16" Height="13"/>
                                        </Button>
                                </Grid>
                                <TextBlock Text="{services:Loc settings.hfToken}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.apiTokenDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MaskedHuggingFaceToken, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                             Visibility="{Binding ShowHuggingFaceToken, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                    <TextBox Text="{Binding HuggingFaceToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WideBox}"
                                             Visibility="{Binding ShowHuggingFaceToken, Converter={StaticResource BoolVis}}"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding ShowHuggingFaceToken}" Margin="8,0,0,0" Padding="12,0" MinWidth="72"
                                                  Style="{StaticResource PlainToggle}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{services:Loc settings.apiKeyShow}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowHuggingFaceToken}" Value="True">
                                                            <Setter Property="Text" Value="{services:Loc settings.apiKeyHide}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>
                                            </views:MasonryPanel>
                    </StackPanel>

                    <!-- ─────────────── GENERAL ─────────────── -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=general}">
                        <TextBlock Text="{services:Loc settings.cat.general}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{services:Loc settings.catDesc.general}" Style="{StaticResource SectionDesc}"/>
<views:MasonryPanel MinColumnWidth="460" Gap="14">

                        <!-- Appearance: the theme picker (Views/Settings/ThemePicker.xaml) — applies live, remembered -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.appearance}" Style="{StaticResource CardTitle}"/>
                                <settingsviews:ThemePicker/>
                                <!-- The text sits beside the box, not in it: a CheckBox's content gets endless width and never wraps. -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="BuddyBubblesBox" IsChecked="{Binding BuddyBubbles}" VerticalAlignment="Top"
                                              AutomationProperties.Name="{services:Loc buddy.bubbles}"/>
                                    <TextBlock Grid.Column="1" Text="{services:Loc buddy.bubbles}" TextWrapping="Wrap" Margin="6,1,0,0"
                                               Foreground="{DynamicResource Text.Primary}" Cursor="Hand"
                                               MouseLeftButtonUp="BuddyBubblesText_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="BuddySoundsBox" IsChecked="{Binding BuddySounds}" VerticalAlignment="Top"
                                              AutomationProperties.Name="{services:Loc buddy.sounds}"/>
                                    <TextBlock Grid.Column="1" Text="{services:Loc buddy.sounds}" TextWrapping="Wrap" Margin="6,1,0,0"
                                               Foreground="{DynamicResource Text.Primary}" Cursor="Hand"
                                               MouseLeftButtonUp="BuddySoundsText_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Text size and font (owner 2026-11-08): a zoom of the whole window and the UI font, live and remembered
                             (SettingsViewModel.Typography.cs → Services/TypographyService). -->
                        <Border Style="{StaticResource Card}" x:Name="TypographyCard">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.typography}" Style="{StaticResource CardTitle}"/>

                                <TextBlock Text="{services:Loc typo.size}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc typo.sizeDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,6" Command="{Binding ZoomOutCommand}"
                                            IsEnabled="{Binding CanZoomOut}" ToolTip="{services:Loc typo.smaller}"
                                            AutomationProperties.Name="{services:Loc typo.smaller}">
                                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <Border MinWidth="64" Margin="0,0,6,6" Padding="8,5" CornerRadius="6"
                                            Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                        <TextBlock x:Name="UiScaleText" Text="{Binding UiScalePercent}" FontSize="13" FontWeight="SemiBold"
                                                   FontFamily="{DynamicResource Font.Mono}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                    </Border>
                                    <Button Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,12,6" Command="{Binding ZoomInCommand}"
                                            IsEnabled="{Binding CanZoomIn}" ToolTip="{services:Loc typo.larger}"
                                            AutomationProperties.Name="{services:Loc typo.larger}">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ScalePresets}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="10,6" Margin="0,0,6,6" ToolTip="{Binding Percent}"
                                                        Command="{Binding DataContext.ZoomPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource State.Selected.Strong}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock><Run Text="{Binding Label, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Percent, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}" FontSize="11"/></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <TextBlock Text="{services:Loc typo.font}" Style="{StaticResource SettingLabel}" Margin="0,8,0,2"/>
                                <TextBlock Text="{services:Loc typo.fontDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="UiFontBox" ItemsSource="{Binding FontChoices}" SelectedItem="{Binding SelectedFontChoice, Mode=TwoWay}"
                                          AutomationProperties.Name="{services:Loc typo.font}" MaxDropDownHeight="360"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontFamily="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                                                <Setter Property="Margin" Value="0,6,0,0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="bundled">
                                                                <Setter Property="ToolTip" Value="{services:Loc typo.font.bundledTip}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Preview: Thai vowels and tone marks stacked above and below, Latin, other scripts, bold -->
                                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource Surface.Input}"
                                        BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                    <StackPanel TextElement.FontFamily="{Binding PreviewFontFamily}">
                                        <TextBlock Text="{services:Loc typo.preview}" FontSize="10.5" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TypoPreviewBig" Text="{services:Loc typo.previewText}" FontSize="17" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ปั๊มน้ำ กี่ปี ญี่ปุ่น ฎีกา · The quick brown fox · Ελληνικά · Кириллица · Tiếng Việt" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"
                                                   Text="ตัวหนา น้ำใจ ปั๊ม · Bold 0123"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{services:Loc typo.font.claudeNote}" Style="{StaticResource SettingDesc}" Margin="0,10,0,4"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,5" FontSize="11.5"
                                        Command="{Binding OpenFontLicenceCommand}" ToolTip="{services:Loc typo.licenceTip}"
                                        Content="{services:Loc typo.licence}"/>
                            </StackPanel>
                        </Border>

                        <!-- More tools: the pages that left the activity bar (also on the rail's ⋯ button, Ctrl+K and their
                             Ctrl+number keys). It was removed with the "dead options" on 2026-10-16, which left Skills and the
                             rest with no button at all (owner 2026-11-07: "ส่วนจัดการ skill ยังไม่เห็น เมนู"). The list is
                             MainViewModel.MoreToolPages, the same one the rail's menu shows. -->
                        <Border Style="{StaticResource Card}" x:Name="MoreToolsCard">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.moreTools}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.moreToolsDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding DataContext.MoreToolPages, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,7"
                                                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Target}" ToolTip="{Binding Tip}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.language}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.uiLanguage}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.uiLanguageDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UiLanguageOptions}" SelectedItem="{Binding UiLanguage}"
                                              Width="150" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.editor}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.autoOpenEditor}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoOpenEditorOnAgentEdit}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.liveEditFollow}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LiveEditFollow}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.followReturn}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.followReturnDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding FollowReturnToChat}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" IsEnabled="{Binding FollowReturnToChat}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.followReturnSeconds}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.followReturnSecondsDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding FollowReturnSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumBox}" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:Loc settings.liveCodingAnimation}" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LiveCodingAnimationEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.storage}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.dataFolder}" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="{services:Loc settings.dataFolderDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataRootDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource WideBox}"
                                             FontFamily="{DynamicResource Font.Mono.Display}"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                            Command="{Binding OpenDirectoryCommand}" CommandParameter="{Binding DataRootDisplay}"
                                            Margin="6,0,0,0" ToolTip="{services:Loc settings.openFolderTip}">
                                            <ContentControl Style="{StaticResource FolderIconOpen}" Width="16" Height="13"/>
                                        </Button>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Accent.1}" FontSize="11" Margin="0,0,0,16"
                                           Text="{services:Loc settings.portableMode}"
                                           Visibility="{Binding IsPortable, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.license}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LicenseStatus}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.licenseDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.licenseOpen}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.maintenance}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{services:Loc settings.checkUpdates}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}">
                                            <Run Text="{services:Loc settings.updatesDesc}"/><Run Text=" "/><Run Text="{Binding DataContext.AppVersion, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                            Command="{Binding DataContext.CheckUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.checkUpdates}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{services:Loc settings.setupWizard.title}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.setupWizard.desc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Content="{services:Loc settings.setupWizard.open}"
                                            Command="{Binding DataContext.OpenSetupWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.resetDefaults}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.resetDefaultsDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{services:Loc settings.resetDefaults}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResetDefaultsCommand}" Foreground="{DynamicResource Status.Danger}"
                                            VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                                            </views:MasonryPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
