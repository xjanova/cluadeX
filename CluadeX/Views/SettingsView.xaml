                                <Grid Style="{StaticResource Row}" Margin="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.chrome}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.chromeDesc}" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding ChromeStatus}" Style="{StaticResource SettingDesc}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ChromeConnectorOn}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>


                        <!-- Batch jobs: half-price batch API work (Anthropic / OpenAI) and where its answers are. -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasBatchService, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.card.batch}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{services:Loc settings.batchDesc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.batchBackground}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.batchBackgroundDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding BatchBackgroundWork}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding BatchJobs}" SelectedItem="{Binding SelectedBatchJob}"
                                         Background="Transparent" BorderThickness="0" MaxHeight="220" Margin="0,8,0,8">
