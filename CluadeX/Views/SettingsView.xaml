                                        <TextBlock Text="{services:Loc settings.tierLocalCheapDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SubAgentLocalCheap}" VerticalAlignment="Center" Margin="16,0,0,0"/>
