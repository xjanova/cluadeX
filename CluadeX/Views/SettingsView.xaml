                                    <Slider Grid.Column="1" Value="{Binding Temperature}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>

                                <Grid Style="{StaticResource Row}" Margin="0" Visibility="{Binding ShowTopP, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">
                                            <Run Text="{services:Loc settings.topP}"/><Run Text="  "/><Run Text="{Binding TopP, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/>
