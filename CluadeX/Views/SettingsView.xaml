                                <TextBlock Text="{services:Loc settings.card.chrome}" Style="{StaticResource CardTitle}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.chromeBridge}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.chromeBridgeDesc}" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding ChromeBridgeStatus}" Style="{StaticResource SettingDesc}" Margin="0,4,0,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddChromeExtensionCommand}" Padding="10,5" Margin="0,8,0,0"
                                                HorizontalAlignment="Left" Content="{services:Loc settings.chromeBridgeAdd}"
                                                Visibility="{Binding ChromeBridgeNeedsExtension, Converter={StaticResource BoolVis}}"/>
                                        <!-- the part Chrome keeps for the user, beside them until the extension connects -->
                                        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource State.Fill.Faint}"
                                                Visibility="{Binding ChromeBridgeGuideVisible, Converter={StaticResource BoolVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{services:Loc chromeBridge.guide.title}" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="{services:Loc chromeBridge.guide.step1}" Style="{StaticResource SettingDesc}" Margin="0,6,0,0"/>
                                                <TextBlock Text="{services:Loc chromeBridge.guide.step2}" Style="{StaticResource SettingDesc}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{services:Loc chromeBridge.guide.step3}" Style="{StaticResource SettingDesc}" Margin="0,4,0,0"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ChromeBridgeExtensionFolder, Mode=OneWay}" IsReadOnly="True" Padding="6,4"
                                                             VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                                             Background="Transparent" Foreground="{DynamicResource Text.Primary}"
                                                             CaretBrush="{DynamicResource Text.Primary}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding CopyChromeExtensionFolderCommand}"
                                                            Padding="10,4" Margin="8,0,0,0" Content="{services:Loc chromeBridge.guide.copy}"/>
                                                </Grid>
                                                <TextBlock Text="{services:Loc chromeBridge.guide.keep}" Style="{StaticResource SettingDesc}" Margin="0,8,0,0"/>
