                                        <TextBlock Text="{services:Loc settings.autoVerifyDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoVerifyAfterEditEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc settings.watchAutoContinue}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{services:Loc settings.watchAutoContinueDesc}" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding WatchAutoContinue}" VerticalAlignment="Center" Margin="16,0,0,0"
                                              AutomationProperties.AutomationId="WatchAutoContinue"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
