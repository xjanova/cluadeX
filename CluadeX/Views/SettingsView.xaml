                                           Foreground="{DynamicResource Text.Secondary}"
                                           Visibility="{Binding SamplingNote, Converter={StaticResource BoolVis}}"/>
                                <Grid Style="{StaticResource Row}" Visibility="{Binding ShowTemperature, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">
                                            <Run Text="{services:Loc settings.temperature}"/><Run Text="  "/><Run Text="{Binding Temperature, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/>
