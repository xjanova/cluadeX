<UserControl x:Class="CluadeX.Views.NodeGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:ui="clr-namespace:CluadeX.Views.UiStudio">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UiStudio/StudioStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="LinkTemplate">
                <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Color}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{Binding Color}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- the line that made this wire: click to open it -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource StudioLinkBtn}" Content="{Binding LineText}" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{services:Loc graph.lineTip}"
                            Visibility="{Binding HasLine, Converter={StaticResource BoolVis}}"
                            Command="{Binding DataContext.OpenLinkEvidenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource StudioLinkBtn}" Content="{Binding Label}" FontFamily="{DynamicResource Font.Mono}"
                            Command="{Binding DataContext.GoToLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </DockPanel>
            </DataTemplate>

            <!-- a kind of connection in the filter row: its colour, name and count; off = its wires are hidden -->
            <Style x:Key="GraphKindChip" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Margin" Value="0,0,6,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="B" CornerRadius="10" Padding="8,2,9,2" BorderThickness="1"
                                    Background="Transparent" BorderBrush="{DynamicResource Border.Subtle}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface.Chip}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Page.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Background="{DynamicResource Page.Toolbar.Background}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{services:Loc graph.title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource Text.Muted}">
                            <Run Text="{Binding RootName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Style="{StaticResource StudioSegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource StudioSegment}" GroupName="GraphMode" Content="{services:Loc graph.modeProject}"
                                         IsChecked="{Binding Mode, Converter={StaticResource NavConverter}, ConverterParameter=project}"/>
                            <RadioButton Style="{StaticResource StudioSegment}" GroupName="GraphMode" Content="{services:Loc graph.modeLive}"
                                         IsChecked="{Binding Mode, Converter={StaticResource NavConverter}, ConverterParameter=live}"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="{services:Loc graph.packages}" IsChecked="{Binding ShowPackages}" VerticalAlignment="Center" Margin="4,0,12,0"
                              Foreground="{DynamicResource Text.Secondary}" FontSize="12" Visibility="{Binding IsProject, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding RefreshCommand}" ToolTip="{services:Loc graph.refreshTip}">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding AutoLayoutCommand}" ToolTip="{services:Loc graph.layoutTip}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="{services:Loc graph.layout}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding FitCommand}" ToolTip="{services:Loc graph.fitTip}">
                        <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding OpenStudioCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="{services:Loc studio.title}"/></StackPanel>
                    </Button>
                </StackPanel>
                <Grid VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource StudioBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="28,5,8,5" MinWidth="220"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding MatchText}" FontSize="10.5" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- project mode: which kinds of connection to show, inferred wires, and grouping by folder -->
        <Border Grid.Row="1" Background="{DynamicResource Page.Toolbar.Background}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,6,12,2"
                Visibility="{Binding IsProject, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,1,0,4">
                    <CheckBox IsChecked="{Binding ShowInferred}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                              Foreground="{DynamicResource Text.Secondary}" ToolTip="{services:Loc graph.inferredTip}"
                              Visibility="{Binding HasInferred, Converter={StaticResource BoolVis}}">
                        <TextBlock><Run Text="{services:Loc graph.showInferred}"/><Run Text=" ("/><Run Text="{Binding InferredCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </CheckBox>
                    <CheckBox Content="{services:Loc graph.groupFolders}" IsChecked="{Binding GroupByFolder}" VerticalAlignment="Center" FontSize="12"
                              Foreground="{DynamicResource Text.Secondary}" ToolTip="{services:Loc graph.groupTip}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource StudioLinkBtn}" Content="{services:Loc graph.allKinds}" Command="{Binding AllKindsCommand}"
                            ToolTip="{services:Loc graph.allKindsTip}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,4"/>
                    <ItemsControl ItemsSource="{Binding EdgeFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource GraphKindChip}" IsChecked="{Binding IsOn}" ToolTip="{services:Loc graph.filterTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" Foreground="{DynamicResource Text.Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <ui:NodeGraphCanvas x:Name="Canvas"/>

            <!-- legend -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="8"
                    Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsProject, Converter={StaticResource BoolVis}}">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F59E0B" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.kind.page}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#7C5CFF" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.kind.component}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#22D3EE" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.kind.script}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#F472B6" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.kind.style}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#60A5FA" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.kind.code}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Border Width="1" Background="{DynamicResource Border.Subtle}" Margin="0,1,12,1"/>
                        <!-- wire colours are on the filter chips above; here only what solid and dashed mean -->
                        <Line X1="0" Y1="1.5" X2="18" Y2="1.5" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.confirmed}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                        <Line X1="0" Y1="1.5" X2="18" Y2="1.5" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" StrokeDashArray="2,1.5" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{services:Loc graph.inferred}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}">
                        <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#2DD4BF" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{services:Loc graph.edge.contains}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,12,0"/>
                    </StackPanel>
                    <TextBlock Text="{services:Loc graph.hint}" FontSize="11" Foreground="{DynamicResource Text.Faint}"/>
                </StackPanel>
            </Border>

            <!-- empty / busy -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Muted}"/>
                <TextBlock Text="{services:Loc graph.busy}" FontSize="13" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            <!-- details -->
            <Border Grid.Column="1" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{services:Loc graph.details}" Style="{StaticResource StudioPanelHeader}"/>
                        <TextBlock Text="{services:Loc graph.noSelection}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding HasAnySelection, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                        <!-- a selected wire: what it is, proven or matched by name, and the lines it stands on -->
                        <StackPanel Visibility="{Binding HasEdgeSelection, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding EdgeTitle}" FontFamily="{DynamicResource Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap" Margin="0,10,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding EdgeColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EdgeKindText}" FontSize="11.5" Foreground="{Binding EdgeColor}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EdgeStatus}" FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding EdgeWhy}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding EdgeWhy, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{services:Loc graph.evidence}" Style="{StaticResource StudioKicker}"/>
                            <ItemsControl ItemsSource="{Binding EdgeEvidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <Button Style="{StaticResource StudioLinkBtn}" Content="{Binding Where}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                    ToolTip="{services:Loc graph.lineTip}"
                                                    Command="{Binding DataContext.OpenEvidenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Border Background="{DynamicResource Surface.Inset}" CornerRadius="5" Padding="6,3" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding SelectedTitle}" FontFamily="{DynamicResource Font.Mono}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding SelectedKind}" FontSize="11" Foreground="{DynamicResource Accent.1}"/>
                            <TextBlock Text="{Binding SelectedPath}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource StudioAccentBtn}" Command="{Binding OpenFileCommand}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="{services:Loc graph.openCode}"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource StudioToolBtn}" Command="{Binding ShowInStudioCommand}" Margin="0,0,6,6"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}" Content="{services:Loc graph.showInStudio}"/>
                                <Button Style="{StaticResource StudioToolBtn}" Command="{Binding ToggleCollapseCommand}" Margin="0,0,6,6"
                                        Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}" Content="{services:Loc graph.collapse}"/>
                            </WrapPanel>

                            <!-- live element: structure edits go to the source -->
                            <StackPanel Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{services:Loc graph.edit}" Style="{StaticResource StudioKicker}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding StructureCommand}" CommandParameter="moveUp" ToolTip="{services:Loc studio.moveUpTip}" Padding="7,4" Margin="0,0,4,4">
                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding StructureCommand}" CommandParameter="moveDown" ToolTip="{services:Loc studio.moveDownTip}" Padding="7,4" Margin="0,0,4,4">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding StructureCommand}" CommandParameter="duplicate" ToolTip="{services:Loc studio.duplicateTip}" Padding="7,4" Margin="0,0,4,4">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button Style="{StaticResource StudioDangerBtn}" Command="{Binding StructureCommand}" CommandParameter="delete" ToolTip="{services:Loc studio.deleteTip}" Padding="7,4" Margin="0,0,4,4">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button Style="{StaticResource StudioToolBtn}" Command="{Binding StructureCommand}" CommandParameter="undo" ToolTip="{services:Loc studio.undoTip}" Padding="7,4" Margin="0,0,4,4">
                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{services:Loc graph.editHint}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource Text.Faint}"/>
                            </StackPanel>

                            <TextBlock Text="{services:Loc graph.outgoing}" Style="{StaticResource StudioKicker}"/>
                            <ItemsControl ItemsSource="{Binding Outgoing}" ItemTemplate="{StaticResource LinkTemplate}"/>
                            <TextBlock Text="{services:Loc graph.incoming}" Style="{StaticResource StudioKicker}"/>
                            <ItemsControl ItemsSource="{Binding Incoming}" ItemTemplate="{StaticResource LinkTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
