<UserControl x:Class="CluadeX.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             Background="{DynamicResource Page.Background}"
             Loaded="OnLoaded">
    <Grid>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{services:Loc setup.title}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui.Display}"/>
                <TextBlock Text="{services:Loc setup.subtitle}" FontSize="12" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Text.Muted}" FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,12,0"/>
                    <Button Content="{services:Loc setup.recheck}" Style="{StaticResource SecondaryButton}" Padding="12,5"
                            Command="{Binding RecheckCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══════ BANNER: the one thing to know first ═══════ -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                Background="{DynamicResource Accent.1.Tint.Faint}" BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Status.Warning}"
                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" MaxWidth="900" FontSize="12.5"
                           Foreground="{DynamicResource Text.Body}"/>
            </StackPanel>
        </Border>

        <!-- ═══════ GROUPS ═══════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <!-- every provider: one click opens its steps -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{services:Loc wizard.hub}" FontSize="13" FontWeight="Bold" Margin="2,0,0,2"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBlock Text="{services:Loc wizard.hubSub}" FontSize="11.5" Margin="2,0,0,8" Foreground="{DynamicResource Text.Muted}"/>
                <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding OpenCommand}" Width="236" Margin="0,0,10,10" Cursor="Hand"
                                    AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Box" Style="{StaticResource Card}" Margin="0" Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="36" Height="36" Margin="0,0,10,0" Fill="{Binding GirlFace}"
                                             Stroke="{DynamicResource Card.Border}" StrokeThickness="1"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Margin="2,0,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- status icon -->
                                                <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Margin="0,2,12,0"
                                                        Background="{DynamicResource Surface.Sunken}">
                                                    <TextBlock Text="{Binding StateGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.Info}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="ok">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="warn">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="danger">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- what it is, why it matters, what was found -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Info}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateKind}" Value="ok">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateKind}" Value="warn">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateKind}" Value="danger">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Why}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource Text.Body}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{DynamicResource Text.Muted}"
                                                               ToolTip="{Binding Detail}"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"
                                                               Foreground="{DynamicResource Accent.1}"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>

                                                <!-- what to do -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button Content="{Binding SecondaryLabel}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0"
                                                            Command="{Binding SecondaryCommand}"
                                                            Visibility="{Binding HasSecondary, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}" Padding="12,5"
                                                            Command="{Binding PrimaryCommand}"
                                                            Visibility="{Binding HasPrimary, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- ═══════ THE CONNECTION WIZARD: covers the page while one provider is being connected ═══════ -->
    <Grid DataContext="{Binding Wizard}" Background="{DynamicResource Page.Background}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- the picture: fades into the page, whatever its colour (off in Classic, like every flourish) -->
        <Grid Width="340" ClipToBounds="True" Visibility="{DynamicResource Fx.Flourish}">
            <Image Source="{Binding Hero}" Stretch="UniformToFill">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Image Source="{Binding Girl}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10,28,30,0"/>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24" MaxWidth="760">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.Ui.Display}"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,18"
                           Foreground="{DynamicResource Text.Muted}" FontFamily="{DynamicResource Font.Ui.Display}"/>

                <!-- the steps -->
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,16" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                    <Border CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Accent.1}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}"/>
                                    <Image Source="{Binding Icon}" Width="42" Height="42"/>
                                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{DynamicResource Status.Success}"
                                            Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Body}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- the step to do now -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding StepIcon}" Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StepCount}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                <TextBlock Text="{Binding StepTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="{Binding StepBody}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Text.Body}"/>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="8" Padding="10,8" Margin="0,12,0,0" Background="{DynamicResource Surface.Sunken}"
                                Visibility="{Binding HasCommands, Converter={StaticResource BoolVis}}">
                            <TextBox Text="{Binding Commands, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                     FontSize="11.5" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Body}"/>
                        </Border>

                        <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Text.Muted}"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,6"
                                    Command="{Binding PrimaryCommand}" Visibility="{Binding HasPrimary, Converter={StaticResource BoolVis}}"/>
                            <Button Content="{Binding FinishLabel}" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,6"
                                    Command="{Binding FinishCommand}" Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}"/>
                            <Button Content="{Binding OtherLabel}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,6"
                                    Command="{Binding OtherCommand}" Visibility="{Binding HasOther, Converter={StaticResource BoolVis}}"/>
                            <Button Content="{services:Loc wizard.useAgy}" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,6"
                                    Command="{Binding UseAntigravityCommand}" Visibility="{Binding CanUseAntigravity, Converter={StaticResource BoolVis}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="{Binding CloseLabel}" Padding="12,5" Margin="0,0,8,0" Command="{Binding CloseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <!-- the finish button in the card is the way out by then -->
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{services:Loc setup.recheck}" Style="{StaticResource SecondaryButton}" Padding="12,5"
                            Command="{Binding CheckAgainCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
