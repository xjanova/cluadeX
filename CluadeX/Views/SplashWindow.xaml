<Window x:Class="CluadeX.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluadeX" Width="940" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="/CluadeX;component/Assets/app.ico" FontFamily="Segoe UI">
    <!-- Startup checks before the app opens: data, chats, license, update (with its download gauge), BrainX, AI, GPU.
         Its own fixed lavender look (the theme is not the point here — the brand is). -->
    <!-- The card sits low-left; the girl stands on the right, taller than the card and over its edge (the window is
         transparent around them). -->
    <Grid>
    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#7C5CC4" ClipToBounds="True"
            Width="720" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,30">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B0F2E" Offset="0"/>
                <GradientStop Color="#2A1648" Offset="0.55"/>
                <GradientStop Color="#3A1F5E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#9B6BFF" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mascot + wordmark -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Image Source="/CluadeX;component/Assets/mascot.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image Source="/CluadeX;component/Assets/logo-wordmark.png" Width="230" Margin="0,6,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"
                           Foreground="#CDB8FF" FontFamily="Consolas"/>
            </StackPanel>

            <!-- Checks -->
            <StackPanel Grid.Column="1" Margin="22,4,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadText" FontSize="17" FontWeight="SemiBold" Foreground="#F3E8FF" Margin="0,0,0,10"/>
                <ItemsControl x:Name="CheckList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E9DDFF" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#B9A3E8" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Update download gauge -->
                <StackPanel x:Name="UpdatePanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="UpdateText" Foreground="#F3E8FF" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="UpdateBar" Height="8" Minimum="0" Maximum="100" Foreground="#C084FC" Background="#3B2560" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer: overall progress + Enter -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="OverallBar" Height="4" Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Foreground="#E879F9" Background="#33204F" BorderThickness="0"/>
                <Button x:Name="EnterButton" Grid.Column="1" Margin="14,0,0,0" Padding="16,6" Visibility="Collapsed"
                        Foreground="White" Background="#8B5CF6" BorderThickness="0" Cursor="Hand" Click="Enter_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
    <Image Source="/CluadeX;component/Assets/splash-girl.png" Height="580" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Margin="0,0,64,6" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
        <Image.Effect>
            <DropShadowEffect Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
        </Image.Effect>
    </Image>
    </Grid>
</Window>
