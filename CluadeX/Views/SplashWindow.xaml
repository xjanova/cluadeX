<Window x:Class="CluadeX.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CluadeX" Width="940" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="/CluadeX;component/Assets/app.ico" FontFamily="Segoe UI">
    <!-- Startup checks before the app opens: data, chats, license, update (with its download gauge), BrainX, AI, GPU.
         Its own fixed lavender look (the theme is not the point here — the brand is). -->
    <!-- The card sits low-left; the girl stands on the right, taller than the card and over its edge (the window is
         transparent around them). -->
    <Grid>
    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#7C5CC4" ClipToBounds="True"
            Width="720" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,30">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B0F2E" Offset="0"/>
                <GradientStop Color="#2A1648" Offset="0.55"/>
                <GradientStop Color="#3A1F5E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#9B6BFF" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="26,22,26,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mascot + wordmark -->
            <StackPanel x:Name="BrandPanel" Grid.Column="0" VerticalAlignment="Center">
                <Image Source="/CluadeX;component/Assets/mascot.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image Source="/CluadeX;component/Assets/logo-wordmark.png" Width="230" Margin="0,6,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"
                           Foreground="#CDB8FF" FontFamily="Consolas"/>
            </StackPanel>

            <!-- Checks -->
            <StackPanel x:Name="ChecksPanel" Grid.Column="1" Margin="22,4,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadText" FontSize="17" FontWeight="SemiBold" Foreground="#F3E8FF" Margin="0,0,0,10"/>
                <ItemsControl x:Name="CheckList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E9DDFF" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#B9A3E8" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Update download gauge -->
                <StackPanel x:Name="UpdatePanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="UpdateText" Foreground="#F3E8FF" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="UpdateBar" Height="8" Minimum="0" Maximum="100" Foreground="#C084FC" Background="#3B2560" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Update mode (design board UpdateSplash): while the startup update downloads, verifies, installs and restarts,
                 the card is about that alone — a ring with the real figure, the four steps, and that nothing is lost. -->
            <Grid x:Name="UpdateMode" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpHead" FontSize="21" FontWeight="SemiBold" Foreground="#F4EEFF" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center" Background="#4D7C3AED" BorderBrush="#99C084FC" BorderThickness="1">
                        <TextBlock x:Name="UpVersions" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4EEFF"/>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- the ring: the figure in the middle, the arc drawn in code (UpdateRing) -->
                    <Grid Width="168" Height="168" VerticalAlignment="Center">
                        <Ellipse Stroke="#2EFFFFFF" StrokeThickness="10" Margin="5"/>
                        <Path x:Name="UpArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C084FC" Offset="0"/><GradientStop Color="#A21CAF" Offset="1"/></LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect><DropShadowEffect Color="#C084FC" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/></Path.Effect>
                        </Path>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="UpPct" FontSize="38" FontWeight="Bold" Foreground="#F4EEFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UpMb" FontSize="12" Foreground="#BBA9DD" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="UpSteps" Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="22" Height="22" HorizontalAlignment="Left">
                                        <Ellipse Stroke="{Binding RingBrush}" StrokeThickness="1.5" Fill="{Binding FillBrush}"/>
                                        <TextBlock Text="{Binding Mark}" FontSize="11" FontWeight="Bold" Foreground="{Binding MarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" Foreground="{Binding LabelBrush}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Border Grid.Row="2" CornerRadius="12" Padding="14,9" Margin="0,14,0,0" Background="#1A4ADE80" BorderBrush="#4D4ADE80" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,1 L14,3.5 L14,8 C14,11.5 11.5,14 8,15 C4.5,14 2,11.5 2,8 L2,3.5 Z M5,8 L7.2,10.2 L11,6.4" Stroke="#4ADE80" StrokeThickness="1.5"
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UpSafe" FontSize="12.5" Foreground="#E4D7FF" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer: overall progress + Enter -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpSlowHint" FontSize="11.5" Foreground="#BBA9DD" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                <ProgressBar x:Name="OverallBar" Height="4" Minimum="0" Maximum="100" VerticalAlignment="Center"
                             Foreground="#E879F9" Background="#33204F" BorderThickness="0"/>
                <!-- "Enter" — or, while the startup update downloads / installs, "Skip" with what skipping means
                     (the download goes on in the background and installs when the app closes). -->
                <Button x:Name="EnterButton" Grid.Column="1" Margin="14,0,0,0" Padding="16,6" Visibility="Collapsed"
                        Foreground="White" Background="#8B5CF6" BorderThickness="0" Cursor="Hand" Click="Enter_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <TextBlock x:Name="EnterTitle" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EnterSub" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="250" FontSize="10.5" Foreground="#E9DDFF" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
    <Image x:Name="SplashGirl" Source="/CluadeX;component/Assets/splash-girl.png" Height="580" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Margin="0,0,64,6" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
        <Image.Effect>
            <DropShadowEffect x:Name="SplashGirlGlow" Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
        </Image.Effect>
    </Image>
    </Grid>
</Window>
