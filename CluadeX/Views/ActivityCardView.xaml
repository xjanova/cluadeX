<!-- The chat's activity card (owner 2026-11-10: "ทำ การ์ดอนิเมชั่นเท่ห์ๆ ในหน้าต่างแชทเพิ่ม เกี่ยวกับ การสั่งงานการทำงานของเอไอ
     ให้เห็นเป็นการจำลองการทำงานแบบแท่ห์ ว่ากำลังทำอะไร … ปิดได้"). DataContext = ChatViewModel.Activity (ActivityCardModel).
       header    a dot in the mood's colour, the title, the turn's clock, ✕ (CloseCommand: off until the "+" menu)
       scene     ActivityScene: the core, the five stations, the beam, packets, comets, sub-agents as satellites
       headline  how the turn stands, and the step running now in the chat's own words
       counters  looked / edits / runs / agents this turn
       feed      the last four steps, newest first, each with ✓ / ✕
     Every part keeps its height whatever it shows (the detail line is Hidden, not Collapsed; the feed has a fixed
     height), so nothing under the card moves while a run works. Compact (the panel stacked under the composer):
     header and headline only. -->
<UserControl x:Class="CluadeX.Views.ActivityCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:services="clr-namespace:CluadeX.Services"
             x:Name="Root"
             AutomationProperties.AutomationId="CxChat.ActivityCard"
             AutomationProperties.Name="{services:Loc activity.name}">
    <UserControl.Resources>
        <!-- the mood's colour: the header dot and the headline -->
        <Style x:Key="MoodColor" TargetType="FrameworkElement">
            <Setter Property="Tag" Value="{DynamicResource Accent.1}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mood}" Value="idle"><Setter Property="Tag" Value="{DynamicResource Text.Muted}"/></DataTrigger>
                <DataTrigger Binding="{Binding Mood}" Value="waiting"><Setter Property="Tag" Value="{DynamicResource Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Mood}" Value="done"><Setter Property="Tag" Value="{DynamicResource Status.Success}"/></DataTrigger>
                <DataTrigger Binding="{Binding Mood}" Value="failed"><Setter Property="Tag" Value="{DynamicResource Status.Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding Mood}" Value="stopped"><Setter Property="Tag" Value="{DynamicResource Text.Muted}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Counter" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CounterGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="CounterNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CounterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card" CornerRadius="12" BorderThickness="1" Padding="10,8,10,10"
            BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="MoodDot" Width="8" Height="8" Margin="2,0,7,0" VerticalAlignment="Center"
                         Style="{StaticResource MoodColor}" Fill="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Column="1" Text="{services:Loc activity.title}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ElapsedText" Grid.Column="2" Text="{Binding Elapsed}" FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                           Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,4,0"
                           ToolTip="{services:Loc activity.elapsedTip}"/>
                <Button x:Name="CloseButton" Grid.Column="3" Content="&#xE711;" FontSize="10" Width="22" Height="22"
                        Style="{DynamicResource IconButton}" Command="{Binding CloseCommand, ElementName=Root}"
                        ToolTip="{services:Loc activity.close}" AutomationProperties.AutomationId="CxChat.ActivityClose"
                        AutomationProperties.Name="{services:Loc activity.close}"/>
            </Grid>

            <!-- the scene -->
            <views:ActivityScene x:Name="Scene" Grid.Row="1" Height="136" Margin="0,8,0,0"
                                 Track="{Binding Track}" Version="{Binding Version}"/>

            <!-- headline + the step running now -->
            <StackPanel Grid.Row="2" Margin="2,8,2,0">
                <TextBlock x:Name="HeadlineText" Text="{Binding Headline}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource MoodColor}" Foreground="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="11" FontFamily="{DynamicResource Font.Mono}" Height="16" Margin="0,2,0,0"
                           Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- counters -->
            <UniformGrid x:Name="Counters" Grid.Row="3" Columns="4" Margin="-2,8,-2,0">
                <Border Style="{StaticResource Counter}" ToolTip="{services:Loc activity.count.readsTip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource CounterGlyph}" Foreground="{DynamicResource Status.Info}"/>
                            <TextBlock Text="{Binding Reads}" Style="{StaticResource CounterNumber}"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc activity.count.reads}" Style="{StaticResource CounterLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Counter}" ToolTip="{services:Loc activity.count.editsTip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource CounterGlyph}" Foreground="{DynamicResource Accent.2}"/>
                            <TextBlock Text="{Binding Edits}" Style="{StaticResource CounterNumber}"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc activity.count.edits}" Style="{StaticResource CounterLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Counter}" ToolTip="{services:Loc activity.count.commandsTip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE756;" Style="{StaticResource CounterGlyph}" Foreground="{DynamicResource Status.Warning}"/>
                            <TextBlock Text="{Binding Commands}" Style="{StaticResource CounterNumber}"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc activity.count.commands}" Style="{StaticResource CounterLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Counter}" ToolTip="{services:Loc activity.count.agentsTip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE716;" Style="{StaticResource CounterGlyph}" Foreground="{DynamicResource Accent.3}"/>
                            <TextBlock Text="{Binding Agents}" Style="{StaticResource CounterNumber}"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc activity.count.agents}" Style="{StaticResource CounterLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- the last steps (fixed height: four rows) -->
            <Border x:Name="FeedBox" Grid.Row="4" Margin="0,8,0,0" Height="86" CornerRadius="8" Padding="8,4"
                    Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="{services:Loc activity.feed.empty}" FontSize="11" Foreground="{DynamicResource Text.Faint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feed.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="FeedList" ItemsSource="{Binding Feed}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="19" ToolTip="{Binding Tip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontSize="10" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Faint}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11">
                                        <Run Text="{Binding Verb, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                        <Run Text="{Binding Target, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Muted}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE710;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent.3}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="ok">
                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="fail">
                                                        <Setter Property="Text" Value="&#xE711;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
