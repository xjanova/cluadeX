<!-- น้อง CluadeX at the top of the activity bar, in place of the cat logo (owner 2026-11-08: "ไอค่อนแมวตัวล่างควรเป็นหน้าของ
     น้อง cluadex ผู้หญิงน่ารักขยับยุกยิกได้ตามงานในขณะนั้น … ไม่มีไรทำก็ทำหลับ"). DataContext: ChatViewModel (BuddyMoodState,
     BuddyMoodTip; the tooltip and the click to Home are on the Button around her in MainWindow). The motion is code-behind (CluadexBuddy.xaml.cs): one set of storyboards per mood, low frame rates,
     paused while the window is minimised or hidden, and while it is in the background when she has nothing to do. -->
<UserControl x:Class="CluadeX.Views.CluadexBuddy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="36" Height="36" Focusable="False">
    <Grid>
        <!-- the rim: the theme's accent; amber while she waits for the owner, red for a moment after a failure -->
        <Ellipse x:Name="Rim" Width="36" Height="36" StrokeThickness="1.5" Stroke="{DynamicResource Accent.2}" Opacity="0.55"/>
        <!-- working: a neon arc runs round her -->
        <Ellipse x:Name="WorkArc" Width="36" Height="36" StrokeThickness="2" StrokeDashArray="9 100" StrokeDashCap="Round"
                 Stroke="{DynamicResource Accent.1}" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse.RenderTransform><RotateTransform x:Name="ArcSpin"/></Ellipse.RenderTransform>
        </Ellipse>

        <!-- her head: bobs, tilts and breathes about the chin -->
        <Grid x:Name="Head" Width="32" Height="32" RenderTransformOrigin="0.5,0.85">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Breathe"/>
                    <RotateTransform x:Name="Tilt"/>
                    <TranslateTransform x:Name="Bob"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Ellipse Fill="{DynamicResource ActivityBar.Logo.Background}"/>
            <Ellipse x:Name="FaceAwake">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="/CluadeX;component/Assets/Buddy/cluadex-face.png" Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                </Ellipse.Fill>
            </Ellipse>
            <!-- eyes closed: a blink now and then, and asleep -->
            <Ellipse x:Name="FaceAsleep" Opacity="0">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="/CluadeX;component/Assets/Buddy/cluadex-face-sleep.png" Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- asleep: two z's float up -->
        <TextBlock x:Name="Z1" Text="z" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent.2}" Opacity="0"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" IsHitTestVisible="False">
            <TextBlock.RenderTransform><TranslateTransform x:Name="Z1Rise"/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="Z2" Text="z" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource Accent.2}" Opacity="0"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,-1,0" IsHitTestVisible="False">
            <TextBlock.RenderTransform><TranslateTransform x:Name="Z2Rise"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- waiting: an amber "?" bubble bounces at her cheek -->
        <Border x:Name="AskChip" Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-3,-2" Background="{DynamicResource Status.Warning}" BorderBrush="{DynamicResource ActivityBar.Background}"
                BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="AskHop"/></Border.RenderTransform>
            <TextBlock Text="?" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ActivityBar.Background}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Border>
        <!-- a failure: a red "!" -->
        <Border x:Name="SadChip" Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-3,-2" Background="{DynamicResource Status.Danger}" BorderBrush="{DynamicResource ActivityBar.Background}"
                BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="!" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ActivityBar.Background}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Border>
        <!-- a turn finished well: a sparkle pops -->
        <TextBlock x:Name="Sparkle" Text="✦" FontSize="11" Foreground="{DynamicResource Status.Success}" Opacity="0"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" IsHitTestVisible="False"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><ScaleTransform x:Name="SparkleScale" ScaleX="0.3" ScaleY="0.3"/></TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</UserControl>
