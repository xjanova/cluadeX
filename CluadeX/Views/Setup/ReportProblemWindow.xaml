<Window x:Class="CluadeX.Views.Setup.ReportProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="{services:Loc bug.title}" Width="1000" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/CluadeX;component/Assets/app.ico" Foreground="#F4EEFF" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- "แจ้งปัญหา": the user's words + what they tick → Xman Studio's bug inbox; a ticket back, or "kept to send later".
         The look of the setup wizard and the update window (SetupStyles). Three faces on one card: the form, the preview
         of exactly what is sent, and the answer. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CluadeX;component/Views/Setup/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CatChip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#E4D7FF"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" CornerRadius="999" Padding="12,5" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#66C084FC"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#4D7C3AED"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#99C084FC"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#F0ABFC"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AttachText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#E4D7FF"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Border CornerRadius="16" Background="#E6100A1E" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
        <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.75,0.82" GradientOrigin="0.75,0.82" RadiusX="0.42" RadiusY="0.55">
                    <GradientStop Color="#557C3AED" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Image x:Name="GirlImage" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="600" Margin="0,0,10,-10"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
            <Image.Effect><DropShadowEffect x:Name="GirlGlowFx" Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Image.Effect>
        </Image>

        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="56,0,0,0" Width="620" MaxHeight="676" CornerRadius="22" Padding="28,22,28,22"
                BorderBrush="#33C084FC" BorderThickness="1" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2241540" Offset="0"/>
                    <GradientStop Color="#F21A0F30" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect Color="#7C3AED" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
            <DockPanel LastChildFill="True">
                <!-- header -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Primary}" VerticalAlignment="Top">
                        <Path Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,16.5 L12,17" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock x:Name="TitleText" Text="{services:Loc bug.title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubText" Text="{services:Loc bug.sub}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource WinBtn}" Width="36" Height="36" VerticalAlignment="Top" Click="Close_Click"
                            ToolTip="{services:Loc bug.close}">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="#E9DDFF" StrokeThickness="1.4" Width="12" Height="12"/>
                    </Button>
                </Grid>

                <!-- the buttons (form and preview) -->
                <Grid x:Name="FormButtons" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="SendButton" Style="{StaticResource BtnPrimary}" Click="Send_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="SendSpinner" Style="{StaticResource Spinner}" Stroke="White" Margin="0,0,10,0" Visibility="Collapsed"/>
                            <Path x:Name="SendIcon" Data="M3,11 L21,3 L14,21 L11,13 Z M11,13 L21,3" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SendText" Text="{services:Loc bug.send}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource BtnBase}" Content="{services:Loc bug.cancel}" Margin="12,0,0,0" Click="Close_Click"/>
                    <Button x:Name="PreviewButton" Grid.Column="2" Style="{StaticResource BtnLink}" Content="{services:Loc bug.preview}" FontSize="12.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="Preview_Click"/>
                </Grid>

                <Grid>
                    <!-- ── the form ── -->
                    <ScrollViewer x:Name="FormPane" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="{services:Loc bug.category}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="CategoryPanel"/>

                            <Grid Margin="0,8,0,6">
                                <TextBlock Text="{services:Loc bug.message}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE"/>
                                <TextBlock x:Name="CounterText" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Dim}" FontFamily="Consolas"/>
                            </Grid>
                            <Border Style="{StaticResource FieldBorder}" Height="118">
                                <Grid>
                                    <TextBox x:Name="MessageInput" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="5000"
                                             VerticalContentAlignment="Top" Padding="12,10" FontSize="13.5" VerticalScrollBarVisibility="Auto"
                                             TextChanged="Message_TextChanged"/>
                                    <TextBlock x:Name="MessageHint" Text="{services:Loc bug.message.hint}" Margin="14,10,14,0" FontSize="13.5"
                                               Foreground="#7F6FA6" IsHitTestVisible="False" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{services:Loc bug.email}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE" Margin="0,14,0,6"/>
                            <Border Style="{StaticResource FieldBorder}" Height="38">
                                <TextBox x:Name="EmailBox" Style="{StaticResource Field}" FontSize="13.5" MaxLength="200"/>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc bug.attach}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="LogCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,3">
                                        <TextBlock x:Name="LogCheckText" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="SystemCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,3">
                                        <TextBlock Text="{services:Loc bug.attach.system}" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="SettingsCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,3">
                                        <TextBlock Text="{services:Loc bug.attach.settings}" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ErrorsCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,3">
                                        <TextBlock x:Name="ErrorsCheckText" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ScreenshotCheck" Style="{StaticResource Check}" Margin="0,3">
                                        <TextBlock Text="{services:Loc bug.attach.screenshot}" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="ChatCheck" Style="{StaticResource Check}" Margin="0,3">
                                        <TextBlock x:Name="ChatCheckText" Text="{services:Loc bug.attach.chat}" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                    <CheckBox x:Name="LicenseCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,3" Visibility="Collapsed">
                                        <TextBlock x:Name="LicenseCheckText" Style="{StaticResource AttachText}"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Path Data="M12,2 L20,5 L20,11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 L4,5 Z" Stroke="#A7F3D0" StrokeThickness="1.4"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{services:Loc bug.privacy}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock x:Name="QueueText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock x:Name="ErrorText" Style="{StaticResource Err}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── the preview ── -->
                    <DockPanel x:Name="PreviewPane" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="{services:Loc bug.preview.title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PreviewExtra" DockPanel.Dock="Bottom" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <Border Style="{StaticResource Card}" Background="#66000000">
                            <TextBox x:Name="PreviewBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#E4D7FF"
                                     FontFamily="Consolas" FontSize="11.5" Padding="12,10" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SelectionBrush="#A855F7"/>
                        </Border>
                    </DockPanel>

                    <!-- ── the answer ── -->
                    <StackPanel x:Name="ResultPane" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="ResultBadge" Width="40" Height="40" CornerRadius="20" Background="#3322C55E" BorderBrush="#8822C55E" BorderThickness="1">
                                <Path x:Name="ResultIcon" Data="{StaticResource IcoCheck}" Stroke="#86EFAC" StrokeThickness="2.4" Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="ResultTitle" Grid.Column="1" FontSize="19" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <Border x:Name="TicketCard" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{services:Loc bug.ticket}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TicketText" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#F4EEFF" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource BtnSmall}" Content="{services:Loc bug.copy}" VerticalAlignment="Center" Click="Copy_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ResultText" FontSize="13.5" Foreground="#E4D7FF" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="DoneButton" Style="{StaticResource BtnPrimary}" Content="{services:Loc bug.close}" Click="Close_Click"/>
                            <Button x:Name="BackButton" Style="{StaticResource BtnBase}" Content="{services:Loc bug.back}" Margin="12,0,0,0" Click="Back_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
