<Window x:Class="CluadeX.Views.Setup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        xmlns:vm="clr-namespace:CluadeX.ViewModels.Setup"
        Title="{services:Loc un.titleBar}" Width="960" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="/CluadeX;component/Assets/app.ico" Foreground="#F4EEFF" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- The uninstall page: the setup wizard's own fixed purple look (no theme is loaded here — the page runs without the
         app), its title bar, stepper, step rows and girl. Pages: Choose (tick what to keep) · Progress · Done; the
         confirmation is an overlay over Choose. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CluadeX;component/Views/Setup/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Danger" Color="#F87171"/>
            <LinearGradientBrush x:Key="DangerFill" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E11D48" Offset="0"/>
                <GradientStop Color="#9333EA" Offset="1"/>
            </LinearGradientBrush>
            <Geometry x:Key="IcoTrash">M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,16 M14,11 L14,16</Geometry>
            <Geometry x:Key="IcoShield">M12,3 L19,6 L19,11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 L5,6 Z</Geometry>
            <Geometry x:Key="IcoWarn">M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.5</Geometry>

            <DataTemplate x:Key="StepRow" DataType="{x:Type vm:WizardStepVm}">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse x:Name="ring" Stroke="#40FFFFFF" StrokeThickness="1.5"/>
                        <Ellipse x:Name="fill" Visibility="Collapsed"/>
                        <Path x:Name="ok" Data="{StaticResource IcoCheck}" Stroke="#4ADE80" StrokeThickness="2.2" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Visibility="Collapsed"/>
                        <Path x:Name="spin" Style="{StaticResource Spinner}" Width="22" Height="22" Data="M11,1.5 A9.5,9.5 0 0 1 20.5,11" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Label}" FontSize="14" Foreground="#CFC2EA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="detail" Grid.Column="2" Text="{Binding Detail}" FontSize="12.5" Foreground="#BBA9DD" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Right" Margin="12,0,0,0" MaxWidth="240" ToolTip="{Binding Detail}"/>
                    <TextBlock x:Name="reason" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="12.5" Foreground="#BBA9DD"
                               TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                        <Setter TargetName="spin" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="ring" Property="Stroke" Value="#4DC084FC"/>
                        <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="fill" Property="Fill" Value="#33A855F7"/>
                        <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                        <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="fill" Property="Fill" Value="#2E4ADE80"/>
                        <Setter TargetName="ok" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                        <Setter TargetName="detail" Property="Foreground" Value="#86EFAC"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                        <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="glyph" Property="Text" Value="–"/>
                        <Setter TargetName="glyph" Property="Foreground" Value="#BBA9DD"/>
                        <Setter TargetName="detail" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="reason" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="fill" Property="Fill" Value="#33F87171"/>
                        <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="glyph" Property="Text" Value="✕"/>
                        <Setter TargetName="glyph" Property="Foreground" Value="#FCA5A5"/>
                        <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                        <Setter TargetName="detail" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="reason" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="reason" Property="Foreground" Value="#FCA5A5"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="16" BorderThickness="1" BorderBrush="#33C4A7FF" Background="#120A22">
        <Grid>
            <!-- ─────────── backdrop: art, glow, girl, stars ─────────── -->
            <Image Source="/CluadeX;component/Assets/Wizard/hero.jpg" Width="560" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.28" IsHitTestVisible="False">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="Black" Offset="0.55"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Ellipse Width="440" Height="440" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,-130" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5CC084FC" Offset="0"/>
                        <GradientStop Color="#00C084FC" Offset="0.68"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Image x:Name="GirlImage" Source="{Binding Girl}" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-10"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
                <Image.Effect><DropShadowEffect x:Name="GirlGlowFx" Color="#C084FC" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/></Image.Effect>
                <Image.RenderTransform><TranslateTransform x:Name="GirlFloat"/></Image.RenderTransform>
            </Image>
            <Path Data="{StaticResource IcoStar}" Fill="#F5D0FE" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,300,0" Opacity="0.6" IsHitTestVisible="False"/>
            <Path Data="{StaticResource IcoStar}" Fill="#E9D5FF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,30,0" Opacity="0.5" IsHitTestVisible="False"/>

            <!-- ─────────── title bar ─────────── -->
            <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="/CluadeX;component/Assets/logo_small.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{services:Loc un.titleBar}" FontSize="13" Foreground="#C9B8EA" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Stepper}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepperItem}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="sep" Width="16" Height="1" Background="#33FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <Border x:Name="dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#40FFFFFF" VerticalAlignment="Center">
                                    <TextBlock x:Name="mark" Text="{Binding Mark}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="12" Foreground="#9F8CC6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowSep}" Value="False"><Setter TargetName="sep" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsNow}" Value="True">
                                    <Setter TargetName="dot" Property="Background" Value="{StaticResource Primary}"/>
                                    <Setter TargetName="dot" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="lbl" Property="Foreground" Value="#F4EEFF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="dot" Property="Background" Value="#2E4ADE80"/>
                                    <Setter TargetName="dot" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="mark" Property="Foreground" Value="#4ADE80"/>
                                    <Setter TargetName="lbl" Property="Foreground" Value="#C9B8EA"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Width="52" Command="{Binding ToggleLanguageCommand}" ToolTip="{services:Loc wiz.language}">
                        <TextBlock Text="{Binding LanguageToggleText}" FontSize="12" Foreground="#C9B8EA"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Minimize_Click" ToolTip="{services:Loc wiz.minimize}">
                        <Path Data="M1,6 L11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="{services:Loc wiz.close}">
                        <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ 1. Choose what to keep ═══════════ -->
            <Grid Visibility="{Binding IsChoose, Converter={StaticResource Vis}}" Margin="52,58,0,20" Width="580" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc un.choose.title}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{services:Loc un.choose.sub}" Style="{StaticResource Sub}" LineHeight="21"/>
                </StackPanel>
                <!-- where the data is · keep all / remove all -->
                <Grid Grid.Row="1" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IcoFolder}" Stroke="#C4B5FD" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0" TextTrimming="CharacterEllipsis" FontSize="12.5">
                        <Run Text="{services:Loc un.choose.dataAt}" Foreground="{StaticResource Dim}"/>
                        <Run Text="{Binding DataRoot, Mode=OneWay}" FontFamily="Consolas" Foreground="#E4D7FF"/>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnLink}" Content="{services:Loc un.choose.keepAll}" Command="{Binding KeepAllCommand}" FontSize="12.5"/>
                        <TextBlock Text="·" Foreground="{StaticResource Dim}" Margin="8,0"/>
                        <Button Style="{StaticResource BtnLink}" Content="{services:Loc un.choose.removeAll}" Command="{Binding RemoveAllCommand}" FontSize="12.5"/>
                    </StackPanel>
                </Grid>
                <!-- the rows: two columns of tiles, so every row is in sight without scrolling -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-4,0">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:KeepRowVm}">
                                <Border x:Name="row" CornerRadius="12" Padding="12,8" Margin="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonUp="Row_Click" ToolTip="{Binding Description}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Keep}" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.Name="{Binding Label}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis" FontSize="11.5">
                                                <Run x:Name="size" Text="{Binding Size, Mode=OneWay}" Foreground="#E4D7FF" FontWeight="SemiBold"/><Run x:Name="dot" Text=" · " Foreground="{StaticResource Dim}"/><Run x:Name="desc" Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Keep}" Value="False">
                                        <Setter TargetName="row" Property="Background" Value="#1AF87171"/>
                                        <Setter TargetName="row" Property="BorderBrush" Value="#40F87171"/>
                                        <Setter TargetName="lbl" Property="Foreground" Value="#FECACA"/>
                                        <Setter TargetName="lbl" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Size}" Value=""><Setter TargetName="dot" Property="Text" Value=""/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                        <Setter TargetName="desc" Property="FontFamily" Value="Consolas"/>
                                        <Setter TargetName="desc" Property="Foreground" Value="#C4B5FD"/>
                                    </DataTrigger>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="BorderBrush" Value="#59C4A7FF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- open app · always removed -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding AppRunning, Converter={StaticResource Vis}}" Margin="0,0,0,6">
                        <Path Data="{StaticResource IcoWarn}" Stroke="#FDE68A" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock Text="{services:Loc un.choose.running}" FontSize="12.5" Foreground="#FDE68A" TextWrapping="Wrap" MaxWidth="550"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcoShield}" Stroke="#A78BFA" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock Text="{services:Loc un.choose.always}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="550" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="GoButton" Command="{Binding GoCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoTrash}" Stroke="White" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GoText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding CancelCommand}" Content="{services:Loc wiz.cancel}" Margin="12,0,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="{Binding Measuring, Converter={StaticResource Vis}}">
                        <Path Style="{StaticResource Spinner}" Width="14" Height="14" Data="M7,1 A6,6 0 0 1 13,7" Margin="0,0,8,0"/>
                        <TextBlock Text="{services:Loc un.choose.measuring}" FontSize="12.5" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ═══════════ 2. Progress ═══════════ -->
            <StackPanel Visibility="{Binding IsProgress, Converter={StaticResource Vis}}" Margin="56,66,0,0" Width="540" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{services:Loc un.prog.title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{services:Loc un.prog.sub}" Style="{StaticResource Sub}"/>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,12">
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" Focusable="False"/>
                </Border>
            </StackPanel>

            <!-- ═══════════ 3. Done ═══════════ -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Vis}}" Margin="56,64,0,0" Width="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Primary}" HorizontalAlignment="Left">
                    <Border.Effect><DropShadowEffect Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                    <Path Data="{StaticResource IcoCheck}" Stroke="White" StrokeThickness="2.6" Width="24" Height="24" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{services:Loc un.done.title}" Style="{StaticResource H1}" FontSize="28" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding DoneBody}" Style="{StaticResource Sub}" FontSize="14" LineHeight="23"/>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                    <StackPanel>
                        <StackPanel Visibility="{Binding KeptSomething, Converter={StaticResource Vis}}">
                            <TextBlock Text="{services:Loc un.done.kept}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D6C9F0" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding KeptLines}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Path Data="{StaticResource IcoCheck}" Stroke="#4ADE80" StrokeThickness="2.2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#E4D7FF" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource BtnLink}" Content="{services:Loc un.done.openFolder}" Command="{Binding OpenFolderCommand}" FontSize="12.5" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers><DataTrigger Binding="{Binding KeptSomething}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource IcoTrash}" Stroke="#C4B5FD" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc un.done.nothingKept}" FontSize="13" Foreground="#E4D7FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Background="#1AF87171" BorderBrush="#4DF87171" BorderThickness="1" Padding="16,12" Margin="0,12,0,0"
                        Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProblemsText}" Style="{StaticResource Err}" LineHeight="20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource BtnSmall}" Content="{services:Loc un.done.retry}" Command="{Binding RetryCommand}"/>
                            <Button Style="{StaticResource BtnSmall}" Content="{services:Loc un.done.openReport}" Command="{Binding OpenReportCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CloseCommand}" Content="{services:Loc un.done.close}" Margin="0,18,0,0" HorizontalAlignment="Left" MinWidth="140"/>
            </StackPanel>

            <!-- ═══════════ overlay: delete for good? ═══════════ -->
            <Grid Visibility="{Binding ShowConfirm, Converter={StaticResource Vis}}" Background="#B3080412" Margin="0,44,0,0">
                <Border Width="560" CornerRadius="18" BorderBrush="#66F87171" BorderThickness="1" Padding="26,22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,60,0,0" Background="#F7201038">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#33F87171">
                                <Path Data="{StaticResource IcoTrash}" Stroke="#FCA5A5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{services:Loc un.confirm.title}" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc un.confirm.body}" FontSize="13.5" Foreground="#D6C9F0" Margin="0,14,0,8" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding ConfirmLines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="#F87171" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13.5" Foreground="#FECACA" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Command="{Binding ConfirmCommand}" Content="{services:Loc un.confirm.yes}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                        <Setter Property="Background" Value="{StaticResource DangerFill}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="ConfirmNo" Style="{StaticResource BtnBase}" Command="{Binding BackToChooseCommand}" Content="{services:Loc un.confirm.no}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
