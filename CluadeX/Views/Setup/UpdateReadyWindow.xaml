<Window x:Class="CluadeX.Views.Setup.UpdateReadyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        Title="{services:Loc upd.title}" Width="960" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/CluadeX;component/Assets/app.ico" Foreground="#F4EEFF" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- "A new version is ready" (design board UpdateReady): what is new, the auto-update switch (only for an install that
         may update by itself — installer contract 2.1), Update and restart / Later / all the details. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CluadeX;component/Views/Setup/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <!-- the dim behind the card, and the girl beside it -->
        <Border CornerRadius="16" Background="#E6100A1E" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
        <Border CornerRadius="16" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.72,0.82" GradientOrigin="0.72,0.82" RadiusX="0.45" RadiusY="0.55">
                    <GradientStop Color="#557C3AED" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Image x:Name="GirlImage" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="560" Margin="0,0,40,-10"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
            <Image.Effect><DropShadowEffect x:Name="GirlGlowFx" Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Image.Effect>
        </Image>

        <!-- the card -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="90,0,0,0" Width="560" CornerRadius="22" Padding="28,24,28,24"
                BorderBrush="#33C084FC" BorderThickness="1" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2241540" Offset="0"/>
                    <GradientStop Color="#F21A0F30" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect Color="#7C3AED" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image Source="/CluadeX;component/Assets/logo.png" Width="44" Height="44" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{services:Loc upd.title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubText" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource WinBtn}" Width="36" Height="36" VerticalAlignment="Top" Click="Later_Click"
                            ToolTip="{services:Loc upd.close}">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="#E9DDFF" StrokeThickness="1.4" Width="12" Height="12"/>
                    </Button>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border CornerRadius="8" Padding="10,4" Background="#14FFFFFF">
                        <TextBlock x:Name="FromText" FontFamily="Consolas" FontSize="12.5" Foreground="#BBA9DD"/>
                    </Border>
                    <Path Grid.Column="1" Data="{StaticResource IcoArrow}" Stroke="#BBA9DD" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="12,0"/>
                    <Border Grid.Column="2" CornerRadius="8" Padding="10,4" Background="#4D7C3AED" BorderBrush="#99C084FC" BorderThickness="1">
                        <TextBlock x:Name="ToText" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#F4EEFF"/>
                    </Border>
                    <TextBlock x:Name="DateText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Dim}"/>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{services:Loc upd.whatsNew}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D8B4FE" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="Notes" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="#F0ABFC" Margin="0,8,12,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Bullet}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="AutoSwitch" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed"/>
                    <StackPanel Grid.Column="1" Margin="12,2,0,0">
                        <TextBlock Text="{services:Loc upd.auto}" FontSize="13" Foreground="#E4D7FF" TextWrapping="Wrap"/>
                        <!-- no paid/trial license and no linked account: the switch cannot turn on; the way to get it -->
                        <StackPanel x:Name="LinkRow" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock Text="{services:Loc update.linkHint}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                            <Button Style="{StaticResource BtnLink}" Content="{services:Loc update.linkAccount}" FontSize="12" Margin="10,0,0,0" Click="Link_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="UpdateButton" Style="{StaticResource BtnPrimary}" Click="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M20,12 A8,8 0 1 1 17.7,6.3 M20,4 L20,9 L15,9" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc upd.now}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource BtnBase}" Content="{services:Loc upd.later}" Margin="12,0,0,0" Click="Later_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnLink}" Content="{services:Loc upd.details}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Details_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
