<Window x:Class="CluadeX.Views.Setup.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        xmlns:vm="clr-namespace:CluadeX.ViewModels.Setup"
        Title="{services:Loc wiz.titleBar}" Width="960" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="/CluadeX;component/Assets/app.ico" Foreground="#F4EEFF" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- The first-run setup wizard (design boards Main, License, LicenseSignIn, Components, InstallProgress, InstallDone;
         960x600, its own fixed purple look — the theme is not loaded yet on a fresh install, and the brand is the point). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <SolidColorBrush x:Key="Muted" Color="#BBA9DD"/>
        <SolidColorBrush x:Key="Dim" Color="#9F8CC6"/>
        <SolidColorBrush x:Key="CardBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="CardLine" Color="#17FFFFFF"/>
        <LinearGradientBrush x:Key="Primary" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#A21CAF" Offset="1"/>
        </LinearGradientBrush>
        <Geometry x:Key="IcoArrow">M5,12 L19,12 M13,6 L19,12 L13,18</Geometry>
        <Geometry x:Key="IcoCheck">M5,12.5 L10,17.5 L19,7.5</Geometry>
        <Geometry x:Key="IcoFolder">M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z</Geometry>
        <Geometry x:Key="IcoUser">M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 Z M4,21 C4,16.5 8,15 12,15 C16,15 20,16.5 20,21</Geometry>
        <Geometry x:Key="IcoBolt">M13,2 L4,14 L12,14 L11,22 L20,10 L12,10 Z</Geometry>
        <Geometry x:Key="IcoDownload">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</Geometry>
        <Geometry x:Key="IcoBulb">M9,18 L15,18 M10,21 L14,21 M12,3 A6,6 0 0 0 8,13.5 C9,14.5 9,15.5 9,16 L15,16 C15,15.5 15,14.5 16,13.5 A6,6 0 0 0 12,3 Z</Geometry>
        <Geometry x:Key="IcoChip">M7,7 L17,7 L17,17 L7,17 Z M10,10 L14,10 L14,14 L10,14 Z M9,3 L9,7 M15,3 L15,7 M9,17 L9,21 M15,17 L15,21 M3,9 L7,9 M3,15 L7,15 M17,9 L21,9 M17,15 L21,15</Geometry>
        <Geometry x:Key="IcoStar">M12,1 L14.2,9.8 L23,12 L14.2,14.2 L12,23 L9.8,14.2 L1,12 L9.8,9.8 Z</Geometry>

        <!-- ── buttons ── -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E4D7FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#29FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.92"/><Setter TargetName="b" Property="BorderBrush" Value="#45FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#C084FC"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#A855F7" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style x:Key="BtnLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D8B4FE"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Foreground" Value="#F5D0FE"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="Foreground" Value="#F5D0FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#E9DDFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── a checkbox (Welcome) and a switch (Components) ── -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4EEFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="#66FFFFFF" Background="Transparent" VerticalAlignment="Center">
                                <Path x:Name="mark" Data="{StaticResource IcoCheck}" Stroke="White" StrokeThickness="2.4" Stretch="Uniform" Margin="3" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#A855F7"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#A855F7"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#F0ABFC"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#E9DDFF" HorizontalAlignment="Left" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Primary}"/>
                                <Setter TargetName="track" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#F0ABFC"/><Setter TargetName="track" Property="BorderThickness" Value="1.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── fields ── -->
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F4EEFF"/>
            <Setter Property="CaretBrush" Value="#F0ABFC"/>
            <Setter Property="SelectionBrush" Value="#A855F7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Pass" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F4EEFF"/>
            <Setter Property="CaretBrush" Value="#F0ABFC"/>
            <Setter Property="SelectionBrush" Value="#A855F7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PathCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="86"/>
        </Style>        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Err" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E4D7FF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Spinner" TargetType="Path">
            <Setter Property="Data" Value="M9,1.5 A7.5,7.5 0 0 1 16.5,9"/>
            <Setter Property="Stroke" Value="#F0ABFC"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="spin">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions><StopStoryboard BeginStoryboardName="spin"/></Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- one install step -->
        <DataTemplate x:Key="StepRow" DataType="{x:Type vm:WizardStepVm}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="ring" Stroke="#40FFFFFF" StrokeThickness="1.5"/>
                    <Ellipse x:Name="fill" Visibility="Collapsed"/>
                    <Path x:Name="ok" Data="{StaticResource IcoCheck}" Stroke="#4ADE80" StrokeThickness="2.2" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                    <TextBlock x:Name="glyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Visibility="Collapsed"/>
                    <Path x:Name="spin" Style="{StaticResource Spinner}" Width="22" Height="22" Data="M11,1.5 A9.5,9.5 0 0 1 20.5,11" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Label}" FontSize="14" Foreground="#CFC2EA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="detail" Grid.Column="2" Text="{Binding Detail}" FontSize="12.5" Foreground="#BBA9DD" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Right" Margin="12,0,0,0" MaxWidth="240" ToolTip="{Binding Detail}"/>
                <!-- a failed or skipped step says WHY on its own line: a reason is a sentence, not a chip -->
                <TextBlock x:Name="reason" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="12.5" Foreground="#BBA9DD"
                           TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="5" Margin="0,8,0,2" Minimum="0" Maximum="1"
                             Value="{Binding Progress, Mode=OneWay}" Foreground="#A3E635" Background="#1AFFFFFF" BorderThickness="0"
                             Visibility="{Binding ShowBar, Converter={StaticResource Vis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="spin" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ring" Property="Stroke" Value="#4DC084FC"/>
                    <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="fill" Property="Fill" Value="#33A855F7"/>
                    <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="fill" Property="Fill" Value="#2E4ADE80"/>
                    <Setter TargetName="ok" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                    <Setter TargetName="detail" Property="Foreground" Value="#86EFAC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="glyph" Property="Text" Value="–"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="#BBA9DD"/>
                    <Setter TargetName="label" Property="Foreground" Value="#CFC2EA"/>
                    <Setter TargetName="detail" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="reason" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="fill" Property="Fill" Value="#33F87171"/>
                    <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="glyph" Property="Text" Value="✕"/>
                    <Setter TargetName="glyph" Property="Foreground" Value="#FCA5A5"/>
                    <Setter TargetName="label" Property="Foreground" Value="#F4EEFF"/>
                    <Setter TargetName="detail" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="reason" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="reason" Property="Foreground" Value="#FCA5A5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="16" BorderThickness="1" BorderBrush="#33C4A7FF" Background="#120A22">
        <Grid>
            <!-- ─────────── backdrop: art, glow, girl, stars ─────────── -->
            <Image Source="/CluadeX;component/Assets/Wizard/hero.jpg" Width="560" HorizontalAlignment="Right" Stretch="UniformToFill" Opacity="0.32" IsHitTestVisible="False">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="Black" Offset="0.55"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-120" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6BC084FC" Offset="0"/>
                        <GradientStop Color="#00C084FC" Offset="0.68"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Image x:Name="GirlImage" Source="{Binding Girl}" Height="590" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-10"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
                <Image.Effect><DropShadowEffect x:Name="GirlGlowFx" Color="#C084FC" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Image.Effect>
                <Image.RenderTransform><TranslateTransform x:Name="GirlFloat"/></Image.RenderTransform>
            </Image>
            <Path Data="{StaticResource IcoStar}" Fill="#F5D0FE" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,360,0" Opacity="0.7" IsHitTestVisible="False"/>
            <Path Data="{StaticResource IcoStar}" Fill="#E9D5FF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,170,40,0" Opacity="0.6" IsHitTestVisible="False"/>
            <Path Data="{StaticResource IcoStar}" Fill="#D8B4FE" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,330,150" Opacity="0.6" IsHitTestVisible="False"/>

            <!-- ─────────── title bar ─────────── -->
            <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="/CluadeX;component/Assets/logo_small.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{services:Loc wiz.titleBar}" FontSize="13" Foreground="#C9B8EA" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Stepper}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding ShowStepper, Converter={StaticResource Vis}}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepperItem}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="sep" Width="16" Height="1" Background="#33FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <Border x:Name="dot" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#40FFFFFF" VerticalAlignment="Center">
                                    <TextBlock x:Name="mark" Text="{Binding Mark}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="12" Foreground="#9F8CC6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowSep}" Value="False"><Setter TargetName="sep" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsNow}" Value="True">
                                    <Setter TargetName="dot" Property="Background" Value="{StaticResource Primary}"/>
                                    <Setter TargetName="dot" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="lbl" Property="Foreground" Value="#F4EEFF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="dot" Property="Background" Value="#2E4ADE80"/>
                                    <Setter TargetName="dot" Property="BorderThickness" Value="0"/>
                                    <Setter TargetName="mark" Property="Foreground" Value="#4ADE80"/>
                                    <Setter TargetName="lbl" Property="Foreground" Value="#C9B8EA"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Width="52" Command="{Binding ToggleLanguageCommand}" ToolTip="{services:Loc wiz.language}">
                        <TextBlock Text="{Binding LanguageToggleText}" FontSize="12" Foreground="#C9B8EA"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Minimize_Click" ToolTip="{services:Loc wiz.minimize}">
                        <Path Data="M1,6 L11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="{services:Loc wiz.close}">
                        <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ 1. Welcome ═══════════ -->
            <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Vis}}" Margin="56,56,0,0" Width="480" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="/CluadeX;component/Assets/logo-wordmark.png" Width="200" HorizontalAlignment="Left" Margin="-8,0,0,4" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect><DropShadowEffect Color="#A855F7" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></Image.Effect>
                </Image>
                <TextBlock Text="{services:Loc wiz.welcome.head}" Style="{StaticResource H1}" FontSize="24" LineHeight="34"/>
                <TextBlock Text="{services:Loc wiz.welcome.body}" Style="{StaticResource Sub}" FontSize="14" LineHeight="23"/>
                <WrapPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource Chip}" Background="#24A78BFA" BorderBrush="#59A78BFA"><TextBlock Text="{Binding VersionChip}" FontSize="12" Foreground="#E4D7FF"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding SizeChip}" FontSize="12" Foreground="#D6C9F0"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="{services:Loc wiz.welcome.os}" FontSize="12" Foreground="#D6C9F0"/></Border>
                </WrapPanel>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IcoFolder}" Stroke="#C4B5FD" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{services:Loc wiz.welcome.installedAt}" FontSize="13" Foreground="{StaticResource Muted}" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding InstallPath}" FontFamily="Consolas" FontSize="12.5" Foreground="#EDE4FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}"/>
                            <TextBlock Grid.Column="3" Text="{services:Loc wiz.welcome.noAdmin}" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <Border Height="1" Background="#14FFFFFF" Margin="0,12"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CreateShortcut}" Content="{services:Loc wiz.welcome.shortcut}"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding OpenWhenDone}" Content="{services:Loc wiz.welcome.openWhenDone}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{services:Loc wiz.welcome.start}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IcoArrow}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding CancelCommand}" Content="{services:Loc wiz.cancel}" Margin="12,0,0,0"/>
                </StackPanel>
                <WrapPanel Margin="0,14,0,0" TextBlock.FontSize="12">
                    <TextBlock Text="{services:Loc wiz.welcome.terms1}" Foreground="{StaticResource Dim}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource BtnLink}" Content="{services:Loc wiz.welcome.terms}" Command="{Binding TermsCommand}" FontSize="12"/>
                    <TextBlock Text="{services:Loc wiz.welcome.and}" Foreground="{StaticResource Dim}" Margin="4,0"/>
                    <Button Style="{StaticResource BtnLink}" Content="{services:Loc wiz.welcome.privacy}" Command="{Binding PrivacyCommand}" FontSize="12"/>
                </WrapPanel>
            </StackPanel>

            <!-- ═══════════ 2. License ═══════════ -->
            <Grid Visibility="{Binding IsLicense, Converter={StaticResource Vis}}" Margin="56,60,0,20" Width="560" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc wiz.lic.title}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{services:Loc wiz.lic.sub}" Style="{StaticResource Sub}"/>
                </StackPanel>
                <!-- the two paths -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="CardAccount" MouseLeftButtonUp="CardAccount_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PathCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseQuickPath}" Value="False">
                                        <Setter Property="BorderBrush" Value="#B3C084FC"/>
                                        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4D7C3AED" Offset="0"/><GradientStop Color="#33A21CAF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoUser}" Stroke="#E9D5FF" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc wiz.lic.account}" FontWeight="SemiBold" FontSize="14.5" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{services:Loc wiz.lic.accountSub}" FontSize="12.5" Foreground="#D6C9F0" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CardQuick" Grid.Column="2" MouseLeftButtonUp="CardQuick_Click" Visibility="{Binding QuickPathOffered, Converter={StaticResource Vis}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PathCard}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseQuickPath}" Value="True">
                                        <Setter Property="BorderBrush" Value="#B3C084FC"/>
                                        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4D7C3AED" Offset="0"/><GradientStop Color="#33A21CAF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoBolt}" Stroke="#E9D5FF" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc wiz.lic.quick}" FontWeight="SemiBold" FontSize="14.5" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding QuickCardText}" FontSize="12.5" Foreground="#D6C9F0" TextWrapping="Wrap" Margin="0,6,8,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="999" Background="#2E4ADE80" Padding="8,2" Margin="0,-2,-4,0">
                                <TextBlock Text="{services:Loc wiz.lic.quickTag}" FontSize="11" Foreground="#86EFAC" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <!-- the account form / the status of the server / what is already here -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasLicenseOk, Converter={StaticResource Vis}}" Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource IcoCheck}" Stroke="#4ADE80" StrokeThickness="2.2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LicenseOk}" FontSize="13" Foreground="#86EFAC" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="480"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowAccountForm, Converter={StaticResource Vis}}">
                            <TextBlock Text="{services:Loc wiz.lic.login}" FontSize="13" Foreground="#D6C9F0"/>
                            <Border Style="{StaticResource FieldBorder}" Margin="0,6,0,0">
                                <TextBox x:Name="LoginBox" Style="{StaticResource Field}" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <TextBlock Text="{services:Loc wiz.lic.password}" FontSize="13" Foreground="#D6C9F0" Margin="0,10,0,0"/>
                            <Border Style="{StaticResource FieldBorder}" Margin="0,6,0,0">
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource Pass}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Border>
                            <!-- one row: "or sign in with" · Google · LINE (the form must fit the 600px window with an error showing) -->
                            <Grid Margin="0,12,0,0" Visibility="{Binding SocialAvailable, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{services:Loc wiz.lic.or}" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnSmall}" Height="40" Command="{Binding OpenQrCommand}" CommandParameter="google">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="G" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4285F4" Offset="0"/><GradientStop Color="#EA4335" Offset="0.4"/>
                                                    <GradientStop Color="#FBBC05" Offset="0.7"/><GradientStop Color="#34A853" Offset="1"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="Google" VerticalAlignment="Center" Foreground="#F4EEFF"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource BtnSmall}" Height="40" Background="#06C755" BorderThickness="0" Foreground="White"
                                        Command="{Binding OpenQrCommand}" CommandParameter="line">
                                    <TextBlock Text="LINE" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <!-- quick path, or no account sign-in on the server -->
                        <StackPanel Visibility="{Binding UseQuickPath, Converter={StaticResource Vis}}" Orientation="Horizontal">
                            <Path Data="{StaticResource IcoBolt}" Stroke="#F0ABFC" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding QuickSubText}" FontSize="13" Foreground="#E4D7FF" TextWrapping="Wrap" Margin="10,0,0,0" MaxWidth="470"/>
                        </StackPanel>
                        <Grid Visibility="{Binding HasLicenseNote, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Spinner}" Width="14" Height="14" Data="M7,1 A6,6 0 0 1 13,7" Margin="0,2,8,0" VerticalAlignment="Top"
                                  Visibility="{Binding CheckingServer, Converter={StaticResource Vis}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding LicenseNote}" FontSize="12.5" Foreground="#FDE68A" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnLink}" Content="{services:Loc acct.doc.run}" Command="{Binding RunDoctorCommand}" FontSize="12.5"
                                    Margin="10,0,0,0" Visibility="{Binding ServerUnreachable, Converter={StaticResource Vis}}" VerticalAlignment="Top"/>
                        </Grid>
                        <StackPanel Visibility="{Binding HasLicenseError, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding LicenseError}" Style="{StaticResource Err}"/>
                            <Button Style="{StaticResource BtnLink}" Content="{services:Loc wiz.lic.store}" Command="{Binding OpenStoreCommand}" FontSize="12.5" Margin="0,4,0,0"
                                    HorizontalAlignment="Left" Visibility="{Binding ShowStoreLink, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- "have a key?" sits with the buttons, so the card above never runs out of room -->
                <Button Grid.Row="3" Style="{StaticResource BtnLink}" Content="{services:Loc wiz.lic.key}" Command="{Binding ShowKeyBoxCommand}" FontSize="12.5"
                        Margin="0,14,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource BtnBase}" Command="{Binding BackCommand}" Content="{services:Loc wiz.back}" Margin="0,0,12,0" Visibility="{Binding ShowBack, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding LicenseNextCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Spinner}" Stroke="White" Margin="0,0,10,0" Visibility="{Binding LicenseBusy, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding LicenseNextText}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IcoArrow}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ 3. Components ═══════════ -->
            <StackPanel Visibility="{Binding IsComponents, Converter={StaticResource Vis}}" Margin="56,60,0,0" Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{services:Loc wiz.comp.title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{services:Loc wiz.comp.sub}" Style="{StaticResource Sub}"/>
                <!-- NVIDIA -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14" BorderBrush="#3384CC16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1484CC16" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10" Background="#2484CC16" VerticalAlignment="Top">
                            <Path Data="{StaticResource IcoChip}" Stroke="#A3E635" StrokeThickness="1.6" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{services:Loc wiz.comp.nv.title}" FontWeight="SemiBold" FontSize="15.5"/>
                                <Border CornerRadius="999" Background="#2EA78BFA" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding NvidiaSelectable, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{services:Loc wiz.comp.recommended}" FontSize="11" Foreground="#E4D7FF"/>
                                </Border>
                                <TextBlock Text="{Binding NvidiaSize}" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NvSub" Text="{Binding NvidiaSub}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#BBA9DD"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding NvidiaDetected}" Value="True"><Setter Property="Foreground" Value="#A3E635"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding NvidiaOn}" IsEnabled="{Binding NvidiaSelectable}" VerticalAlignment="Top" Margin="0,8,0,0"
                                  AutomationProperties.Name="{services:Loc wiz.comp.nv.title}"/>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#A3E635" Margin="0,8,9,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{services:Loc wiz.comp.nv.b1}" Style="{StaticResource Bullet}"/></Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#A3E635" Margin="0,8,9,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{services:Loc wiz.comp.nv.b2}" Style="{StaticResource Bullet}"/></Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{services:Loc wiz.comp.nv.why}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
                <!-- BrainX -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14" BorderBrush="#3338BDF8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1438BDF8" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10" Background="#2438BDF8" VerticalAlignment="Top" ClipToBounds="True">
                            <Image Source="/CluadeX;component/Assets/Wizard/brain.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{services:Loc wiz.comp.bx.title}" FontWeight="SemiBold" FontSize="15.5"/>
                            <TextBlock Text="{Binding BrainXSub}" FontSize="12.5" Foreground="#7DD3FC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding BrainXOn}" VerticalAlignment="Top" Margin="0,8,0,0"
                                  AutomationProperties.Name="{services:Loc wiz.comp.bx.title}"/>
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#7DD3FC" Margin="0,8,9,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{services:Loc wiz.comp.bx.b1}" Style="{StaticResource Bullet}"/></Grid>
                            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#7DD3FC" Margin="0,8,9,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{services:Loc wiz.comp.bx.b2}" Style="{StaticResource Bullet}"/></Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{services:Loc wiz.comp.bx.why}" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource BtnBase}" Command="{Binding BackCommand}" Content="{services:Loc wiz.back}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoDownload}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc wiz.comp.install}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════ 4. Progress ═══════════ -->
            <StackPanel Visibility="{Binding IsProgress, Converter={StaticResource Vis}}" Margin="56,60,0,0" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding ProgressTitle}" Style="{StaticResource H1}"/>
                <!-- while it runs: the sub line, the big percentage and the bar; once something failed they give their room to the reasons -->
                <StackPanel Visibility="{Binding ShowOverall, Converter={StaticResource Vis}}">
                <TextBlock Text="{services:Loc wiz.prog.sub}" Style="{StaticResource Sub}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding OverallText}" FontSize="50" FontWeight="SemiBold" Foreground="#E9D5FF">
                        <TextBlock.Effect><DropShadowEffect Color="#C084FC" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding Eta}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,14"/>
                </StackPanel>
                <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Overall, Mode=OneWay}" BorderThickness="0" Background="#1AFFFFFF" Margin="0,4,0,0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#E879F9" Offset="1"/></LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
                </StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,10">
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" Focusable="False"/>
                </Border>
                <!-- something failed: the doctor, the report, and go on -->
                <StackPanel Visibility="{Binding InstallNeedsAttention, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                    <TextBlock Text="{services:Loc wiz.prog.someFailed}" FontSize="13" Foreground="#FDE68A" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Height="44" Command="{Binding ContinueCommand}" Content="{services:Loc wiz.next}"/>
                        <Button Style="{StaticResource BtnSmall}" Height="44" Command="{Binding RunDoctorCommand}" Content="{services:Loc acct.doc.run}" Margin="10,0,0,0"/>
                        <Button Style="{StaticResource BtnSmall}" Height="44" Command="{Binding CopyInstallReportCommand}" Content="{services:Loc acct.doc.copy}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Toast}" FontSize="12" Foreground="#86EFAC" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="14" Padding="16,12" BorderBrush="#40C084FC" BorderThickness="1"
                            Visibility="{Binding Installing, Converter={StaticResource Vis}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#337C3AED" Offset="0"/><GradientStop Color="#26A21CAF" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IcoBulb}" Stroke="#FDE68A" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{services:Loc wiz.prog.tip}" FontWeight="SemiBold" FontSize="13" Foreground="#FDE68A"/>
                                <TextBlock Text="{Binding Tip}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BtnSmall}" Command="{Binding CancelInstallCommand}" Content="{services:Loc wiz.cancel}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding Installing, Converter={StaticResource Vis}}"/>
                </Grid>
            </StackPanel>

            <!-- ═══════════ 5. Done ═══════════ -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Vis}}" Margin="56,70,0,0" Width="480" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource Primary}" HorizontalAlignment="Left">
                    <Border.Effect><DropShadowEffect Color="#C084FC" BlurRadius="26" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                    <Path Data="{StaticResource IcoCheck}" Stroke="White" StrokeThickness="2.6" Width="26" Height="26" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{services:Loc wiz.done.title}" Style="{StaticResource H1}" FontSize="29" Margin="0,22,0,0"/>
                <TextBlock Text="{Binding DoneBody}" Style="{StaticResource Sub}" FontSize="14" LineHeight="23"/>
                <TextBlock Text="{services:Loc wiz.done.next}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D6C9F0" Margin="0,18,0,8"/>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#33A78BFA"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/></Border>
                        <TextBlock Text="{services:Loc wiz.done.n1}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#33A78BFA"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/></Border>
                            <TextBlock Text="{services:Loc wiz.done.n2}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{services:Loc wiz.done.skippable}" FontSize="12" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#33A78BFA"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/></Border>
                        <TextBlock Text="{services:Loc wiz.done.n3}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding OpenAppCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{services:Loc wiz.done.open}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IcoArrow}" Stroke="White" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnBase}" Command="{Binding DoneCloseCommand}" Content="{services:Loc wiz.done.close}" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════ overlay: QR sign-in (LicenseSignIn board) ═══════════ -->
            <Grid Visibility="{Binding ShowQr, Converter={StaticResource Vis}}" Background="#99080412" Margin="0,44,0,0">
                <Border Width="600" CornerRadius="18" BorderBrush="#40C4A7FF" BorderThickness="1" Padding="26,22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,26,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F21E1036" Offset="0"/><GradientStop Color="#F22A1548" Offset="1"/></LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{services:Loc wiz.qr.title}" FontSize="19" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource WinBtn}" Width="34" Height="34" HorizontalAlignment="Right" Command="{Binding CloseQrCommand}" ToolTip="{services:Loc wiz.close}">
                                <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="#E9DDFF" StrokeThickness="1.4" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <!-- LINE / Google tabs only change the hint -->
                        <Border CornerRadius="12" Background="#14FFFFFF" Padding="4" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabLine" GroupName="qrTab" Command="{Binding QrTabCommand}" CommandParameter="line" Content="LINE" Cursor="Hand" IsChecked="{Binding QrLine, Mode=OneWay}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" CornerRadius="9" Padding="18,6" Background="Transparent">
                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontWeight="SemiBold" Foreground="#C9B8EA"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#06C755"/><Setter TargetName="t" Property="Foreground" Value="White"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton x:Name="TabGoogle" GroupName="qrTab" Command="{Binding QrTabCommand}" CommandParameter="google" Content="Google" Cursor="Hand" IsChecked="{Binding QrGoogle, Mode=OneWay}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="b" CornerRadius="9" Padding="18,6" Background="Transparent">
                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" FontWeight="SemiBold" Foreground="#C9B8EA"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/><Setter TargetName="t" Property="Foreground" Value="White"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="200" Height="200" CornerRadius="14" Background="White" BorderBrush="#2206C755" BorderThickness="4">
                                <Grid>
                                    <Image Source="{Binding QrImage}" Margin="8" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <Path Style="{StaticResource Spinner}" Stroke="#7C3AED" Width="28" Height="28" Data="M14,2 A12,12 0 0 1 26,14" Visibility="{Binding QrBusy, Converter={StaticResource Vis}}"/>
                                    <Button Style="{StaticResource BtnSmall}" Background="#7C3AED" Foreground="White" BorderThickness="0" Content="{services:Loc wiz.qr.newCode}"
                                            Command="{Binding NewCodeCommand}" Visibility="{Binding QrExpired, Converter={StaticResource Vis}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#2E4ADE80"><TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{Binding QrHint1}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap" MaxWidth="290"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#2E4ADE80"><TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{services:Loc wiz.qr.step2}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#2E4ADE80" VerticalAlignment="Top"><TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="{services:Loc wiz.qr.step3}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap" MaxWidth="290"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{services:Loc wiz.qr.code}" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UserCode}" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#F5D0FE" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Border CornerRadius="10" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="14,10" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource Spinner}" Stroke="#4ADE80" Width="14" Height="14" Data="M7,1 A6,6 0 0 1 13,7" Margin="0,0,10,0"
                                              Visibility="{Binding QrWaiting, Converter={StaticResource Vis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding QrStatus}" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding QrCountdown}" FontSize="12.5" Foreground="{StaticResource Dim}" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                                <Button Style="{StaticResource BtnLink}" Content="{services:Loc acct.doc.run}" Command="{Binding RunDoctorCommand}" FontSize="12.5" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Visibility="{Binding QrFailed, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#1AFFFFFF" Margin="0,18,0,14"/>
                        <Grid>
                            <TextBlock Text="{services:Loc wiz.qr.noPhone}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,200,0"/>
                            <Button Style="{StaticResource BtnSmall}" Content="{services:Loc wiz.qr.here}" Command="{Binding SignInHereCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ overlay: type a key ═══════════ -->
            <Grid Visibility="{Binding ShowKeyBox, Converter={StaticResource Vis}}" Background="#99080412" Margin="0,44,0,0">
                <Border Width="460" CornerRadius="18" BorderBrush="#40C4A7FF" BorderThickness="1" Padding="24,20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,90,0,0" Background="#F2201038">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{services:Loc wiz.key.title}" FontSize="18" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource FieldBorder}" Margin="0,14,0,0">
                            <TextBox x:Name="KeyBox" Style="{StaticResource Field}" FontFamily="Consolas" FontSize="15" CharacterCasing="Upper" MaxLength="64"
                                     Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                        <TextBlock Text="{services:Loc wiz.key.hint}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding KeyError}" Style="{StaticResource Err}" Margin="0,8,0,0" Visibility="{Binding HasKeyError, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Height="44" Command="{Binding ActivateKeyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Spinner}" Stroke="White" Margin="0,0,10,0" Visibility="{Binding KeyBusy, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{services:Loc wiz.key.activate}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnSmall}" Height="44" Command="{Binding CloseKeyBoxCommand}" Content="{services:Loc wiz.cancel}" Margin="10,0,0,0" IsCancel="{Binding ShowKeyBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ overlay: connection doctor ═══════════ -->
            <Grid Visibility="{Binding ShowDoctor, Converter={StaticResource Vis}}" Background="#B3080412" Margin="0,44,0,0">
                <Border Width="640" MaxHeight="520" CornerRadius="18" BorderBrush="#40C4A7FF" BorderThickness="1" Padding="24,20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,14,0,0" Background="#F7201038">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{services:Loc acct.doc.title}" FontSize="18" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource WinBtn}" Width="34" Height="34" HorizontalAlignment="Right" Command="{Binding CloseDoctorCommand}" ToolTip="{services:Loc acct.doc.close}">
                                <Path Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" Stroke="#E9DDFF" StrokeThickness="1.4" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding DoctorLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DoctorLineVm}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border x:Name="dot" Width="20" Height="20" CornerRadius="10" Background="#14FFFFFF" VerticalAlignment="Top">
                                                <TextBlock x:Name="m" Text="{Binding Mark}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BBA9DD"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Top" TextWrapping="Wrap"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="r" Text="{Binding Reason}" FontSize="13" TextWrapping="Wrap" Foreground="#E4D7FF"/>
                                                <TextBlock x:Name="d" Text="{Binding Detail}" FontSize="11" FontFamily="Consolas" Foreground="#8F7CB8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- no reason: the technical detail sits on the label's line instead of a blank line under it -->
                                            <DataTrigger Binding="{Binding Reason}" Value=""><Setter TargetName="r" Property="Visibility" Value="Collapsed"/><Setter TargetName="d" Property="Margin" Value="0,3,0,0"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="d" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Ok"><Setter TargetName="dot" Property="Background" Value="#2E4ADE80"/><Setter TargetName="m" Property="Foreground" Value="#4ADE80"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Warn"><Setter TargetName="dot" Property="Background" Value="#33FBBF24"/><Setter TargetName="m" Property="Foreground" Value="#FDE68A"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter TargetName="dot" Property="Background" Value="#33F87171"/><Setter TargetName="m" Property="Foreground" Value="#FCA5A5"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Info"><Setter TargetName="dot" Property="Background" Value="#2438BDF8"/><Setter TargetName="m" Property="Foreground" Value="#7DD3FC"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="2" CornerRadius="10" Background="#0FFFFFFF" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Spinner}" Width="14" Height="14" Data="M7,1 A6,6 0 0 1 13,7" Margin="0,2,8,0" VerticalAlignment="Top" Visibility="{Binding DoctorBusy, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding DoctorCause}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DoctorSaved}" FontSize="11" Foreground="#8F7CB8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource BtnSmall}" Command="{Binding CopyDoctorCommand}" Content="{services:Loc acct.doc.copy}"/>
                            <Button Style="{StaticResource BtnSmall}" Command="{Binding SendDoctorCommand}" Content="{services:Loc acct.doc.send}" Margin="10,0,0,0"/>
                            <Button Style="{StaticResource BtnSmall}" Command="{Binding RunDoctorCommand}" Content="{services:Loc acct.doc.run}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Toast}" FontSize="12" Foreground="#86EFAC" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="200"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
