<UserControl x:Class="CluadeX.Views.TaskManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels">

    <UserControl.Resources>
        <!-- Status badge style -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <vm:TaskStatusLabelConverter x:Key="TaskStatusLabel"/>
        <vm:TaskKindLabelConverter x:Key="TaskKindLabel"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Elevated}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Border Grid.Row="0" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc tasks.title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"
                               FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,0,0,4"/>
                    <TextBlock Text="{services:Loc tasks.subtitle}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Asks first: the agent's dev servers are in this list too. -->
                    <Button Content="{services:Loc tasks.stopAll}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StopAllCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="{services:Loc tasks.clearCompleted}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCompletedCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ TASK LIST ═══════ -->
        <Border Grid.Row="1" Margin="24,8,24,8" Background="{DynamicResource Surface.Sunken}"
                CornerRadius="8" Padding="0">
            <ListView ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource Text.Primary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource Surface.Sunken}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Display}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Surface.Raised}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>

                        <!-- ID Column -->
                        <GridViewColumn Header="ID" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                               Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Name Column -->
                        <GridViewColumn Header="{services:Loc tasks.colName}" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}" FontSize="12"
                                               ToolTip="{Binding Cwd}"
                                               TextTrimming="CharacterEllipsis" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Status Column -->
                        <GridViewColumn Header="{services:Loc tasks.colStatus}" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Padding" Value="8,3"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="{DynamicResource Text.Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="running">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.1}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="stopped">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource TaskStatusLabel}}" FontSize="11"
                                                   FontFamily="{DynamicResource Font.Ui.Display}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="running">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.OnStatus}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="completed">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.OnStatus}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.OnStatus}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="stopped">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.OnStatus}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Kind Column (command / file server) -->
                        <GridViewColumn Header="{services:Loc tasks.colKind}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource TaskKindLabel}}"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Port Column -->
                        <GridViewColumn Header="{services:Loc tasks.colPort}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PortText}" Foreground="{DynamicResource Text.Secondary}"
                                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- URL Column: opens in the user's browser (loopback URLs only) -->
                        <GridViewColumn Header="{services:Loc tasks.colUrl}" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,2" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                   CommandParameter="{Binding}"
                                                   Foreground="{DynamicResource Text.Link}"
                                                   ToolTip="{services:Loc tasks.openUrlTip}">
                                            <Run Text="{Binding Url, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Exit code Column -->
                        <GridViewColumn Header="{services:Loc tasks.colExit}" Width="56">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExitCodeText}" Foreground="{DynamicResource Text.Tertiary}"
                                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Command Column -->
                        <GridViewColumn Header="{services:Loc tasks.colCommand}" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Command}" Foreground="{DynamicResource Text.Secondary}"
                                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" Margin="4,2"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Actions Column -->
                        <GridViewColumn Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{services:Loc tasks.stop}"
                                            Padding="8,3" FontSize="11"
                                            Command="{Binding DataContext.StopTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="failed">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="stopped">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ═══════ NEW TASK FORM ═══════ -->
        <Border Grid.Row="2" Margin="24,4,24,8" Background="{DynamicResource Surface.Sunken}"
                CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Tag="{services:Loc tasksm.namePlaceholder}"
                         Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding NewTaskCommand, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Tag="{services:Loc tasksm.commandPlaceholder}"
                         Margin="0,0,8,0"/>

                <Button Grid.Column="2" Content="{services:Loc tasks.start}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateTaskCommand}"
                        Padding="16,8"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,6,0,0" FontSize="11"
                           Text="{Binding WorkingDirectoryText}"
                           Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis"/>

                <!-- Why a start was refused / what Stop all did — empty most of the time. -->
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="2,4,0,0" FontSize="11"
                           Text="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Status.Warning}"/>
            </Grid>
        </Border>

        <!-- ═══════ OUTPUT PANE ═══════ -->
        <Border Grid.Row="3" Margin="24,0,24,16" Background="{DynamicResource Bg.Window}"
                CornerRadius="8" Padding="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Output header -->
                <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource Bg.Panel}"
                        CornerRadius="8,8,0,0">
                    <TextBlock FontFamily="{DynamicResource Font.Ui.Display}" FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}">
                        <Run Text="{services:Loc tasks.output}"/>
                        <Run Text=" - "/>
                        <Run Text="{Binding SelectedTaskTitle, Mode=OneWay}"
                             Foreground="{DynamicResource Accent.1}"/>
                    </TextBlock>
                </Border>

                <!-- Output content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Style="{StaticResource SlimScrollViewer}">
                    <TextBox Text="{Binding SelectedTask.Output, Mode=OneWay, FallbackValue=''}"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="{DynamicResource Text.Primary}"
                             FontFamily="{DynamicResource Font.Mono.Display}"
                             FontSize="12"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Disabled"
                             Padding="12,8"
                             CaretBrush="{DynamicResource Text.Primary}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
