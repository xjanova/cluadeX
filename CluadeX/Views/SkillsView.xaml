<UserControl x:Class="CluadeX.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SkillsViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>
        <DataTemplate x:Key="SkillCardTemplate" DataType="{x:Type m:SkillDefinition}">
            <Button Click="OnSkillClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{StaticResource NeonLineBrush}"
                                Background="{StaticResource NeonCardFill}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4CDFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Slash-command badge -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4CDFFF" Offset="0"/>
                                <GradientStop Color="#A672FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#4CDFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock Text="/" FontSize="22" FontWeight="Bold"
                                   FontFamily="{StaticResource NeonMonoFont}" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource NeonMonoFont}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource NeonInk0Brush}"/>
                            <Border Margin="10,0,0,0" Padding="5,1" CornerRadius="3"
                                    Background="#225CFFB0"
                                    BorderThickness="1" BorderBrush="{StaticResource NeonMintBrush}"
                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{services:Loc skills.builtInBadge}" FontSize="9"
                                           FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonMintBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{StaticResource NeonInk2Brush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="#7028326E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B22E3870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#225CFFB0" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7F141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4CDFFF" Offset="0"/>
                                <GradientStop Color="#5CFFB0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#5CFFB0" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="/" FontSize="26" FontWeight="Bold"
                                   FontFamily="{StaticResource NeonMonoFont}" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc skills.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0">
                            <Run Text="{services:Loc skills.subtitle}"/>
                            <Run Text="{Binding BuiltInCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc skills.builtInSuffix}"/>
                            <Run Text="{Binding CustomCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc skills.customSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenUserSkillsFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc skills.openFolder}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc skills.refresh}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: list + detail -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Skills}"
                                      ItemTemplate="{StaticResource SkillCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="56" Height="56" CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4CDFFF" Offset="0"/>
                                            <GradientStop Color="#A672FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#A672FF" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                    <TextBlock Text="/" FontSize="28" FontWeight="Bold"
                                               FontFamily="{StaticResource NeonMonoFont}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk0Brush}"/>
                                    <TextBlock Text="{Binding SelectedSource}" FontSize="10"
                                               FontFamily="{StaticResource NeonMonoFont}"
                                               Foreground="{StaticResource NeonInk3Brush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.Description}" FontSize="13"
                                       Foreground="{StaticResource NeonInk1Brush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Border Padding="12" CornerRadius="6"
                                    Background="#11FFFFFF"
                                    BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.allowedTools}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedToolsDisplay}"
                                               FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                               Foreground="{StaticResource NeonCyanBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="6" Margin="0,0,0,12"
                                    Background="#3328326E"
                                    BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{services:Loc skills.invokeFromChat}" FontFamily="{StaticResource NeonMonoFont}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{services:Loc skills.copy}"
                                                Command="{Binding CopyInvokeCommand}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Padding="6,2" Foreground="{StaticResource NeonCyanBrush}" FontSize="10"/>
                                    </Grid>
                                    <TextBox Text="{Binding SelectedInvokeSnippet, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{StaticResource NeonMonoFont}" FontSize="14"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource NeonInk0Brush}"
                                             Padding="0"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="6"
                                    Background="#7011152E"
                                    BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.promptBody}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding Selected.PromptContent, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource NeonInk1Brush}"
                                             Padding="0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource NeonLineBrush}" Background="#88141838">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{StaticResource NeonMonoFont}"
                           Foreground="{StaticResource NeonInk2Brush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
