<UserControl x:Class="CluadeX.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SkillsViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">
    <UserControl.Resources>
        <!-- Toggle Switch (same look as the Features page) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Cursor="Hand" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="{DynamicResource Surface.Raised}"
                                    HorizontalAlignment="Left">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Text.OnAccent}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Status.Success}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="21,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SkillCardTemplate" DataType="{x:Type vm:SkillItem}">
            <Button Click="OnSkillClick" Tag="{Binding}" Cursor="Hand" Opacity="{Binding CardOpacity}"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="14,12" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Surface.Card}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.Card.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Slash-command badge -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top"
                            Background="{DynamicResource IconTile.Accent.1-2}"
                            Effect="{DynamicResource Glow.IconTile.Medium.Accent.1}">
                        <TextBlock Text="/" FontSize="22" FontWeight="Bold"
                                   FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <Border Margin="10,0,0,0" Padding="5,1" CornerRadius="3"
                                    Background="{DynamicResource Status.Success.Tint}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Status.Success}">
                                <TextBlock Text="{Binding SourceTag}" FontSize="9"
                                           FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Status.Success}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UsageText}" FontSize="9" Margin="0,4,0,0"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding CostText}" FontSize="9" FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Text.Faint}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{services:Loc skills.costTip}"/>
                            <TextBlock Text="{services:Loc skills.heavy}" FontSize="9" Margin="6,0,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Status.Warning}"
                                       Visibility="{Binding IsHeavy, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,1,0,0"
                                       Foreground="{DynamicResource Accent.1}" ToolTip="{services:Loc skills.pinTip}"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Margin="10,0,0,0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              ToolTip="{services:Loc skills.enabledLabel}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Foreground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Action.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Action.Hover.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The Copy link-button. Its own template: the Windows one painted its hover / pressed box in its own light
             blue whatever the theme said. Same shape and trigger order; Midnight's Button.Plain.* tokens hold those
             Windows colours, so it looks exactly as before. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Plain.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Hover.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Pressed.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Pressed.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Success}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                            Background="{DynamicResource IconTile.Accent.1-Success}"
                            Effect="{DynamicResource Glow.IconTile.Success}">
                        <TextBlock Text="/" FontSize="26" FontWeight="Bold"
                                   FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc skills.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0">
                            <Run Text="{services:Loc skills.subtitle}"/>
                            <Run Text="{Binding BuiltInCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc skills.builtInSuffix}"/>
                            <Run Text="{Binding CustomCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc skills.customSuffix}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleInstallModeCommand}" Style="{StaticResource NeonAction}"
                                Visibility="{Binding CanInstallSkills, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <Grid>
                                    <TextBlock Text="{services:Loc skills.getMore}" Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{services:Loc skills.backToList}" Visibility="{Binding IsInstallMode, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EnableAllCommand}" Style="{StaticResource NeonAction}"
                                Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc skills.enableAll}"/>
                        </Button>
                        <Button Command="{Binding OpenUserSkillsFolderCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc skills.openFolder}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc skills.refresh}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The gauge (owner 2026-11-07): what the switched-on skills cost on every turn, against the model's ceiling -->
                <Border x:Name="SkillGauge" Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                        Background="{DynamicResource State.Fill.Faint}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                        Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GaugeLevelText}" FontSize="11" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Right" x:Name="GaugeLevelLabel">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GaugeLevel}" Value="Near">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GaugeLevel}" Value="Over">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GaugeLevel}" Value="Empty">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{services:Loc skills.gaugeTitle}" FontFamily="{DynamicResource Font.Mono.Display}"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- the bar: the ceiling sits in the middle, so a full bar is twice the ceiling -->
                            <Grid Margin="0,8,0,4" Height="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="GaugeBar" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding GaugeFill, Mode=OneWay}"
                                             Height="10" BorderThickness="0" Background="{DynamicResource Surface.Raised}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GaugeLevel}" Value="Near">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GaugeLevel}" Value="Over">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <Border Grid.Column="1" Width="2" HorizontalAlignment="Left" Margin="-1,-3,0,-3"
                                        Background="{DynamicResource Text.Primary}" ToolTip="{Binding GaugeCapText}"/>
                            </Grid>
                            <TextBlock Text="{Binding GaugeUsedText}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding GaugeCapText}" FontSize="10" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding GaugeNote}" FontSize="10" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="340">
                            <StackPanel Orientation="Horizontal" ToolTip="{services:Loc skills.autoPickTip}">
                                <CheckBox x:Name="AutoPickSwitch" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoPickEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{services:Loc skills.autoPick}" Margin="8,0,0,0" FontSize="12" TextWrapping="Wrap"
                                           MaxWidth="290" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" ToolTip="{services:Loc skills.brainIndexTip}">
                                <CheckBox x:Name="BrainIndexSwitch" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding BrainIndexEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{services:Loc skills.brainIndex}" Margin="8,0,0,0" FontSize="12" TextWrapping="Wrap"
                                           MaxWidth="290" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BrainStatusText}" FontSize="10" Margin="48,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Muted}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

            <!-- Body: list + detail -->
            <Grid Grid.Row="1" Margin="20,16,20,16" Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <ItemsControl ItemsSource="{Binding Skills}"
                                      ItemTemplate="{StaticResource SkillCardTemplate}"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="56" Height="56" CornerRadius="14"
                                        Background="{DynamicResource IconTile.Accent.1-2}"
                                        Effect="{DynamicResource Glow.IconTile.Accent.2}">
                                    <TextBlock Text="/" FontSize="28" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource IconTile.Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Selected.Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <TextBlock Text="{Binding SelectedSource}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.Description}" FontSize="13"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected.IsEnabled, Mode=TwoWay}"/>
                                <TextBlock Text="{services:Loc skills.enabledLabel}" Margin="8,0,0,0" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"
                                          IsChecked="{Binding Selected.IsPinned, Mode=TwoWay}" ToolTip="{services:Loc skills.pinTip}"/>
                                <TextBlock Text="{services:Loc skills.pin}" Margin="8,0,0,0" FontSize="12" ToolTip="{services:Loc skills.pinTip}"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.CostText}" FontSize="11" Margin="0,0,0,12"
                                       FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Muted}"
                                       ToolTip="{services:Loc skills.costTip}"/>

                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                                    Background="{DynamicResource State.Fill.Faint}"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                    Visibility="{Binding Selected.HasWhenToUse, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.whenToUse}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.WhenToUse}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                                    Background="{DynamicResource State.Fill.Faint}"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.usageHeader}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.UsageText}" FontSize="11" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.Mono.Display}"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="12" CornerRadius="6"
                                    Background="{DynamicResource State.Fill.Faint}"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.allowedTools}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedToolsDisplay}"
                                               FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                               Foreground="{DynamicResource Accent.1}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="6" Margin="0,0,0,12"
                                    Background="{DynamicResource Surface.Raised.Strong}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{services:Loc skills.invokeFromChat}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{services:Loc skills.copy}"
                                                Style="{StaticResource PlainButton}"
                                                Command="{Binding CopyInvokeCommand}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Padding="6,2" Foreground="{DynamicResource Accent.1}" FontSize="10"/>
                                    </Grid>
                                    <TextBox Text="{Binding SelectedInvokeSnippet, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{DynamicResource Font.Mono.Display}" FontSize="14"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Primary}"
                                             Padding="0"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="6"
                                    Background="{DynamicResource Surface.Input}"
                                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc skills.promptBody}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding Selected.PromptContent, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Secondary}"
                                             Padding="0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Install: trusted source → list → preview → Install -->
            <Grid Grid.Row="1" Margin="20,16,20,16" Visibility="{Binding IsInstallMode, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{services:Loc skills.source}" FontFamily="{DynamicResource Font.Mono.Display}"
                                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding TrustedSources}" SelectedItem="{Binding SelectedSourceUrl}"
                                          FontSize="11" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Command="{Binding LoadRemoteCommand}" Style="{StaticResource NeonAction}"
                                        Content="{services:Loc skills.load}"/>
                                <Button Grid.Column="2" Command="{Binding RemoveSourceCommand}" Style="{StaticResource NeonAction}"
                                        Content="{services:Loc skills.removeSource}" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewSourceUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                         ToolTip="{services:Loc skills.addSourceHint}" Margin="0,0,6,0" Padding="4,3"/>
                                <Button Grid.Column="1" Command="{Binding AddSourceCommand}" Style="{StaticResource NeonAction}"
                                        Content="{services:Loc skills.addSource}" Margin="0"/>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RemoteSkills}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RemoteSkillItem}">
                                        <Button Cursor="Hand" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PreviewRemoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Padding="12,9" CornerRadius="8" BorderThickness="1"
                                                            BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Card}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                                                    <TextBlock Text="{services:Loc skills.alreadyInstalled}" Margin="8,0,0,0" FontSize="9"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Status.Success}"
                                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding HtmlUrl}" FontSize="9" Foreground="{DynamicResource Text.Faint}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid>
                        <TextBlock Text="{services:Loc skills.pickRemote}" Margin="24" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Visibility="{Binding HasNoPreview, Converter={StaticResource BoolVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Preview.Skill.Name}" FontFamily="{DynamicResource Font.Mono.Display}"
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="{Binding Preview.Remote.HtmlUrl}" FontSize="10" Margin="0,4,0,10"
                                           FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Faint}"/>
                                <TextBlock Text="{Binding Preview.Skill.Description}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding PreviewProblems}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Status.Danger}"
                                           Visibility="{Binding HasPreviewProblems, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding PreviewWarnings}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                           Foreground="{DynamicResource Status.Warning}"
                                           Visibility="{Binding HasPreviewWarnings, Converter={StaticResource BoolVis}}"/>

                                <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                                        Background="{DynamicResource State.Fill.Faint}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc skills.allowedTools}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding PreviewTools}" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                                   Foreground="{DynamicResource Accent.1}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock Text="{services:Loc skills.license}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding PreviewLicense}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{services:Loc skills.installNote}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Text.Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Command="{Binding InstallCommand}" Style="{StaticResource NeonAction}"
                                            IsEnabled="{Binding Preview.CanInstall}" Content="{services:Loc skills.install}"/>
                                    <CheckBox IsChecked="{Binding ReplaceExisting}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              Content="{services:Loc skills.replaceExisting}" Foreground="{DynamicResource Text.Secondary}"
                                              Visibility="{Binding Preview.AlreadyInstalled, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <Border Padding="14" CornerRadius="6"
                                        Background="{DynamicResource Surface.Input}"
                                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{services:Loc skills.promptBody}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                   FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding Preview.RawText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                                 FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource Text.Secondary}" Padding="0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Page.Footer.Background}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{DynamicResource Font.Mono.Display}"
                           Foreground="{DynamicResource Text.Muted}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
