<Window x:Class="CluadeX.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:CluadeX.Services"
        xmlns:views="clr-namespace:CluadeX.Views"
        Title="{Binding Title, StringFormat='Plan — {0}'}" Width="460" Height="680" MinWidth="360" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" ShowInTaskbar="True"
        FontFamily="{DynamicResource Font.Ui}" Foreground="{DynamicResource Text.Soft}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono.Display}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}"
            Background="{DynamicResource Dialog.Background}" Effect="{DynamicResource Shadow.Dialog}">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag handle) -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis">
                        <Run Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        <Run Text=" "/>
                        <Run Text="{services:Loc plan.window.title}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{Binding Project}" FontSize="11" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Faint}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" x:Name="PinButton" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,4,0"
                              Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Cursor="Hand"
                              Checked="Pin_Changed" Unchecked="Pin_Changed" ToolTip="{services:Loc plan.pin.tip}"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Muted}"/>
                <Button Grid.Column="2" Width="30" Height="30" VerticalAlignment="Top" Click="Close_Click"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Cursor="Hand" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel>
                    <!-- Where it is -->
                    <Border Padding="12,9" CornerRadius="8" Margin="0,4,0,0" Background="{DynamicResource State.Fill.Faint}">
                        <!-- a dock, not a horizontal stack: the status wraps to the window's width, wide or narrow -->
                        <DockPanel LastChildFill="True">
                            <!-- running: a dot with a ring rippling out of it — only while the chat works and this is on screen -->
                            <Grid DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                                <Ellipse Stroke="{DynamicResource Status.Success}" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5" Opacity="0"
                                         IsHitTestVisible="False">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <!-- RunRipple: begun once by Motion while LoopOn and on screen, removed when either ends -->
                                            <Setter Property="views:Motion.Loop">
                                                <Setter.Value>
                                                    <Storyboard RepeatBehavior="Forever" Duration="0:0:1.8" Timeline.DesiredFrameRate="24">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.2"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Scale)" From="1" To="2.6" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="views:Motion.LoopOn" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Fill="{DynamicResource Status.Success}"/>
                            </Grid>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </DockPanel>
                    </Border>

                    <!-- The plan: its title with the count on the right, and a line that glides as steps finish -->
                    <DockPanel Margin="0,0,2,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Kicker}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock Text="{services:Loc plan.section.items}" Style="{StaticResource Kicker}"/>
                    </DockPanel>
                    <Grid Height="3" Margin="2,0,2,8" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}}">
                        <Border CornerRadius="1.5" Background="{DynamicResource State.Fill.Faint}"/>
                        <Border CornerRadius="1.5" Background="{DynamicResource Accent.Gradient}" views:Motion.Fraction="{Binding Progress, Mode=OneWay}"/>
                    </Grid>
                    <TextBlock Text="{services:Loc plan.items.empty}" FontSize="12" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                               Visibility="{Binding HasRows, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    <!-- every step plays its state (Resources/Theme.xaml, PLAN STEPS); the rows are kept and changed in
                         place (PlanWindowViewModel.Refresh), so a step finishing pops here too. Queued = typed here, not
                         sent yet: a dashed outline and a "waiting" tag — never the accent, which is the step at work. -->
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="-4,0,0,0" views:Motion.Accent="{DynamicResource Accent.1}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource PlanStepRow}" Padding="8,6" Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlanStepMark}" Focusable="False"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                                   Style="{StaticResource PlanStepText}" VerticalAlignment="Top" Margin="0,0.5,0,0"/>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Top"
                                                BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource State.Fill.Faint}"
                                                Visibility="{Binding IsQueued, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{services:Loc plan.state.queued}" FontSize="10.5" Foreground="{DynamicResource Text.Muted}"/>
                                        </Border>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{services:Loc plan.startQueued}" Command="{Binding StartQueuedCommand}" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" Padding="12,5"
                            Visibility="{Binding CanStartQueued, Converter={StaticResource Vis}}"/>

                    <!-- Time machine for this chat -->
                    <TextBlock Text="{services:Loc plan.section.steps}" Style="{StaticResource Kicker}"/>
                    <TextBlock Text="{services:Loc plan.steps.empty}" FontSize="12" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                               Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" Margin="0,0,0,4" CornerRadius="7" BorderThickness="1"
                                        BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Dialog.Card.Background}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" FontSize="12.5" Foreground="{DynamicResource Text.Primary}">
                                                <Run Text="{Binding Step, Mode=OneWay, StringFormat='#{0}'}" FontFamily="{DynamicResource Font.Mono.Display}"
                                                     Foreground="{DynamicResource Accent.1}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Faint}"
                                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                                <Run Text="{Binding When, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding FileList, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    IsEnabled="{Binding DataContext.CanTravel, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button Style="{StaticResource SmallButton}" Content="{services:Loc plan.rewind}"
                                                    ToolTip="{services:Loc plan.rewind.tip}"
                                                    Command="{Binding DataContext.AskRewindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallButton}" Content="{services:Loc plan.branch}"
                                                    ToolTip="{services:Loc plan.branch.tip}"
                                                    Command="{Binding DataContext.AskBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Add to the plan -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,0,6"
                           Foreground="{DynamicResource Accent.1}"
                           Visibility="{Binding Message, Converter={StaticResource BoolVis}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewItemBox" Text="{Binding NewItem, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                             FontSize="12.5" VerticalContentAlignment="Center" ToolTip="{services:Loc plan.add.tip}"
                             Background="{DynamicResource Input.Background}" Foreground="{DynamicResource Text.Primary}"
                             BorderBrush="{DynamicResource Border.Subtle}" CaretBrush="{DynamicResource Accent.1}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="{services:Loc plan.add}" Command="{Binding AddItemCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="12,5"/>
                </Grid>
            </StackPanel>

            <!-- Confirm: going back / branching change files -->
            <Grid Grid.RowSpan="3" Background="{DynamicResource Bg.Scrim.Dialog}" Margin="-18,-14,-18,-16"
                  Visibility="{Binding IsConfirmOpen, Converter={StaticResource Vis}}">
                <Border Margin="22" Padding="18" CornerRadius="12" VerticalAlignment="Center"
                        Background="{DynamicResource Dialog.Background}" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding ConfirmBody}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{services:Loc timemachine.cancel}" Command="{Binding CancelCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,5"/>
                            <Button Content="{services:Loc plan.confirm}" Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
