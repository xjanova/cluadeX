<UserControl x:Class="CluadeX.Views.PopOut.PoppedOutPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:popout="clr-namespace:CluadeX.Views.PopOut">
    <!-- Where a page was while it is in its own window (PageHost shows this in its place). The page is the DataContext. -->
    <Grid Background="{DynamicResource Page.Background}">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24"
                Padding="28,24" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Subtle}">
            <StackPanel>
                <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Accent.1.Tint}"/>
                    <TextBlock x:Name="PageGlyph" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource Accent.1}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4"
                            Background="{DynamicResource Bg.Window}" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="PageName" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{services:Loc popout.placeholder.title}" FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{services:Loc popout.placeholder.hint}" FontSize="12" Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="18"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource PrimaryButton}" Margin="4" MinWidth="120"
                            Command="{x:Static popout:PagePopOut.BringBackCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{services:Loc popout.placeholder.back}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShowButton" Style="{StaticResource SecondaryButton}" Margin="4" MinWidth="120"
                            Command="{x:Static popout:PagePopOut.ShowWindowCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{services:Loc popout.placeholder.show}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
