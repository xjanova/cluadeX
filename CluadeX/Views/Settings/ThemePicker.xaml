<UserControl x:Class="CluadeX.Views.Settings.ThemePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services">
    <!--
        The theme picker (Settings › General › Appearance) — owner-approved design: ThemePicker.dc.html.
        Three cards, each a picture of its theme; a click applies the theme live and remembers it.
        DataContext: SettingsViewModel (ThemeOptions, SelectThemeCommand).

        The card chrome follows the ACTIVE theme (semantic tokens, DynamicResource). The three previews do
        not: each is a fixed little picture of ITS theme, so its colours are literal by design.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- Classic — XP Silver: light silver window, Luna title bar, blue selection -->
        <DataTemplate x:Key="PreviewClassic">
            <Border Background="#ECECF0" BorderBrush="#8C8FA8" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="14" BorderBrush="#8C8FA8" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FEFEFF" Offset="0"/>
                                <GradientStop Color="#CDCFDD" Offset="0.55"/>
                                <GradientStop Color="#B9BCCE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#8C8FA8" BorderThickness="0,0,1,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CDD0E0" Offset="0"/>
                                    <GradientStop Color="#B2B6CC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Grid Height="10"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <Border Background="#316AC5"/></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Background="#C5C8D6"/></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Background="#C5C8D6"/></Grid>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Midnight — today's CluadeX: navy, violet, cyan -->
        <DataTemplate x:Key="PreviewMidnight">
            <Border Background="#0F1230" BorderBrush="#2B2F5A" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="14" Background="#141838" BorderBrush="#2B2F5A" BorderThickness="0,0,0,1"/>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#0A0C22" BorderBrush="#2B2F5A" BorderThickness="0,0,1,0"/>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Grid Height="10"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <Border Background="#A672FF"/></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Background="#28326E"/></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Background="#4CDFFF"/></Grid>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Neon Cyber LED — black grid, cyan LED strips, magenta / lime glow -->
        <DataTemplate x:Key="PreviewNeonCyber">
            <Border BorderBrush="#00E5FF" BorderThickness="1" ClipToBounds="False">
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#070812">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#1400E5FF">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,10,1"/>
                                            <RectangleGeometry Rect="0,0,1,10"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <DockPanel ClipToBounds="True">
                    <Border DockPanel.Dock="Top" Height="14" Background="#0E1228" BorderBrush="#00E5FF" BorderThickness="0,0,0,1">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#060814" BorderBrush="#6600E5FF" BorderThickness="0,0,1,0"/>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Grid Height="10"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <Border Background="#FF2BD6">
                                    <Border.Effect><DropShadowEffect Color="#FF2BD6" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                </Border></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="9*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Background="#7300E5FF"/></Grid>
                            <Grid Height="8" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Background="#A6FF00">
                                    <Border.Effect><DropShadowEffect Color="#A6FF00" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                                </Border></Grid>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- One card: preview, radio dot + name (+ "in progress" badge), description. A Button, not a
             RadioButton: a RadioButton would check itself on click and break the binding to IsSelected. -->
        <Style x:Key="ThemeCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource State.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{DynamicResource State.Selected}"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="card" Property="Margin" Value="-1"/>
                                <Setter TargetName="card" Property="Effect" Value="{DynamicResource Glow.Accent.1}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{services:Loc settings.theme}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,2"/>
        <TextBlock Text="{services:Loc settings.themeDesc}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,12"/>

        <ItemsControl ItemsSource="{Binding ThemeOptions}" Focusable="False"
                      AutomationProperties.Name="{services:Loc settings.theme}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Margin="0,0,-12,0"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ThemeCard}"
                            Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Id}"
                            AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{Binding Description}">
                        <StackPanel>
                            <Grid>
                                <ContentControl Content="{Binding}" Height="120" Focusable="False" IsTabStop="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource PreviewMidnight}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Id}" Value="Classic">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource PreviewClassic}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="NeonCyber">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource PreviewNeonCyber}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <!-- "In progress" — the theme applies, but its team has not finished painting it -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7" CornerRadius="8" Padding="7,1"
                                        Background="{DynamicResource Bg.Panel}"
                                        BorderBrush="{DynamicResource Status.Warning.Border}" BorderThickness="1"
                                        ToolTip="{services:Loc settings.themeInProgressTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{services:Loc settings.themeInProgress}" FontSize="10"
                                               Foreground="{DynamicResource Status.Warning}"/>
                                </Border>
                            </Grid>

                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <!-- radio dot: filled while this theme is the one in use -->
                                <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource Focus.Ring}" StrokeThickness="1"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Focus.Ring}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Muted}" LineHeight="18"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lavender Night only: its colours are the owner's to choose — the whole theme follows (ThemeTint) -->
        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="10" Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                Visibility="{Binding IsLavenderTheme, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="{services:Loc settings.palette.title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                <TextBlock Text="{services:Loc settings.palette.desc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,10"/>

                <TextBlock Text="{services:Loc settings.palette.background}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding BackgroundSwatches}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PickBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Cursor="Hand" Margin="0,0,8,8"
                                    AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Border.Strong}" BorderThickness="2"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{services:Loc settings.palette.accent}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,6"/>
                <ItemsControl ItemsSource="{Binding AccentSwatches}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Cursor="Hand" Margin="0,0,8,8"
                                    AutomationProperties.Name="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Border.Strong}" BorderThickness="2"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{services:Loc settings.palette.own}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding CustomBackground, UpdateSourceTrigger=PropertyChanged}" Width="92" ToolTip="{services:Loc settings.palette.bgHex}"/>
                    <TextBox Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}" Width="92" Margin="6,0,0,0" ToolTip="{services:Loc settings.palette.acHex}"/>
                    <Button Content="{services:Loc settings.palette.apply}" Command="{Binding ApplyCustomColoursCommand}" Margin="8,0,0,0" Padding="12,4"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button Content="{services:Loc settings.palette.reset}" Command="{Binding ResetThemeColoursCommand}" Margin="6,0,0,0" Padding="12,4"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
