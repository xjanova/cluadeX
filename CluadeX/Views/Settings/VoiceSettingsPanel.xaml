<UserControl x:Class="CluadeX.Views.Settings.VoiceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:services="clr-namespace:CluadeX.Services">
    <!--
        Settings › Voice › who reads the replies aloud (2026-11-09). DataContext: VoiceSettingsViewModel.
        Engine picker; then the chosen engine's own section (ElevenLabs: key, model with what it can do, voice, fine
        settings, cloning · OpenAI: the AI Provider key, model, voice, instructions · the two free ones); each girl's
        own voice; a test. The engine's girl stands on the right (ElevenLabs has her own).
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
        <Style x:Key="Line" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Slide" TargetType="Slider">
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <!-- engine -->
            <Grid Style="{StaticResource Line}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc voice.ui.engine}" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding EngineNote}" Style="{StaticResource Desc}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding EngineOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Engine}"/>
            </Grid>
            <Grid Style="{StaticResource Line}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc voice.ui.persona}" Style="{StaticResource Label}"/>
                    <TextBlock Text="{services:Loc voice.ui.personaDesc}" Style="{StaticResource Desc}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding PersonaVoices}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
            <Grid Style="{StaticResource Line}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc voice.ui.maxChars}" Style="{StaticResource Label}"/>
                    <TextBlock Text="{services:Loc voice.ui.maxCharsDesc}" Style="{StaticResource Desc}"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding MaxChars, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"
                         Width="96" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>

            <!-- ═══ ElevenLabs ═══ -->
            <StackPanel Visibility="{Binding IsEleven, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{services:Loc voice.ui.elevenKey}" Style="{StaticResource Head}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding MaskedElevenKey, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Box}"
                             Visibility="{Binding ShowElevenKey, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                    <TextBox Text="{Binding ElevenKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"
                             Visibility="{Binding ShowElevenKey, Converter={StaticResource BoolVis}}"/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Click="ToggleKey_Click" MinWidth="72"
                            Content="{services:Loc voice.ui.showKey}"/>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Command="{Binding CheckElevenCommand}"
                            Content="{services:Loc voice.ui.check}"/>
                </Grid>
                <TextBlock Text="{services:Loc voice.ui.elevenKeyDesc}" Style="{StaticResource Desc}"/>
                <TextBlock Text="{Binding AccountText}" Style="{StaticResource Desc}" Foreground="{DynamicResource Accent.1}" Margin="0,4,0,0"/>

                <TextBlock Text="{services:Loc voice.ui.model}" Style="{StaticResource Head}"/>
                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Badges}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ModelInfo}" Style="{StaticResource Desc}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ModelBadges}" Style="{StaticResource Desc}" Foreground="{DynamicResource Accent.1}" Margin="0,2,0,0"/>
                <TextBlock Text="{services:Loc voice.ui.noThai}" Style="{StaticResource Desc}" Foreground="#FF6B6B" Margin="0,4,0,0"
                           Visibility="{Binding ThaiWarning, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="{services:Loc voice.ui.voice}" Style="{StaticResource Head}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding VoiceSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"
                             ToolTip="{services:Loc voice.ui.searchTip}"/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Command="{Binding RefreshVoicesCommand}" Content="{services:Loc voice.ui.loadVoices}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Name"/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Command="{Binding PreviewVoiceCommand}" Content="{services:Loc voice.ui.preview}"/>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Command="{Binding DeleteVoiceCommand}" Content="{services:Loc voice.ui.deleteVoice}"/>
                </Grid>
                <TextBlock Text="{Binding VoiceInfo}" Style="{StaticResource Desc}" Margin="0,4,0,0"/>

                <TextBlock Text="{services:Loc voice.ui.fine}" Style="{StaticResource Head}"/>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}"><Run Text="{services:Loc voice.ui.stability}"/><Run Text="  "/><Run Text="{Binding StabilityText, Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                        <TextBlock Text="{services:Loc voice.ui.stabilityDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding Stability}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}"><Run Text="{services:Loc voice.ui.similarity}"/><Run Text="  "/><Run Text="{Binding Similarity, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                        <TextBlock Text="{services:Loc voice.ui.similarityDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding Similarity}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                </Grid>
                <Grid Style="{StaticResource Line}" IsEnabled="{Binding StyleEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}"><Run Text="{services:Loc voice.ui.style}"/><Run Text="  "/><Run Text="{Binding Style, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                        <TextBlock Text="{services:Loc voice.ui.styleDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding Style}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}"><Run Text="{services:Loc voice.ui.speed}"/><Run Text="  "/><Run Text="{Binding Speed, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                        <TextBlock Text="{services:Loc voice.ui.speedDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding Speed}" Minimum="0.7" Maximum="1.2" TickFrequency="0.05"/>
                </Grid>
                <Grid Style="{StaticResource Line}" IsEnabled="{Binding BoostEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.boost}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.boostDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding SpeakerBoost}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <Grid Style="{StaticResource Line}" IsEnabled="{Binding TagsEnabled}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.tags}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.tagsDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AudioTags}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.format}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.formatDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding OutputFormats}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding OutputFormat}"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.norm}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.normDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding Normalizations}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Normalization}"/>
                </Grid>

                <!-- instant voice cloning -->
                <TextBlock Text="{services:Loc voice.ui.clone}" Style="{StaticResource Head}"/>
                <TextBlock Text="{services:Loc voice.ui.cloneDesc}" Style="{StaticResource Desc}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{services:Loc voice.ui.cloneName}" Style="{StaticResource Label}" VerticalAlignment="Center" Width="110"/>
                    <TextBox Grid.Column="1" Text="{Binding CloneName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{services:Loc voice.ui.cloneAbout}" Style="{StaticResource Label}" VerticalAlignment="Center" Width="110"/>
                    <TextBox Grid.Column="1" Text="{Binding CloneDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CloneFilesText}" Style="{StaticResource Desc}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource Small}" Command="{Binding AddCloneFilesCommand}" Content="{services:Loc voice.ui.cloneAdd}"/>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Command="{Binding ClearCloneFilesCommand}" Content="{services:Loc voice.ui.cloneClear}"/>
                </Grid>
                <CheckBox IsChecked="{Binding CloneRemoveNoise}" Content="{services:Loc voice.ui.cloneNoise}" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                <CheckBox IsChecked="{Binding CloneConsent}" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8">
                    <TextBlock Text="{services:Loc voice.ui.cloneConsent}" TextWrapping="Wrap"/>
                </CheckBox>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloneCommand}" Content="{services:Loc voice.ui.cloneGo}"
                        HorizontalAlignment="Left" Padding="16,7"/>
            </StackPanel>

            <!-- ═══ OpenAI ═══ -->
            <StackPanel Visibility="{Binding IsOpenAi, Converter={StaticResource BoolVis}}">
                <TextBlock Text="OpenAI" Style="{StaticResource Head}"/>
                <TextBlock Text="{services:Loc voice.ui.openaiKeyOk}" Style="{StaticResource Desc}" Foreground="{DynamicResource Accent.1}"
                           Visibility="{Binding OpenAiHasKey, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{services:Loc voice.openai.noKey}" Style="{StaticResource Desc}" Foreground="#FF6B6B"
                           Visibility="{Binding OpenAiHasKey, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <Grid Style="{StaticResource Line}" Margin="0,10,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.model}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.openaiModelDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" Width="200" ItemsSource="{Binding OpenAiModels}" SelectedItem="{Binding OpenAiModel}"/>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Command="{Binding RefreshOpenAiModelsCommand}" Content="{services:Loc voice.ui.loadModels}"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{services:Loc voice.ui.voice}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" Width="200" ItemsSource="{Binding OpenAiVoices}" SelectedItem="{Binding OpenAiVoice}"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center"><Run Text="{services:Loc voice.ui.speed}"/><Run Text="  "/><Run Text="{Binding OpenAiSpeed, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding OpenAiSpeed}" Minimum="0.5" Maximum="2" TickFrequency="0.05"/>
                </Grid>
                <StackPanel IsEnabled="{Binding OpenAiTakesInstructions}">
                    <TextBlock Text="{services:Loc voice.ui.instructions}" Style="{StaticResource Label}"/>
                    <TextBlock Text="{services:Loc voice.ui.instructionsDesc}" Style="{StaticResource Desc}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding OpenAiInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══ free: the browser's voices ═══ -->
            <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{services:Loc voice.engine.browser}" Style="{StaticResource Head}"/>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.voice}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.browserVoiceDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" IsEditable="True" ItemsSource="{Binding BrowserVoices}"
                              Text="{Binding BrowserVoice, UpdateSourceTrigger=LostFocus}"/>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Command="{Binding RefreshFreeVoicesCommand}" Content="↻"/>
                </Grid>
                <TextBlock Text="{services:Loc voice.ui.noBrowserVoices}" Style="{StaticResource Desc}" Margin="0,-6,0,10"
                           Visibility="{Binding NoBrowserVoices, Converter={StaticResource BoolVis}}"/>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center"><Run Text="{services:Loc voice.ui.speed}"/><Run Text="  "/><Run Text="{Binding BrowserRate, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding BrowserRate}" Minimum="0.5" Maximum="2" TickFrequency="0.05"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center"><Run Text="{services:Loc voice.ui.pitch}"/><Run Text="  "/><Run Text="{Binding BrowserPitch, StringFormat='{}{0:F2}', Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding BrowserPitch}" Minimum="0.5" Maximum="2" TickFrequency="0.05"/>
                </Grid>
            </StackPanel>

            <!-- ═══ free: Windows' offline voices ═══ -->
            <StackPanel Visibility="{Binding IsWindows, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{services:Loc voice.engine.windows}" Style="{StaticResource Head}"/>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc voice.ui.voice}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{services:Loc voice.ui.windowsVoiceDesc}" Style="{StaticResource Desc}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource Pick}" ItemsSource="{Binding WindowsVoices}" SelectedItem="{Binding WindowsVoice}"/>
                </Grid>
                <Grid Style="{StaticResource Line}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center"><Run Text="{services:Loc voice.ui.speed}"/><Run Text="  "/><Run Text="{Binding WindowsRate, Mode=OneWay}" Foreground="{DynamicResource Accent.1}"/></TextBlock>
                    <Slider Grid.Column="1" Style="{StaticResource Slide}" Value="{Binding WindowsRate}" Minimum="-10" Maximum="10" TickFrequency="1"/>
                </Grid>
            </StackPanel>

            <!-- ═══ each girl's own voice ═══ -->
            <TextBlock Text="{services:Loc voice.ui.girls}" Style="{StaticResource Head}"/>
            <TextBlock Text="{services:Loc voice.ui.girlsDesc}" Style="{StaticResource Desc}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding GirlRows}" IsEnabled="{Binding PersonaVoices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="34" Height="34" Fill="{Binding Face}" Stroke="{Binding Accent}" StrokeThickness="2"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="220" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ItemsSource="{Binding DataContext.GirlVoiceChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Voice}"/>
                            <Button Grid.Column="3" Style="{StaticResource Small}" Content="{services:Loc voice.ui.listen}"
                                    Command="{Binding DataContext.TestGirlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ test ═══ -->
            <TextBlock Text="{services:Loc voice.ui.test}" Style="{StaticResource Head}"/>
            <TextBox Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Box}" Margin="0,0,0,8"
                     ToolTip="{services:Loc voice.ui.testTip}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding TestGirls}" SelectedValuePath="Value" SelectedValue="{Binding TestGirl}" Width="160" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding TestCommand}" Content="{services:Loc voice.ui.testGo}"
                        Margin="8,0,0,0" Padding="16,7"/>
                <Button Style="{StaticResource Small}" Command="{Binding StopCommand}" Content="{services:Loc voice.ui.stop}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="#FF6B6B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding SaveText}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- the engine's girl -->
        <StackPanel Grid.Column="1" Width="150" Margin="16,0,0,0" VerticalAlignment="Top">
            <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{Binding MascotAccent}"
                    Background="{DynamicResource Card.Background}">
                <TextBlock Text="{Binding MascotLine}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Primary}"/>
            </Border>
            <Image Source="{Binding MascotImage}" Height="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding MascotName}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,6,0,0"
                       Foreground="{Binding MascotAccent}"/>
        </StackPanel>
    </Grid>
</UserControl>
