<UserControl x:Class="CluadeX.Views.SecurityShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecurityShieldViewModel}"
             Background="{StaticResource NeonBg0Brush}"
             FontFamily="{StaticResource NeonUiFont}">
    <UserControl.Resources>
        <DataTemplate x:Key="FindingCardTemplate" DataType="{x:Type m:SecurityFinding}">
            <Button Click="OnFindingClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="12,10" CornerRadius="8"
                                BorderThickness="1,1,1,1" BorderBrush="{StaticResource NeonLineBrush}"
                                Background="{StaticResource NeonCardFill}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Padding="6,2" CornerRadius="3" Background="#22FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{StaticResource NeonMonoFont}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0" Background="#15FFFFFF" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding Category}" FontSize="9"
                                       FontFamily="{StaticResource NeonMonoFont}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding RuleId}" FontSize="9" Margin="8,0,0,0"
                                   FontFamily="{StaticResource NeonMonoFont}"
                                   Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RuleName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource NeonInk0Brush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Location}" FontSize="10" Margin="0,3,0,0"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonCyanBrush}"/>
                    <TextBlock Text="{Binding LineSnippet}" FontSize="11" Margin="0,4,0,0"
                               FontFamily="{StaticResource NeonMonoFont}"
                               Foreground="{StaticResource NeonInk2Brush}"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="#7028326E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B22E3870"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5EC4" Offset="0"/>
                        <GradientStop Color="#A672FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource NeonMagentaBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF5EC4" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#7011152E"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonLineHiBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource NeonInk0Brush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource NeonMonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" RadiusX="0.7" RadiusY="0.55">
                    <GradientStop Color="#22FF5EC4" Offset="0"/>
                    <GradientStop Color="#06071A" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7F141838" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF5EC4" Offset="0"/>
                                <GradientStop Color="#FF6E6E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5EC4" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc shield.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonInk0Brush}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource NeonInk2Brush}" Margin="0,2,0,0">
                            <Run Text="{services:Loc shield.staticAnalysis}"/>
                            <Run Text="{Binding RuleCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc shield.rulesSuffix}"/>
                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Scan button -->
                        <Button Command="{Binding ScanCommand}" Style="{StaticResource NeonPrimary}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                                IsEnabled="{Binding HasProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.scanProject}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelScanCommand}" Style="{StaticResource NeonAction}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.cancelScan}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.clear}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter + counters bar -->
            <Border Grid.Row="1" Padding="24,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NeonLineBrush}"
                    Background="#5511152E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding SeverityChoices}"
                              SelectedItem="{Binding SeverityFilter}"
                              Width="110" Height="28" Margin="0,0,10,0"
                              FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                              Background="#7011152E" Foreground="{StaticResource NeonInk0Brush}"
                              BorderBrush="{StaticResource NeonLineHiBrush}" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryChoices}"
                              SelectedItem="{Binding CategoryFilter}"
                              Width="140" Height="28" Margin="0,0,10,0"
                              FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                              Background="#7011152E" Foreground="{StaticResource NeonInk0Brush}"
                              BorderBrush="{StaticResource NeonLineHiBrush}" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Column="2" Style="{StaticResource NeonTextBox}" Width="220" Margin="0,0,16,0"
                             Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{services:Loc shield.filterTip}"/>

                    <!-- Counter chips -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="#22FF5EC4" BorderBrush="{StaticResource NeonMagentaBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonMagentaBrush}">
                                <Run Text="🔥 "/>
                                <Run Text="{Binding CriticalCount, Mode=OneWay}"/>
                                <Run Text=" CRIT"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="#22FF6E6E" BorderBrush="{StaticResource NeonRedBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonRedBrush}">
                                <Run Text="✗ "/>
                                <Run Text="{Binding HighCount, Mode=OneWay}"/>
                                <Run Text=" HIGH"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="#22FFD166" BorderBrush="{StaticResource NeonAmberBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonAmberBrush}">
                                <Run Text="⚠ "/>
                                <Run Text="{Binding MediumCount, Mode=OneWay}"/>
                                <Run Text=" MED"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4"
                                Background="#224CDFFF" BorderBrush="{StaticResource NeonCyanBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{StaticResource NeonMonoFont}"
                                       Foreground="{StaticResource NeonCyanBrush}">
                                <Run Text="ℹ "/>
                                <Run Text="{Binding LowCount, Mode=OneWay}"/>
                                <Run Text=" LOW"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="5" FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                               Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center">
                        <Run Text="{Binding FilesScanned, Mode=OneWay}"/>
                        <Run Text="{services:Loc shield.filesSuffix}"/>
                        <Run Text="{Binding DurationDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Findings list + detail -->
            <Grid Grid.Row="2" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <ItemsControl ItemsSource="{Binding Findings}"
                                          ItemTemplate="{StaticResource FindingCardTemplate}"/>
                        </ScrollViewer>
                        <!-- Empty / scanning state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                                    Visibility="{Binding VisibleFindingCount, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                       Foreground="{StaticResource NeonInk3Brush}" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource NeonInk2Brush}" TextAlignment="Center">
                                <Run Text="{services:Loc shield.clickPrefix}"/>
                                <Run Text="{services:Loc shield.scanProject}" FontWeight="Bold" Foreground="#FF5EC4"/>
                                <Run Text="{services:Loc shield.toRun}"/>
                                <Run Text="{Binding RuleCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shield.rulesAcross}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="2" Background="{StaticResource NeonPanelFill}"
                        BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                        <StackPanel>
                            <!-- Severity + category badges -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Padding="8,3" CornerRadius="4" Background="#22FFFFFF" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding Selected.SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                    </Border.BorderBrush>
                                    <TextBlock Text="{Binding Selected.SeverityLabel}" FontSize="10" FontWeight="Bold"
                                               FontFamily="{StaticResource NeonMonoFont}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Selected.SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <Border Padding="8,3" CornerRadius="4" Margin="6,0,0,0"
                                        Background="#15FFFFFF" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding Selected.CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                    </Border.BorderBrush>
                                    <TextBlock Text="{Binding Selected.Category}" FontSize="10"
                                               FontFamily="{StaticResource NeonMonoFont}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Selected.CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Selected.RuleId}" Margin="10,0,0,0"
                                           FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonInk3Brush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Selected.Cwe}" Margin="10,0,0,0"
                                           FontSize="10" FontFamily="{StaticResource NeonMonoFont}"
                                           Foreground="{StaticResource NeonAmberBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.RuleName}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource NeonInk0Brush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Selected.Description}" FontSize="12"
                                       Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <!-- Location -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="#11FFFFFF" BorderBrush="{StaticResource NeonLineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.location}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.FilePath}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="11" Foreground="{StaticResource NeonCyanBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontFamily="{StaticResource NeonMonoFont}" FontSize="11"
                                               Foreground="{StaticResource NeonInk2Brush}" Margin="0,4,0,0">
                                        <Run Text="{services:Loc shield.lineLabel}"/>
                                        <Run Text="{Binding Selected.LineNumber, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Snippet -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="#7011152E" BorderBrush="{StaticResource NeonLineHiBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.offendingLine}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource NeonInk3Brush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Selected.LineSnippet, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="False"
                                             FontFamily="{StaticResource NeonMonoFont}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource NeonInk0Brush}"
                                             Padding="0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Fix -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="#225CFFB0" BorderBrush="{StaticResource NeonMintBrush}" BorderThickness="1"
                                    Visibility="{Binding Selected.Fix, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.suggestedFix}" FontFamily="{StaticResource NeonMonoFont}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource NeonMintBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.Fix}" FontSize="12"
                                               Foreground="{StaticResource NeonInk1Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding OpenFileCommand}" Style="{StaticResource NeonAction}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                    <TextBlock Text="{services:Loc shield.openInEditor}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource NeonLineBrush}" Background="#88141838">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{StaticResource NeonMonoFont}"
                           Foreground="{StaticResource NeonMintBrush}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
