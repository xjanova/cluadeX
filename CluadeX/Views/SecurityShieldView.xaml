<UserControl x:Class="CluadeX.Views.SecurityShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:m="clr-namespace:CluadeX.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SecurityShieldViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">
    <UserControl.Resources>
        <DataTemplate x:Key="FindingCardTemplate" DataType="{x:Type m:SecurityFinding}">
            <Button Click="OnFindingClick" Tag="{Binding}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="12,10" CornerRadius="8"
                                BorderThickness="1,1,1,1" BorderBrush="{DynamicResource Border.Subtle}"
                                Background="{DynamicResource Surface.Card}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Padding="6,2" CornerRadius="3" Background="{DynamicResource Surface.Badge}" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="9" FontWeight="Bold"
                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border Padding="6,2" CornerRadius="3" Margin="6,0,0,0" Background="{DynamicResource State.Hover.Subtle}" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding Category}" FontSize="9"
                                       FontFamily="{DynamicResource Font.Mono.Display}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding RuleId}" FontSize="9" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource Font.Mono.Display}"
                                   Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RuleName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Location}" FontSize="10" Margin="0,3,0,0"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Accent.1}"/>
                    <TextBlock Text="{Binding LineSnippet}" FontSize="11" Margin="0,4,0,0"
                               FontFamily="{DynamicResource Font.Mono.Display}"
                               Foreground="{DynamicResource Text.Muted}"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="NeonAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Foreground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Action.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Action.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonPrimary" TargetType="Button" BasedOn="{StaticResource NeonAction}">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Accent.3.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Primary.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Primary.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Effect" Value="{DynamicResource Glow.Button.Action.Accent.3}"/>
        </Style>

        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent.1}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono.Display}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Accent.3}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                            Background="{DynamicResource IconTile.Accent.3-Danger}"
                            Effect="{DynamicResource Glow.IconTile.Accent.3}">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource IconTile.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc shield.title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,2,0,0">
                            <Run Text="{services:Loc shield.staticAnalysis}"/>
                            <Run Text="{Binding RuleCount, Mode=OneWay}"/>
                            <Run Text="{services:Loc shield.rulesSuffix}"/>
                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Scan button -->
                        <Button Command="{Binding ScanCommand}" Style="{StaticResource NeonPrimary}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                                IsEnabled="{Binding HasProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.scanProject}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelScanCommand}" Style="{StaticResource NeonAction}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.cancelScan}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCommand}" Style="{StaticResource NeonAction}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{services:Loc shield.clear}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter + counters bar -->
            <Border Grid.Row="1" Padding="24,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Toolbar.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding SeverityChoices}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SeverityFilter}"
                              Width="150" Height="28" Margin="0,0,10,0"
                              FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                              Background="{DynamicResource Surface.Input}" Foreground="{DynamicResource Text.Primary}"
                              BorderBrush="{DynamicResource Border.Default}" VerticalContentAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryChoices}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding CategoryFilter}"
                              Width="140" Height="28" Margin="0,0,10,0"
                              FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                              Background="{DynamicResource Surface.Input}" Foreground="{DynamicResource Text.Primary}"
                              BorderBrush="{DynamicResource Border.Default}" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Column="2" Style="{StaticResource NeonTextBox}" Width="220" Margin="0,0,16,0"
                             Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{services:Loc shield.filterTip}"/>

                    <!-- Counter chips -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="{DynamicResource Accent.3.Tint}" BorderBrush="{DynamicResource Accent.3}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Accent.3}">
                                <Run Text="🔥 "/>
                                <Run Text="{Binding CriticalCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shieldx.chipCrit}"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="{DynamicResource Status.Danger.Tint}" BorderBrush="{DynamicResource Status.Danger}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Danger}">
                                <Run Text="✗ "/>
                                <Run Text="{Binding HighCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shieldx.chipHigh}"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4" Margin="0,0,6,0"
                                Background="{DynamicResource Status.Warning.Tint}" BorderBrush="{DynamicResource Status.Warning}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Status.Warning}">
                                <Run Text="⚠ "/>
                                <Run Text="{Binding MediumCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shieldx.chipMed}"/>
                            </TextBlock>
                        </Border>
                        <Border Padding="8,3" CornerRadius="4"
                                Background="{DynamicResource Accent.1.Tint}" BorderBrush="{DynamicResource Accent.1}" BorderThickness="1">
                            <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono.Display}"
                                       Foreground="{DynamicResource Accent.1}">
                                <Run Text="ℹ "/>
                                <Run Text="{Binding LowCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shieldx.chipLow}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="5" FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                               Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center">
                        <Run Text="{Binding FilesScanned, Mode=OneWay}"/>
                        <Run Text="{services:Loc shield.filesSuffix}"/>
                        <Run Text="{Binding DurationDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Findings list + detail -->
            <Grid Grid.Row="2" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <ItemsControl ItemsSource="{Binding Findings}"
                                          ItemTemplate="{StaticResource FindingCardTemplate}"/>
                        </ScrollViewer>
                        <!-- Empty / scanning state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                                    Visibility="{Binding VisibleFindingCount, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                                       Foreground="{DynamicResource Text.Faint}" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}" TextAlignment="Center">
                                <Run Text="{services:Loc shield.clickPrefix}"/>
                                <Run Text="{services:Loc shield.scanProject}" FontWeight="Bold" Foreground="{DynamicResource Accent.3}"/>
                                <Run Text="{services:Loc shield.toRun}"/>
                                <Run Text="{Binding RuleCount, Mode=OneWay}"/>
                                <Run Text="{services:Loc shield.rulesAcross}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="2" Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}"
                        Effect="{DynamicResource Shadow.Panel.Soft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                        <StackPanel>
                            <!-- Severity + category badges -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Padding="8,3" CornerRadius="4" Background="{DynamicResource Surface.Badge}" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding Selected.SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                    </Border.BorderBrush>
                                    <TextBlock Text="{Binding Selected.SeverityLabel}" FontSize="10" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font.Mono.Display}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Selected.SeverityColorHex, Converter={StaticResource HexToColor}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <Border Padding="8,3" CornerRadius="4" Margin="6,0,0,0"
                                        Background="{DynamicResource State.Hover.Subtle}" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding Selected.CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                    </Border.BorderBrush>
                                    <TextBlock Text="{Binding Selected.Category}" FontSize="10"
                                               FontFamily="{DynamicResource Font.Mono.Display}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Selected.CategoryColorHex, Converter={StaticResource HexToColor}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Selected.RuleId}" Margin="10,0,0,0"
                                           FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Text.Faint}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Selected.Cwe}" Margin="10,0,0,0"
                                           FontSize="10" FontFamily="{DynamicResource Font.Mono.Display}"
                                           Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.RuleName}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Selected.Description}" FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <!-- Location -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="{DynamicResource State.Fill.Faint}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.location}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.FilePath}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="11" Foreground="{DynamicResource Accent.1}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontFamily="{DynamicResource Font.Mono.Display}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0">
                                        <Run Text="{services:Loc shield.lineLabel}"/>
                                        <Run Text="{Binding Selected.LineNumber, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Snippet -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.offendingLine}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Faint}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Selected.LineSnippet, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="False"
                                             FontFamily="{DynamicResource Font.Mono.Display}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Primary}"
                                             Padding="0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Fix -->
                            <Border Padding="12" CornerRadius="6" Margin="0,0,0,10"
                                    Background="{DynamicResource Status.Success.Tint}" BorderBrush="{DynamicResource Status.Success}" BorderThickness="1"
                                    Visibility="{Binding Selected.Fix, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{services:Loc shield.suggestedFix}" FontFamily="{DynamicResource Font.Mono.Display}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Status.Success}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Selected.Fix}" FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Command="{Binding OpenFileCommand}" Style="{StaticResource NeonAction}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc shield.openInEditor}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RevealFileCommand}" Style="{StaticResource NeonAction}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{services:Loc shieldx.revealInExplorer}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Padding="20,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Page.Footer.Background}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="{DynamicResource Font.Mono.Display}"
                           Foreground="{DynamicResource Status.Success}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
