<UserControl x:Class="CluadeX.Views.ProjectFilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:services="clr-namespace:CluadeX.Services">
    <!-- The open project's files, in the left sidebar under the chat list (owner 2026-10-18: "ช่องแสดงไฟล์ไปไว้ในด้านซ้าย
         ต่อจากบทสนทนา จะเหมาะกว่าไว้ใต้แชท"). DataContext: the ChatViewModel. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="14,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{services:Loc chat.side.files}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" Click="Refresh_Click"
                    ToolTip="{services:Loc chat.side.refreshTip}">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
            </Button>
        </Grid>
        <TreeView Grid.Row="1" x:Name="Tree" ItemsSource="{Binding ProjectTree}" Background="Transparent" BorderThickness="0"
                  Padding="4,0,4,8" MouseDoubleClick="Tree_DoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolVis}}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                    <Setter Property="Padding" Value="1,1"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel Grid.Row="1" Margin="14,4" Visibility="{Binding HasProject, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
            <TextBlock Text="{services:Loc chat.side.noProjectChat}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"/>
            <Button Content="{services:Loc chat.side.openFolder}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
