<UserControl x:Class="CluadeX.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:services="clr-namespace:CluadeX.Services">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- Feature Card Style -->
        <Style x:Key="FeatureCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Sunken}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Display}"/>
            <Setter Property="Margin" Value="0,20,0,4"/>
        </Style>
        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui.Display}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Toggle Switch (simplified) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Cursor="Hand">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="{DynamicResource Surface.Raised}"
                                    HorizontalAlignment="Left">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Text.OnAccent}"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Status.Success}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="21,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="750">

            <!-- Page Title -->
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"
                       FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PageSubtitle}"
                       Foreground="{DynamicResource Text.Secondary}" FontSize="13" Margin="0,0,0,4"/>

            <!-- ═══════ ACTIVATION KEY SECTION ═══════ -->
            <Border Background="{DynamicResource Surface.Sunken}" CornerRadius="12" Padding="18,14" Margin="0,8,0,4">
                <StackPanel>
                    <!-- Header row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{services:Loc activation.key}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontFamily="{DynamicResource Font.Ui.Display}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Tier badge (when activated) -->
                        <Border Grid.Column="1" CornerRadius="10" Padding="10,4"
                                Visibility="{Binding IsActivated, Converter={StaticResource BoolVis}}"
                                Background="{DynamicResource License.Tier.Background}">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource License.Tier.Foreground}"
                                       FontFamily="{DynamicResource Font.Ui.Display}">
                                <Run Text="✅ "/>
                                <Run Text="{Binding ActivationTier, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Input row (when NOT activated) -->
                    <Grid Visibility="{Binding IsActivated, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Surface.Raised}" CornerRadius="8" Padding="10,0">
                            <TextBox Text="{Binding ActivationKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text.Primary}"
                                     FontFamily="{DynamicResource Font.Ui.Display}" FontSize="13"
                                     Padding="0,8" VerticalAlignment="Center"
                                     CaretBrush="{DynamicResource Accent.2}"/>
                        </Border>
                        <Button Grid.Column="1" Content="{services:Loc activation.activate}" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" Padding="16,8"
                                Command="{Binding ActivateCommand}"/>
                        <!-- No key yet: plans, purchase link and the free trial live in the license dialog -->
                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,8"
                                Command="{Binding DataContext.OpenLicenseCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Background" Value="{DynamicResource License.Chip.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource License.Chip.Foreground}"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{services:Loc settings.licenseOpen}" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <!-- Deactivate button — paid keys only: deactivating a trial released the demo key for good -->
                    <Button Content="{services:Loc activation.deactivate}" Margin="0,4,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Command="{Binding DeactivateCommand}"
                            Visibility="{Binding CanDeactivate, Converter={StaticResource BoolVis}}"/>

                    <!-- Force transfer button (when device conflict) -->
                    <Button Content="{services:Loc activation.transfer}" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Padding="12,6" FontSize="12"
                            FontFamily="{DynamicResource Font.Ui.Display}"
                            Command="{Binding ForceActivateCommand}"
                            Visibility="{Binding ShowForceActivate, Converter={StaticResource BoolVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Background" Value="{DynamicResource Status.Caution.Tint}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Status message -->
                    <TextBlock Text="{Binding ActivationMessage}" FontSize="12" Margin="0,6,0,0"
                               FontFamily="{DynamicResource Font.Ui.Display}" TextWrapping="Wrap"
                               Visibility="{Binding ActivationMessage, Converter={StaticResource BoolVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivationSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{services:Loc activation.hint}"
                               FontSize="10.5" Foreground="{DynamicResource Text.Muted}"
                               FontFamily="{DynamicResource Font.Ui.Display}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsActivated, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                </StackPanel>
            </Border>

            <!-- ═══════ CORE FEATURES ═══════ -->
            <TextBlock Text="{Binding CoreLabel}" Style="{StaticResource SectionHeader}"
                       Foreground="{DynamicResource Status.Success}"/>
            <TextBlock Text="{Binding CoreDesc}" Style="{StaticResource SectionDesc}"/>

            <ItemsControl ItemsSource="{Binding CoreFeatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeatureCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsEnabled}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                               Foreground="{DynamicResource Text.Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════ ADVANCED FEATURES ═══════ -->
            <TextBlock Text="{Binding AdvancedLabel}" Style="{StaticResource SectionHeader}"
                       Foreground="{DynamicResource Accent.2}"/>
            <TextBlock Text="{Binding AdvancedDesc}" Style="{StaticResource SectionDesc}"/>

            <ItemsControl ItemsSource="{Binding AdvancedFeatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeatureCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center"
                                        Background="{DynamicResource Surface.Raised}"
                                        CornerRadius="8" Padding="8,4">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                               Foreground="{DynamicResource Status.Warning}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════ AGENT TOOLS ═══════ -->
            <TextBlock Text="{Binding ToolsLabel}" Style="{StaticResource SectionHeader}"
                       Foreground="{DynamicResource Accent.1}"/>
            <TextBlock Text="{Binding ToolsDesc}" Style="{StaticResource SectionDesc}"/>

            <ItemsControl ItemsSource="{Binding ToolFeatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeatureCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <!-- Dev Preview: the engine found, or the command that installs it (selectable) -->
                                    <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" FontSize="10"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource Accent.1}" FontFamily="Consolas"
                                             TextWrapping="Wrap" Margin="0,3,0,0"
                                             Visibility="{Binding Detail, Converter={StaticResource BoolVis}}"/>
                                    <!-- Dev Preview: sites outside this PC — ask / allow / block -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="{Binding ChoiceTip}"
                                                Visibility="{Binding HasChoices, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding ChoiceLabel}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted}" FontFamily="{DynamicResource Font.Ui.Display}"/>
                                        <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedChoice, Mode=TwoWay}" FontSize="10"
                                                  MinWidth="90" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsEnabled}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                               Foreground="{DynamicResource Text.Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════ SECURITY ═══════ -->
            <TextBlock Text="{Binding SecurityLabel}" Style="{StaticResource SectionHeader}"
                       Foreground="{DynamicResource Status.Danger}"/>
            <TextBlock Text="{Binding SecurityDesc}" Style="{StaticResource SectionDesc}"/>

            <ItemsControl ItemsSource="{Binding SecurityFeatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeatureCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsEnabled}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                               Foreground="{DynamicResource Text.Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════ FUN & EXTRAS ═══════ -->
            <TextBlock Text="{Binding FunLabel}" Style="{StaticResource SectionHeader}"
                       Foreground="{DynamicResource Accent.4}"/>
            <TextBlock Text="{Binding FunDesc}" Style="{StaticResource SectionDesc}"/>

            <ItemsControl ItemsSource="{Binding FunFeatures}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FeatureCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Text.Muted}"
                                               FontFamily="{DynamicResource Font.Ui.Display}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsEnabled}"
                                              IsEnabled="{Binding CanToggle}"
                                              Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                               Foreground="{DynamicResource Text.Muted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
