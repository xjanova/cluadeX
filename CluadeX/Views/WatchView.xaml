<UserControl x:Class="CluadeX.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource State.Fill.Faint}"/>
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource GlowTextBox}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- One status chip: test result -->
        <DataTemplate x:Key="TestChip">
            <Border x:Name="B" Style="{StaticResource Chip}">
                <TextBlock x:Name="T" FontSize="11" Foreground="{DynamicResource Text.Muted}" Text="{services:Loc watch.test.never}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TestState}" Value="running">
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.test.running}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Accent.1}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TestState}" Value="passed">
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.test.passed}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TestState}" Value="failed">
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.test.failed}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="RunChip">
            <Border x:Name="B" Style="{StaticResource Chip}" Visibility="Collapsed">
                <TextBlock x:Name="T" FontSize="11"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RunState}" Value="running">
                    <Setter TargetName="B" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.run.running}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="crashed">
                    <Setter TargetName="B" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.run.crashed}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="UrlChip">
            <Border x:Name="B" Style="{StaticResource Chip}" Visibility="Collapsed">
                <TextBlock x:Name="T" FontSize="11"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding UrlState}" Value="up">
                    <Setter TargetName="B" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.url.up}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UrlState}" Value="down">
                    <Setter TargetName="B" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="T" Property="Text" Value="{services:Loc watch.url.down}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Page.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                Background="{DynamicResource Page.Header.Background}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc watch.title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{services:Loc watch.subtitle}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate}" MinWidth="260" MaxWidth="420"
                              ToolTip="{services:Loc watch.addPick}"/>
                    <Button Content="{services:Loc watch.add}" Command="{Binding AddCandidateCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="6,0,10,0" Padding="12,5"/>
                    <Button Content="{services:Loc watch.addCurrent}" Command="{Binding AddCurrentCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Padding="12,5"/>
                    <Button Content="{services:Loc watch.testAll}" Command="{Binding TestAllCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Watched apps -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{services:Loc watch.empty}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Text.Muted}"
                           Margin="4,8" Visibility="{Binding HasApps, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Card" Padding="14,11" CornerRadius="10" BorderThickness="1"
                                                    Background="{DynamicResource Surface.Card.Flat}" BorderBrush="{DynamicResource Border.Subtle}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                 Fill="{DynamicResource Status.Success}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProjectPath}" FontSize="10.5" Margin="17,2,0,7" TextTrimming="CharacterEllipsis"
                                                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Text.Faint}"/>
                                                    <WrapPanel Margin="17,0,0,0">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TestChip}"/>
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RunChip}"/>
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource UrlChip}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Status.Danger}"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TestState}" Value="never">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Text.Faint}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                            <!-- The same page on a phone, on this Wi-Fi -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="14,12" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Surface.Card.Flat}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{services:Loc watch.web.title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="{services:Loc watch.web.desc}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,8,0" Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSharing}" VerticalAlignment="Center"
                                      Style="{StaticResource ModernCheckBox}" ToolTip="{services:Loc watch.web.toggleTip}" Content="{services:Loc watch.web.on}" Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasPhoneUrl, Converter={StaticResource BoolVis}}">
                            <Border Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center">
                                <Image Source="{Binding PhoneQr}" Width="168" Height="168" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBox Text="{Binding PhoneUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" FontSize="11"
                                     FontFamily="{DynamicResource Font.Mono}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                     Foreground="{DynamicResource Text.Secondary}" HorizontalContentAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Content="{services:Loc watch.web.copy}" Command="{Binding CopyPhoneUrlCommand}" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="{services:Loc watch.web.newKey}" Command="{Binding NewKeyCommand}" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" ToolTip="{services:Loc watch.web.newKeyTip}"/>
                            </StackPanel>
                            <TextBlock Text="{services:Loc watch.web.firewall}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The selected app -->
            <Border Grid.Column="2" Padding="20,16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Surface.Card.Flat}" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource SlimScrollViewer}" DataContext="{Binding Selected}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="Bold"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Primary}"
                                     CaretBrush="{DynamicResource Accent.1}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{services:Loc watch.askAi}" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,8,0"
                                        Command="{Binding DataContext.AskAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}" ToolTip="{services:Loc watch.askAiTip}"/>
                                <Button Content="{services:Loc watch.remove}" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                        Command="{Binding DataContext.AskRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ProjectPath}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Text.Faint}"/>

                        <!-- Tests -->
                        <TextBlock Text="{services:Loc watch.section.tests}" Style="{StaticResource Kicker}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TestCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                     ToolTip="{services:Loc watch.testCmdTip}"/>
                            <Button Grid.Column="1" Content="{services:Loc watch.runTests}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,5"
                                    Command="{Binding DataContext.RunTestsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TestChip}"/>
                            <TextBlock Text="{Binding TestSummary}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Text="{Binding TestWhen, StringFormat='  ·  {0:d MMM HH:mm}'}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Faint}"/>
                        </StackPanel>
                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource State.Fill.Faint}"
                                Visibility="{Binding TestTail, Converter={StaticResource BoolVis}}">
                            <TextBox Text="{Binding TestTail, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="11" TextWrapping="Wrap" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>

                        <!-- The app itself -->
                        <TextBlock Text="{services:Loc watch.section.app}" Style="{StaticResource Kicker}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RunCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                     ToolTip="{services:Loc watch.runCmdTip}"/>
                            <Button Grid.Column="1" Content="{services:Loc watch.start}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,5"
                                    Command="{Binding DataContext.StartAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="2" Content="{services:Loc watch.stop}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="12,5"
                                    Command="{Binding DataContext.StopAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                        <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Left" Content="{Binding}" ContentTemplate="{StaticResource RunChip}"/>
                        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource State.Fill.Faint}"
                                Visibility="{Binding RunErrors, Converter={StaticResource BoolVis}}">
                            <TextBox Text="{Binding RunErrors, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="11" TextWrapping="Wrap" MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Status.Danger}"/>
                        </Border>

                        <!-- The page -->
                        <TextBlock Text="{services:Loc watch.section.web}" Style="{StaticResource Kicker}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                     ToolTip="{services:Loc watch.urlTip}"/>
                            <Button Grid.Column="1" Content="{services:Loc watch.check}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,5"
                                    Command="{Binding DataContext.CheckUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource UrlChip}"/>
                            <TextBlock Text="{Binding UrlDetail}" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                        </StackPanel>

                        <Button Content="{services:Loc watch.save}" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="12,5"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" VerticalAlignment="Bottom" Margin="24,0,24,4" FontSize="11.5"
                   Foreground="{DynamicResource Accent.1}"/>

        <!-- Confirm remove -->
        <Grid Grid.RowSpan="2" Background="{DynamicResource Bg.Scrim.Dialog}"
              Visibility="{Binding IsRemoveConfirmOpen, Converter={StaticResource BoolVis}}">
            <Border Width="420" Padding="22" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Dialog.Background}" BorderThickness="1" BorderBrush="{DynamicResource Dialog.Border}">
                <StackPanel>
                    <TextBlock Text="{services:Loc watch.removeTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}"/>
                    <TextBlock Text="{Binding PendingRemove.Name}" FontSize="12.5" Margin="0,6,0,4" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{services:Loc watch.removeBody}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource Text.Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{services:Loc timemachine.cancel}" Command="{Binding CancelRemoveCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Padding="12,5"/>
                        <Button Content="{services:Loc watch.remove}" Command="{Binding ConfirmRemoveCommand}" Style="{StaticResource DangerButton}" Padding="12,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
