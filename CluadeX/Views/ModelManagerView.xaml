<UserControl x:Class="CluadeX.Views.ModelManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:vm="clr-namespace:CluadeX.ViewModels">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:FileSizeConverter x:Key="FileSize"/>
        <conv:InverseBoolConverter x:Key="InvertBool"/>
        <views:ModelCategoryLabelConverter x:Key="CategoryLabel"/>

        <!-- Tag badge style -->
        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Accent tag badge (quantization) -->
        <Style x:Key="QuantBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Badge.Quant.Background}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="SizeBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Badge.Size.Background}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Source card hover -->
        <Style x:Key="SourceCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource State.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- List / grid switch. Its own template: the Windows one painted its hover / pressed / checked box in its own
             light blue whatever the theme said. Same shape and trigger order as that template, so Midnight (whose
             Button.Plain.* tokens hold those Windows colours) looks exactly as before. -->
        <Style x:Key="ViewToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Plain.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter Focusable="False" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Hover.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Pressed.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Checked.Background}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Plain.Checked.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <!-- Page Header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc models.managerTitle}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"
                               FontFamily="{DynamicResource Font.Ui.Display}"/>
                    <TextBlock Text="{services:Loc models.managerSubtitle}"
                               Foreground="{DynamicResource Text.Secondary}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE838;" Style="{StaticResource IconButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Command="{Binding OpenModelFolderCommand}"
                            ToolTip="{services:Loc models.openFolderTip}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseAndLoadModelCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc models.loadGgufFile}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- GPU Info Card -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Surface.Raised}" CornerRadius="8"
                            Width="44" Height="44" Margin="0,0,14,0">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource Accent.1}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc models.gpuStatus}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{Binding GpuRecommendation}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Download Progress -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding DownloadStatus}"
                                   Foreground="{DynamicResource Text.Primary}" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{services:Loc models.cancel}" Style="{StaticResource DangerButton}"
                                Command="{Binding CancelDownloadCommand}" Padding="12,4" FontSize="12"/>
                    </Grid>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                                 Style="{StaticResource ModernProgressBar}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status Message (non-downloading) -->
            <TextBlock Text="{Binding DownloadStatus}" Foreground="{DynamicResource Text.Secondary}"
                       FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DownloadStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Model Load Status -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0"
                    Visibility="{Binding IsLoadingModel, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ModelLoadStatus}" Foreground="{DynamicResource Text.Primary}" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Last load / unload / apply-fit result. Above the tabs: it used to live inside "My Models",
                 so pressing Apply fit or Load on the Recommended tab showed no result at all. -->
            <TextBlock Text="{Binding ModelLoadStatus}" Foreground="{DynamicResource Text.Secondary}"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModelLoadStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoadingModel}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ═══════ TAB NAVIGATION ═══════ -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Surface.Sunken}"
                    Margin="0,16,0,0" Padding="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{services:Loc models.tabRecommended}" Style="{StaticResource NavButton}" Tag="&#xE735;"
                                 IsChecked="True" GroupName="ModelTabs" x:Name="RecommendedTab"/>
                    <RadioButton Content="{services:Loc models.tabMyModels}" Style="{StaticResource NavButton}" Tag="&#xE8B7;"
                                 GroupName="ModelTabs" x:Name="LocalTab"/>
                    <RadioButton Content="{services:Loc models.tabSearchHf}" Style="{StaticResource NavButton}" Tag="&#xE721;"
                                 GroupName="ModelTabs" x:Name="SearchTab"/>
                    <RadioButton Content="{services:Loc models.tabWhereToGet}" Style="{StaticResource NavButton}" Tag="&#xE774;"
                                 GroupName="ModelTabs" x:Name="SourcesTab"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- RECOMMENDED MODELS TAB                                 -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=RecommendedTab, Converter={StaticResource BoolVis}}"
                        Margin="0,16,0,0">

                <!-- Category Filter + List/Grid Toggle -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{services:Loc models.popularForGpu}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" FontSize="15"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- List/Grid view switch -->
                        <Border CornerRadius="6" Background="{DynamicResource Surface.Sunken}"
                                Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsListView, Mode=OneWay}"
                                              Command="{Binding SwitchToListViewCommand}"
                                              ToolTip="{services:Loc models.listView}"
                                              Padding="8,4" MinWidth="32"
                                              Background="Transparent" BorderThickness="0"
                                              Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                              Style="{StaticResource ViewToggle}"/>
                                <ToggleButton IsChecked="{Binding IsGridView, Mode=OneWay}"
                                              Command="{Binding SwitchToGridViewCommand}"
                                              ToolTip="{services:Loc models.gridView}"
                                              Padding="8,4" MinWidth="32"
                                              Background="Transparent" BorderThickness="0"
                                              Content="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                              Style="{StaticResource ViewToggle}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{services:Loc models.category}" Foreground="{DynamicResource Text.Muted}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedCategory}"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="140"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding RecommendedModels}">
                    <!-- Swap the panel based on IsGridView: stack vs 2-column uniform grid -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" CornerRadius="10"
                                    Background="{DynamicResource Surface.Sunken}"
                                    Padding="12"
                                    BorderThickness="2"
                                    ToolTip="{Binding FitHint}">
                                <!-- Left-edge accent colored by fit tier -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Raised}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}" FontSize="14"/>
                                            <!-- Category badge -->
                                            <Border Style="{StaticResource TagBadge}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category, Converter={StaticResource CategoryLabel}}" FontSize="10"
                                                           Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Parameter badge -->
                                            <Border Style="{StaticResource SizeBadge}" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold">
                                                    <Run Text="{Binding ParameterBillions}"/><Run Text="B"/>
                                                </TextBlock>
                                            </Border>
                                            <!-- Fit badge — colored pill telling the user how this model runs on their GPU -->
                                            <Border VerticalAlignment="Center" Margin="4,0,0,0"
                                                    CornerRadius="4" Padding="7,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Surface.Raised}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                                                                <Setter Property="Background" Value="{DynamicResource Fit.Excellent.Tint}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                                                                <Setter Property="Background" Value="{DynamicResource Fit.Good.Tint}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                                                                <Setter Property="Background" Value="{DynamicResource Fit.Partial.Tint}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                                                                <Setter Property="Background" Value="{DynamicResource Fit.Poor.Tint}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                                                                <Setter Property="Background" Value="{DynamicResource Fit.TooLarge.Tint}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FitLabel}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Installed badge -->
                                            <Border VerticalAlignment="Center" Margin="4,0,0,0"
                                                    CornerRadius="4" Padding="7,2"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"
                                                    Background="{DynamicResource Badge.Installed.Background}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x2713;" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource Status.Success}"
                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{services:Loc models.installed}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Status.Success}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- One-click apply of the card's recommended -ngl -->
                                            <Button Margin="4,0,0,0" Padding="7,2" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Surface.Raised}"
                                                    ToolTip="{Binding FitHint}"
                                                    Command="{Binding DataContext.ApplyFitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="{services:Loc models.applyFit}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent.1}"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <!-- Star rating -->
                                            <TextBlock Text="{Binding StarDisplay}" FontSize="11"
                                                       Foreground="{DynamicResource Rating.Star}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Foreground="{DynamicResource Text.Muted}" FontSize="11">
                                                <Run Text="{services:Loc models.vramLabel}"/><Run Text="{Binding RequiredVramMB, StringFormat='{}{0:N0} MB'}"/>
                                                <Run Text="{services:Loc models.sizeLabel}"/>
                                                <Run Text="{Binding ApproxSizeBytes, Converter={StaticResource FileSize}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Content="&#xE774;" Style="{StaticResource IconButton}"
                                                FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Url}"
                                                ToolTip="{services:Loc models.viewOnHf}" Margin="0,0,6,0"/>
                                        <!-- Load button (shown when installed) -->
                                        <Button Content="{services:Loc models.load}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding InstalledPath}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"
                                                Padding="16,8"/>
                                        <!-- Download button (shown when NOT installed) -->
                                        <Button Content="{services:Loc models.download}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.DownloadRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                                                Padding="16,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pagination Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                    <Button Content="{services:Loc modelsm.prev}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PrevPageCommand}" Padding="12,4" FontSize="11"/>
                    <TextBlock Text="{Binding PageInfo}" Foreground="{DynamicResource Text.Primary}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="16,0" FontFamily="{DynamicResource Font.Mono.Display}"/>
                    <Button Content="{services:Loc modelsm.next}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}" Padding="12,4" FontSize="11"/>
                </StackPanel>

                <!-- Empty state for filtered -->
                <TextBlock Text="{services:Loc models.noMatchVram}"
                           Foreground="{DynamicResource Text.Muted}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,20" FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecommendedModels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- LOCAL MODELS TAB                                       -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=LocalTab, Converter={StaticResource BoolVis}}"
                        Margin="0,16,0,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{services:Loc models.downloadedModels}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" FontSize="15"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddModelDirectoryCommand}"
                                Margin="0,0,6,0" Padding="10,6" ToolTip="{services:Loc models.scanFolderTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{services:Loc models.addFolder}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{services:Loc models.unload}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding UnloadModelCommand}" Margin="0,0,6,0" Padding="12,6"/>
                        <Button Content="{services:Loc models.refresh}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshLocalModelsCommand}" Padding="12,6"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding LocalModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}" FontSize="14"/>
                                            <!-- Quant badge -->
                                            <Border Style="{StaticResource QuantBadge}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding QuantizationType, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding QuantizationType}" FontSize="10"
                                                           Foreground="{DynamicResource Accent.2}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Param size badge -->
                                            <Border Style="{StaticResource SizeBadge}" VerticalAlignment="Center"
                                                    Visibility="{Binding ParameterDisplay, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding ParameterDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FileSizeDisplay}"
                                                       Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LocalPath}" Foreground="{DynamicResource Text.Muted}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   FontFamily="{DynamicResource Font.Mono.Display}" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{services:Loc models.load}" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding LocalPath}"
                                                Padding="14,8" Margin="0,0,6,0"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource DangerButton}"
                                                FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,8" ToolTip="{services:Loc models.deleteTip}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LocalModels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" Margin="0,16">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="{services:Loc models.noModelsFound}" Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{services:Loc modelsm.noModelsHint}" Foreground="{DynamicResource Text.Muted}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,4,0,12" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BrowseAndLoadModelCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{services:Loc models.browseGguf}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddModelDirectoryCommand}"
                                    Margin="8,0,0,0" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{services:Loc models.addModelFolder}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- SEARCH HUGGINGFACE TAB                                 -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=SearchTab, Converter={StaticResource BoolVis}}"
                        Margin="0,16,0,0">
                <TextBlock Text="{services:Loc models.searchHfTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock Text="{services:Loc modelsm.searchHint}" Foreground="{DynamicResource Text.Muted}"
                           FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <!-- Search Bar -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             FontSize="14"
                             x:Name="SearchBox"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchModelsCommand}"
                            IsEnabled="{Binding IsSearching, Converter={StaticResource InvertBool}}"
                            Margin="8,0,0,0" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{services:Loc models.search}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{services:Loc models.searching}" Foreground="{DynamicResource Accent.1}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="{services:Loc models.cancel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelSearchCommand}" Padding="10,3" FontSize="11" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Search Result Info -->
                <TextBlock Text="{Binding SearchResultInfo}" Foreground="{DynamicResource Text.Secondary}"
                           FontSize="12" Margin="0,0,0,8"
                           Visibility="{Binding SearchResultInfo, Converter={StaticResource BoolVis}}"/>

                <!-- Search Results -->
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <!-- Repo name -->
                                        <TextBlock Foreground="{DynamicResource Text.Primary}" FontSize="13">
                                            <Run Text="{Binding Author}" Foreground="{DynamicResource Text.Muted}"/><Run Text="/" Foreground="{DynamicResource Text.Muted}"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <!-- File name with badges -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{DynamicResource Accent.1}"
                                                       FontSize="12" FontFamily="{DynamicResource Font.Mono.Display}"
                                                       VerticalAlignment="Center"/>
                                            <!-- Installed badge -->
                                            <Border VerticalAlignment="Center" Margin="8,0,0,0"
                                                    CornerRadius="4" Padding="7,2"
                                                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                    Background="{DynamicResource Badge.Installed.Background}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x2713;" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource Status.Success}"
                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{services:Loc models.installed}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Status.Success}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Badges row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <!-- File size -->
                                            <Border Style="{StaticResource SizeBadge}"
                                                    Visibility="{Binding FileSize, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Quantization -->
                                            <Border Style="{StaticResource QuantBadge}"
                                                    Visibility="{Binding QuantizationType, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding QuantizationType}" FontSize="10"
                                                           Foreground="{DynamicResource Accent.2}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Param size -->
                                            <Border Style="{StaticResource TagBadge}"
                                                    Visibility="{Binding ParameterDisplay, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding ParameterDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource Status.Warning}" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Downloads -->
                                            <Border Style="{StaticResource TagBadge}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9" Foreground="{DynamicResource Text.Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding DownloadsDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource Text.Muted}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Likes -->
                                            <Border Style="{StaticResource TagBadge}"
                                                    Visibility="{Binding Likes, Converter={StaticResource BoolVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9" Foreground="{DynamicResource Status.Danger}"
                                                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{Binding LikesDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource Text.Muted}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Read more on HuggingFace -->
                                        <Button Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding HuggingFaceUrl}"
                                                ToolTip="{services:Loc models.openCardTip}"
                                                Padding="6,4" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent.1}"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{services:Loc models.readMore}" FontSize="11"
                                                           Foreground="{DynamicResource Accent.1}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Load button (shown when installed) -->
                                        <Button Content="{services:Loc models.load}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding LocalPath}"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}"
                                                Padding="14,8"/>
                                        <!-- Download button (shown when NOT installed) -->
                                        <Button Content="{services:Loc models.download}"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.DownloadSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"
                                                Padding="14,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Search-result pagination. The VM has paged the results all along
                     (SearchPage / SearchTotalPages / SearchPageInfo) but there were no
                     buttons, so only the first page was ever reachable. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4"
                            Visibility="{Binding HasSearchResults, Converter={StaticResource BoolVis}}">
                    <Button Content="{services:Loc modelsm.prev}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PrevSearchPageCommand}" Padding="12,4" FontSize="11"/>
                    <TextBlock Text="{Binding SearchPageInfo}" Foreground="{DynamicResource Text.Primary}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="16,0" FontFamily="{DynamicResource Font.Mono.Display}"/>
                    <Button Content="{services:Loc modelsm.next}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextSearchPageCommand}" Padding="12,4" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- WHERE TO GET MODELS TAB                                -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding IsChecked, ElementName=SourcesTab, Converter={StaticResource BoolVis}}"
                        Margin="0,16,0,0">
                <TextBlock Text="{services:Loc models.whereToGetTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}" FontSize="15" Margin="0,0,0,4"/>
                <TextBlock Text="{services:Loc modelsm.ggufIntro}" Foreground="{DynamicResource Text.Muted}"
                           FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <!-- Model Sources -->
                <ItemsControl ItemsSource="{Binding ModelSources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Url}"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,6" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Style="{StaticResource Card}" x:Name="CardBorder">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource Surface.Raised}" CornerRadius="8"
                                                        Width="40" Height="40" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="18" Foreground="{DynamicResource Accent.1}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}" FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE8A7;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background"
                                                        Value="{DynamicResource Surface.Raised}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tips Section -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{services:Loc models.tipsTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipQuantTitle}"/></Bold>
                            <Run Text="{services:Loc modelsm.tipQuant}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipVramTitle}"/></Bold>
                            <Run Text="{services:Loc modelsm.tipVram}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipCodingTitle}"/></Bold>
                            <Run Text="{services:Loc modelsm.tipCoding}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12"
                                   TextWrapping="Wrap">
                            <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipPortableTitle}"/></Bold>
                            <Run Text="{services:Loc modelsm.tipPortable}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
