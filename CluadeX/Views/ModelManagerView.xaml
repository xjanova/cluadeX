<UserControl x:Class="CluadeX.Views.ModelManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CluadeX.Services"
             xmlns:conv="clr-namespace:CluadeX.Converters"
             xmlns:views="clr-namespace:CluadeX.Views"
             xmlns:vm="clr-namespace:CluadeX.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelManagerViewModel}"
             Background="{DynamicResource Bg.Window}"
             FontFamily="{DynamicResource Font.Ui.Display}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolConverter x:Key="InvertBool"/>
        <conv:NavIconSourceConverter x:Key="NavIconSource"/>
        <views:AdaptiveColumnsConverter x:Key="AdaptiveColumns"/>
        <views:HasValueToVisibilityConverter x:Key="HasValue"/>

        <!-- ─── Pills ─── -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Chip}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <Style x:Key="AccentPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Accent.1.Tint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.1.Border}"/>
        </Style>
        <Style x:Key="SuccessPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Status.Success.Tint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Status.Success.Border}"/>
        </Style>
        <Style x:Key="DangerPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Status.Danger.Tint}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Border}"/>
        </Style>

        <!-- Fit badge: colour follows FitColorKey (RecommendedModel, QuantPlan and ModelInfo all have it) -->
        <Style x:Key="FitPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                    <Setter Property="Background" Value="{DynamicResource Fit.Excellent.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Success.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                    <Setter Property="Background" Value="{DynamicResource Fit.Good.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.1.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                    <Setter Property="Background" Value="{DynamicResource Fit.Partial.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                    <Setter Property="Background" Value="{DynamicResource Fit.Poor.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                    <Setter Property="Background" Value="{DynamicResource Fit.TooLarge.Tint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Border}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitLabel}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FitColored" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 4 px strip on the card's left edge in the fit colour -->
        <Style x:Key="FitStrip" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="12,0,0,12"/>
            <Setter Property="Background" Value="{DynamicResource Border.Subtle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Green">
                    <Setter Property="Background" Value="{DynamicResource Status.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Teal">
                    <Setter Property="Background" Value="{DynamicResource Accent.1}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Yellow">
                    <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Peach">
                    <Setter Property="Background" Value="{DynamicResource Status.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitColorKey}" Value="Red">
                    <Setter Property="Background" Value="{DynamicResource Status.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Cards ─── -->
        <Style x:Key="ModelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
                    <Setter Property="Effect" Value="{DynamicResource Glow.Card.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ─── Buttons (same family as the Plugins page) ─── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Foreground}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Button.Action.Hover.Background}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Button.Action.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionPrimary" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Primary.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Primary.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Primary.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect" Value="{DynamicResource Glow.Button.Action.Primary}"/>
        </Style>
        <Style x:Key="ActionSuccess" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Button.Action.Success.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Action.Success.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Button.Action.Success.Foreground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Page tabs as chips -->
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.1.Tint.Strong}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Job filter chips (ListBox items) -->
        <Style x:Key="TaskChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource Surface.Chip}" BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="14" Padding="11,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent.1.Tint.Strong}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent.1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List / grid switch. Its own template: the Windows one painted its hover / pressed / checked box in its own light blue. -->
        <Style x:Key="ViewToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Button.Plain.Border}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter Focusable="False" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Plain.Checked.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Catalog card ═══ -->
        <DataTemplate x:Key="CatalogCard">
            <Border Style="{StaticResource ModelCard}" ToolTip="{Binding FitHint}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FitStrip}"/>
                    <StackPanel Grid.Column="1" Margin="14,12,12,8">
                        <!-- Title -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,1,0,0">
                                    <Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ReleasedText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ParamsText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StarText}" FontSize="12.5" Margin="8,2,0,0" FontFamily="Segoe UI Symbol"
                                       Foreground="{DynamicResource Rating.Star}" VerticalAlignment="Top" ToolTip="{services:Loc modelsm.starsTip}"/>
                        </Grid>

                        <!-- Badges -->
                        <WrapPanel Margin="0,9,0,0">
                            <Border Style="{StaticResource FitPill}">
                                <TextBlock Text="{Binding FitLabel}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource FitColored}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Visibility="{Binding SpeedText, Converter={StaticResource HasValue}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4A;" Style="{StaticResource PillGlyph}"/>
                                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource PillText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Visibility="{Binding ContextText, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding ContextText}" Style="{StaticResource PillText}"/>
                            </Border>
                            <Border Style="{StaticResource SuccessPill}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource PillGlyph}" Foreground="{DynamicResource Status.Success}"/>
                                    <TextBlock Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold">
                                        <Run Text="{services:Loc models.installed}"/><Run Text=" "/><Run Text="{Binding InstalledQuant, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AccentPill}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{services:Loc modelsm.loadedNow}" Style="{StaticResource PillText}" Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Visibility="{Binding IsLegacy, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{services:Loc modelsm.legacyTag}" Style="{StaticResource PillText}"/>
                            </Border>
                            <!-- Vision: ready / comes with the download / the bundled llama.cpp cannot read its projector -->
                            <Border Style="{StaticResource SuccessPill}" Visibility="{Binding VisionReady, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc modelsm.visionReadyTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" Style="{StaticResource PillGlyph}" Foreground="{DynamicResource Status.Success}"/>
                                    <TextBlock Text="{services:Loc modelsm.visionReady}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Success}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Visibility="{Binding VisionComesWithDownload, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc modelsm.visionPlusTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" Style="{StaticResource PillGlyph}"/>
                                    <TextBlock Style="{StaticResource PillText}">
                                        <Run Text="{services:Loc modelsm.visionPlus}"/><Run Text=" +"/><Run Text="{Binding ProjectorSizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Status.Warning.Tint}" BorderBrush="{DynamicResource Status.Warning.Border}"
                                    Visibility="{Binding VisionNeedsNewerBackend, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc modelsm.visionNewerTip}">
                                <TextBlock Text="{services:Loc modelsm.visionNewer}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Warning}"/>
                            </Border>
                            <Border Style="{StaticResource DangerPill}" Visibility="{Binding NeedsNewerBackend, Converter={StaticResource BoolVis}}"
                                    ToolTip="{services:Loc modelsm.newerBackendTip}">
                                <TextBlock Text="{services:Loc modelsm.newerBackend}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Danger}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding TaskChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AccentPill}">
                                            <TextBlock Text="{Binding}" Style="{StaticResource PillText}" Foreground="{DynamicResource Accent.1}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <TextBlock Text="{Binding DescriptionText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"/>

                        <!-- Why -->
                        <Grid Margin="0,8,0,0" Visibility="{Binding ReasonsText, Converter={StaticResource HasValue}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,7,0"
                                       Foreground="{DynamicResource Accent.2}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding ReasonsText}" Style="{StaticResource Muted}"/>
                        </Grid>

                        <!-- Download progress of this card -->
                        <ProgressBar Margin="0,10,0,0" Maximum="100" Style="{StaticResource ModernProgressBar}"
                                     Value="{Binding DataContext.DownloadProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                     Visibility="{Binding IsDownloadingThis, Converter={StaticResource BoolVis}}"/>

                        <!-- Actions -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Style="{StaticResource ModernComboBox}"
                                          MinWidth="200" MaxWidth="300" Margin="0,0,8,6" FontSize="11.5"
                                          ToolTip="{services:Loc modelsm.quantTip}"
                                          Visibility="{Binding HasQuantChoice, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ActionButton}" Padding="9,7"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Url}" ToolTip="{services:Loc models.viewOnHf}">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource ActionButton}" ToolTip="{services:Loc modelsm.addVisionTip}"
                                        Command="{Binding DataContext.DownloadProjectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                        Visibility="{Binding CanAddVision, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock>
                                            <Run Text="{services:Loc modelsm.addVision}"/><Run Text=" · "/><Run Text="{Binding ProjectorSizeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionButton}" ToolTip="{Binding FitHint}"
                                        Command="{Binding DataContext.ApplyFitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Visibility>
                                        <Binding Path="IsInstalled" Converter="{StaticResource BoolVis}"/>
                                    </Button.Visibility>
                                    <TextBlock Text="{services:Loc models.applyFit}"/>
                                </Button>
                                <Button Style="{StaticResource ActionSuccess}"
                                        Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding InstalledPath}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{services:Loc models.load}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionPrimary}"
                                        Command="{Binding DataContext.DownloadRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock>
                                            <Run Text="{services:Loc modelsm.downloadShort}"/><Run Text=" · "/><Run Text="{Binding DownloadSizeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ Top pick card ═══ -->
        <DataTemplate x:Key="PickCard">
            <Border Style="{StaticResource ModelCard}" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Accent.1.Border}">
                <StackPanel Margin="14,12,14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Top"
                                Background="{DynamicResource IconTile.Accent.1-2}" Effect="{DynamicResource Glow.IconTile.Small.Accent.1}">
                            <TextBlock Foreground="{DynamicResource IconTile.Foreground}" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Run Text="#"/><Run Text="{Binding PickRank, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{Binding ParamsText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedPlan.Name, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DownloadSizeText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,9,0,0">
                        <Border Style="{StaticResource FitPill}">
                            <TextBlock Text="{Binding FitLabel}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource FitColored}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Visibility="{Binding SpeedText, Converter={StaticResource HasValue}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC4A;" Style="{StaticResource PillGlyph}"/>
                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource PillText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SuccessPill}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc models.installed}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding ReasonsText}" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionSuccess}"
                                Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding InstalledPath}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc models.load}"/>
                        </Button>
                        <Button Style="{StaticResource ActionPrimary}"
                                Command="{Binding DataContext.DownloadRecommendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc modelsm.downloadShort}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Rectangle IsHitTestVisible="False" Fill="{DynamicResource Page.Wash.Accent.2}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Border Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}"
                    Background="{DynamicResource Page.Header.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource IconTile.Accent.1-2}"
                            Effect="{DynamicResource Glow.IconTile.Accent.1}">
                        <Grid>
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource IconTile.Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{DynamicResource NavIcon.Glyph.Visibility}"/>
                            <Image Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Source=models, Converter={StaticResource NavIconSource}}"
                                   Visibility="{DynamicResource NavIcon.Art.Visibility}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{services:Loc models.managerTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="{services:Loc modelsm.subtitle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Text.Muted}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="320">
                        <Button Style="{StaticResource ActionButton}" Command="{Binding OpenModelFolderCommand}"
                                ToolTip="{services:Loc models.openFolderTip}" Padding="10,7">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource ActionPrimary}" Command="{Binding BrowseAndLoadModelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{services:Loc models.loadGgufFile}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,14,24">

                    <!-- ═══ Your PC ═══ -->
                    <Border Style="{StaticResource ModelCard}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{services:Loc modelsm.hwTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding HwBackendDetail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Padding="9,6" VerticalAlignment="Top"
                                        Command="{Binding RefreshHardwareCommand}" ToolTip="{services:Loc modelsm.hwRefreshTip}">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </Grid>
                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource AdaptiveColumns}" ConverterParameter="250,3">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!-- GPU -->
                                <Grid Margin="0,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top"
                                            Background="{DynamicResource IconTile.Accent.1-Success}">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource IconTile.Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HwGpuText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{Binding HwGpuDetail}" Style="{StaticResource Muted}"/>
                                        <ProgressBar Margin="0,5,0,0" Height="5" Maximum="100" Value="{Binding VramUsedPercent, Mode=OneWay}"
                                                     Style="{StaticResource ModernProgressBar}"
                                                     Visibility="{Binding VramUsedPercent, Converter={StaticResource HasValue}}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- RAM / CPU -->
                                <Grid Margin="0,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top"
                                            Background="{DynamicResource IconTile.Accent.2-1}">
                                        <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource IconTile.Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HwRamText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{Binding HwRamDetail}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Backend -->
                                <Grid Margin="0,0,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top"
                                            Background="{DynamicResource IconTile.Accent.4-3}">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource IconTile.Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HwBackendText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Primary}"/>
                                        <TextBlock Text="{services:Loc modelsm.hwEstimateNote}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Grid>
                            </ItemsControl>
                            <Border Margin="0,4,0,0" Padding="10,7" CornerRadius="8"
                                    Background="{DynamicResource Status.Warning.Tint}" BorderBrush="{DynamicResource Status.Warning.Border}" BorderThickness="1"
                                    Visibility="{Binding HwNote, Converter={StaticResource HasValue}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,8,0"
                                               Foreground="{DynamicResource Status.Warning}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HwNote}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Download / load status ═══ -->
                    <Border Style="{StaticResource ModelCard}" Padding="14,12"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DownloadStatus}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Primary}" FontSize="12.5" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="{services:Loc models.cancel}" Style="{StaticResource DangerButton}"
                                        Command="{Binding CancelDownloadCommand}" Padding="12,4" FontSize="12" Margin="8,0,0,0"/>
                            </Grid>
                            <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100"
                                         Style="{StaticResource ModernProgressBar}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModelCard}" Padding="14,12"
                            Visibility="{Binding IsLoadingModel, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource Accent.1}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ModelLoadStatus}" Foreground="{DynamicResource Text.Primary}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <!-- Last download / delete result -->
                    <TextBlock Text="{Binding DownloadStatus}" FontSize="12" Margin="2,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DownloadStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Last load / unload / apply-fit result (above the tabs, so it shows whichever tab pressed it) -->
                    <TextBlock Text="{Binding ModelLoadStatus}" FontSize="12" Margin="2,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelLoadStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoadingModel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- ═══ Tabs ═══ -->
                    <WrapPanel Margin="0,6,0,6">
                        <RadioButton Style="{StaticResource TabChip}" Tag="&#xE734;" IsChecked="True" GroupName="ModelTabs" x:Name="RecommendedTab"
                                     Content="{services:Loc models.tabRecommended}"/>
                        <RadioButton Style="{StaticResource TabChip}" Tag="&#xE8B7;" GroupName="ModelTabs" x:Name="LocalTab">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{services:Loc models.tabMyModels}"/>
                                <Border Margin="7,0,0,0" Padding="6,0" CornerRadius="8" Background="{DynamicResource Accent.1.Tint}"
                                        Visibility="{Binding InstalledCountText, Converter={StaticResource HasValue}}">
                                    <TextBlock Text="{Binding InstalledCountText}" FontSize="10.5" Foreground="{DynamicResource Accent.1}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabChip}" Tag="&#xE721;" GroupName="ModelTabs" x:Name="SearchTab"
                                     Content="{services:Loc models.tabSearchHf}"/>
                        <RadioButton Style="{StaticResource TabChip}" Tag="&#xE774;" GroupName="ModelTabs" x:Name="SourcesTab"
                                     Content="{services:Loc models.tabWhereToGet}"/>
                    </WrapPanel>

                    <!-- ═══════════ RECOMMENDED ═══════════ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=RecommendedTab, Converter={StaticResource BoolVis}}">

                        <!-- Job filter -->
                        <TextBlock Text="{services:Loc modelsm.taskQuestion}" Style="{StaticResource Muted}" Margin="2,4,0,6"/>
                        <ListBox ItemsSource="{Binding TaskOptions}" SelectedValuePath="Key" SelectedValue="{Binding SelectedTask}"
                                 ItemContainerStyle="{StaticResource TaskChipItem}" Background="Transparent" BorderThickness="0"
                                 Padding="0" Margin="0,0,0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Best for your PC -->
                        <StackPanel Visibility="{Binding HasTopPicks, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding TopPicksTitle}" Style="{StaticResource SectionTitle}" Margin="2,4,0,2"/>
                            <TextBlock Text="{services:Loc modelsm.topPicksHint}" Style="{StaticResource Muted}" Margin="2,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TopPicks}" ItemTemplate="{StaticResource PickCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid>
                                            <UniformGrid.Columns>
                                                <MultiBinding Converter="{StaticResource AdaptiveColumns}" ConverterParameter="300,3">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </MultiBinding>
                                            </UniformGrid.Columns>
                                        </UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Border Style="{StaticResource ModelCard}" Padding="14,12"
                                Visibility="{Binding ShowNoPicks, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{services:Loc modelsm.noPicks}" Style="{StaticResource Muted}" FontSize="12"/>
                        </Border>

                        <!-- Catalog toolbar -->
                        <Grid Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{services:Loc modelsm.catalogTitle}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding CatalogCountText}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <!-- Text filter -->
                            <Grid Width="240" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBox x:Name="CatalogFilterBox" Text="{Binding CatalogFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         Style="{StaticResource ModernTextBox}" FontSize="12" Padding="28,6,26,6"/>
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="10,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}"/>
                                <TextBlock Text="{services:Loc modelsm.filterPlaceholder}" FontSize="12" Margin="30,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Faint}"
                                           Visibility="{Binding CatalogFilter, Converter={StaticResource HasValue}, ConverterParameter=Invert}"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Margin="0,0,4,0" Padding="4"
                                        Command="{Binding ClearCatalogFilterCommand}" ToolTip="{services:Loc modelsm.clearFilter}"
                                        Visibility="{Binding CatalogFilter, Converter={StaticResource HasValue}}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                </Button>
                            </Grid>
                            <!-- Sort -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,6" VerticalAlignment="Center">
                                <TextBlock Text="{services:Loc modelsm.sortBy}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding SortOptions}" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedSort}" Style="{StaticResource ModernComboBox}" MinWidth="150">
                                    <!-- An ItemTemplate (not DisplayMemberPath): the closed box uses it too, so the label follows the language -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="{services:Loc modelsm.showLegacy}" IsChecked="{Binding ShowLegacy}"
                                      Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <Border CornerRadius="7" Background="{DynamicResource Surface.Sunken}" Padding="2" Margin="0,0,0,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding SwitchToListViewCommand}"
                                                  ToolTip="{services:Loc models.listView}" Padding="8,4" MinWidth="32"
                                                  Background="Transparent" BorderThickness="0"
                                                  Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12" Style="{StaticResource ViewToggle}"/>
                                    <ToggleButton IsChecked="{Binding IsGridView, Mode=OneWay}" Command="{Binding SwitchToGridViewCommand}"
                                                  ToolTip="{services:Loc models.gridView}" Padding="8,4" MinWidth="32"
                                                  Background="Transparent" BorderThickness="0"
                                                  Content="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="12" Style="{StaticResource ViewToggle}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding RecommendedModels}" ItemTemplate="{StaticResource CatalogCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top">
                                        <UniformGrid.Columns>
                                            <MultiBinding Converter="{StaticResource AdaptiveColumns}" ConverterParameter="440,3">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                <Binding Path="DataContext.IsGridView" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            </MultiBinding>
                                        </UniformGrid.Columns>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Style="{StaticResource ModelCard}" Padding="14,16">
                            <Border.Visibility>
                                <Binding Path="RecommendedModels.Count" Converter="{StaticResource HasValue}" ConverterParameter="Invert"/>
                            </Border.Visibility>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,8"/>
                                <TextBlock Text="{services:Loc modelsm.noMatch}" Style="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ MY MODELS ═══════════ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=LocalTab, Converter={StaticResource BoolVis}}">
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{services:Loc models.downloadedModels}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{services:Loc modelsm.localHint}" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="420">
                                <Button Style="{StaticResource ActionButton}" Command="{Binding AddModelDirectoryCommand}" ToolTip="{services:Loc models.scanFolderTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{services:Loc models.addFolder}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionButton}" Command="{Binding UnloadModelCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{services:Loc models.unload}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionButton}" Command="{Binding RefreshLocalModelsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{services:Loc models.refresh}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LocalModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModelCard}" ToolTip="{Binding FitHint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource FitStrip}"/>
                                            <StackPanel Grid.Column="1" Margin="14,12,10,8">
                                                <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding CatalogName}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CatalogName}" Value="">
                                                                    <Setter Property="Text" Value="{Binding Name}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Accent.1}"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border Style="{StaticResource AccentPill}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{services:Loc modelsm.loadedNow}" Style="{StaticResource PillText}" Foreground="{DynamicResource Accent.1}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Style="{StaticResource FitPill}">
                                                        <TextBlock Text="{Binding FitLabel}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource FitColored}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding SpeedText, Converter={StaticResource HasValue}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xEC4A;" Style="{StaticResource PillGlyph}"/>
                                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource PillText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource SuccessPill}" Visibility="{Binding HasVision, Converter={StaticResource BoolVis}}"
                                                            ToolTip="{services:Loc modelsm.visionReadyTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE890;" Style="{StaticResource PillGlyph}" Foreground="{DynamicResource Status.Success}"/>
                                                            <TextBlock Text="{services:Loc modelsm.visionReady}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Success}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding QuantizationType, Converter={StaticResource HasValue}}">
                                                        <TextBlock Text="{Binding QuantizationType}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding ParameterDisplay, Converter={StaticResource HasValue}}">
                                                        <TextBlock Text="{Binding ParameterDisplay}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding FileSizeDisplay}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding LocalPath}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalPath}"
                                                           FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Text.Faint}"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="220" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource ActionSuccess}"
                                                        Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding LocalPath}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{services:Loc models.load}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ActionButton}" Padding="9,7" Foreground="{DynamicResource Status.Danger}"
                                                        Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="{services:Loc models.deleteTip}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border Style="{StaticResource ModelCard}" Padding="16,20">
                            <Border.Visibility>
                                <Binding Path="LocalModels.Count" Converter="{StaticResource HasValue}" ConverterParameter="Invert"/>
                            </Border.Visibility>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="{services:Loc models.noModelsFound}" Foreground="{DynamicResource Text.Secondary}"
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{services:Loc modelsm.noModelsHint}" Style="{StaticResource Muted}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,4,0,12" TextAlignment="Center" MaxWidth="520"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionPrimary}" Command="{Binding BrowseAndLoadModelCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{services:Loc models.browseGguf}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButton}" Command="{Binding AddModelDirectoryCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{services:Loc models.addModelFolder}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════ SEARCH HUGGING FACE ═══════════ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SearchTab, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{services:Loc models.searchHfTitle}" Style="{StaticResource SectionTitle}" Margin="0,6,0,2"/>
                        <TextBlock Text="{services:Loc modelsm.searchHint}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                                     FontSize="13" x:Name="SearchBox" KeyDown="SearchBox_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionPrimary}" Command="{Binding SearchModelsCommand}"
                                    IsEnabled="{Binding IsSearching, Converter={StaticResource InvertBool}}" Margin="8,0,0,0" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc models.search}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Accent.1}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{services:Loc models.searching}" Foreground="{DynamicResource Accent.1}" FontSize="12.5" VerticalAlignment="Center"/>
                            <Button Content="{services:Loc models.cancel}" Style="{StaticResource ActionButton}"
                                    Command="{Binding CancelSearchCommand}" Padding="10,4" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SearchResultInfo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding SearchResultInfo, Converter={StaticResource HasValue}}"/>

                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModelCard}" ToolTip="{Binding FitHint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource FitStrip}"/>
                                            <StackPanel Grid.Column="1" Margin="14,12,10,8">
                                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}">
                                                    <Run Text="{Binding Author, Mode=OneWay}" Foreground="{DynamicResource Text.Muted}"/><Run Text="/" Foreground="{DynamicResource Text.Muted}"/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           FontFamily="{DynamicResource Font.Mono.Display}" Foreground="{DynamicResource Accent.1}"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border Style="{StaticResource SuccessPill}" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{services:Loc models.installed}" Style="{StaticResource PillText}" Foreground="{DynamicResource Status.Success}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Style="{StaticResource FitPill}">
                                                        <TextBlock Text="{Binding FitLabel}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource FitColored}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding SpeedText, Converter={StaticResource HasValue}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xEC4A;" Style="{StaticResource PillGlyph}"/>
                                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource PillText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding FileSize, Converter={StaticResource HasValue}}">
                                                        <TextBlock Text="{Binding FileSizeDisplay}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding QuantizationType, Converter={StaticResource HasValue}}">
                                                        <TextBlock Text="{Binding QuantizationType}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding ParameterDisplay, Converter={StaticResource HasValue}}">
                                                        <TextBlock Text="{Binding ParameterDisplay}" Style="{StaticResource PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource PillGlyph}"/>
                                                            <TextBlock Text="{Binding DownloadsDisplay}" Style="{StaticResource PillText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Visibility="{Binding Likes, Converter={StaticResource HasValue}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xEB52;" Style="{StaticResource PillGlyph}" Foreground="{DynamicResource Status.Danger}"/>
                                                            <TextBlock Text="{Binding LikesDisplay}" Style="{StaticResource PillText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="240" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource ActionButton}"
                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding HuggingFaceUrl}" ToolTip="{services:Loc models.openCardTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{services:Loc models.readMore}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ActionSuccess}"
                                                        Command="{Binding DataContext.LoadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding LocalPath}"
                                                        Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{services:Loc models.load}"/>
                                                </Button>
                                                <Button Style="{StaticResource ActionPrimary}"
                                                        Command="{Binding DataContext.DownloadSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBool}}"
                                                        Visibility="{Binding IsDownloaded, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                                                    <TextBlock Text="{services:Loc modelsm.downloadShort}"/>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Search-result pagination -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4"
                                    Visibility="{Binding HasSearchResults, Converter={StaticResource BoolVis}}">
                            <Button Content="{services:Loc modelsm.prev}" Style="{StaticResource ActionButton}" Command="{Binding PrevSearchPageCommand}"/>
                            <TextBlock Text="{Binding SearchPageInfo}" Foreground="{DynamicResource Text.Primary}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="16,0,10,6" FontFamily="{DynamicResource Font.Mono.Display}"/>
                            <Button Content="{services:Loc modelsm.next}" Style="{StaticResource ActionButton}" Command="{Binding NextSearchPageCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══════════ WHERE TO GET MODELS ═══════════ -->
                    <StackPanel Visibility="{Binding IsChecked, ElementName=SourcesTab, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{services:Loc models.whereToGetTitle}" Style="{StaticResource SectionTitle}" Margin="0,6,0,2"/>
                        <TextBlock Text="{services:Loc modelsm.ggufIntro}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding ModelSources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid>
                                        <UniformGrid.Columns>
                                            <MultiBinding Converter="{StaticResource AdaptiveColumns}" ConverterParameter="380,2">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            </MultiBinding>
                                        </UniformGrid.Columns>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Url}" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Style="{StaticResource ModelCard}" Padding="14,12" x:Name="CardBorder">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource IconTile.Accent.4-2}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                                       Foreground="{DynamicResource IconTile.Foreground}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Text.Primary}"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource ModelCard}" Padding="16,14" Margin="0,4,10,10">
                            <StackPanel>
                                <TextBlock Text="{services:Loc models.tipsTitle}" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipQuantTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipQuant}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipVramTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipVram}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipMoeTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipMoe}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipVisionTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipVision}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipCodingTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipCoding}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap">
                                    <Bold Foreground="{DynamicResource Accent.1}"><Run Text="{services:Loc modelsm.tipPortableTitle}"/></Bold>
                                    <Run Text="{services:Loc modelsm.tipPortable}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
