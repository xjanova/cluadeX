{
  "manifest_version": 3,
  "name": "CluadeX Bridge",
  "version": "1.0.0",
  "description": "Connects this Chrome to the CluadeX app on this PC, so its agent can work in a window of its own.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "declarativeNetRequestWithHostAccess", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "CluadeX Bridge",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png" }
  },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" }
}
