<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Slim, arrow-less scroll bars (Classic keeps its XP bars) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CluadeX;component/Resources/Themes/ModernScrollBars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        ═══════════════════════════════════════════════════════════════════════════════════════════════
        THEME: Lavender — the CluadeX mascot's night room: deep violet, lavender glass, pink glow, gold.
        GENERATED from Midnight.xaml by design/lavender/make_theme.py (same keys); hand-tune below.

        This file must stay PIXEL-IDENTICAL to that look: tests/themetest compares every page and dialog
        against the golden renders (≤ 0.1 % changed pixels per page). Change a value here only on purpose.

        Layout of every theme file (Midnight.xaml, Classic.xaml, NeonCyber.xaml — the SAME keys in each,
        tests/themetest fails on a key that only one theme has):
          1. Theme.Id
          2. SEMANTIC TOKENS — what new and converted XAML / C# uses ({DynamicResource Text.Primary},
             ThemeService.GetBrush("Status.Danger")). The catalogue is Resources/Themes/Tokens.md and the
             list in code is Services/ThemeTokens.cs.
          3. LEGACY PALETTE — the Neon*, Catppuccin and Metal* keys the views still reference with
             StaticResource. Kept so nothing breaks while the converter teams move views to tokens;
             Tokens.md maps each one to its token.
        A theme is ONE dictionary merged first in App.xaml; ThemeService swaps it at runtime.
        ═══════════════════════════════════════════════════════════════════════════════════════════════
    -->

    <sys:String x:Key="Theme.Id">Lavender</sys:String>

    <!-- Menu icons: font glyphs, or the ChatGPT-made art in Assets/Icons (Lavender) -->
    <Visibility x:Key="NavIcon.Glyph.Visibility">Collapsed</Visibility>
    <Visibility x:Key="NavIcon.Art.Visibility">Visible</Visibility>

    <!-- ═════════════════════════════════════ 2. SEMANTIC TOKENS ═════════════════════════════════════ -->

