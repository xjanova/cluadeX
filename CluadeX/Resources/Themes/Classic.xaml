    <SolidColorBrush x:Key="State.Hover.Strong" Color="#29316AC5"/>
    <SolidColorBrush x:Key="State.Pressed" Color="#3D316AC5"/>
    <SolidColorBrush x:Key="State.Selected" Color="#E1E9F7"/>
    <SolidColorBrush x:Key="State.Selected.Strong" Color="#66316AC5"/>
    <SolidColorBrush x:Key="State.Fill.Faint" Color="#0D1C1E33"/>
    <SolidColorBrush x:Key="Selection.Text" Color="#99316AC5"/>

    <!-- Title bar (42 px, touches the window edge: square). Luna Silver: bright band at 8 %, the 50 % fold,
         a sharp dark line at the bottom -->
