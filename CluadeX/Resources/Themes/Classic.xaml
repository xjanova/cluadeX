    <SolidColorBrush x:Key="Bg.Panel" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FCFCFE"/>
    <SolidColorBrush x:Key="Bg.Panel.Solid" Color="#F2F3F8"/>
    <SolidColorBrush x:Key="Bg.Overlay" Color="#ECECF0" Opacity="0.85"/>
    <SolidColorBrush x:Key="Bg.Scrim" Color="#803A3D57"/>

    <!-- The app-wide backdrop: the plain XP window face — no nebula, no orbs -->
    <LinearGradientBrush x:Key="Backdrop.Nebula" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFEFF3" Offset="0"/>
        <GradientStop Color="#E8E8EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Backdrop.Orb.1" Color="Transparent"/>
    <SolidColorBrush x:Key="Backdrop.Orb.2" Color="Transparent"/>
    <SolidColorBrush x:Key="Backdrop.Orb.3" Color="Transparent"/>
    <SolidColorBrush x:Key="Backdrop.Orb.4" Color="Transparent"/>

    <!-- Surfaces: panels and cards on top of the backgrounds -->
