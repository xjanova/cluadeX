        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F8FB" Offset="0.08"/>
        <GradientStop Color="#EDEEF3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F8FB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Surface.Card.Flat" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="Surface.Glass" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Sunken" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="Surface.Raised" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Raised.Strong" Color="#EEF1F8"/>
    <SolidColorBrush x:Key="Surface.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Chip" Color="#E9EAF0"/>
    <SolidColorBrush x:Key="Surface.Popup" Color="#FCFCFE"/>
    <SolidColorBrush x:Key="Surface.Badge" Color="#1A1C1E33"/>

    <!-- Text: darkest → faintest. Inverse = text on a dark/strong fill, so WHITE in a light theme -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1C1E33"/>
    <SolidColorBrush x:Key="Text.Body" Color="#2A2C44"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#4A4D68"/>
    <SolidColorBrush x:Key="Text.Tertiary" Color="#575A75"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#63667F"/>
    <SolidColorBrush x:Key="Text.Faint" Color="#767990"/>
    <SolidColorBrush x:Key="Text.Inverse" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.Link" Color="#1F3A93"/>
    <!-- The softer text ladder of the dialogs (License, BrainX, DGX Spark) and the shared controls -->
    <SolidColorBrush x:Key="Text.Soft" Color="#1C1E33"/>
    <SolidColorBrush x:Key="Text.Soft.Secondary" Color="#4A4D68"/>
    <SolidColorBrush x:Key="Text.Soft.Muted" Color="#686B84"/>

    <!-- Borders + focus ring -->
