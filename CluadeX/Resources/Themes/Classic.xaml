    <SolidColorBrush x:Key="Accent.2.Glow" Color="#5B4AA8" Opacity="0.6"/>
    <SolidColorBrush x:Key="Accent.3.Glow" Color="#E8A23A" Opacity="0.6"/>
    <SolidColorBrush x:Key="Status.Success.Glow" Color="#3FAE3F" Opacity="0.6"/>
    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2D4FA8" Offset="0"/>
        <GradientStop Color="#6C97E0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Brand colours, deepened just enough to read on silver: CluadeX Pro pink, NVIDIA DGX Spark green -->
    <SolidColorBrush x:Key="Brand.Pro" Color="#C8337E"/>
    <SolidColorBrush x:Key="Brand.Pro.Border" Color="#AAC8337E"/>
    <SolidColorBrush x:Key="Brand.Spark" Color="#4E9A2A"/>
    <SolidColorBrush x:Key="Brand.Spark.Border" Color="#AA4E9A2A"/>

    <!-- Status. The *.Soft ladder is used as TEXT on silver and as a FILL under Text.Inverse (white), so it is
