    <SolidColorBrush x:Key="Status.Caution.Soft" Color="#B9561A"/>
    <SolidColorBrush x:Key="Status.Danger.Soft" Color="#B83246"/>
    <SolidColorBrush x:Key="Accent.2.Soft" Color="#6B4FB8"/>
    <SolidColorBrush x:Key="Status.Warning" Color="#A86A0C"/>
