        <GradientStop Color="#E2F2D8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Spark.Chip.Border" Color="#6E9A5A"/>
    <SolidColorBrush x:Key="Spark.Chip.Dot" Color="#A9C79B"/>
    <SolidColorBrush x:Key="Spark.Chip.Dot.Active" Color="#3FAE3F"/>
    <SolidColorBrush x:Key="Spark.Chip.Foreground" Color="#24561A"/>
    <DropShadowEffect x:Key="Glow.Spark.Active" Color="#3FAE3F" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
    <!-- No key yet: an XP blue gel button ("ซื้อเลย" in License.dc.html) -->
