        <GradientStop Color="#FEFEFF" Offset="0"/>
        <GradientStop Color="#F6F6FA" Offset="0.08"/>
        <GradientStop Color="#E6E7EF" Offset="0.42"/>
        <GradientStop Color="#CDCFDD" Offset="0.58"/>
        <GradientStop Color="#BCBFD1" Offset="0.95"/>
        <GradientStop Color="#A9ACC2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBar.Border" Color="#8C8FA8"/>
    <SolidColorBrush x:Key="TitleBar.Foreground" Color="#1B1D3A"/>
    <SolidColorBrush x:Key="TitleBar.Chip.Background" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="TitleBar.Button.Foreground" Color="#2E3150"/>
    <!-- Caption hover: the 42×42 hit area stays, and a real XP caption button (25×23, bevelled) is drawn in
         its middle. Stretch=None keeps it that size whatever the area. -->
    <VisualBrush x:Key="TitleBar.Button.Hover.Background" Stretch="None" AlignmentX="Center" AlignmentY="Center">
        <VisualBrush.Visual>
            <Border Width="25" Height="23" CornerRadius="3" BorderThickness="1" BorderBrush="#7E8199">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F7F8FB" Offset="0.08"/>
                        <GradientStop Color="#E6E8F0" Offset="0.5"/>
                        <GradientStop Color="#D5D7E3" Offset="0.92"/>
                        <GradientStop Color="#B9BCCE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border BorderThickness="1,1,0,0" BorderBrush="#FFFFFF" CornerRadius="2"/>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <SolidColorBrush x:Key="TitleBar.Button.Hover.Foreground" Color="#1B1D3A"/>
    <VisualBrush x:Key="TitleBar.Close.Hover.Background" Stretch="None" AlignmentX="Center" AlignmentY="Center">
        <VisualBrush.Visual>
            <Border Width="25" Height="23" CornerRadius="3" BorderThickness="1" BorderBrush="#8A3B2B">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F8D6CC" Offset="0"/>
                        <GradientStop Color="#F4C2B4" Offset="0.08"/>
                        <GradientStop Color="#E58C72" Offset="0.5"/>
                        <GradientStop Color="#D2563A" Offset="0.92"/>
                        <GradientStop Color="#A8402A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border BorderThickness="1,1,0,0" BorderBrush="#99FFFFFF" CornerRadius="2"/>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <SolidColorBrush x:Key="TitleBar.Close.Hover.Foreground" Color="White"/>
    <SolidColorBrush x:Key="TitleBar.Search.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBar.Search.Border" Color="#7F9DB9"/>
    <SolidColorBrush x:Key="TitleBar.Search.Foreground" Color="#63667F"/>
    <SolidColorBrush x:Key="TitleBar.Search.Hover.Border" Color="#316AC5"/>
    <SolidColorBrush x:Key="TitleBar.Search.Hover.Foreground" Color="#1C1E33"/>
    <SolidColorBrush x:Key="TitleBar.Search.Kbd.Background" Color="#E4E5EC"/>

