    <!-- ═══════════════════════════════ 3. CLASSIC CONTROL STYLES (implicit) ═══════════════════════════════ -->
    <!-- Type-keyed only: no x:Key in this section. They reach controls WITHOUT a Style of their own and leave
         every local value alone (templates bind Background / BorderBrush / BorderThickness / Padding), so a
         borderless icon button stays borderless. When Classic is switched off they vanish with the slot. -->

    <!-- XP push button: bevelled silver face, 2 px amber ring on hover, blue ring when default / focused -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Button.Secondary.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Secondary.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Secondary.Foreground}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="face" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="bevel" Margin="1" CornerRadius="2" BorderThickness="1,1,0,0" BorderBrush="#D9FFFFFF" IsHitTestVisible="False"/>
                        <Border x:Name="shade" Margin="1" CornerRadius="2" BorderThickness="0,0,1,1" BorderBrush="#1F1C1E33" IsHitTestVisible="False"/>
                        <Border x:Name="ring" Margin="1" CornerRadius="2" BorderThickness="2" Opacity="0" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFF0CF" Offset="0"/>
                                    <GradientStop Color="#FDD889" Offset="0.5"/>
                                    <GradientStop Color="#E5A01A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <!-- Press / borderless-hover overlay, drawn OVER the face: a button with its own colour keeps
                             it (the face itself is never replaced, so its text keeps its contrast) -->
                        <Border x:Name="wash" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#381C1E33" Offset="0"/>
                                    <GradientStop Color="#121C1E33" Offset="0.4"/>
                                    <GradientStop Color="#001C1E33" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter x:Name="content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="ring" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#CEE7FF" Offset="0"/>
                                        <GradientStop Color="#BCD4F6" Offset="0.5"/>
                                        <GradientStop Color="#6982EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="ring" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#CEE7FF" Offset="0"/>
                                        <GradientStop Color="#BCD4F6" Offset="0.5"/>
                                        <GradientStop Color="#6982EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                            <Setter TargetName="ring" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF0CF" Offset="0"/>
                                        <GradientStop Color="#FDD889" Offset="0.5"/>
                                        <GradientStop Color="#E5A01A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="shade" Property="BorderThickness" Value="1,1,0,0"/>
                            <Setter TargetName="ring" Property="Opacity" Value="0"/>
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Borderless (icon) buttons: no bevel, no ring; hover / press are a Luna-blue wash -->
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="shade" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="BorderThickness" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="wash" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="BorderThickness" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="wash" Property="Background" Value="{DynamicResource State.Pressed}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="face" Property="BorderBrush" Value="#C9CBD6"/>
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ring" Property="Opacity" Value="0"/>
                            <Setter TargetName="content" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP toggle button: the push button, held down while checked -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource Button.Secondary.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Secondary.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Secondary.Foreground}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="face" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="bevel" Margin="1" CornerRadius="2" BorderThickness="1,1,0,0" BorderBrush="#D9FFFFFF" IsHitTestVisible="False"/>
                        <Border x:Name="shade" Margin="1" CornerRadius="2" BorderThickness="0,0,1,1" BorderBrush="#1F1C1E33" IsHitTestVisible="False"/>
                        <Border x:Name="ring" Margin="1" CornerRadius="2" BorderThickness="2" Opacity="0" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFF0CF" Offset="0"/>
                                    <GradientStop Color="#FDD889" Offset="0.5"/>
                                    <GradientStop Color="#E5A01A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <Border x:Name="wash" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#381C1E33" Offset="0"/>
                                    <GradientStop Color="#121C1E33" Offset="0.4"/>
                                    <GradientStop Color="#001C1E33" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter x:Name="content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="shade" Property="BorderThickness" Value="1,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ring" Property="Opacity" Value="0"/>
                            <Setter TargetName="content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="BorderThickness" Value="0">
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="shade" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="BorderThickness" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="wash" Property="Background" Value="{DynamicResource State.Hover.Strong}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="BorderThickness" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="wash" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="wash" Property="Background" Value="{DynamicResource State.Pressed}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="face" Property="BorderBrush" Value="#C9CBD6"/>
                            <Setter TargetName="bevel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ring" Property="Opacity" Value="0"/>
                            <Setter TargetName="content" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP edit box: white, square, #7F9DB9 border, Luna blue on focus. Same structure as the system template,
         so Padding, scrolling and every local value behave exactly as before. -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Input.Caret}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Selection.Text}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.56"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Input.Focus.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP Silver scroll bar: pale trough, bevelled silver thumb with a grip, arrow buttons; amber hot-track -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type RepeatButton}">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border x:Name="face" Margin="1" CornerRadius="2" BorderThickness="1" BorderBrush="#A5A9BF"
                                                Background="{DynamicResource Button.Secondary.Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="face" Property="BorderBrush" Value="#E5A01A"/>
                                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Button.Secondary.Hover.Background}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="face" Property="Background" Value="#D8D9E2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="face" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type Thumb}">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border x:Name="thumb" Margin="1,0" CornerRadius="2" BorderThickness="1" BorderBrush="#8C8FA8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#F3F4F8" Offset="0.3"/>
                                                    <GradientStop Color="#E3E5EE" Offset="0.85"/>
                                                    <GradientStop Color="#CDD0DD" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="7" Height="2" Margin="0,0,0,1" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                                <Border Width="7" Height="2" Margin="0,0,0,1" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                                <Border Width="7" Height="2" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="thumb" Property="BorderBrush" Value="#E5A01A"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="thumb" Property="BorderBrush" Value="#316AC5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="16"/>
                            <RowDefinition Height="0.00001*"/>
                            <RowDefinition MaxHeight="16"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="3" Background="#F3F3F7" BorderBrush="#DCDDE5" BorderThickness="1,0,0,0"/>
                        <RepeatButton Grid.Row="0" Command="{x:Static ScrollBar.LineUpCommand}">
                            <Path Data="M 0,4 L 3.5,0 L 7,4 Z" Fill="#4D6185"/>
                        </RepeatButton>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb/>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}">
                            <Path Data="M 0,0 L 3.5,4 L 7,0 Z" Fill="#4D6185"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="MinHeight" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <ControlTemplate.Resources>
                                <Style TargetType="{x:Type RepeatButton}">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border x:Name="face" Margin="1" CornerRadius="2" BorderThickness="1" BorderBrush="#A5A9BF"
                                                        Background="{DynamicResource Button.Secondary.Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="face" Property="BorderBrush" Value="#E5A01A"/>
                                                        <Setter TargetName="face" Property="Background" Value="{DynamicResource Button.Secondary.Hover.Background}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="face" Property="Background" Value="#D8D9E2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="face" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="{x:Type Thumb}">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumb" Margin="0,1" CornerRadius="2" BorderThickness="1" BorderBrush="#8C8FA8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#F3F4F8" Offset="0.3"/>
                                                            <GradientStop Color="#E3E5EE" Offset="0.85"/>
                                                            <GradientStop Color="#CDD0DD" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="2" Height="7" Margin="0,0,1,0" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                                        <Border Width="2" Height="7" Margin="0,0,1,0" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                                        <Border Width="2" Height="7" Background="#8C8FA8" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumb" Property="BorderBrush" Value="#E5A01A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumb" Property="BorderBrush" Value="#316AC5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ControlTemplate.Resources>
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="16"/>
                                    <ColumnDefinition Width="0.00001*"/>
                                    <ColumnDefinition MaxWidth="16"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Background="#F3F3F7" BorderBrush="#DCDDE5" BorderThickness="0,1,0,0"/>
                                <RepeatButton Grid.Column="0" Command="{x:Static ScrollBar.LineLeftCommand}">
                                    <Path Data="M 4,0 L 0,3.5 L 4,7 Z" Fill="#4D6185"/>
                                </RepeatButton>
                                <Track x:Name="PART_Track" Grid.Column="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb/>
                                    </Track.Thumb>
                                </Track>
                                <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}">
                                    <Path Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="#4D6185"/>
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- List rows: a light Luna-blue selection that keeps ANY item template readable (dark text stays dark) -->
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="bd" SnapsToDevicePixels="True" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListItem.Hover.Background}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ListItem.Hover.Border}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Dropdown.Item.Hover.Background}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#316AC5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP property-sheet tabs (Settings.dc.html): white selected tab with the orange hot-track line on top -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Bg.Elevated}"/>
        <Setter Property="BorderBrush" Value="#919B9C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" Margin="2,0,2,-1"
                                  IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="root" Margin="0,3,2,0" SnapsToDevicePixels="True">
                        <Border x:Name="tab" BorderBrush="#A8AEB3" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#F4F4F8" Offset="0.5"/>
                                    <GradientStop Color="#E4E5EC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter x:Name="content" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="hot" Height="3" VerticalAlignment="Top" CornerRadius="3,3,0,0" Background="#E8A23A" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1"/>
                            <Setter TargetName="root" Property="Margin" Value="-2,0,0,-1"/>
                            <Setter TargetName="tab" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                            <Setter TargetName="tab" Property="BorderBrush" Value="#919B9C"/>
                            <Setter TargetName="hot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="content" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- XP option button: white well, green dot, amber ring on hover -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource CheckBox.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource CheckBox.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBox.Border}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="hot" Margin="1" Stroke="#F8B330" StrokeThickness="1.5" Opacity="0"/>
                            <Ellipse x:Name="dot" Width="5" Height="5" Opacity="0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                                        <GradientStop Color="#8FE38F" Offset="0"/>
                                        <GradientStop Color="#21A121" Offset="0.7"/>
                                        <GradientStop Color="#1A7A1A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Links: XP blue, darker under the pointer -->
    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Link}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#0B1F66"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chat + code editor (team A). XP Silver values from research/themes/Main.dc.html: accent #316AC5, input
         border #7F9DB9, info-bar yellow #FFFFE1, success #24561A on #F1F8EC, close-button red #D2563A. Buttons
         follow the XP metal recipe: multi-stop gradient, bright band at 8 %, a dark line at the bottom. -->
    <SolidColorBrush x:Key="Accent.1.Tint.Faint" Color="#14316AC5"/>
    <SolidColorBrush x:Key="Accent.1.Border.Soft" Color="#7F9DB9"/>
    <SolidColorBrush x:Key="Accent.2.Hover" Color="#6C97E0"/>
    <SolidColorBrush x:Key="State.Hover.Danger" Color="#33D2563A"/>
    <SolidColorBrush x:Key="Banner.Warning.Background" Color="#FFFFE1"/>
    <SolidColorBrush x:Key="Banner.Danger.Background" Color="#FDECEA"/>
    <LinearGradientBrush x:Key="Button.Flat.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FBFBFD" Offset="0.08"/>
        <GradientStop Color="#ECEDF2" Offset="0.5"/>
        <GradientStop Color="#DDE0EB" Offset="0.92"/>
        <GradientStop Color="#B9BCCE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Button.Flat.Hover.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FFF7E3" Offset="0.08"/>
        <GradientStop Color="#FDEBC0" Offset="0.5"/>
        <GradientStop Color="#FDD889" Offset="0.92"/>
        <GradientStop Color="#E5A01A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Flat.Foreground" Color="#1C1E33"/>
    <LinearGradientBrush x:Key="Button.Success.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4FBEF" Offset="0"/>
