    <SolidColorBrush x:Key="License.Chip.Border" Color="#1B3E86"/>
    <LinearGradientBrush x:Key="License.Chip.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A9C4F2" Offset="0"/>
        <GradientStop Color="#86ABEA" Offset="0.08"/>
        <GradientStop Color="#5F8FDD" Offset="0.48"/>
        <GradientStop Color="#4479D0" Offset="0.52"/>
        <GradientStop Color="#316AC5" Offset="0.92"/>
        <GradientStop Color="#24549F" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Glow.License.Chip" Color="#316AC5" BlurRadius="6" ShadowDepth="0" Opacity="0.35"/>
    <!-- Free trial: amber gel with dark text (the "คุ้มที่สุด" badge tones) -->
    <SolidColorBrush x:Key="License.Chip.Trial.Foreground" Color="#5A3800"/>
    <LinearGradientBrush x:Key="License.Chip.Trial.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF7E2" Offset="0"/>
        <GradientStop Color="#FDEBBE" Offset="0.08"/>
        <GradientStop Color="#FCE2A8" Offset="0.5"/>
        <GradientStop Color="#F3C46A" Offset="0.92"/>
