    <SolidColorBrush x:Key="Status.Success.Tint" Color="#1F3FAE3F"/>
    <SolidColorBrush x:Key="Status.Success.Border" Color="#B5D3A3"/>
    <SolidColorBrush x:Key="Status.Success.Tint.Strong" Color="#333FAE3F"/>
    <SolidColorBrush x:Key="Status.Success.Soft" Color="#2E8B2E"/>
