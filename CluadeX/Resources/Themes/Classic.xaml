    <SolidColorBrush x:Key="Border.Strong" Color="#7E8199"/>
    <SolidColorBrush x:Key="Focus.Ring" Color="#316AC5"/>

    <!-- Accents: 1 Luna blue · 2 indigo · 3 XP orange · 4 rose — dark enough to read as text on silver -->
    <SolidColorBrush x:Key="Accent.1" Color="#316AC5"/>
    <SolidColorBrush x:Key="Accent.1.Tint" Color="#1F316AC5"/>
    <SolidColorBrush x:Key="Accent.1.Border" Color="#8C316AC5"/>
    <SolidColorBrush x:Key="Accent.1.Tint.Strong" Color="#38316AC5"/>
    <SolidColorBrush x:Key="Accent.2" Color="#5B4AA8"/>
    <SolidColorBrush x:Key="Accent.2.Tint" Color="#1F5B4AA8"/>
    <SolidColorBrush x:Key="Accent.2.Border" Color="#805B4AA8"/>
    <SolidColorBrush x:Key="Accent.2.Tint.Strong" Color="#385B4AA8"/>
    <SolidColorBrush x:Key="Accent.3" Color="#C2600E"/>
    <SolidColorBrush x:Key="Accent.3.Tint" Color="#1FC2600E"/>
    <SolidColorBrush x:Key="Accent.3.Border" Color="#80C2600E"/>
    <SolidColorBrush x:Key="Accent.4" Color="#C24E6E"/>
    <!-- 60 % accent fills for strokes and halos -->
