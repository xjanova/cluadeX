<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        SHARED STYLES — the same for every theme. No colours live here any more: every brush, effect and
        font is a {DynamicResource <token>} from the active theme dictionary (Resources/Themes/*.xaml, merged
        BEFORE this file in App.xaml and swapped at runtime by ThemeService), so a theme switch restyles
        every control that uses these styles live, without a restart.

        Rules for anyone editing this file:
          • Reference SEMANTIC TOKENS only (Tokens.md), never a legacy key (NeonInk0Brush, TextBrush, …):
            seven views redefine the legacy keys locally, and a DynamicResource lookup starts at the element,
            so a legacy key here would pick up a view's local copy and change that view's look.
          • Setter values and trigger setters take a whole brush / effect token ({DynamicResource Shadow.Card}),
            never an inline brush or DropShadowEffect whose Color is a DynamicResource — a style seals its
            setter values, and a sealed Freezable cannot follow a resource.
    -->

    <!-- Wider letter-spacing for uppercase section headers (EXPLORER / SOURCE CONTROL etc) -->
    <Style x:Key="Letterspacing15" TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <!-- WPF has no native letter-spacing; fake it via Typography.StylisticSet -->
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- IDE SHELL STYLES (Title bar / Activity bar / Status bar) -->
    <!-- ═══════════════════════════════════════════════════ -->

    <!-- Activity bar icon button (60px wide rail, 44x44 buttons, color accent on active) -->
    <Style x:Key="ActivityBarButton" TargetType="RadioButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ActivityBar.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- Left accent strip when active -->
                        <Border x:Name="accent" Width="3" HorizontalAlignment="Left"
                                Margin="-8,8,0,8" CornerRadius="0,2,2,0"
                                Background="{DynamicResource ActivityBar.Indicator}"
                                Effect="{DynamicResource Glow.ActivityBar.Indicator}"
                                Opacity="0"/>
                        <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontFamily="Segoe MDL2 Assets"
                                              TextBlock.FontSize="18"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ActivityBar.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ActivityBar.Hover.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ActivityBar.Checked.Background}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ActivityBar.Checked.Border}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.ActivityBar.Checked}"/>
                            <Setter TargetName="accent" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource ActivityBar.Checked.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar caption button (min/max/close) — neon-themed -->
    <Style x:Key="NeonCaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleBar.Button.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource TitleBar.Button.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBar.Button.Hover.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource NeonCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource TitleBar.Close.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBar.Close.Hover.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status bar chip button (Time Machine / Hex Editor quick access) -->
    <Style x:Key="StatusBarChipButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource StatusBar.Chip.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StatusBar.Chip.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource StatusBar.Chip.Foreground}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Glow.StatusBar.Chip}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Command palette pill (title bar center) -->
    <Style x:Key="CommandPalettePill" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource TitleBar.Search.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBar.Search.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TitleBar.Search.Foreground}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TitleBar.Search.Hover.Border}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBar.Search.Hover.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SCROLLBAR                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Style>
                                    <Style TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource Scrollbar.Thumb}"
                                                            CornerRadius="4" Margin="1" Opacity="0.6"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Thumb.Style>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- CanContentScroll must be passed through: without it a ListBox inside falls back to physical
                             scrolling and its VirtualizingStackPanel builds EVERY row (a 578-row chat took 35 s to open). -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar Grid.Column="1" Name="PART_VerticalScrollBar"
                                   Style="{StaticResource SlimScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- BUTTONS — 3D METALLIC                               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Button.Primary.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Primary.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource Button.Primary.Border}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="8,8,0,0" Height="1" VerticalAlignment="Top"
                                Background="{DynamicResource Button.Primary.Highlight}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Primary.Hover.Background}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Primary.Pressed.Border}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Button.Secondary.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Secondary.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource Button.Secondary.Border}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="6,6,0,0" Height="1" VerticalAlignment="Top"
                                Background="{DynamicResource Button.Secondary.Highlight}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Secondary.Hover.Background}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource Button.Danger.Foreground}"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Button.Icon.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Button.Icon.Hover.Background}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Button.Icon.Hover.Border}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Button.Icon.Hover.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- NAVIGATION — 3D METALLIC WITH ACCENT GLOW           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Nav.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="2,1">
                        <!-- Left accent strip: shows only when selected -->
                        <Border x:Name="accentGlow" Width="3" HorizontalAlignment="Left"
                                CornerRadius="0,2,2,0" Margin="0,4"
                                Background="{DynamicResource Nav.Indicator}" Opacity="0"/>

                        <!-- Main card — gets lifted with a drop shadow when selected -->
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="4,1"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="liftTransform" Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Colored bubble behind the icon when selected — gives depth + identity color -->
                                <Grid>
                                    <Ellipse x:Name="iconBubble" Width="26" Height="26"
                                             Fill="{DynamicResource Nav.IconBubble}" Opacity="0"/>
                                    <TextBlock x:Name="icon" Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <!-- Subtle chevron on hover / selected for extra affordance -->
                                <TextBlock x:Name="chevron" Grid.Column="2"
                                           Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource Nav.Chevron}"
                                           Opacity="0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Nav.Hover.Background}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Nav.Hover.Border}"/>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Nav.Hover.Icon}"/>
                            <Setter TargetName="chevron" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Nav.Hover.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Nav.Selected.Background}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Nav.Selected.Border}"/>
                            <Setter TargetName="iconBubble" Property="Opacity" Value="0.25"/>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Nav.Selected.Icon}"/>
                            <Setter TargetName="icon" Property="FontSize" Value="16"/>
                            <Setter TargetName="accentGlow" Property="Opacity" Value="1"/>
                            <Setter TargetName="chevron" Property="Opacity" Value="1"/>
                            <Setter TargetName="chevron" Property="Foreground" Value="{DynamicResource Nav.Selected.Chevron}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Nav.Selected.Foreground}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="border" Property="Effect" Value="{DynamicResource Glow.Nav.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TEXTBOX — 3D INSET                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Input.Caret}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <Border CornerRadius="8,8,0,0" Height="1" VerticalAlignment="Top"
                                Background="{DynamicResource Input.InnerShadow}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Input.Focus.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- COMBOBOX — 3D METALLIC                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Dropdown.Item.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Dropdown.Item.Hover.Background}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Dropdown.Item.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Dropdown.Item.Selected.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Dropdown.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Dropdown.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Dropdown.Border}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource Dropdown.Arrow}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2" Opacity="0" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="8,8,0,0" Height="1" VerticalAlignment="Top"
                                Background="{DynamicResource Dropdown.Highlight}" IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Popup.Background}"
                                    BorderBrush="{DynamicResource Popup.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Margin="0,4,0,0" Padding="4"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{DynamicResource Shadow.Popup}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Dropdown.Open.Border}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Dropdown.Hover.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItem}"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CHECKBOX — 3D METALLIC                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource CheckBox.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <Border x:Name="checkBorder" Width="20" Height="20"
                                    CornerRadius="5"
                                    Background="{DynamicResource CheckBox.Background}"
                                    BorderBrush="{DynamicResource CheckBox.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="checkMark" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource CheckBox.Mark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource CheckBox.Checked.Background}"/>
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource CheckBox.Checked.Border}"/>
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource CheckBox.Hover.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SLIDER — 3D METALLIC                                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource Slider.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Slider.Foreground}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Slider.Track}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{DynamicResource Slider.Fill}" Height="6" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="thumb" Width="20" Height="20" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="thumbEllipse"
                                                         Fill="{DynamicResource Slider.Thumb}"
                                                         Width="20" Height="20"
                                                         Stroke="{DynamicResource Slider.Thumb.Border}" StrokeThickness="1"/>
                                                <Ellipse Width="14" Height="8" VerticalAlignment="Top"
                                                         Margin="0,2,0,0" IsHitTestVisible="False"
                                                         Fill="{DynamicResource Slider.Thumb.Gloss}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbEllipse" Property="Fill" Value="{DynamicResource Slider.Thumb.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumbEllipse" Property="Width" Value="22"/>
                                                    <Setter TargetName="thumbEllipse" Property="Height" Value="22"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource ModernSlider}"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PROGRESS BAR — 3D                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Progress.Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource Progress.Fill}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3"
                            BorderThickness="1" BorderBrush="{DynamicResource Progress.Border}">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CARD — 3D METALLIC WITH DROP SHADOW                 -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow.Card}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TOOLTIP — 3D                                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Tooltip.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tooltip.Foreground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tooltip.Border}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- WINDOW CAPTION BUTTONS                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Caption.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Caption.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Caption.Hover.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Caption.Pressed.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Caption.Foreground}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Caption.Close.Hover.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TitleBar.Close.Hover.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Caption.Close.Pressed.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CONTEXT PROGRESS BAR                                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ContextProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Progress.Track}"/>
        <Setter Property="Foreground" Value="{DynamicResource Progress.Context.Fill}"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- EXPANDER — 3D                                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ToolExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Expander.Foreground}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="hdrBorder" Background="Transparent"
                                            CornerRadius="4" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="arrow" Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                       Foreground="{DynamicResource Expander.Arrow}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="arrow" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hdrBorder" Property="Background" Value="{DynamicResource Expander.Hover.Background}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SESSION LIST ITEM — 3D                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="SessionItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ListItem.Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ListItem.Hover.Background}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ListItem.Hover.Border}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ListItem.Hover.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource ListItem.Pressed.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- BADGE                                               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource Badge.Background}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Badge.Border}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CODE BLOCK — 3D                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="CodeBlock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CodeBlock.Background}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CodeBlock.Border}"/>
        <Setter Property="Effect" Value="{DynamicResource Shadow.Card}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- GLOW TEXTBOX — 3D                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="GlowTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="glow" CornerRadius="8" Opacity="0"
                                BorderThickness="1" BorderBrush="{DynamicResource Input.Focus.Border}">
                            <Border.Effect>
                                <BlurEffect Radius="8"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <Border CornerRadius="8,8,0,0" Height="1" VerticalAlignment="Top"
                                Background="{DynamicResource Input.InnerShadow}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Input.Focus.Border}"/>
                            <Setter TargetName="glow" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
