    <!--
        PLAN STEPS — one look for the plan card in the chat, the plan bar over it and the plan window (owner
        2026-11-03: "หน้าแผนงานควรมีอินเมชั่นของงานแต่ละแผนตามสเตตัสจริง สวยงาม"). The DataContext is a
        Models.PlanItemView; colour comes from its state alone:
          pending  a dim ring, the words in the secondary colour
          active   the accent: a ring arc turning, a light sweeping the row, a bar on its left (IsWorking: the
                   run is still going — a step a finished run left "in progress" keeps the colour, not the motion)
          done     a green check that pops in once and a green wash that comes and goes, when it turns done on
                   screen (JustDone); afterwards just the check and softer words
          queued   a dashed ring and outline — typed in the plan window, waiting for Start
        The live parts take views:Motion.Accent (inherited) — the theme's Accent.1, or the plan bar's author colour.
        Every endless storyboard runs only while its step IsWorking AND the element is on screen (IsVisible): it stops
        by its ExitActions the moment either goes, so a folded bar or a scrolled-away card asks for no frames.
        AmbientAnimation.SetMinimized pauses them in a minimised window.
    -->
    <DataTemplate x:Key="PlanStepMark">
        <Grid Width="18" Height="18">
            <!-- done on screen: a green ring that grows and fades, once -->
            <Ellipse StrokeThickness="1.5" Stroke="{DynamicResource Status.Success}" Opacity="0" RenderTransformOrigin="0.5,0.5"
                     IsHitTestVisible="False">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JustDone}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="StepBurst">
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.6"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Scale)" From="0.8" To="2" Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <!-- the ring: its colour is the state -->
            <Ellipse StrokeThickness="1.4">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Stroke" Value="{DynamicResource Text.Faint}"/>
                        <Setter Property="Fill" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource State.Fill.Faint}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Status.Success}"/>
                                <Setter Property="Fill" Value="{DynamicResource Status.Success.Tint}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
                                <Setter Property="StrokeDashArray" Value="2 1.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <!-- active: an arc round the ring, turning while the step is worked on -->
            <Ellipse StrokeThickness="2" StrokeDashArray="6 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                     Stroke="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}" IsHitTestVisible="False">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <!-- StepSpin: begun once by Motion while LoopOn and on screen, removed when either ends -->
                        <Setter Property="views:Motion.Loop">
                            <Setter.Value>
                                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                    <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Spin)"
                                                     From="0" To="360" Duration="0:0:1.1"/>
                                </Storyboard>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                <Setter Property="views:Motion.LoopOn" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <!-- active: the dot at its centre -->
            <Ellipse Width="6" Height="6" Fill="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <!-- done: the check, popping in (overshoot) when it turns done on screen -->
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Status.Success}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding JustDone}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="StepPop">
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(views:Motion.Scale)">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.4"><EasingDoubleKeyFrame.EasingFunction><QuadraticEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="0.9"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.44" Value="1"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- queued: a small clock — it waits for Start -->
            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="8.5" Foreground="{DynamicResource Text.Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <!-- A plan step's row: the highlight, the sweep, the done wash and the queued outline behind its content. -->
    <Style x:Key="PlanStepRow" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="8,3,8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- active: the row lit faintly in the accent, and a bar on its left edge -->
                        <Border CornerRadius="6" IsHitTestVisible="False"
                                Background="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0.09"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="2.5" HorizontalAlignment="Left" Margin="0,3" CornerRadius="1.25" IsHitTestVisible="False"
                                Background="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- active and worked on: a soft light sweeping across the row (the mask's band moves, the row does not) -->
                        <Rectangle RadiusX="6" RadiusY="6" IsHitTestVisible="False"
                                   Fill="{Binding (views:Motion.Accent), RelativeSource={RelativeSource Self}}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00000000" Offset="0.32"/>
                                    <GradientStop Color="#38000000" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="0.68"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <!-- StepSweep: begun once by Motion while LoopOn and on screen, removed when either ends -->
                                    <Setter Property="views:Motion.Loop">
                                        <Setter.Value>
                                            <Storyboard RepeatBehavior="Forever" Duration="0:0:2.6" Timeline.DesiredFrameRate="30">
                                                <DoubleAnimation Storyboard.TargetProperty="(views:Motion.Sweep)"
                                                                 From="-0.75" To="0.75" Duration="0:0:1.8">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                            <Setter Property="views:Motion.LoopOn" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <!-- turned done on screen: a green wash that comes and goes, once -->
                        <Border CornerRadius="6" Background="{DynamicResource Status.Success.Tint}" Opacity="0" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JustDone}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="StepWash">
                                                    <Storyboard FillBehavior="Stop">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                                            <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- queued: a dashed outline round the row -->
                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1" StrokeDashArray="3 2.5" IsHitTestVisible="False"
                                   Stroke="{DynamicResource Text.Faint}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plan step's words: the state's colour (never the accent — only the active step stands out, by weight). -->
    <Style x:Key="PlanStepText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsQueued}" Value="True">
                <Setter Property="FontStyle" Value="Italic"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- AGENT AVATAR — a sub-agent's head on the agent map and in its window. Its colour comes from the node's
         ColorKey (by kind, or a specialist's own colour; cyan = general); the glyph is what it does right now
         (AgentNode.AvatarGlyph) and pops in each time it changes. DataContext = the AgentNode. -->
    <Style x:Key="AgentAvatar.Disc" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Accent.1.Tint}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ColorKey}" Value="blue">
                <Setter Property="Fill" Value="{DynamicResource Status.Info.Tint}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="mint">
                <Setter Property="Fill" Value="{DynamicResource Status.Success.Tint}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="amber">
                <Setter Property="Fill" Value="{DynamicResource Status.Warning.Tint}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="violet">
                <Setter Property="Fill" Value="{DynamicResource Accent.2.Tint}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="red">
                <Setter Property="Fill" Value="{DynamicResource Status.Danger.Tint}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="magenta">
                <Setter Property="Fill" Value="{DynamicResource Accent.3.Tint}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AgentAvatar.Ring" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource Accent.1}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ColorKey}" Value="blue">
                <Setter Property="Stroke" Value="{DynamicResource Status.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="mint">
                <Setter Property="Stroke" Value="{DynamicResource Status.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="amber">
                <Setter Property="Stroke" Value="{DynamicResource Status.Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="violet">
                <Setter Property="Stroke" Value="{DynamicResource Accent.2}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="red">
                <Setter Property="Stroke" Value="{DynamicResource Status.Danger}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="magenta">
                <Setter Property="Stroke" Value="{DynamicResource Accent.3}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AgentAvatar.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Foreground" Value="{DynamicResource Accent.1}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ColorKey}" Value="blue">
                <Setter Property="Foreground" Value="{DynamicResource Status.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="mint">
                <Setter Property="Foreground" Value="{DynamicResource Status.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="amber">
                <Setter Property="Foreground" Value="{DynamicResource Status.Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="violet">
                <Setter Property="Foreground" Value="{DynamicResource Accent.2}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="red">
                <Setter Property="Foreground" Value="{DynamicResource Status.Danger}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="magenta">
                <Setter Property="Foreground" Value="{DynamicResource Accent.3}"/>
            </DataTrigger>
            <!-- a new tool: the glyph pops in (Text is bound with NotifyOnTargetUpdated) -->
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.22"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.55" To="1" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.55" To="1" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    <!-- the tier badge (ถูก / กลาง / ลึก) next to an agent's name -->
    <Style x:Key="AgentTier.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Text" Value="{Binding Tier}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tier}" Value="cheap"><Setter Property="Text" Value="{services:Loc usage.tier.cheap}"/></DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="mid"><Setter Property="Text" Value="{services:Loc usage.tier.mid}"/></DataTrigger>
            <DataTrigger Binding="{Binding Tier}" Value="deep"><Setter Property="Text" Value="{services:Loc usage.tier.deep}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        FOLDERS — one drawn folder for the whole app (owner 2026-11-10: "ไอค่อนโฟลเด้อ มันดูไม่ชัด … สำรวจไอค่อน โฟลเด้อ
        จุดอื่นให้เปลี่ยนตามกันด้วยเช่น ไฟล์ในโปรเจค"). The Segoe MDL2 folders were thin outlines that read as a grey box
        at 11-13 px, and E838 (open folder) drew as a half bracket. These are filled, in the theme's accents (the tab in
        Accent.2, the body in Accent.Gradient), and scale to any size: give the ContentControl a Width and Height in about
        16:13. FolderIcon = a folder (a project, a directory in a tree, a folder setting); FolderIconOpen = an open folder
        (an expanded directory, an "open / browse folder" action); FolderIconNew = a folder with a plus (add / make one).
        Dimmed with the control they sit in when it is disabled.
    -->
    <DataTemplate x:Key="Icon.Folder">
        <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="13">
                <Path Data="M1,1.6 Q1,0.5 2.1,0.5 L5.8,0.5 Q6.4,0.5 6.8,1 L7.8,2.2 L13.9,2.2 Q15,2.2 15,3.3 L15,5 L1,5 Z"
                      Fill="{DynamicResource Accent.2}"/>
                <Path Data="M0.5,4.6 Q0.5,3.6 1.5,3.6 L14.5,3.6 Q15.5,3.6 15.5,4.6 L15.5,11.7 Q15.5,12.8 14.4,12.8 L1.6,12.8 Q0.5,12.8 0.5,11.7 Z"
                      Fill="{DynamicResource Accent.Gradient}"/>
                <Path Data="M1.6,5 L14.4,5" Stroke="#59FFFFFF" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="Icon.FolderOpen">
        <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="13">
                <Path Data="M0.5,1.6 Q0.5,0.5 1.6,0.5 L5.3,0.5 Q5.9,0.5 6.3,1 L7.3,2.2 L13.2,2.2 Q14.3,2.2 14.3,3.3 L14.3,5.4 L2.6,5.4 Q1.6,5.4 1.4,6.4 L0.5,11.6 Z"
                      Fill="{DynamicResource Accent.2}"/>
                <Path Data="M2.7,5.4 L15,5.4 Q15.9,5.4 15.7,6.3 L14.4,11.9 Q14.2,12.8 13.3,12.8 L1.3,12.8 Q0.4,12.8 0.6,11.9 L1.8,6.3 Q2,5.4 2.7,5.4 Z"
                      Fill="{DynamicResource Accent.Gradient}"/>
                <Path Data="M2.8,6.8 L14.6,6.8" Stroke="#59FFFFFF" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="Icon.FolderNew">
        <Viewbox Stretch="Uniform">
            <Canvas Width="16" Height="13">
                <Path Data="M1,1.6 Q1,0.5 2.1,0.5 L5.8,0.5 Q6.4,0.5 6.8,1 L7.8,2.2 L13.9,2.2 Q15,2.2 15,3.3 L15,5 L1,5 Z"
                      Fill="{DynamicResource Accent.2}"/>
                <Path Data="M0.5,4.6 Q0.5,3.6 1.5,3.6 L14.5,3.6 Q15.5,3.6 15.5,4.6 L15.5,11.7 Q15.5,12.8 14.4,12.8 L1.6,12.8 Q0.5,12.8 0.5,11.7 Z"
                      Fill="{DynamicResource Accent.Gradient}"/>
                <Path Data="M8,6.1 L8,11 M5.55,8.55 L10.45,8.55" Stroke="{DynamicResource Text.OnAccent}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <Style x:Key="FolderIcon" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Content" Value="folder"/>
        <Setter Property="ContentTemplate" Value="{StaticResource Icon.Folder}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FolderIconOpen" TargetType="ContentControl" BasedOn="{StaticResource FolderIcon}">
        <Setter Property="ContentTemplate" Value="{StaticResource Icon.FolderOpen}"/>
    </Style>
    <Style x:Key="FolderIconNew" TargetType="ContentControl" BasedOn="{StaticResource FolderIcon}">
        <Setter Property="ContentTemplate" Value="{StaticResource Icon.FolderNew}"/>
    </Style>

</ResourceDictionary>
