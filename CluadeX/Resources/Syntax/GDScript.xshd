<?xml version="1.0" encoding="utf-8"?>
<!-- GDScript (Godot 4).
     Colour NAMES are the contract, not the colours: NeonHighlighting re-tints each one to a Syntax.* token by
     name (Function -> Syntax.Function, ControlKeyword -> Syntax.Control, PropertyName -> Syntax.Variable, ...).
     A new colour must use a name PickThemed maps; tests/syntaxtest fails otherwise.
     Rules: the earliest match wins; at the same column the span / rule listed first does. -->
<SyntaxDefinition name="GDScript" extensions=".gd" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" exampleText="# comment" />
  <Color name="DocComment" foreground="#808080" exampleText="## doc comment" />
  <Color name="String" foreground="#CE9178" exampleText="&quot;text&quot;" />
  <Color name="Number" foreground="#B5CEA8" exampleText="0.10" />
  <Color name="Keyword" foreground="#569CD6" exampleText="func" />
  <Color name="ControlKeyword" foreground="#C586C0" exampleText="return" />
  <Color name="ConstantKeyword" foreground="#569CD6" exampleText="null" />
  <Color name="Type" foreground="#4EC9B0" exampleText="Vector2" />
  <Color name="Function" foreground="#DCDCAA" exampleText="_ready()" />
  <Color name="Annotation" foreground="#D7BA7D" exampleText="@export" />
  <Color name="NodeVariable" foreground="#9CDCFE" exampleText="$Player" />
  <Color name="ConstantVariable" foreground="#4FC1FF" exampleText="MAX_SPEED" />
  <Color name="Property" foreground="#9CDCFE" exampleText="node.position" />

  <RuleSet>
    <!-- ## documents the next declaration (Godot 4 doc comments); # is an ordinary comment. -->
    <Span color="DocComment" begin="##" />
    <Span color="Comment" begin="#" />
    <!-- Triple quotes before single ones. &amp;"x" = StringName, ^"x" = NodePath, r"x" = raw. -->
    <Span color="String" multiline="true">
      <Begin>(?:[&amp;^]|\br)?"""</Begin>
      <End>"""</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Span color="String" multiline="true">
      <Begin>(?:[&amp;^]|\br)?'''</Begin>
      <End>'''</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Span color="String">
      <Begin>(?:[&amp;^]|\br)?"</Begin>
      <End>"</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Span color="String">
      <Begin>(?:[&amp;^]|\br)?'</Begin>
      <End>'</End>
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>

    <!-- Keywords and types come before the call rule: int(x) is a type, if (x) is control flow. -->
    <Rule color="Annotation">@[A-Za-z_]\w*</Rule>
    <!-- $Node/Path and %UniqueName, but not the modulo operator (a % b, "%d" % n). -->
    <Rule color="NodeVariable">\$%?[A-Za-z_][\w/]*|(?&lt;![\w)\]\s])%[A-Za-z_]\w*|(?&lt;=(?:^|[(\[,=:])\s*)%[A-Za-z_]\w*</Rule>
    <Keywords color="ControlKeyword">
      <Word>if</Word><Word>elif</Word><Word>else</Word><Word>for</Word><Word>while</Word><Word>match</Word>
      <Word>when</Word><Word>break</Word><Word>continue</Word><Word>pass</Word><Word>return</Word><Word>yield</Word>
      <Word>await</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>var</Word><Word>const</Word><Word>func</Word><Word>class</Word><Word>class_name</Word><Word>extends</Word>
      <Word>static</Word><Word>enum</Word><Word>signal</Word><Word>export</Word><Word>onready</Word><Word>tool</Word>
      <Word>setget</Word><Word>is</Word><Word>as</Word><Word>in</Word><Word>not</Word><Word>and</Word><Word>or</Word>
      <Word>self</Word><Word>super</Word><Word>preload</Word><Word>breakpoint</Word><Word>assert</Word>
    </Keywords>
    <Keywords color="ConstantKeyword">
      <Word>true</Word><Word>false</Word><Word>null</Word><Word>PI</Word><Word>TAU</Word><Word>INF</Word>
      <Word>NAN</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>void</Word><Word>bool</Word><Word>int</Word><Word>float</Word><Word>String</Word><Word>StringName</Word>
      <Word>NodePath</Word><Word>Vector2</Word><Word>Vector2i</Word><Word>Vector3</Word><Word>Vector3i</Word>
      <Word>Vector4</Word><Word>Vector4i</Word><Word>Color</Word><Word>Rect2</Word><Word>Rect2i</Word>
      <Word>Transform2D</Word><Word>Transform3D</Word><Word>Basis</Word><Word>Quaternion</Word><Word>Plane</Word>
      <Word>AABB</Word><Word>Projection</Word><Word>RID</Word><Word>Callable</Word><Word>Signal</Word>
      <Word>Array</Word><Word>Dictionary</Word><Word>Object</Word><Word>Variant</Word><Word>PackedByteArray</Word>
      <Word>PackedInt32Array</Word><Word>PackedInt64Array</Word><Word>PackedFloat32Array</Word>
      <Word>PackedFloat64Array</Word><Word>PackedStringArray</Word><Word>PackedVector2Array</Word>
      <Word>PackedVector3Array</Word><Word>PackedVector4Array</Word><Word>PackedColorArray</Word><Word>Node</Word>
      <Word>Node2D</Word><Word>Node3D</Word><Word>Control</Word><Word>CanvasItem</Word><Word>Resource</Word>
      <Word>RefCounted</Word><Word>SceneTree</Word><Word>Engine</Word><Word>Input</Word><Word>OS</Word><Word>IP</Word>
      <Word>JSON</Word><Word>Time</Word><Word>Timer</Word><Word>Tween</Word><Word>Sprite2D</Word><Word>Sprite3D</Word>
      <Word>AnimatedSprite2D</Word><Word>AnimationPlayer</Word><Word>CharacterBody2D</Word>
      <Word>CharacterBody3D</Word><Word>RigidBody2D</Word><Word>RigidBody3D</Word><Word>StaticBody2D</Word>
      <Word>Area2D</Word><Word>Area3D</Word><Word>CollisionShape2D</Word><Word>Camera2D</Word><Word>Camera3D</Word>
      <Word>Label</Word><Word>Button</Word><Word>TextureRect</Word><Word>AudioStream</Word><Word>AudioStreamWAV</Word>
      <Word>AudioStreamPlayer</Word><Word>AudioStreamPlayer2D</Word><Word>AudioStreamPlayer3D</Word>
      <Word>PackedScene</Word><Word>Texture2D</Word><Word>Image</Word><Word>InputEvent</Word>
      <Word>InputEventKey</Word><Word>InputEventMouseButton</Word>
    </Keywords>
    <!-- Any other Capitalised identifier with a lower-case letter is a class (Godot's or a class_name). -->
    <Rule color="Type">\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\b</Rule>
    <!-- ALL_CAPS: constants and enum values (RATE, KEY_SPACE). -->
    <Rule color="ConstantVariable">\b[A-Z][A-Z0-9_]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:0x[0-9A-Fa-f_]+|0b[01_]+|(?:\d[\d_]*(?:\.[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?)(?!\w)</Rule>
    <!-- Definitions and calls alike: an identifier followed by ( -->
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <!-- obj.member that is not a call -->
    <Rule color="Property">(?&lt;=\.)[a-z_]\w*\b(?!\s*\()</Rule>
  </RuleSet>
</SyntaxDefinition>
