<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tooltest</AssemblyName>
    <RootNamespace>ToolTest</RootNamespace>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- The REAL shipping assembly — linked, NOT rebuilt: build CluadeX first or you test a stale binary.
       Default is the normal Debug output. While the app is running (its exe is locked), build CluadeX with
       -p:OutDir=<dir>\ instead and point this at it: dotnet run -p:CluadeXBin=<dir>\ -->
  <PropertyGroup>
    <CluadeXBin Condition="'$(CluadeXBin)' == ''">$(MSBuildThisFileDirectory)..\..\CluadeX\bin\DebugBuild\net8.0-windows\</CluadeXBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CluadeX">
      <HintPath>$(CluadeXBin)CluadeX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The differential check (DIFF) compares the blocklist with a BASELINE build of CluadeX — the last
       committed version, built into its own folder: -p:CluadeXBaselineBin=<dir>\ (or set CLUADEX_BASELINE_BIN).
       Only CluadeX.dll is loaded from there, into its own AssemblyLoadContext; nothing in it is run but the check. -->
  <ItemGroup Condition="'$(CluadeXBaselineBin)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CluadeXBaselineBin</_Parameter1>
      <_Parameter2>$(CluadeXBaselineBin)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Versions must match what CluadeX was COMPILED against (Abstractions is unified to 10.x). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.5" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="LLamaSharp" Version="0.26.0" />
  </ItemGroup>

  <!-- portable.txt next to the exe => SettingsService uses <exe>\Data as its data root, so this
       harness can never touch the user's real ~/.cluadex (settings, chat DB). -->
  <ItemGroup>
    <None Include="portable.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
