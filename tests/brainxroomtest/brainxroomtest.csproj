<Project Sdk="Microsoft.NET.Sdk">

  <!-- Live round trip through the BrainX cowork room: CluadeX's BrainX model posts a request, an agent in the room
       answers, and the reply must come back under the agent's name with its code block and [done] handled.
       Needs BrainX installed with the cowork room open, and somebody in the room to answer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>brainxroomtest</AssemblyName>
    <RootNamespace>BrainXRoomTest</RootNamespace>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- The REAL shipping assembly — linked, NOT rebuilt: build CluadeX first. -->
  <PropertyGroup>
    <CluadeXBin Condition="'$(CluadeXBin)' == ''">$(MSBuildThisFileDirectory)..\..\CluadeX\bin\DebugBuild\net8.0-windows\</CluadeXBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CluadeX">
      <HintPath>$(CluadeXBin)CluadeX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.5" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- portable.txt => settings live next to the exe, never the user's ~/.cluadex. -->
  <ItemGroup>
    <None Include="portable.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
