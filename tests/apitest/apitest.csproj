<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>apitest</AssemblyName>
    <RootNamespace>ApiTest</RootNamespace>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- The REAL shipping assembly — linked, NOT rebuilt: build CluadeX first or you test a stale binary.
       While the app is running (its exe is locked), build CluadeX with -p:OutDir=<dir>\ and point this
       at it: dotnet run -p:CluadeXBin=<dir>\ -->
  <PropertyGroup>
    <CluadeXBin Condition="'$(CluadeXBin)' == ''">$(MSBuildThisFileDirectory)..\..\CluadeX\bin\Debug\net8.0-windows\</CluadeXBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CluadeX">
      <HintPath>$(CluadeXBin)CluadeX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Versions must match what CluadeX was COMPILED against (Abstractions is unified to 10.x). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- portable.txt next to the exe => SettingsService uses <exe>\Data as its data root, so this
       harness never writes the user's real ~/.cluadex. The API key is only READ from there. -->
  <ItemGroup>
    <None Include="portable.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- ImageWire: the no-image Anthropic request bodies captured from the build before tool images existed. -->
    <None Include="fixtures\*.golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
