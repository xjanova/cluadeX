<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>graphtest</AssemblyName>
    <RootNamespace>GraphTest</RootNamespace>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- The fixture projects are data the harness reads, never code this project compiles. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
    <Page Remove="fixtures/**" />
    <ApplicationDefinition Remove="fixtures/**" />
    <None Remove="fixtures/**" />
  </ItemGroup>

  <!-- The REAL shipping assembly — linked, NOT rebuilt: build CluadeX first or you test a stale binary.
       While the app is running (its exe is locked), build CluadeX with -p:OutDir=<dir>\ and point this
       at it: dotnet run -p:CluadeXBin=<dir>\ -->
  <PropertyGroup>
    <CluadeXBin Condition="'$(CluadeXBin)' == ''">$(MSBuildThisFileDirectory)..\..\CluadeX\bin\DebugBuild\net8.0-windows\</CluadeXBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CluadeX">
      <HintPath>$(CluadeXBin)CluadeX.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Versions must match what CluadeX was COMPILED against. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
